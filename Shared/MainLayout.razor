@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ThemeState ThemeState
@inject IJSRuntime JS
@inject Healthspan.Offline.SyncStatusService SyncStatus
@inject Healthspan.Offline.SyncCoordinator SyncCoordinator
@inject Healthspan.Offline.SyncEngine SyncEngine
@inject AppStateService AppState
@inject ActiveSessionState ActiveSession
@implements IDisposable

<MudThemeProvider IsDarkMode="@ThemeState.IsDarkMode" Theme="@HealthspanTheme.Default" />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="hs-shell">
    <header class="hs-topbar">
        <MudText Typo="Typo.subtitle2" Class="hs-topbar-brand">Healthspan</MudText>
        <MudSpacer />
        <SyncStatusIndicator />
        <MudMenu AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Icon="@Icons.Material.Filled.Person"
                 AriaLabel="Account and health sections"
                 Class="hs-topbar-account">
            <MudMenuItem OnClick='@(() => Go("/health/dashboard"))'>Health dashboard</MudMenuItem>
            <MudMenuItem OnClick='@(() => Go("/health/blood-tests"))'>Blood Tests</MudMenuItem>
            <MudMenuItem OnClick='@(() => Go("/health/biomarkers"))'>Biomarkers</MudMenuItem>
            <MudMenuItem OnClick='@(() => Go("/health/assessments"))'>Assessments</MudMenuItem>
            <MudMenuItem OnClick='@(() => Go("/health/profile"))'>Personal Profile</MudMenuItem>
            @if (_isTrainer)
            {
                <MudMenuItem OnClick='@(() => Go("/trainees"))'>Trainees</MudMenuItem>
            }
            <MudMenuItem OnClick='@(() => Go("/settings"))'>Account &amp; Settings</MudMenuItem>
        </MudMenu>
    </header>

    <aside class="hs-sidebar" aria-label="Primary navigation">
        <div class="hs-sidebar-brand">
            <div class="hs-brand-mark" aria-hidden="true">H</div>
            <div>
                <MudText Typo="Typo.h6" Class="hs-brand-name">Healthspan</MudText>
                <MudText Typo="Typo.caption" Class="hs-brand-caption">Health + training</MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="@(ActiveSession.SessionId is null ? MudBlazor.Color.Primary : MudBlazor.Color.Success)"
                   FullWidth="true"
                   StartIcon="@(ActiveSession.SessionId is null ? Icons.Material.Filled.Add : Icons.Material.Filled.Check)"
                   Class="hs-sidebar-cta"
                   OnClick="OnLogWorkoutClicked">
            @(ActiveSession.SessionId is null ? "Registrar entreno" : "Finalizar entreno")
        </MudButton>
        <NavMenu />
    </aside>

    <main class="main-content hs-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="hs-app-content">
            @Body
        </MudContainer>
    </main>

    <nav class="hs-bottom-nav" aria-label="Primary navigation">
        <NavLink href="/training/today" class="hs-bottom-nav-link" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="MudBlazor.Size.Small" />
            <span>Hoy</span>
        </NavLink>
        <NavLink href="/training/history" class="hs-bottom-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="MudBlazor.Size.Small" />
            <span>Historial</span>
        </NavLink>
        <button type="button"
                class="@(ActiveSession.SessionId is null ? "hs-fab" : "hs-fab hs-fab-done")"
                aria-label="@(ActiveSession.SessionId is null ? "Registrar entreno" : "Finalizar entreno")"
                @onclick="OnLogWorkoutClicked">
            @if (ActiveSession.SessionId is null)
            {
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="MudBlazor.Size.Medium" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Size="MudBlazor.Size.Medium" />
                <span class="hs-fab-label">Finalizar</span>
            }
        </button>
        <NavLink href="/training/insights" class="hs-bottom-nav-link" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.Insights" Size="MudBlazor.Size.Small" />
            <span>Insights</span>
        </NavLink>
        <NavLink href="/training/library" class="hs-bottom-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="MudBlazor.Size.Small" />
            <span>Biblioteca</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool _jsBridgeRegistered;
    private DotNetObjectReference<MainLayout>? _selfRef;

    private bool _isTrainer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jsBridgeRegistered)
        {
            return;
        }

        // Bridge browser online/offline events to the sync status service and
        // start the queue-drain loop for this app scope.
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("hsdb.setConnectivityBridge", _selfRef);
        SyncCoordinator.Register(SyncEngine);
        SyncEngine.Start(CancellationToken.None);
        _jsBridgeRegistered = true;
    }

    [JSInvokable]
    public void OnBrowserConnectivity(bool online)
    {
        if (online)
        {
            SyncStatus.MarkOnline();
            _ = SyncCoordinator.TriggerDrainAsync();
        }
        else
        {
            SyncStatus.MarkOffline();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += HandleThemeChanged;
        ActiveSession.Changed += HandleActiveSessionChanged;

        // Redirect based on auth state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var isRoot = string.IsNullOrWhiteSpace(relativePath) || relativePath == "/";

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var roles = await AppState.GetUserRolesAsync();
            _isTrainer = roles.Contains("Trainer");

            if (isRoot)
                NavigationManager.NavigateTo("/training/insights");
        }
        else if (!IsAnonymousRoute(relativePath))
        {
            // Land back in context after login (ux-ui-good-apps rule 2):
            // preserve the page the user was trying to reach as returnUrl,
            // matching RedirectToLogin so the two redirects agree.
            if (isRoot)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var returnUrl = "/" + relativePath.TrimStart('/');
                NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
            }
        }
    }

    private static bool IsAnonymousRoute(string relativePath) =>
        relativePath.StartsWith("login", StringComparison.OrdinalIgnoreCase) ||
        relativePath.StartsWith("register", StringComparison.OrdinalIgnoreCase);

    private void Go(string route) => NavigationManager.NavigateTo(route);
    private void GoToToday() => NavigationManager.NavigateTo("/training/today");

    // The FAB and the "Hoy" tab are not the same affordance: "Hoy" is the day
    // summary, the FAB is a quick start. With no session open it lands on Today
    // already logged in to the logging state (1 tap, no wizard); with a session
    // open it closes that session through the flow Today itself registered.
    private void GoToQuickStart() => NavigationManager.NavigateTo("/training/today?start=1");

    private async Task OnLogWorkoutClicked()
    {
        if (ActiveSession.SessionId is null)
        {
            GoToQuickStart();
            return;
        }

        await ActiveSession.FinishAsync();
    }

    private void HandleActiveSessionChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void HandleThemeChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeState.Changed -= HandleThemeChanged;
        ActiveSession.Changed -= HandleActiveSessionChanged;
        SyncCoordinator.Unregister(SyncEngine);
        SyncEngine.Stop();
        _selfRef?.Dispose();
        _selfRef = null;
    }
}
