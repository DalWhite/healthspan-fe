@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using System.Security.Claims
@inject Blazored.LocalStorage.ISyncLocalStorageService LocalStorage

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="hs-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="MudBlazor.Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle navigation"
                       OnClick="ToggleDrawer" />
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="hs-appbar-primary-action"
                   OnClick="GoToToday">
            Log workout
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen"
               Elevation="0"
               Variant="@DrawerVariant.Responsive"
               Breakpoint="@Breakpoint.Md"
               Class="hs-app-drawer">
        <MudDrawerHeader Class="hs-drawer-header">
            <div class="hs-brand-mark">H</div>
            <div>
                <MudText Typo="Typo.h6" Class="hs-brand-name">Healthspan</MudText>
                <MudText Typo="Typo.caption" Class="hs-brand-caption">Health + training</MudText>
            </div>
        </MudDrawerHeader>
        <NavMenu />

        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <div class="hs-account-dock">
                    <MudIconButton OnClick="GoToSettings"
                                   Icon="@Icons.Material.Filled.Settings"
                                   aria-label="settings" />
                    <MudAvatar Color="MudBlazor.Color.Primary"
                               Class="hs-account-avatar"
                               title="Profile"
                               role="button"
                               tabindex="0"
                               @onclick="GoToProfile"
                               @onkeydown="OnAvatarKeyDown">
                        @GetAvatarInitial(context.User)
                    </MudAvatar>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent Class="main-content hs-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="hs-app-content">
            @Body
        </MudContainer>
    </MudMainContent>

    <nav class="hs-mobile-bottom-nav" aria-label="Primary navigation">
        <NavLink href="/health/dashboard" class="hs-mobile-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="MudBlazor.Size.Small" />
            <span>Health</span>
        </NavLink>
        <NavLink href="/training/today" class="hs-mobile-nav-link hs-mobile-nav-primary" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="MudBlazor.Size.Small" />
            <span>Today</span>
        </NavLink>
        <NavLink href="/training/history" class="hs-mobile-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="MudBlazor.Size.Small" />
            <span>History</span>
        </NavLink>
        <NavLink href="/training/library" class="hs-mobile-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="MudBlazor.Size.Small" />
            <span>Library</span>
        </NavLink>
    </nav>
</MudLayout>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        Palette = new PaletteLight
        {
            Primary = "#ae1d0d",
            Secondary = "#035960",
            AppbarBackground = "#082f33",
            DrawerBackground = "#f7faf9",
            Background = "#f3f7f6",
            Surface = "#ffffff"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#ae1d0d",
            Secondary = "#05a0ac",
            AppbarBackground = "#102c30",
            DrawerBackground = "#13272a",
            Background = "#0e1c1f",
            Surface = "#172b2e"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        // Restore dark mode preference
        if (LocalStorage.ContainKey("_isDarkMode"))
            _isDarkMode = LocalStorage.GetItem<bool>("_isDarkMode");

        // Redirect based on auth state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var isRoot = string.IsNullOrWhiteSpace(relativePath) || relativePath == "/";

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            if (isRoot)
                NavigationManager.NavigateTo("/health/dashboard");
        }
        else
            NavigationManager.NavigateTo("/login");
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void GoToToday() => NavigationManager.NavigateTo("/training/today");
    private void GoToProfile() => NavigationManager.NavigateTo("/profile");
    private void GoToSettings() => NavigationManager.NavigateTo("/settings");
    private void OnAvatarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            GoToProfile();
        }
    }

    private static string GetAvatarInitial(ClaimsPrincipal? user)
    {
        var source = user?.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user?.FindFirst(ClaimTypes.Name)?.Value
            ?? user?.FindFirst(ClaimTypes.Email)?.Value
            ?? user?.Identity?.Name;

        return string.IsNullOrWhiteSpace(source) ? "U" : source.Trim()[0].ToString().ToUpperInvariant();
    }
}
