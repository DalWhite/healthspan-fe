@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using System.Security.Claims
@inject TitleService TitleService
@inject Blazored.LocalStorage.ISyncLocalStorageService LocalStorage

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="MudBlazor.Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">@TitleService.Title</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Elevation="1" Class="drawer-responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Healthspan</MudText>
        </MudDrawerHeader>
        <NavMenu />

        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <div class="hs-account-dock ml-6 mb-6">
                    <MudIconButton OnClick="GoToSettings"
                                   Icon="@Icons.Material.Filled.Settings"
                                   aria-label="settings" />
                    <MudAvatar Color="MudBlazor.Color.Primary"
                               Class="hs-account-avatar"
                               title="Profile"
                               role="button"
                               tabindex="0"
                               @onclick="GoToProfile"
                               @onkeydown="OnAvatarKeyDown">
                        @GetAvatarInitial(context.User)
                    </MudAvatar>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent Class="main-content">
        <MudContainer Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = false;

    private readonly MudTheme _theme = new()
    {
        Palette = new PaletteLight
        {
            Primary = "#ae1d0d",
            Secondary = "#035960",
            AppbarBackground = "#02363a"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#ae1d0d",
            Secondary = "#05a0ac",
            AppbarBackground = "#108b37"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to title changes
        TitleService.OnChange += StateHasChanged;

        // Restore dark mode preference
        if (LocalStorage.ContainKey("_isDarkMode"))
            _isDarkMode = LocalStorage.GetItem<bool>("_isDarkMode");

        // Redirect based on auth state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var isRoot = string.IsNullOrWhiteSpace(relativePath) || relativePath == "/";

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            if (isRoot)
                NavigationManager.NavigateTo("/health/dashboard");
        }
        else
            NavigationManager.NavigateTo("/login");
    }

    public void Dispose() => TitleService.OnChange -= StateHasChanged;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void GoToProfile() => NavigationManager.NavigateTo("/profile");
    private void GoToSettings() => NavigationManager.NavigateTo("/settings");
    private void OnAvatarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            GoToProfile();
        }
    }

    private static string GetAvatarInitial(ClaimsPrincipal? user)
    {
        var source = user?.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user?.FindFirst(ClaimTypes.Name)?.Value
            ?? user?.FindFirst(ClaimTypes.Email)?.Value
            ?? user?.Identity?.Name;

        return string.IsNullOrWhiteSpace(source) ? "U" : source.Trim()[0].ToString().ToUpperInvariant();
    }
}
