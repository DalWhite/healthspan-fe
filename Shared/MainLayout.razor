@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using Healthspan.Authentication
@inject IAccountManagement Acct
@inject TitleService TitleService
@inject Blazored.LocalStorage.ISyncLocalStorageService localStorage

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_currentTheme"/>
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">
            @TitleService.Title
        </MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="@open" Elevation="1" Class="drawer-responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Healthspan</MudText>
        </MudDrawerHeader>
        <NavMenu />
        <MudSwitch @bind-Checked="@_isDarkMode" Size="Size.Small" Color="Color.Primary" Class="ma-4" T="bool" Label="Dark Theme" ValueChanged="HandleValueChanged"/>
        <MudSpacer/>
        <AuthorizeView>
            <Authorized>
                <div class= "d-inline object-bottom ml-6 mb-6">
                    <MudAvatar Color="Color.Primary">@context.User?.Identity?.Name[0].ToString().ToUpper()</MudAvatar>
                    <MudButton OnClick="@Logout" Color="Color.Tertiary">Logout</MudButton>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudDrawer>
    <MudMainContent Class="main-content">
        <MudContainer Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>


@code {
    private MudTheme _theme = new();
    private bool _isDarkMode;
    bool open = false;

    private readonly MudTheme _currentTheme = new()
    {
        Palette = new PaletteLight
        {
            Primary = "#ae1d0d",
            Secondary = "#035960",
            AppbarBackground = "#02363a"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#ae1d0d",
            Secondary = "#05a0ac",
            AppbarBackground = "#108b37"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            NavigationManager.NavigateTo("/workouts");
        }
        else
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    void ToggleDrawer()
    {
        open = !open;
    }
    async Task Logout()
    {
        if (await Acct.CheckAuthenticatedAsync())
        {
            await Acct.LogoutAsync();
        }

        NavigationManager.NavigateTo("/login", true);
    }

    protected override void OnInitialized()
    {
        TitleService.OnChange += StateHasChanged;

        if (localStorage.ContainKey("_isDarkMode"))
        {
            _isDarkMode = localStorage.GetItem<bool>("_isDarkMode");
        }
    }

    private void HandleValueChanged(bool value)
    {
        localStorage.SetItem("_isDarkMode", value);
    }
    public void Dispose()
    {
        TitleService.OnChange -= StateHasChanged;
    }
}