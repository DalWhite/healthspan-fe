@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject Blazored.LocalStorage.ISyncLocalStorageService LocalStorage
@inject ThemeState ThemeState
@implements IDisposable

<MudThemeProvider IsDarkMode="@ThemeState.IsDarkMode" Theme="@HealthspanTheme.Default" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="hs-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="MudBlazor.Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle navigation"
                       OnClick="ToggleDrawer" />
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="hs-appbar-primary-action"
                   OnClick="GoToToday">
            Log workout
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen"
               id="app-navigation-drawer"
               Elevation="0"
               Variant="@DrawerVariant.Responsive"
               Breakpoint="@Breakpoint.Md"
               Class="hs-app-drawer">
        <MudDrawerHeader Class="hs-drawer-header">
            <div class="hs-brand-mark">H</div>
            <div>
                <MudText Typo="Typo.h6" Class="hs-brand-name">Healthspan</MudText>
                <MudText Typo="Typo.caption" Class="hs-brand-caption">Health + training</MudText>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Class="hs-drawer-close"
                           aria-label="Close navigation menu"
                           OnClick="ToggleDrawer" />
        </MudDrawerHeader>
        <NavMenu />

        <MudSpacer />
    </MudDrawer>

    <MudMainContent Class="main-content hs-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="hs-app-content">
            @Body
        </MudContainer>
    </MudMainContent>

    <nav class="hs-mobile-bottom-nav" aria-label="Primary navigation">
        <button type="button"
                class="hs-mobile-nav-link hs-mobile-nav-menu"
                aria-label="@(_drawerOpen ? "Close navigation menu" : "Open navigation menu")"
                aria-controls="app-navigation-drawer"
                aria-expanded="@_drawerOpen"
                @onclick="ToggleDrawer">
            <MudIcon Icon="@Icons.Material.Filled.Menu" Size="MudBlazor.Size.Small" />
            <span>Menu</span>
        </button>
        <NavLink href="/health/dashboard" class="hs-mobile-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="MudBlazor.Size.Small" />
            <span>Health</span>
        </NavLink>
        <NavLink href="/training/today" class="hs-mobile-nav-link hs-mobile-nav-primary" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="MudBlazor.Size.Small" />
            <span>Today</span>
        </NavLink>
        <NavLink href="/training/history" class="hs-mobile-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.History" Size="MudBlazor.Size.Small" />
            <span>History</span>
        </NavLink>
        <NavLink href="/training/library" class="hs-mobile-nav-link" Match="NavLinkMatch.Prefix">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="MudBlazor.Size.Small" />
            <span>Library</span>
        </NavLink>
    </nav>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += HandleThemeChanged;

        if (LocalStorage.ContainKey("_isDarkMode"))
            ThemeState.SetDarkMode(LocalStorage.GetItem<bool>("_isDarkMode"));

        // Redirect based on auth state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var isRoot = string.IsNullOrWhiteSpace(relativePath) || relativePath == "/";

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            if (isRoot)
                NavigationManager.NavigateTo("/health/dashboard");
        }
        else
            NavigationManager.NavigateTo("/login");
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void GoToToday() => NavigationManager.NavigateTo("/training/today");

    private void HandleThemeChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
        => ThemeState.Changed -= HandleThemeChanged;

}
