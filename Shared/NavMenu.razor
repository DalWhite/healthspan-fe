@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppStateService AppState

<MudNavMenu Class="hs-nav-menu">
    <MudNavGroup Title="Health" Icon="@Icons.Material.Filled.MonitorHeart" Expanded="true">
        <MudNavLink Href="health/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">
            Dashboard
        </MudNavLink>

        <MudNavLink Href="health/blood-tests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Biotech">
            Blood Tests
        </MudNavLink>

        <MudNavLink Href="health/biomarkers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QueryStats">
            Biomarkers
        </MudNavLink>

        <MudNavLink Href="health/assessments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">
            Assessments
        </MudNavLink>

    </MudNavGroup>

    <MudNavGroup Title="Training" Icon="@Icons.Material.Filled.FitnessCenter" Expanded="true">
        <MudNavLink Href="training/today" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AddCircle">
            Hoy
        </MudNavLink>

        <MudNavLink Href="training/history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">
            Historial
        </MudNavLink>

        <MudNavLink Href="training/library" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FitnessCenter">
            Biblioteca
        </MudNavLink>

        <MudNavLink Href="training/insights" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Insights">
            Insights
        </MudNavLink>
    </MudNavGroup>

    @if (_isTrainer)
    {
        <MudNavGroup Title="Coaching" Icon="@Icons.Material.Filled.Groups">
            <MudNavLink Href="trainees" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                Trainees
            </MudNavLink>
        </MudNavGroup>
    }

    <MudNavGroup Title="Account" Icon="@Icons.Material.Filled.AccountCircle">
        <MudNavLink Href="health/profile" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Badge">
            Personal Profile
        </MudNavLink>

        <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
            Account &amp; Settings
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code {
    private bool _isTrainer = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var roles = await AppState.GetUserRolesAsync();
            _isTrainer = roles.Contains("Trainer");
        }
    }
}
