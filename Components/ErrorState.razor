<div class="hs-error-state" role="alert" aria-live="assertive">
    <MudIcon Icon="@Icon" Class="hs-state-icon" aria-hidden="true" />
    <MudText Typo="Typo.h6">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <MudText Typo="Typo.body2" Class="hs-state-copy">@Message</MudText>
    }
    @if (!string.IsNullOrWhiteSpace(ActionLabel) && OnAction.HasDelegate)
    {
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   OnClick="OnAction">
            @ActionLabel
        </MudButton>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.ErrorOutline;
    [Parameter] public string Title { get; set; } = "Something went wrong";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
