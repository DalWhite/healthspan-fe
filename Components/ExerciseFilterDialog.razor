@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudContainer Class="mt-4">
            <MudText Typo="Typo.h6" Class="mb-3">Filter By Exercise Type</MudText>
            <MudAutocomplete T="ExerciseTypeFilterOption"
                         @bind-Value="selectedExerciseType"
                         SearchFunc="@SearchExerciseTypes"
                         ToStringFunc="@(option => option?.Label ?? string.Empty)"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         Placeholder="Select an exercise type..."
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.FitnessCenter"
                         IconSize="MudBlazor.Size.Small"
                         Class="mb-4" />

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-3">Filter By Muscle Group</MudText>
            <MudContainer Class="d-flex flex-wrap gap-2 px-0">
                @foreach (var muscle in muscleGroups)
                {
                    <MudChip Color="@(selectedMuscleGroups.Contains(muscle) ? Color.Secondary : Color.Default)"
                             Variant="@(selectedMuscleGroups.Contains(muscle) ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => ToggleMuscleGroup(muscle))">
                        @muscle
                    </MudChip>
                }
            </MudContainer>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="MudBlazor.Color.Default">Cancel</MudButton>
        <MudButton OnClick="ClearFilters" Variant="Variant.Text" Color="MudBlazor.Color.Error">Clear All</MudButton>
        <MudButton OnClick="ApplyFilters" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">Apply Filters</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<ExerciseTypeFilterOption> ExerciseTypes { get; set; } = new();
    [Parameter] public List<string> MuscleGroups { get; set; } = new List<string>();
    [Parameter] public int? SelectedExerciseTypeId { get; set; }
    [Parameter] public List<string> SelectedMuscleGroups { get; set; } = new List<string>();

    private ExerciseTypeFilterOption? selectedExerciseType;
    private List<string> selectedMuscleGroups = new List<string>();
    private List<string> muscleGroups = new List<string>();

    protected override void OnInitialized()
    {
        selectedExerciseType = ExerciseTypes.FirstOrDefault(option => option.Id == SelectedExerciseTypeId);
        selectedMuscleGroups = new List<string>(SelectedMuscleGroups);
        muscleGroups = MuscleGroups;
    }

    private Task<IEnumerable<ExerciseTypeFilterOption>> SearchExerciseTypes(string value)
    {
        // Search locally to avoid API call for each keystroke
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(ExerciseTypes.AsEnumerable());

        var matches = ExerciseTypes
            .Where(x => x.Label.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .OrderBy(x => x.Label)
            .Take(10)
            .ToList();

        return Task.FromResult(matches.AsEnumerable());
    }

    private void ToggleMuscleGroup(string muscle)
    {
        if (selectedMuscleGroups.Contains(muscle))
        {
            selectedMuscleGroups.Remove(muscle);
        }
        else
        {
            selectedMuscleGroups.Add(muscle);
        }
    }

    private void ApplyFilters()
    {
        var result = new FilterSettings
        {
            ExerciseTypeId = selectedExerciseType?.Id,
            ExerciseTypeLabel = selectedExerciseType?.Label,
            MuscleGroups = selectedMuscleGroups
        };

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void ClearFilters()
    {
        selectedExerciseType = null;
        selectedMuscleGroups.Clear();
    }

    private void Cancel() => MudDialog.Cancel();

    public class FilterSettings
    {
        public int? ExerciseTypeId { get; set; }
        public string? ExerciseTypeLabel { get; set; }
        public List<string> MuscleGroups { get; set; } = new List<string>();
    }
}
