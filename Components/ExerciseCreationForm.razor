@inject HttpClient Http


<MudContainer>
    <MudDatePicker Label="Fecha"
                   @bind-Date="workoutToAdd.Date"
                   Variant="Variant.Outlined"
                   class="ma-2" />
    <MudAutocomplete T="GetExerciseTypeResource"
                     Label="Ejercicio"
                     Variant="Variant.Outlined"
                     class="ma-2"
                     @bind-Value="typeToAdd"
                     ToStringFunc="@(et => et?.Name ?? string.Empty)"
                     SearchFunc="SearchExerciseTypes"
                     CoerceText="true"
                     Clearable="true"
                     />
    <MudNumericField class="ma-2"
                     @bind-Value="exercise.Series"
                     Label="Series"
                     Variant="Variant.Outlined"
                     InputType="InputType.Number"
                     />
    <MudNumericField class="ma-2"
                     @bind-Value="exercise.Repetitions"
                     Label="Repeticiones"
                     Variant="Variant.Outlined"
                     InputType="InputType.Number"
                     />
    @if (exercise.WeightType == ExerciseWeightType.BodyWeight)
    {
        <MudNumericField class="ma-2"
                         @bind-Value="exercise.BodyWeight"
                         Label="Peso corporal"
                         Variant="Variant.Outlined"
                         InputType="InputType.Number"
                         HelperText="Tu peso actual."
                         />
        <MudNumericField class="ma-2"
                         @bind-Value="exercise.AddedWeight"
                         Label="Peso añadido"
                         Variant="Variant.Outlined"
                         InputType="InputType.Number"
                         HelperText="Peso extra usado en el ejercicio."
                         />
    }
    else if (exercise.WeightType == ExerciseWeightType.Standard)
    {
        <MudNumericField class="ma-2"
                         @bind-Value="exercise.Weight"
                         Label="Peso"
                         Variant="Variant.Outlined"
                         Step=".5M"
                         InputType="InputType.Number"
                         HelperText="Peso usado en el ejercicio."
                         />
    }
</MudContainer>

<MudFab @onclick="AddExerciseToTheForm"
    Color="Color.Primary"
    StartIcon="@Icons.Material.Filled.Add"
    style="float: right;"
    Size="Size.Small"
    class="mr-8" />

@code {
    public string createTypeButton = "CreateNew";
    // ...existing code...
    [Parameter] public GetExerciseTypeResource[]? ExerciseTypes { get; set; }
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public string? traineeId { get; set; }

    // Event callback for when an exercise is added
    [Parameter] public EventCallback<AddExerciseResource> OnExerciseAdded { get; set; }

    private AddExerciseResource exercise = new();
    private GetExerciseTypeResource? typeToAdd;
    private WorkoutPostResource workoutToAdd = new(){Date = DateTime.Now};

    // Search function for MudAutocomplete
    private Task<IEnumerable<GetExerciseTypeResource>> SearchExerciseTypes(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(ExerciseTypes?.AsEnumerable() ?? Enumerable.Empty<GetExerciseTypeResource>());
        return Task.FromResult(
            ExerciseTypes?.Where(x => x.Name != null && x.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
            ?? Enumerable.Empty<GetExerciseTypeResource>()
        );
    }

    // Set WeightType based on selected exercise type
    private void UpdateWeightType()
    {
        if (typeToAdd != null)
        {
            exercise.WeightType = typeToAdd.WeightType;
        }
        else
        {
            exercise.WeightType = ExerciseWeightType.Standard;
        }
    }
    private async Task AddExerciseToTheForm()
    {
        if (WorkoutId == Guid.Empty)
        {
            WorkoutId = await GetLastWorkoutIdOrNewIfNoWorkoutForSelectedDate(workoutToAdd.Date);
        }
        exercise.WorkoutId = WorkoutId;
        exercise.TypeId = typeToAdd?.Id;

        var response = await Http.PostAsJsonAsync("/Exercises", exercise);

        if (response.IsSuccessStatusCode)
        {
            await OnExerciseAdded.InvokeAsync(exercise);
        }

        exercise = new();
        typeToAdd = null;
    }
    private async Task<Guid> GetLastWorkoutIdOrNewIfNoWorkoutForSelectedDate(DateTime? selectedDate)
    {
    // Fetch the workouts for the trainee (if traineeId is provided) or all workouts otherwise
    var workoutsUrl = traineeId != null ? $"/workouts?traineeId={traineeId}" : "/workouts";
    var workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>(workoutsUrl);

        // Get the workout for the selected date (ordered by descending date to get the latest workout)
        var workoutForSelectedDate = workouts?
            .FirstOrDefault(w => w.Date.HasValue && selectedDate.HasValue &&
                                 w.Date.Value.Date.DayOfYear == selectedDate.Value.Date.DayOfYear &&
                                 w.Date.Value.Year == selectedDate.Value.Year);

        // If no workout exists for the selected date, create a new one
        if (workoutForSelectedDate == null)
        {
            var postResource = new WorkoutPostResource
            {
                Type = "default",
                // If traineeId is null, send null so backend won't try to set an invalid FK value
                UserId = traineeId,
                Date = selectedDate ?? DateTime.Now
            };
            var response = await Http.PostAsJsonAsync("/Workouts", postResource);
            var newWorkout = await response.Content.ReadFromJsonAsync<GetWorkoutResource>();

            return newWorkout != null ? newWorkout.Id : Guid.NewGuid();
        }

        // Return the ID of the existing workout for the selected date
        return workoutForSelectedDate.Id;
    }

    protected override void OnParametersSet()
    {
        UpdateWeightType();
    }

    // When exercise type changes, update WeightType
    private void OnTypeChanged(GetExerciseTypeResource? newType)
    {
        typeToAdd = newType;
        UpdateWeightType();
    }
}
