@inject HttpClient Http
@using System.Text.Json

<EditForm EditContext="_editContext" OnValidSubmit="SubmitExercise">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(_submissionError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mx-2 mb-2">
            @_submissionError
        </MudAlert>
    }

    <MudContainer>
        @if (ShowDatePicker)
        {
            <MudDatePicker Label="Date"
                           @bind-Date="_workout.Date"
                           Variant="Variant.Outlined"
                           Class="ma-2" />
        }

        @if (ShowQuickPicks && FavouriteQuickPicks.Count > 0)
        {
            <div class="hs-exercise-quick-picks" aria-label="Favourite exercises">
                <span class="hs-exercise-quick-label">Favourites</span>
                <div class="hs-exercise-quick-list">
                    @foreach (var exerciseType in FavouriteQuickPicks)
                    {
                        <button type="button"
                                class="hs-exercise-quick-button"
                                @onclick="@(() => SelectType(exerciseType))">
                            <MudIcon Icon="@Icons.Material.Filled.Star"
                                     Size="MudBlazor.Size.Small" />
                            <span>@exerciseType.Name</span>
                        </button>
                    }
                </div>
            </div>
        }

        @if (ShowQuickPicks && RecentQuickPicks.Count > 0)
        {
            <div class="hs-exercise-quick-picks" aria-label="Recent exercises">
                <span class="hs-exercise-quick-label">Recent</span>
                <div class="hs-exercise-quick-list">
                    @foreach (var exerciseType in RecentQuickPicks)
                    {
                        <button type="button"
                                class="hs-exercise-quick-button"
                                @onclick="@(() => SelectType(exerciseType))">
                            <MudIcon Icon="@Icons.Material.Filled.History"
                                     Size="MudBlazor.Size.Small" />
                            <span>@exerciseType.Name</span>
                        </button>
                    }
                </div>
            </div>
        }

        <MudAutocomplete T="GetExerciseTypeResource"
                         Label="Exercise"
                         Variant="Variant.Outlined"
                         Class="ma-2"
                         Value="_selectedType"
                         ValueChanged="OnTypeChanged"
                         ToStringFunc="@(et => et?.Name ?? string.Empty)"
                         SearchFunc="SearchExerciseTypes"
                         CoerceText="true"
                         Clearable="true" />

        <MudNumericField Class="ma-2"
                         @bind-Value="_exercise.Series"
                         Label="Sets"
                         Variant="Variant.Outlined"
                         InputType="InputType.Number" />

        <MudNumericField Class="ma-2"
                         @bind-Value="_exercise.Repetitions"
                         Label="Repetitions"
                         Variant="Variant.Outlined"
                         InputType="InputType.Number" />

        @if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            <MudNumericField Class="ma-2"
                             @bind-Value="_exercise.BodyWeight"
                             Label="Body Weight (kg)"
                             Variant="Variant.Outlined"
                             InputType="InputType.Number"
                             HelperText="Your current body weight."
                             Immediate="true" />

            <MudNumericField Class="ma-2"
                             @bind-Value="_exercise.AddedWeight"
                             Label="Added Weight (kg)"
                             Variant="Variant.Outlined"
                             InputType="InputType.Number"
                             HelperText="Extra weight used in the exercise."
                             Immediate="true" />

            <MudText Typo="Typo.caption" Class="mx-2 mb-2 hs-muted-copy">
                1RM will use @ExerciseLoadCalculator.GetEffectiveLoad(_exercise, CurrentUserBodyWeight).ToString("0.#") kg total load.
            </MudText>
        }
        else
        {
            <MudNumericField Class="ma-2"
                             @bind-Value="_exercise.Weight"
                             Label="Weight (kg)"
                             Variant="Variant.Outlined"
                             Step=".5M"
                             InputType="InputType.Number"
                             HelperText="Weight used in the exercise." />
        }

        <ExerciseTagEditor @bind-Tags="_exercise.Tags" />
    </MudContainer>
</EditForm>

<div class="hs-form-primary-action">
    <MudButton OnClick="OnSaveClick"
               Color="MudBlazor.Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="@_isSaving"
               Loading="@_isSaving"
               FullWidth="true">
        @SubmitLabel
    </MudButton>
</div>

@code {
    [Parameter] public GetExerciseTypeResource[]? ExerciseTypes { get; set; }
    [Parameter] public decimal? CurrentUserBodyWeight { get; set; }
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public string? TraineeId { get; set; }
    [Parameter] public int? InitialExerciseTypeId { get; set; }
    [Parameter] public DateTime? InitialDate { get; set; }
    [Parameter] public bool ShowDatePicker { get; set; } = true;
    [Parameter] public bool ShowQuickPicks { get; set; }
    [Parameter] public bool UseWorkoutSessionEndpoint { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Save exercise";
    [Parameter] public IReadOnlyCollection<int> RecentExerciseTypeIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback<AddExerciseResource> OnExerciseAdded { get; set; }
    [Parameter] public EventCallback<WorkoutSessionResource> OnSessionUpdated { get; set; }

    private AddExerciseResource _exercise = new();
    private GetExerciseTypeResource? _selectedType;
    private WorkoutPostResource _workout = new() { Date = DateTime.Now };
    private EditContext? _editContext;
    private int? _appliedInitialExerciseTypeId;
    private DateTime? _appliedInitialDate;
    private string? _submissionError;
    private bool _isSaving;

    private List<GetExerciseTypeResource> FavouriteQuickPicks
        => (ExerciseTypes ?? Array.Empty<GetExerciseTypeResource>())
            .Where(exerciseType => exerciseType.IsFavourite)
            .Take(4)
            .ToList();

    private List<GetExerciseTypeResource> RecentQuickPicks
    {
        get
        {
            var exerciseTypes = ExerciseTypes ?? Array.Empty<GetExerciseTypeResource>();
            var favourites = FavouriteQuickPicks
                .Select(exerciseType => exerciseType.Id)
                .ToHashSet();

            return RecentExerciseTypeIds
                .Select(id => exerciseTypes.FirstOrDefault(exerciseType => exerciseType.Id == id))
                .Where(exerciseType => exerciseType is not null && !favourites.Contains(exerciseType.Id))
                .Cast<GetExerciseTypeResource>()
                .Take(4)
                .ToList();
        }
    }

    protected override void OnInitialized() => _editContext = new EditContext(_exercise);

    protected override void OnParametersSet()
    {
        ApplyInitialDate();
        ApplyInitialType();
        SyncTypeToModel();
    }

    private Task<IEnumerable<GetExerciseTypeResource>> SearchExerciseTypes(string value)
    {
        var all = ExerciseTypes?.AsEnumerable() ?? Enumerable.Empty<GetExerciseTypeResource>();
        var results = string.IsNullOrWhiteSpace(value)
            ? all
            : all.Where(x => x.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
        return Task.FromResult(results);
    }

    private void SyncTypeToModel()
    {
        if (_selectedType is null)
        {
            _exercise.TypeId = null;
            _exercise.WeightType = ExerciseWeightType.Standard;
        }
        else
        {
            _exercise.TypeId = _selectedType.Id;
            _exercise.WeightType = _selectedType.WeightType ?? ExerciseWeightType.Standard;
        }

        if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            if (_exercise.BodyWeight == null && CurrentUserBodyWeight != null)
                _exercise.BodyWeight = CurrentUserBodyWeight;
            _exercise.AddedWeight ??= 0m;
        }
        else if (_exercise.WeightType == ExerciseWeightType.None)
        {
            _exercise.Weight = 0m;
            _exercise.BodyWeight = null;
            _exercise.AddedWeight = null;
        }
        else
        {
            _exercise.BodyWeight = null;
            _exercise.AddedWeight = null;
        }
    }

    private void ApplyInitialDate()
    {
        var normalizedDate = (InitialDate ?? DateTime.Now).Date;

        if (_appliedInitialDate != normalizedDate)
        {
            _workout.Date = normalizedDate;
            _appliedInitialDate = normalizedDate;
        }
        else if (!_workout.Date.HasValue)
        {
            _workout.Date = normalizedDate;
        }
    }

    private void ApplyInitialType()
    {
        if (InitialExerciseTypeId == _appliedInitialExerciseTypeId &&
            (_selectedType != null || !InitialExerciseTypeId.HasValue))
        {
            return;
        }

        if (!InitialExerciseTypeId.HasValue)
        {
            _selectedType = null;
            _appliedInitialExerciseTypeId = null;
            return;
        }

        var match = ExerciseTypes?.FirstOrDefault(type => type.Id == InitialExerciseTypeId.Value);
        if (match is null)
        {
            return;
        }

        _selectedType = match;
        _appliedInitialExerciseTypeId = InitialExerciseTypeId;
    }

    private async Task SubmitExercise()
    {
        if (_isSaving)
        {
            return;
        }

        if (_selectedType is null)
        {
            _submissionError = "Choose an exercise before saving.";
            return;
        }

        _submissionError = null;
        _isSaving = true;

        try
        {
            ExerciseLoadCalculator.NormalizeForSubmission(_exercise, CurrentUserBodyWeight);

            // Resolve or create workout for the selected date
            var workoutId = WorkoutId != Guid.Empty
                ? WorkoutId
                : await ResolveWorkoutIdAsync(_workout.Date);

            if (workoutId == Guid.Empty)
                return;

            _exercise.WorkoutId = workoutId;
            _exercise.TypeId = _selectedType.Id;

            var endpoint = UseWorkoutSessionEndpoint
                ? $"/Workouts/{workoutId}/exercises"
                : "/Exercises";
            using var response = await Http.PostAsJsonAsync(endpoint, _exercise);

            if (!response.IsSuccessStatusCode)
            {
                _submissionError =
                    await HttpProblemDetailsReader.ReadMessageAsync(
                        response,
                        "The exercise could not be saved. Please try again.");
                return;
            }

            WorkoutSessionResource? updatedSession = null;
            if (UseWorkoutSessionEndpoint)
            {
                updatedSession = await response.Content.ReadFromJsonAsync<WorkoutSessionResource>();
                if (updatedSession is null)
                {
                    _submissionError = "The workout response was incomplete. Please try again.";
                    return;
                }
            }

            var addedExercise = CloneExercise(_exercise);
            ResetForm();

            if (updatedSession is not null)
            {
                await OnSessionUpdated.InvokeAsync(updatedSession);
            }

            await OnExerciseAdded.InvokeAsync(addedExercise);
        }
        catch (HttpRequestException)
        {
            _submissionError = "The exercise could not be saved. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            _submissionError = "Saving took too long. Please try again.";
        }
        catch (JsonException)
        {
            _submissionError = "The server returned an incomplete response. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<Guid> ResolveWorkoutIdAsync(DateTime? date)
    {
        var url = TraineeId != null ? $"/workouts?traineeId={TraineeId}" : "/workouts";
        var workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>(url);

        var existing = workouts?.FirstOrDefault(w =>
            w.Date.HasValue && date.HasValue && w.Date.Value.Date == date.Value.Date);

        if (existing != null) return existing.Id;

        // Create a new workout for this date. The page reports success only after the exercise is saved.
        var newWorkout = new WorkoutPostResource { Type = "default", UserId = TraineeId, Date = date ?? DateTime.Now };
        using var resp = await Http.PostAsJsonAsync("/Workouts", newWorkout);
        if (!resp.IsSuccessStatusCode)
        {
            _submissionError = "The workout could not be prepared. Please try again.";
            return Guid.Empty;
        }

        var created = await resp.Content.ReadFromJsonAsync<GetWorkoutResource>();
        if (created?.Id == null)
        {
            _submissionError = "The workout response was incomplete. Please try again.";
            return Guid.Empty;
        }
        return created.Id;
    }

    private void ResetForm()
    {
        _exercise = new();
        _selectedType = null;
        _workout = new WorkoutPostResource();
        _editContext = new EditContext(_exercise);
        _submissionError = null;
        ApplyInitialDate();
        ApplyInitialType();
        SyncTypeToModel();
    }

    private void OnTypeChanged(GetExerciseTypeResource? newType)
    {
        _selectedType = newType;
        if (newType is not null)
        {
            _submissionError = null;
        }
        SyncTypeToModel();
    }

    private void SelectType(GetExerciseTypeResource exerciseType)
        => OnTypeChanged(exerciseType);

    private static AddExerciseResource CloneExercise(AddExerciseResource source)
        => new()
        {
            WorkoutId = source.WorkoutId,
            TypeId = source.TypeId,
            Series = source.Series,
            Repetitions = source.Repetitions,
            Weight = source.Weight,
            WeightType = source.WeightType,
            BodyWeight = source.BodyWeight,
            AddedWeight = source.AddedWeight,
            Tags = ExerciseTagText.Normalize(source.Tags)
        };

    private async Task OnSaveClick()
    {
        _editContext ??= new EditContext(_exercise);
        if (_editContext.Validate())
            await SubmitExercise();
    }
}
