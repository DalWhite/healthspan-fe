@inject HttpClient Http

<EditForm EditContext="_editContext" OnValidSubmit="AddExerciseToTheForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudContainer>
    <MudDatePicker Label="Fecha"
                   @bind-Date="_workoutToAdd.Date"
                   Variant="Variant.Outlined"
                   class="ma-2" />
    <MudAutocomplete T="GetExerciseTypeResource"
                     Label="Ejercicio"
                     Variant="Variant.Outlined"
                     class="ma-2"
                     Value="_selectedType"
                     ValueChanged="OnTypeChanged"
                     ToStringFunc="@(et => et?.Name ?? string.Empty)"
                     SearchFunc="SearchExerciseTypes"
                     CoerceText="true"
                     Clearable="true"
                     />
    <MudNumericField class="ma-2"
                     @bind-Value="_exercise.Series"
                     Label="Series"
                     Variant="Variant.Outlined"
                     InputType="InputType.Number"
                     />
    <MudNumericField class="ma-2"
                     @bind-Value="_exercise.Repetitions"
                     Label="Repeticiones"
                     Variant="Variant.Outlined"
                     InputType="InputType.Number"
                     />
        @if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            <MudNumericField class="ma-2"
                             @bind-Value="_exercise.BodyWeight"
                             ValueExpression="() => _exercise.BodyWeight"
                             Label="Peso corporal"
                             Variant="Variant.Outlined"
                             InputType="InputType.Number"
                             HelperText="Tu peso actual."
                             Immediate="true"
                             />

            <MudNumericField class="ma-2"
                             @bind-Value="_exercise.AddedWeight"
                             ValueExpression="() => _exercise.AddedWeight"
                             Label="Peso añadido"
                             Variant="Variant.Outlined"
                             InputType="InputType.Number"
                             HelperText="Peso extra usado en el ejercicio."
                             Immediate="true"
                             />
        }
        else
        {
            <MudNumericField class="ma-2"
                             @bind-Value="_exercise.Weight"
                             Label="Peso"
                             Variant="Variant.Outlined"
                             Step=".5M"
                             InputType="InputType.Number"
                             HelperText="Peso usado en el ejercicio."
                             />
        }
    </MudContainer>

</EditForm>

<MudFab @onclick="OnFabClick"
    Color="Color.Primary"
    StartIcon="@Icons.Material.Filled.Add"
    style="float: right;"
    Size="Size.Small"
    class="mr-8" />

@code {
    [Parameter] public GetExerciseTypeResource[]? ExerciseTypes { get; set; }
    [Parameter] public decimal? CurrentUserBodyWeight { get; set; }
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public string? traineeId { get; set; }
    [Parameter] public EventCallback<AddExerciseResource> OnExerciseAdded { get; set; }

    private AddExerciseResource _exercise = new();
    private GetExerciseTypeResource? _selectedType;
    private WorkoutPostResource _workoutToAdd = new() { Date = DateTime.Now };
    private EditContext? _editContext;

    protected override void OnInitialized() => _editContext = new EditContext(_exercise);

    protected override void OnParametersSet() => ApplySelectedTypeToModel();

    private Task<IEnumerable<GetExerciseTypeResource>> SearchExerciseTypes(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(ExerciseTypes?.AsEnumerable() ?? Enumerable.Empty<GetExerciseTypeResource>());

        var results = ExerciseTypes?.Where(x => !string.IsNullOrEmpty(x.Name) && x.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                      ?? Enumerable.Empty<GetExerciseTypeResource>();

        return Task.FromResult(results);
    }

    private void ApplySelectedTypeToModel()
    {
        if (_selectedType is null)
        {
            _exercise.TypeId = null;
            _exercise.WeightType = ExerciseWeightType.Standard;
        }
        else
        {
            _exercise.TypeId = _selectedType.Id;
            _exercise.WeightType = _selectedType.WeightType ?? ExerciseWeightType.Standard;
        }

        if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            if (_exercise.BodyWeight == null && CurrentUserBodyWeight != null)
                _exercise.BodyWeight = CurrentUserBodyWeight;

            _exercise.AddedWeight ??= 0m;
        }

        StateHasChanged();
    }

    private async Task AddExerciseToTheForm()
    {
        if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            if (_exercise.BodyWeight == null && CurrentUserBodyWeight != null)
                _exercise.BodyWeight = CurrentUserBodyWeight;

            _exercise.AddedWeight ??= 0m;
            _exercise.Weight = (_exercise.BodyWeight ?? 0m) + (_exercise.AddedWeight ?? 0m);
        }

        if (WorkoutId == Guid.Empty)
            WorkoutId = await GetLastWorkoutIdOrNewIfNoWorkoutForSelectedDate(_workoutToAdd.Date);

        _exercise.WorkoutId = WorkoutId;
        _exercise.TypeId = _selectedType?.Id;

        var response = await Http.PostAsJsonAsync("/Exercises", _exercise);

        if (response.IsSuccessStatusCode)
            await OnExerciseAdded.InvokeAsync(_exercise);

        _exercise = new();
        _selectedType = null;
        _editContext = new EditContext(_exercise);
    }

    private async Task<Guid> GetLastWorkoutIdOrNewIfNoWorkoutForSelectedDate(DateTime? selectedDate)
    {
        var workoutsUrl = traineeId != null ? $"/workouts?traineeId={traineeId}" : "/workouts";
        var workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>(workoutsUrl);

        var workoutForSelectedDate = workouts?
            .FirstOrDefault(w => w.Date.HasValue && selectedDate.HasValue && w.Date.Value.Date == selectedDate.Value.Date);

        if (workoutForSelectedDate == null)
        {
            var postResource = new WorkoutPostResource { Type = "default", UserId = traineeId, Date = selectedDate ?? DateTime.Now };
            var response = await Http.PostAsJsonAsync("/Workouts", postResource);
            var newWorkout = await response.Content.ReadFromJsonAsync<GetWorkoutResource>();
            return newWorkout?.Id ?? Guid.NewGuid();
        }

        return workoutForSelectedDate.Id;
    }

    private void OnTypeChanged(GetExerciseTypeResource? newType)
    {
        _selectedType = newType;
        ApplySelectedTypeToModel();
    }

    private async Task OnFabClick()
    {
        _editContext ??= new EditContext(_exercise);
        if (_editContext.Validate())
            await AddExerciseToTheForm();
    }
}
