@inject HttpClient Http
@using System.Text.Json

<EditForm EditContext="_editContext"
          OnValidSubmit="SubmitExercise"
          class="hs-exercise-entry-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(_submissionError))
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            @_submissionError
        </MudAlert>
    }

    <div class="hs-exercise-entry-fields">
        @if (ShowDatePicker)
        {
            <MudDatePicker Label="Fecha"
                           @bind-Date="_workout.Date"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" />
        }

        @if (ShowQuickPicks && FavouriteQuickPicks.Count > 0)
        {
            <div class="hs-exercise-quick-picks" aria-label="Ejercicios favoritos">
                <span class="hs-exercise-quick-label">Favoritos</span>
                <div class="hs-exercise-quick-list">
                    @foreach (var exerciseType in FavouriteQuickPicks)
                    {
                        <button type="button"
                                class="hs-exercise-quick-button"
                                @onclick="@(() => SelectType(exerciseType))">
                            <MudIcon Icon="@Icons.Material.Filled.Star"
                                     Size="MudBlazor.Size.Small" />
                            <span>@exerciseType.Name</span>
                        </button>
                    }
                </div>
            </div>
        }

        @if (ShowQuickPicks && RecentQuickPicks.Count > 0)
        {
            <div class="hs-exercise-quick-picks" aria-label="Ejercicios recientes">
                <span class="hs-exercise-quick-label">Recientes</span>
                <div class="hs-exercise-quick-list">
                    @foreach (var exerciseType in RecentQuickPicks)
                    {
                        <button type="button"
                                class="hs-exercise-quick-button"
                                @onclick="@(() => SelectType(exerciseType))">
                            <MudIcon Icon="@Icons.Material.Filled.History"
                                     Size="MudBlazor.Size.Small" />
                            <span>@exerciseType.Name</span>
                        </button>
                    }
                </div>
            </div>
        }

        <MudAutocomplete T="GetExerciseTypeResource"
                         id="exercise-type"
                         Label="Ejercicio"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Value="_selectedType"
                         ValueChanged="OnTypeChanged"
                         ToStringFunc="@(et => et?.Name ?? string.Empty)"
                         SearchFunc="SearchExerciseTypes"
                         CoerceText="true"
                         Clearable="true" />

        <div class="hs-exercise-prescription-grid">
            <MudNumericField T="int?"
                             Value="_exercise.Series"
                             ValueChanged="@(value => { _exercise.Series = value; _prescriptionTouched = true; })"
                             id="exercise-series"
                             Label="Series"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             InputType="InputType.Number"
                             HideSpinButtons="true" />

            <MudNumericField T="int?"
                             Value="_exercise.Repetitions"
                             ValueChanged="@(value => { _exercise.Repetitions = value; _prescriptionTouched = true; })"
                             id="exercise-reps"
                             Label="Reps"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             InputType="InputType.Number"
                             HideSpinButtons="true" />

            @if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
            {
                <MudNumericField @bind-Value="_exercise.BodyWeight"
                                 id="exercise-body-weight"
                                 Label="Peso corporal (kg)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 InputType="InputType.Number"
                                 Immediate="true"
                                 HideSpinButtons="true" />

                <MudNumericField @bind-Value="_exercise.AddedWeight"
                                 id="exercise-added-weight"
                                 Label="Peso añadido (kg)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 InputType="InputType.Number"
                                 Immediate="true"
                                 HideSpinButtons="true" />
            }
            else if (_exercise.WeightType != ExerciseWeightType.None)
            {
                <MudNumericField @bind-Value="_exercise.Weight"
                                 id="exercise-weight"
                                 Label="Peso (kg)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Step=".5M"
                                 InputType="InputType.Number"
                                 HideSpinButtons="true" />
            }
        </div>

        @if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            <span class="hs-exercise-effective-load">
                Carga total @ExerciseLoadCalculator.GetEffectiveLoad(_exercise, CurrentUserBodyWeight).ToString("0.#") kg
            </span>
        }

        @if (_showTags)
        {
            <ExerciseTagEditor @bind-Tags="_exercise.Tags" />
        }
        else
        {
            <MudButton Variant="Variant.Text"
                       Color="MudBlazor.Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.LocalOffer"
                       OnClick="@(() => _showTags = true)">
                Añadir etiquetas
            </MudButton>
        }

        @* Progressive disclosure: sets/reps stay upfront (the frequent case);
           attempts, intent and load type are rare and stay behind one tap.
           When the user tapped "Exercise" on a block, the block is already
           chosen and the disclosure opens with it. *@
        @if (ShowQualityOptions)
        {
            @if (_showQuality)
            {
                <div class="hs-exercise-quality">
                    @if (Blocks is { Count: > 0 })
                    {
                        <MudSelect T="Guid?"
                                   Value="_blockId"
                                   ValueChanged="@(value => { _blockId = value; _blockIdTouched = true; })"
                                   Label="Bloque"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true">
                            <MudSelectItem T="Guid?" Value="null">Sin bloque</MudSelectItem>
                            @foreach (var block in Blocks)
                            {
                                <MudSelectItem T="Guid?" Value="@block.Id">@BlockLabel(block)</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudNumericField T="int"
                                     Value="_attempts"
                                     ValueChanged="@(value => _attempts = Math.Clamp(value, 1, 100))"
                                     Label="Intentos"
                                     Min="1"
                                     Max="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     InputType="InputType.Number" />

                    <div class="hs-today-chip-row" role="group" aria-label="Intención de calidad">
                        @foreach (var intent in QualityIntentChoices)
                        {
                            <button type="button"
                                    class="@(_qualityIntent == intent ? "hs-chip hs-chip-selected" : "hs-chip")"
                                    aria-pressed="@(_qualityIntent == intent)"
                                    @onclick="() => _qualityIntent = _qualityIntent == intent ? null : intent">
                                @intent
                            </button>
                        }
                    </div>

                    <MudTextField @bind-Value="_qualityIntent"
                                  Label="Intención (opcional)"
                                  Placeholder="100% explosive, controlled, isometric 30s…"
                                  MaxLength="200"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />

                    <MudSelect T="string?"
                               Value="_loadType"
                               ValueChanged="@(value => _loadType = value)"
                               Label="Carga"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var loadType in TrainingIntent.LoadOrder)
                        {
                            <MudSelectItem T="string?" Value="@loadType.ToString()">@loadType.Label()</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Text"
                           Color="MudBlazor.Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Tune"
                           OnClick="@(() => _showQuality = true)">
                    Intentos y calidad
                </MudButton>
            }
        }

        <div class="hs-exercise-entry-submit">
            <MudButton OnClick="OnSaveClick"
                       Color="MudBlazor.Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@_isSaving"
                       Loading="@_isSaving">
                @SubmitLabel
            </MudButton>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public GetExerciseTypeResource[]? ExerciseTypes { get; set; }
    [Parameter] public decimal? CurrentUserBodyWeight { get; set; }
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public string? TraineeId { get; set; }
    [Parameter] public int? InitialExerciseTypeId { get; set; }
    [Parameter] public DateTime? InitialDate { get; set; }
    [Parameter] public bool ShowDatePicker { get; set; } = true;
    [Parameter] public bool ShowQuickPicks { get; set; }
    [Parameter] public bool UseWorkoutSessionEndpoint { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Save exercise";
    [Parameter] public IReadOnlyCollection<int> RecentExerciseTypeIds { get; set; } = Array.Empty<int>();
    [Parameter] public IReadOnlyList<WorkoutSessionExerciseResource>? PrescriptionHints { get; set; }
    [Parameter] public Func<Task<Guid>>? WorkoutIdResolver { get; set; }
    [Parameter] public int DefaultSets { get; set; } = 3;
    [Parameter] public int DefaultReps { get; set; } = 10;
    [Parameter] public IReadOnlyList<WorkoutBlockResource>? Blocks { get; set; }
    [Parameter] public Guid? InitialBlockId { get; set; }
    [Parameter] public bool ShowQualityOptions { get; set; }
    [Parameter] public EventCallback<AddExerciseResource> OnExerciseAdded { get; set; }
    [Parameter] public EventCallback<WorkoutSessionResource> OnSessionUpdated { get; set; }

    private AddExerciseResource _exercise = new();
    private GetExerciseTypeResource? _selectedType;
    private WorkoutPostResource _workout = new() { Date = DateTime.Now };
    private EditContext? _editContext;
    private int? _appliedInitialExerciseTypeId;
    private DateTime? _appliedInitialDate;
    private string? _submissionError;
    private bool _isSaving;
    private bool _showTags;

    // Universal tracker: attempts / intent / load stay behind one tap so the
    // fast path (pick exercise, save) keeps its two fields.
    private bool _showQuality;
    private bool _blockIdTouched;
    private Guid? _blockId;
    private Guid? _seededBlockId;
    private int _attempts = 1;
    private string? _qualityIntent;
    private string? _loadType;

    private static readonly string[] QualityIntentChoices =
        ["Explosive", "Controlled", "Isometric", "To failure"];

    private static string BlockLabel(WorkoutBlockResource block)
    {
        var type = WorkoutBlockTypeLabels.Parse(block.Type) is { } parsed
            ? parsed.Label()
            : "Block";
        return string.IsNullOrWhiteSpace(block.Label) ? type : $"{block.Label} · {type}";
    }

    // Fast logging first, detail after: sets/reps arrive prefilled so the user
    // never has to touch them to save. They stay editable in place, and the
    // values come from what the user actually logged before when we have it.
    private bool _prescriptionTouched;
    private readonly List<PrescriptionHint> _localPrescriptionHints = [];

    private readonly record struct PrescriptionHint(
        int TypeId,
        int? Series,
        int? Repetitions);

    private List<GetExerciseTypeResource> FavouriteQuickPicks
        => (ExerciseTypes ?? Array.Empty<GetExerciseTypeResource>())
            .Where(exerciseType => exerciseType.IsFavourite)
            .Take(4)
            .ToList();

    private List<GetExerciseTypeResource> RecentQuickPicks
    {
        get
        {
            var exerciseTypes = ExerciseTypes ?? Array.Empty<GetExerciseTypeResource>();
            var favourites = FavouriteQuickPicks
                .Select(exerciseType => exerciseType.Id)
                .ToHashSet();

            return RecentExerciseTypeIds
                .Select(id => exerciseTypes.FirstOrDefault(exerciseType => exerciseType.Id == id))
                .Where(exerciseType => exerciseType is not null && !favourites.Contains(exerciseType.Id))
                .Cast<GetExerciseTypeResource>()
                .Take(4)
                .ToList();
        }
    }

    protected override void OnInitialized() => CreateEditContext();

    private void CreateEditContext()
        => _editContext = new EditContext(_exercise);

    protected override void OnParametersSet()
    {
        ApplyInitialDate();
        ApplyInitialType();
        ApplyInitialBlock();
        SyncTypeToModel();
    }

    // Tapping "Exercise" on a block pre-selects it: the user already decided
    // where the exercise goes, so the form must not ask again.
    private void ApplyInitialBlock()
    {
        if (InitialBlockId == _seededBlockId)
        {
            return;
        }

        _seededBlockId = InitialBlockId;
        if (InitialBlockId is not null && !_blockIdTouched)
        {
            _blockId = InitialBlockId;
            _showQuality = true;
        }
    }

    private Task<IEnumerable<GetExerciseTypeResource>> SearchExerciseTypes(string value)
    {
        var all = ExerciseTypes?.AsEnumerable() ?? Enumerable.Empty<GetExerciseTypeResource>();
        var results = string.IsNullOrWhiteSpace(value)
            ? all
            : all.Where(x => x.Name?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
        return Task.FromResult(results);
    }

    private void SyncTypeToModel()
    {
        if (_selectedType is null)
        {
            _exercise.TypeId = null;
            _exercise.WeightType = ExerciseWeightType.Standard;
        }
        else
        {
            _exercise.TypeId = _selectedType.Id;
            _exercise.WeightType = _selectedType.WeightType ?? ExerciseWeightType.Standard;
        }

        if (_exercise.WeightType == ExerciseWeightType.BodyWeight)
        {
            if (_exercise.BodyWeight == null && CurrentUserBodyWeight != null)
                _exercise.BodyWeight = CurrentUserBodyWeight;
            _exercise.AddedWeight ??= 0m;
        }
        else if (_exercise.WeightType == ExerciseWeightType.None)
        {
            _exercise.Weight = 0m;
            _exercise.BodyWeight = null;
            _exercise.AddedWeight = null;
        }
        else
        {
            _exercise.BodyWeight = null;
            _exercise.AddedWeight = null;
        }

        ApplyPrescriptionDefaults();
    }

    private void ApplyPrescriptionDefaults()
    {
        if (_prescriptionTouched || _exercise.TypeId is not { } typeId)
        {
            return;
        }

        int? sets;
        int? repetitions;

        if (_localPrescriptionHints.Any(hint => hint.TypeId == typeId))
        {
            var logged = _localPrescriptionHints
                .LastOrDefault(hint => hint.TypeId == typeId);
            sets = logged.Series;
            repetitions = logged.Repetitions;
        }
        else
        {
            var hint = PrescriptionHints?
                .LastOrDefault(candidate => candidate.TypeId == typeId);
            sets = hint?.Series;
            repetitions = hint?.Repetitions;
        }

        _exercise.Series = sets ?? DefaultSets;
        _exercise.Repetitions = repetitions ?? DefaultReps;
    }

    private void ApplyInitialDate()
    {
        var normalizedDate = (InitialDate ?? DateTime.Now).Date;

        if (_appliedInitialDate != normalizedDate)
        {
            _workout.Date = normalizedDate;
            _appliedInitialDate = normalizedDate;
        }
        else if (!_workout.Date.HasValue)
        {
            _workout.Date = normalizedDate;
        }
    }

    private void ApplyInitialType()
    {
        if (InitialExerciseTypeId == _appliedInitialExerciseTypeId &&
            (_selectedType != null || !InitialExerciseTypeId.HasValue))
        {
            return;
        }

        if (!InitialExerciseTypeId.HasValue)
        {
            _selectedType = null;
            _appliedInitialExerciseTypeId = null;
            return;
        }

        var match = ExerciseTypes?.FirstOrDefault(type => type.Id == InitialExerciseTypeId.Value);
        if (match is null)
        {
            return;
        }

        _selectedType = match;
        _appliedInitialExerciseTypeId = InitialExerciseTypeId;
    }

    private async Task SubmitExercise()
    {
        if (_isSaving)
        {
            return;
        }

        if (_selectedType is null)
        {
            _submissionError = "Choose an exercise before saving.";
            return;
        }

        _submissionError = null;
        _isSaving = true;

        try
        {
            ExerciseLoadCalculator.NormalizeForSubmission(_exercise, CurrentUserBodyWeight);

            // Resolve or create workout for the selected date
            var workoutId = WorkoutId != Guid.Empty
                ? WorkoutId
                : WorkoutIdResolver is not null
                    ? await WorkoutIdResolver()
                    : await ResolveWorkoutIdAsync(_workout.Date);

            if (workoutId == Guid.Empty)
            {
                _submissionError ??=
                    "We couldn't prepare today's workout. Please try again.";
                return;
            }

            _exercise.WorkoutId = workoutId;
            _exercise.TypeId = _selectedType.Id;

            if (UseWorkoutSessionEndpoint)
            {
                // Order 0 = append at the end of the block: the user never
                // manages sequence numbers. A multi-attempt entry starts with
                // nothing completed, so "muscle-up 8/0" is a valid log.
                _exercise.BlockId = _blockId;
                _exercise.Order = 0;
                _exercise.Attempts = _attempts;
                _exercise.CompletedAttempts = _attempts > 1 ? 0 : 1;
                _exercise.QualityIntent = string.IsNullOrWhiteSpace(_qualityIntent)
                    ? null
                    : _qualityIntent.Trim();
                _exercise.LoadType = _loadType;
            }

            var endpoint = UseWorkoutSessionEndpoint
                ? $"/Workouts/{workoutId}/exercises{TraineeRoute.TraineeQuery(TraineeId)}"
                : $"/Exercises{TraineeRoute.ApiUserQuery(TraineeId)}";
            using var response = await Http.PostAsJsonAsync(endpoint, _exercise);

            if (!response.IsSuccessStatusCode)
            {
                _submissionError =
                    await HttpProblemDetailsReader.ReadMessageAsync(
                        response,
                        "The exercise could not be saved. Please try again.");
                return;
            }

            WorkoutSessionResource? updatedSession = null;
            if (UseWorkoutSessionEndpoint)
            {
                updatedSession = await response.Content.ReadFromJsonAsync<WorkoutSessionResource>();
                if (updatedSession is null)
                {
                    _submissionError = "The workout response was incomplete. Please try again.";
                    return;
                }

                // One row per planned set: a 3-series entry becomes 3 real
                // session exercises (same type, appended in order) so editing
                // one set never overwrites the others. Attempt-based entries
                // keep their single row and their completed/planned dots.
                if (_attempts <= 1 && _exercise.Series > 1)
                {
                    for (var plannedSet = 1; plannedSet < _exercise.Series; plannedSet++)
                    {
                        var extra = new AddExerciseResource
                        {
                            WorkoutId = workoutId,
                            TypeId = _selectedType.Id,
                            Series = 1,
                            Repetitions = _exercise.Repetitions,
                            Weight = _exercise.Weight,
                            WeightType = _exercise.WeightType,
                            BodyWeight = _exercise.BodyWeight,
                            AddedWeight = _exercise.AddedWeight,
                            Tags = ExerciseTagText.Normalize(_exercise.Tags),
                            BlockId = _blockId,
                            Order = 0,
                            Attempts = 1,
                            CompletedAttempts = 1,
                            QualityIntent = _exercise.QualityIntent,
                            LoadType = _exercise.LoadType,
                        };

                        using var extraResponse = await Http.PostAsJsonAsync(endpoint, extra);
                        if (!extraResponse.IsSuccessStatusCode)
                        {
                            _submissionError =
                                await HttpProblemDetailsReader.ReadMessageAsync(
                                    extraResponse,
                                    "The exercise could not be saved. Please try again.");
                            return;
                        }

                        var refreshed = await extraResponse
                            .Content
                            .ReadFromJsonAsync<WorkoutSessionResource>();
                        if (refreshed is not null)
                        {
                            updatedSession = refreshed;
                        }
                    }
                }
            }

            var addedExercise = CloneExercise(_exercise);

            // The values just logged become the default for the next entry of
            // the same exercise, so repeat sets need no taps at all.
            if (_exercise.TypeId is { } addedTypeId)
            {
                _localPrescriptionHints.Add(new PrescriptionHint(
                    addedTypeId,
                    _exercise.Series,
                    _exercise.Repetitions));
            }

            ResetForm();

            if (updatedSession is not null)
            {
                await OnSessionUpdated.InvokeAsync(updatedSession);
            }

            await OnExerciseAdded.InvokeAsync(addedExercise);
        }
        catch (HttpRequestException)
        {
            _submissionError = "The exercise could not be saved. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            _submissionError = "Saving took too long. Please try again.";
        }
        catch (JsonException)
        {
            _submissionError = "The server returned an incomplete response. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<Guid> ResolveWorkoutIdAsync(DateTime? date)
    {
        var url = $"/workouts{TraineeRoute.TraineeQuery(TraineeId)}";
        var workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>(url);

        var existing = workouts?.FirstOrDefault(w =>
            w.Date.HasValue && date.HasValue && w.Date.Value.Date == date.Value.Date);

        if (existing != null) return existing.Id;

        // Create a new workout for this date. The page reports success only after the exercise is saved.
        var newWorkout = new WorkoutPostResource { Type = "default", UserId = TraineeId, Date = date ?? DateTime.Now };
        using var resp = await Http.PostAsJsonAsync("/Workouts", newWorkout);
        if (!resp.IsSuccessStatusCode)
        {
            _submissionError = "The workout could not be prepared. Please try again.";
            return Guid.Empty;
        }

        var created = await resp.Content.ReadFromJsonAsync<GetWorkoutResource>();
        if (created?.Id == null)
        {
            _submissionError = "The workout response was incomplete. Please try again.";
            return Guid.Empty;
        }
        return created.Id;
    }

    private void ResetForm()
    {
        _exercise = new();
        _selectedType = null;
        _workout = new WorkoutPostResource();
        CreateEditContext();
        _submissionError = null;
        _prescriptionTouched = false;
        _showTags = false;
        ApplyInitialDate();
        ApplyInitialType();
        SyncTypeToModel();
    }

    private void OnTypeChanged(GetExerciseTypeResource? newType)
    {
        _selectedType = newType;
        if (newType is not null)
        {
            _submissionError = null;
        }
        SyncTypeToModel();
    }

    private void SelectType(GetExerciseTypeResource exerciseType)
        => OnTypeChanged(exerciseType);

    private static AddExerciseResource CloneExercise(AddExerciseResource source)
        => new()
        {
            WorkoutId = source.WorkoutId,
            TypeId = source.TypeId,
            Series = source.Series,
            Repetitions = source.Repetitions,
            Weight = source.Weight,
            WeightType = source.WeightType,
            BodyWeight = source.BodyWeight,
            AddedWeight = source.AddedWeight,
            Tags = ExerciseTagText.Normalize(source.Tags)
        };

    private async Task OnSaveClick()
    {
        _editContext ??= new EditContext(_exercise);
        if (_editContext.Validate())
            await SubmitExercise();
    }
}
