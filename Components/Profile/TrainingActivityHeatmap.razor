<section class="hs-training-activity hs-surface"
         aria-labelledby="training-activity-title">
    <div class="hs-insights-section-head">
        <MudText Typo="Typo.h6" id="training-activity-title">
            Training days
        </MudText>
        <span class="hs-training-activity-count">
            @ActiveDayCount active
        </span>
    </div>

    <div class="hs-training-activity-grid"
         role="img"
         aria-label="@($"{ActiveDayCount} training days in the last 35 days")">
        @foreach (var cell in Cells)
        {
            if (cell.Date is null)
            {
                <span class="hs-training-activity-day is-spacer"
                      aria-hidden="true"></span>
            }
            else
            {
                <span class="hs-training-activity-day level-@GetLevel(cell)"
                      title="@GetTitle(cell)"
                      aria-hidden="true"></span>
            }
        }
    </div>

    <div class="hs-training-activity-range">
        <span>@StartDate.ToString("d MMM")</span>
        <span>Last 35 days</span>
        <span>@EndDate.ToString("d MMM")</span>
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<TrainingDayActivityResource> ActivityDays
    {
        get;
        set;
    } = Array.Empty<TrainingDayActivityResource>();

    private DateTime EndDate => DateTime.Today;
    private DateTime StartDate => EndDate.AddDays(-34);
    private int ActiveDayCount
        => ActivityDays.Count(day =>
            day.Date.Date >= StartDate
            && day.Date.Date <= EndDate
            && day.WorkoutCount > 0);

    private IReadOnlyList<ActivityCell> Cells
    {
        get
        {
            var activityByDate = ActivityDays
                .GroupBy(day => day.Date.Date)
                .ToDictionary(
                    group => group.Key,
                    group => new TrainingDayActivityResource
                    {
                        Date = group.Key,
                        WorkoutCount = group.Sum(day =>
                            day.WorkoutCount),
                        ExerciseCount = group.Sum(day =>
                            day.ExerciseCount)
                    });
            var leadingSpacers =
                (7 + (StartDate.DayOfWeek - DayOfWeek.Monday))
                % 7;
            var cells = new List<ActivityCell>();

            for (var index = 0; index < leadingSpacers; index++)
            {
                cells.Add(new ActivityCell(null, 0, 0));
            }

            for (var offset = 0; offset < 35; offset++)
            {
                var date = StartDate.AddDays(offset);
                activityByDate.TryGetValue(date, out var activity);
                cells.Add(new ActivityCell(
                    date,
                    activity?.WorkoutCount ?? 0,
                    activity?.ExerciseCount ?? 0));
            }

            return cells;
        }
    }

    private static int GetLevel(ActivityCell cell)
        => cell.WorkoutCount <= 0
            ? 0
            : cell.WorkoutCount >= 2 || cell.ExerciseCount >= 8
                ? 4
                : cell.ExerciseCount >= 6
                    ? 3
                    : cell.ExerciseCount >= 3
                        ? 2
                        : 1;

    private static string GetTitle(ActivityCell cell)
    {
        if (cell.Date is null)
        {
            return string.Empty;
        }

        var sessions = cell.WorkoutCount == 1
            ? "1 session"
            : $"{cell.WorkoutCount} sessions";
        return cell.WorkoutCount == 0
            ? $"{cell.Date:ddd, d MMM}: rest"
            : $"{cell.Date:ddd, d MMM}: {sessions}, {cell.ExerciseCount} exercises";
    }

    private sealed record ActivityCell(
        DateTime? Date,
        int WorkoutCount,
        int ExerciseCount);
}
