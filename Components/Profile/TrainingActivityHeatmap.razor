<section class="hs-training-activity hs-surface"
         aria-labelledby="training-activity-title">
    <div class="hs-insights-section-head">
        <MudText Typo="Typo.h6" id="training-activity-title">
            Training days
        </MudText>
        <span class="hs-training-activity-count">
            @ActiveDayCount active
        </span>
    </div>

    <div class="hs-training-activity-months">
        @foreach (var month in Months)
        {
            <section class="hs-training-activity-month"
                     aria-label="@month.ToString("MMMM yyyy")">
                <strong class="hs-training-activity-month-name">
                    @month.ToString("MMM yyyy")
                </strong>

                <div class="hs-training-activity-weekdays"
                     aria-hidden="true">
                    @foreach (var weekday in Weekdays)
                    {
                        <span title="@weekday.Name">@weekday.Label</span>
                    }
                </div>

                <div class="hs-training-activity-calendar"
                     role="grid"
                     aria-label="@($"{month:MMMM yyyy} training activity")">
                    @foreach (var cell in BuildMonthCells(month))
                    {
                        if (cell.Date is null)
                        {
                            <span class="hs-training-activity-day is-spacer"
                                  aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="@GetCellClass(cell)"
                                  role="gridcell"
                                  title="@GetTitle(cell)"
                                  aria-label="@GetTitle(cell)"></span>
                        }
                    }
                </div>
            </section>
        }
    </div>

    <div class="hs-training-activity-legend" aria-hidden="true">
        <span>No training</span>
        <span class="hs-training-activity-day level-0"></span>
        <span class="hs-training-activity-day level-1"></span>
        <span class="hs-training-activity-day level-2"></span>
        <span class="hs-training-activity-day level-3"></span>
        <span class="hs-training-activity-day level-4"></span>
        <span>More activity</span>
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<TrainingDayActivityResource> ActivityDays
    {
        get;
        set;
    } = Array.Empty<TrainingDayActivityResource>();

    private static readonly IReadOnlyList<Weekday> Weekdays =
    [
        new("M", "Monday"),
        new("T", "Tuesday"),
        new("W", "Wednesday"),
        new("T", "Thursday"),
        new("F", "Friday"),
        new("S", "Saturday"),
        new("S", "Sunday")
    ];

    private DateTime CurrentMonthStart
        => new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime PreviousMonthStart
        => CurrentMonthStart.AddMonths(-1);
    private IReadOnlyList<DateTime> Months
        => [PreviousMonthStart, CurrentMonthStart];
    private int ActiveDayCount
        => ActivityDays.Count(day =>
            day.Date.Date >= PreviousMonthStart
            && day.Date.Date <= DateTime.Today
            && day.WorkoutCount > 0);

    private IReadOnlyList<ActivityCell> BuildMonthCells(
        DateTime monthStart)
    {
        var activityByDate = ActivityDays
            .GroupBy(day => day.Date.Date)
            .ToDictionary(
                group => group.Key,
                group => new TrainingDayActivityResource
                {
                    Date = group.Key,
                    WorkoutCount = group.Sum(day =>
                        day.WorkoutCount),
                    ExerciseCount = group.Sum(day =>
                        day.ExerciseCount)
                });
        var leadingSpacers =
            (7 + (monthStart.DayOfWeek - DayOfWeek.Monday))
            % 7;
        var cells = new List<ActivityCell>(42);

        for (var index = 0; index < leadingSpacers; index++)
        {
            cells.Add(new ActivityCell(null, 0, 0));
        }

        var daysInMonth = DateTime.DaysInMonth(
            monthStart.Year,
            monthStart.Month);
        for (var day = 1; day <= daysInMonth; day++)
        {
            var date = new DateTime(
                monthStart.Year,
                monthStart.Month,
                day);
            activityByDate.TryGetValue(date, out var activity);
            cells.Add(new ActivityCell(
                date,
                activity?.WorkoutCount ?? 0,
                activity?.ExerciseCount ?? 0));
        }

        while (cells.Count < 42)
        {
            cells.Add(new ActivityCell(null, 0, 0));
        }

        return cells;
    }

    private static string GetCellClass(ActivityCell cell)
        => $"hs-training-activity-day level-{GetLevel(cell)}"
           + (cell.Date > DateTime.Today ? " is-future" : string.Empty);

    private static int GetLevel(ActivityCell cell)
        => cell.WorkoutCount <= 0
            ? 0
            : cell.WorkoutCount >= 2 || cell.ExerciseCount >= 8
                ? 4
                : cell.ExerciseCount >= 6
                    ? 3
                    : cell.ExerciseCount >= 3
                        ? 2
                        : 1;

    private static string GetTitle(ActivityCell cell)
    {
        if (cell.Date is null)
        {
            return string.Empty;
        }

        if (cell.Date > DateTime.Today)
        {
            return $"{cell.Date:dddd, d MMMM}: upcoming";
        }

        var sessions = cell.WorkoutCount == 1
            ? "1 session"
            : $"{cell.WorkoutCount} sessions";
        return cell.WorkoutCount == 0
            ? $"{cell.Date:ddd, d MMM}: rest"
            : $"{cell.Date:ddd, d MMM}: {sessions}, {cell.ExerciseCount} exercises";
    }

    private sealed record ActivityCell(
        DateTime? Date,
        int WorkoutCount,
        int ExerciseCount);

    private sealed record Weekday(string Label, string Name);
}
