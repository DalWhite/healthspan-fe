<div class="hs-body-map-shell">
    <div class="hs-body-map-stage">
        <svg viewBox="0 0 420 520" class="hs-body-map-svg" role="img" aria-label="Weekly body load heatmap">
            @if (ShowFront)
            {
                <g transform="@GetFrontTransform()">
                    <text x="60" y="18" class="hs-body-figure-label">Front</text>
                    @RenderBaseFigure()
                    <ellipse cx="18" cy="138" rx="11" ry="36" fill="@GetFill("biceps-brachii")" stroke="@GetStroke("biceps-brachii")" stroke-width="2" />
                    <ellipse cx="102" cy="138" rx="11" ry="36" fill="@GetFill("biceps-brachii")" stroke="@GetStroke("biceps-brachii")" stroke-width="2" />
                    <ellipse cx="18" cy="206" rx="8" ry="28" fill="@GetFill("brachialis")" stroke="@GetStroke("brachialis")" stroke-width="2" />
                    <ellipse cx="102" cy="206" rx="8" ry="28" fill="@GetFill("brachialis")" stroke="@GetStroke("brachialis")" stroke-width="2" />
                    <path d="M36 88 C43 74, 55 72, 60 98 C55 122, 40 126, 32 112 Z" fill="@GetFill("pectoralis-major")" stroke="@GetStroke("pectoralis-major")" stroke-width="2" />
                    <path d="M84 88 C77 74, 65 72, 60 98 C65 122, 80 126, 88 112 Z" fill="@GetFill("pectoralis-major")" stroke="@GetStroke("pectoralis-major")" stroke-width="2" />
                    <path d="M34 120 C42 118, 46 124, 44 150 C34 150, 28 142, 28 130 Z" fill="@GetFill("serratus-anterior")" stroke="@GetStroke("serratus-anterior")" stroke-width="2" />
                    <path d="M86 120 C78 118, 74 124, 76 150 C86 150, 92 142, 92 130 Z" fill="@GetFill("serratus-anterior")" stroke="@GetStroke("serratus-anterior")" stroke-width="2" />
                    <rect x="47" y="118" width="26" height="78" rx="11" fill="@GetFill("rectus-abdominis")" stroke="@GetStroke("rectus-abdominis")" stroke-width="2" />
                    <path d="M36 154 C40 146, 46 146, 48 170 C46 194, 38 194, 30 180 Z" fill="@GetFill("external-obliques")" stroke="@GetStroke("external-obliques")" stroke-width="2" />
                    <path d="M84 154 C80 146, 74 146, 72 170 C74 194, 82 194, 90 180 Z" fill="@GetFill("external-obliques")" stroke="@GetStroke("external-obliques")" stroke-width="2" />
                    <rect x="32" y="226" width="22" height="122" rx="11" fill="@GetFill("quadriceps-femoris")" stroke="@GetStroke("quadriceps-femoris")" stroke-width="2" />
                    <rect x="66" y="226" width="22" height="122" rx="11" fill="@GetFill("quadriceps-femoris")" stroke="@GetStroke("quadriceps-femoris")" stroke-width="2" />
                </g>
            }

            @if (ShowBack)
            {
                <g transform="@GetBackTransform()">
                    <text x="60" y="18" class="hs-body-figure-label">Back</text>
                    @RenderBaseFigure()
                    <ellipse cx="18" cy="138" rx="11" ry="36" fill="@GetFill("triceps-brachii")" stroke="@GetStroke("triceps-brachii")" stroke-width="2" />
                    <ellipse cx="102" cy="138" rx="11" ry="36" fill="@GetFill("triceps-brachii")" stroke="@GetStroke("triceps-brachii")" stroke-width="2" />
                    <path d="M60 84 L40 112 Q60 130 80 112 Z" fill="@GetFill("trapezius")" stroke="@GetStroke("trapezius")" stroke-width="2" />
                    <path d="M38 112 C24 122, 24 154, 42 184 C50 176, 50 140, 48 120 Z" fill="@GetFill("latissimus-dorsi")" stroke="@GetStroke("latissimus-dorsi")" stroke-width="2" />
                    <path d="M82 112 C96 122, 96 154, 78 184 C70 176, 70 140, 72 120 Z" fill="@GetFill("latissimus-dorsi")" stroke="@GetStroke("latissimus-dorsi")" stroke-width="2" />
                    <ellipse cx="46" cy="216" rx="16" ry="20" fill="@GetFill("gluteus-maximus")" stroke="@GetStroke("gluteus-maximus")" stroke-width="2" />
                    <ellipse cx="74" cy="216" rx="16" ry="20" fill="@GetFill("gluteus-maximus")" stroke="@GetStroke("gluteus-maximus")" stroke-width="2" />
                    <rect x="32" y="232" width="22" height="112" rx="11" fill="@GetFill("biceps-femoris")" stroke="@GetStroke("biceps-femoris")" stroke-width="2" />
                    <rect x="66" y="232" width="22" height="112" rx="11" fill="@GetFill("biceps-femoris")" stroke="@GetStroke("biceps-femoris")" stroke-width="2" />
                    <rect x="34" y="344" width="18" height="50" rx="9" fill="@GetFill("gastrocnemius")" stroke="@GetStroke("gastrocnemius")" stroke-width="2" />
                    <rect x="68" y="344" width="18" height="50" rx="9" fill="@GetFill("gastrocnemius")" stroke="@GetStroke("gastrocnemius")" stroke-width="2" />
                    <rect x="36" y="392" width="14" height="28" rx="7" fill="@GetFill("soleus")" stroke="@GetStroke("soleus")" stroke-width="2" />
                    <rect x="70" y="392" width="14" height="28" rx="7" fill="@GetFill("soleus")" stroke="@GetStroke("soleus")" stroke-width="2" />
                </g>
            }
        </svg>
    </div>

    <div class="hs-body-scale">
        <span>Low load</span>
        <div class="hs-body-scale-bar"></div>
        <span>High load</span>
    </div>

    <div class="hs-body-map-legend">
        @foreach (var region in VisibleRegions)
        {
            <div class="hs-body-map-legend-item">
                <div class="hs-body-map-legend-copy">
                    <span class="hs-body-map-legend-label">@region.Label</span>
                    <span class="hs-body-map-legend-meta">@region.Group</span>
                </div>
                <div class="hs-body-map-legend-metric">
                    <span>@FormatLoad(region.Load)</span>
                    <span class="hs-body-map-legend-dot" style="background:@GetFill(region.Key)"></span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<MuscleLoadRegionResource> Regions { get; set; } = Array.Empty<MuscleLoadRegionResource>();
    [Parameter] public string ViewMode { get; set; } = "both";

    private readonly Dictionary<string, MuscleLoadRegionResource> _regionsByKey = new(StringComparer.OrdinalIgnoreCase);

    private bool ShowFront => !string.Equals(ViewMode, "back", StringComparison.OrdinalIgnoreCase);
    private bool ShowBack => !string.Equals(ViewMode, "front", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<MuscleLoadRegionResource> VisibleRegions =>
        Regions
            .Where(region => string.Equals(ViewMode, "both", StringComparison.OrdinalIgnoreCase)
                || string.Equals(region.Side, ViewMode, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(region => region.Load)
            .ThenBy(region => region.Label);

    protected override void OnParametersSet()
    {
        _regionsByKey.Clear();

        foreach (var region in Regions)
        {
            _regionsByKey[region.Key] = region;
        }
    }

    private RenderFragment RenderBaseFigure() => builder =>
    {
        builder.OpenElement(0, "circle");
        builder.AddAttribute(1, "cx", "60");
        builder.AddAttribute(2, "cy", "46");
        builder.AddAttribute(3, "r", "24");
        builder.AddAttribute(4, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(5, "rect");
        builder.AddAttribute(6, "x", "28");
        builder.AddAttribute(7, "y", "78");
        builder.AddAttribute(8, "width", "64");
        builder.AddAttribute(9, "height", "118");
        builder.AddAttribute(10, "rx", "28");
        builder.AddAttribute(11, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(12, "rect");
        builder.AddAttribute(13, "x", "22");
        builder.AddAttribute(14, "y", "190");
        builder.AddAttribute(15, "width", "76");
        builder.AddAttribute(16, "height", "48");
        builder.AddAttribute(17, "rx", "18");
        builder.AddAttribute(18, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(19, "rect");
        builder.AddAttribute(20, "x", "8");
        builder.AddAttribute(21, "y", "96");
        builder.AddAttribute(22, "width", "18");
        builder.AddAttribute(23, "height", "146");
        builder.AddAttribute(24, "rx", "9");
        builder.AddAttribute(25, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(26, "rect");
        builder.AddAttribute(27, "x", "94");
        builder.AddAttribute(28, "y", "96");
        builder.AddAttribute(29, "width", "18");
        builder.AddAttribute(30, "height", "146");
        builder.AddAttribute(31, "rx", "9");
        builder.AddAttribute(32, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(33, "rect");
        builder.AddAttribute(34, "x", "30");
        builder.AddAttribute(35, "y", "236");
        builder.AddAttribute(36, "width", "26");
        builder.AddAttribute(37, "height", "188");
        builder.AddAttribute(38, "rx", "12");
        builder.AddAttribute(39, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(40, "rect");
        builder.AddAttribute(41, "x", "64");
        builder.AddAttribute(42, "y", "236");
        builder.AddAttribute(43, "width", "26");
        builder.AddAttribute(44, "height", "188");
        builder.AddAttribute(45, "rx", "12");
        builder.AddAttribute(46, "class", "hs-body-base");
        builder.CloseElement();
    };

    private string GetFrontTransform()
        => ShowFront && ShowBack ? "translate(42 34)" : "translate(150 34)";

    private string GetBackTransform()
        => ShowFront && ShowBack ? "translate(218 34)" : "translate(150 34)";

    private string GetFill(string key)
    {
        if (!_regionsByKey.TryGetValue(key, out var region) || region.RelativeLoad <= 0)
        {
            return "rgba(215, 223, 226, 0.36)";
        }

        return InterpolateColor(region.RelativeLoad);
    }

    private string GetStroke(string key)
    {
        if (!_regionsByKey.TryGetValue(key, out var region) || region.RelativeLoad <= 0)
        {
            return "#d7dfe2";
        }

        return InterpolateColor(Math.Min(1d, region.RelativeLoad + 0.12d));
    }

    private static string InterpolateColor(double value)
    {
        var clamped = Math.Clamp(value, 0d, 1d);
        var start = (R: 233d, G: 239d, B: 240d);
        var end = (R: 174d, G: 29d, B: 13d);

        var r = (int)Math.Round(start.R + ((end.R - start.R) * clamped));
        var g = (int)Math.Round(start.G + ((end.G - start.G) * clamped));
        var b = (int)Math.Round(start.B + ((end.B - start.B) * clamped));

        return $"rgb({r}, {g}, {b})";
    }

    private static string FormatLoad(double load)
        => load >= 100
            ? $"{Math.Round(load):0} kg"
            : $"{load:0.#} kg";
}
