@using System.Text
@*
    Weekly muscle-load body map.

    Geometry is derived from MuscleMap (@musclemap/assets, MIT) — traced per-muscle
    SVG path data, male + female, front + back. See MuscleBodyMapData.cs.

    Region-key contract (20 keys, produced by AppStateService):
      chest, front-delts, side-delts, biceps, forearms, abs, obliques, quads,
      adductors, calves, rear-delts, triceps, traps, upper-back, lats, glutes,
      abductors, hamstrings, serratus, hip-flexors

    MuscleMap group -> app key, per view:
      FRONT: CHEST->chest, SHOULDERS_FRONT->front-delts, SHOULDERS_SIDE->side-delts,
             BICEPS->biceps, FOREARMS->forearms, CORE->abs, OBLIQUES->obliques,
             QUADS->quads, ADDUCTORS->adductors, CALVES->calves, ABDUCTORS->abductors,
             TRAPEZIUS->traps, TRICEPS->triceps
      BACK:  SHOULDERS_REAR->rear-delts, SHOULDERS_SIDE->side-delts, TRICEPS->triceps,
             FOREARMS->forearms, TRAPEZIUS->traps, RHOMBOIDS->upper-back, LATS->lats,
             GLUTES->glutes, ABDUCTORS->abductors, HAMSTRINGS->hamstrings, CALVES->calves,
             OBLIQUES->obliques, ADDUCTORS->adductors

    18/20 keys have a traced body region. `serratus` and `hip-flexors` have no traced
    path in MuscleMap, so they are legend-only (same treatment as the reference
    Hypertrophy-Toolbox map). `BACK_LOWER` (erectors) is not one of the 20 tracked
    keys and stays part of the base silhouette.

    Load colour is a traffic-light ramp by intensity (DESIGN.md readiness ramp):
      no load -> card surface, low -> done #2FBF71, mid -> PR #F5B83D, high -> error #F1545B
*@
<div class="hs-body-map-shell @BodyProfileClass"
     data-body-profile="@BodyProfileKey">
    <div class="hs-body-map-stage">
        <svg viewBox="@ViewBox"
             class="hs-body-map-svg"
             role="img"
             aria-label="@BodyMapAriaLabel"
             preserveAspectRatio="xMidYMid meet">
            @if (ShowFront)
            {
                <g transform="translate(0 0)">
                    @RenderFigure(FrontFigure, "Front")
                </g>
            }
            @if (ShowBack)
            {
                <g transform="@BackTransform">
                    @RenderFigure(BackFigure, "Back")
                </g>
            }
        </svg>
    </div>

    <div class="hs-body-scale">
        <span>Low load</span>
        <div class="hs-body-scale-bar"></div>
        <span>High load</span>
    </div>

    <div class="hs-body-map-legend">
        @foreach (var region in VisibleRegions)
        {
            <div class="hs-body-map-legend-item">
                <div class="hs-body-map-legend-copy">
                    <span class="hs-body-map-legend-label">@region.Label</span>
                    <span class="hs-body-map-legend-meta">@region.Group</span>
                </div>
                <div class="hs-body-map-legend-metric">
                    <span>@FormatLoad(region.Load)</span>
                    <span class="hs-body-map-legend-dot" style="background:@GetFill(region.Key)"></span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<MuscleLoadRegionResource> Regions { get; set; } = Array.Empty<MuscleLoadRegionResource>();
    [Parameter] public string ViewMode { get; set; } = "both";
    [Parameter] public HealthBiologicalSex BiologicalSex { get; set; }

    private readonly Dictionary<string, MuscleLoadRegionResource> _regionsByKey = new(StringComparer.OrdinalIgnoreCase);

    private bool ShowFront => !string.Equals(ViewMode, "back", StringComparison.OrdinalIgnoreCase);
    private bool ShowBack => !string.Equals(ViewMode, "front", StringComparison.OrdinalIgnoreCase);
    private bool BothViews => ShowFront && ShowBack;

    private string BodyProfileKey
        => BiologicalSex switch
        {
            HealthBiologicalSex.Female => "female",
            HealthBiologicalSex.Male => "male",
            _ => "neutral"
        };
    private string BodyProfileClass => $"is-{BodyProfileKey}";
    private string BodyMapAriaLabel
        => $"{BodyProfileKey} weekly muscle load map";

    // Neutral falls back to the male figure; MuscleMap ships male + female only.
    private bool UseFemaleBody => BiologicalSex == HealthBiologicalSex.Female;
    private MuscleBodyMapFigure FrontFigure => UseFemaleBody ? MuscleBodyMapData.FemaleFront : MuscleBodyMapData.MaleFront;
    private MuscleBodyMapFigure BackFigure => UseFemaleBody ? MuscleBodyMapData.FemaleBack : MuscleBodyMapData.MaleBack;

    // Each figure occupies a 1024 x 1536 box; -60 top leaves room for the figure label.
    private string ViewBox => BothViews ? "0 -60 2088 1620" : "0 -60 1024 1620";
    private string BackTransform => BothViews ? "translate(1064 0)" : "translate(0 0)";

    private IEnumerable<MuscleLoadRegionResource> VisibleRegions =>
        Regions
            .Where(region => region.Load > 0)
            .Where(region => string.Equals(ViewMode, "both", StringComparison.OrdinalIgnoreCase)
                || string.Equals(region.Side, "both", StringComparison.OrdinalIgnoreCase)
                || string.Equals(region.Side, ViewMode, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(region => region.Load)
            .ThenBy(region => region.Label)
            .Take(6);

    protected override void OnParametersSet()
    {
        _regionsByKey.Clear();

        foreach (var region in Regions)
        {
            _regionsByKey[region.Key] = region;
        }
    }

    private RenderFragment RenderFigure(MuscleBodyMapFigure figure, string label) => builder =>
    {
        var markup = new StringBuilder();
        markup.Append($"<text x=\"512\" y=\"-24\" class=\"hs-body-figure-label\">{label}</text>");
        markup.Append($"<path class=\"hs-body-base\" d=\"{figure.Outline}\" />");

        for (var i = 0; i < figure.Keys.Length; i++)
        {
            var key = figure.Keys[i];
            markup.Append(
                $"<path class=\"hs-body-muscle\" d=\"{figure.Paths[i]}\" fill=\"{GetFill(key)}\" stroke=\"{GetStroke(key)}\" />");
        }

        builder.AddMarkupContent(0, markup.ToString());
    };

    private string GetFill(string key)
    {
        if (!_regionsByKey.TryGetValue(key, out var region) || region.RelativeLoad <= 0)
        {
            return "rgba(40, 48, 64, 0.45)";
        }

        return LoadColor(region.RelativeLoad, 1d);
    }

    private string GetStroke(string key)
    {
        if (!_regionsByKey.TryGetValue(key, out var region) || region.RelativeLoad <= 0)
        {
            return "var(--hs-border)";
        }

        return LoadColor(region.RelativeLoad, 0.72d);
    }

    // Traffic-light readiness ramp: done -> PR -> error as intensity rises.
    private static readonly (int R, int G, int B) LoadLow = (47, 191, 113);   // --hs-done  #2FBF71
    private static readonly (int R, int G, int B) LoadMid = (245, 184, 61);   // --hs-pr    #F5B83D
    private static readonly (int R, int G, int B) LoadHigh = (241, 84, 91);   // --hs-err   #F1545B

    private static string LoadColor(double value, double factor)
    {
        var clamped = Math.Clamp(value, 0d, 1d);
        int r, g, b;

        if (clamped <= 0.5d)
        {
            var u = clamped / 0.5d;
            r = (int)Math.Round(LoadLow.R + ((LoadMid.R - LoadLow.R) * u));
            g = (int)Math.Round(LoadLow.G + ((LoadMid.G - LoadLow.G) * u));
            b = (int)Math.Round(LoadLow.B + ((LoadMid.B - LoadLow.B) * u));
        }
        else
        {
            var u = (clamped - 0.5d) / 0.5d;
            r = (int)Math.Round(LoadMid.R + ((LoadHigh.R - LoadMid.R) * u));
            g = (int)Math.Round(LoadMid.G + ((LoadHigh.G - LoadMid.G) * u));
            b = (int)Math.Round(LoadMid.B + ((LoadHigh.B - LoadMid.B) * u));
        }

        r = (int)Math.Round(r * factor);
        g = (int)Math.Round(g * factor);
        b = (int)Math.Round(b * factor);

        return $"rgb({r}, {g}, {b})";
    }

    private static string FormatLoad(double load)
        => load >= 100
            ? $"{Math.Round(load):0} kg"
            : $"{load:0.#} kg";
}
