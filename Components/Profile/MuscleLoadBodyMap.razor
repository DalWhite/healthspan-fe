<div class="hs-body-map-shell @BodyProfileClass"
     data-body-profile="@BodyProfileKey">
    <div class="hs-body-map-stage">
        <svg viewBox="0 0 420 520"
             class="hs-body-map-svg"
             role="img"
             aria-label="@BodyMapAriaLabel">
            @if (ShowFront)
            {
                <g transform="@GetFrontTransform()">
                    <text x="60" y="18" class="hs-body-figure-label">Front</text>
                    @RenderBaseFigure()
                    <path d="M30 78 C40 70, 48 70, 52 92 C44 112, 34 112, 26 98 Z" fill="@GetFill("front-delts")" stroke="@GetStroke("front-delts")" stroke-width="2" />
                    <path d="M90 78 C80 70, 72 70, 68 92 C76 112, 86 112, 94 98 Z" fill="@GetFill("front-delts")" stroke="@GetStroke("front-delts")" stroke-width="2" />
                    <ellipse cx="20" cy="96" rx="8" ry="18" fill="@GetFill("side-delts")" stroke="@GetStroke("side-delts")" stroke-width="2" />
                    <ellipse cx="100" cy="96" rx="8" ry="18" fill="@GetFill("side-delts")" stroke="@GetStroke("side-delts")" stroke-width="2" />
                    <ellipse cx="20" cy="138" rx="11" ry="34" fill="@GetFill("biceps")" stroke="@GetStroke("biceps")" stroke-width="2" />
                    <ellipse cx="100" cy="138" rx="11" ry="34" fill="@GetFill("biceps")" stroke="@GetStroke("biceps")" stroke-width="2" />
                    <rect x="11" y="176" width="16" height="56" rx="8" fill="@GetFill("forearms")" stroke="@GetStroke("forearms")" stroke-width="2" />
                    <rect x="93" y="176" width="16" height="56" rx="8" fill="@GetFill("forearms")" stroke="@GetStroke("forearms")" stroke-width="2" />
                    <path d="M36 88 C43 74, 55 72, 60 98 C55 122, 40 126, 32 112 Z" fill="@GetFill("chest")" stroke="@GetStroke("chest")" stroke-width="2" />
                    <path d="M84 88 C77 74, 65 72, 60 98 C65 122, 80 126, 88 112 Z" fill="@GetFill("chest")" stroke="@GetStroke("chest")" stroke-width="2" />
                    <path d="M34 120 C42 118, 46 124, 44 148 C34 150, 28 142, 28 130 Z" fill="@GetFill("serratus")" stroke="@GetStroke("serratus")" stroke-width="2" />
                    <path d="M86 120 C78 118, 74 124, 76 148 C86 150, 92 142, 92 130 Z" fill="@GetFill("serratus")" stroke="@GetStroke("serratus")" stroke-width="2" />
                    <rect x="47" y="118" width="26" height="78" rx="11" fill="@GetFill("abs")" stroke="@GetStroke("abs")" stroke-width="2" />
                    <path d="M36 154 C40 146, 46 146, 48 172 C46 194, 38 194, 30 180 Z" fill="@GetFill("obliques")" stroke="@GetStroke("obliques")" stroke-width="2" />
                    <path d="M84 154 C80 146, 74 146, 72 172 C74 194, 82 194, 90 180 Z" fill="@GetFill("obliques")" stroke="@GetStroke("obliques")" stroke-width="2" />
                    <rect x="42" y="204" width="14" height="24" rx="7" fill="@GetFill("hip-flexors")" stroke="@GetStroke("hip-flexors")" stroke-width="2" />
                    <rect x="64" y="204" width="14" height="24" rx="7" fill="@GetFill("hip-flexors")" stroke="@GetStroke("hip-flexors")" stroke-width="2" />
                    <rect x="26" y="228" width="28" height="118" rx="12" fill="@GetFill("quads")" stroke="@GetStroke("quads")" stroke-width="2" />
                    <rect x="66" y="228" width="28" height="118" rx="12" fill="@GetFill("quads")" stroke="@GetStroke("quads")" stroke-width="2" />
                    <rect x="45" y="236" width="10" height="110" rx="5" fill="@GetFill("adductors")" stroke="@GetStroke("adductors")" stroke-width="2" />
                    <rect x="65" y="236" width="10" height="110" rx="5" fill="@GetFill("adductors")" stroke="@GetStroke("adductors")" stroke-width="2" />
                </g>
            }

            @if (ShowBack)
            {
                <g transform="@GetBackTransform()">
                    <text x="60" y="18" class="hs-body-figure-label">Back</text>
                    @RenderBaseFigure()
                    <path d="M30 78 C40 70, 48 70, 52 92 C44 112, 34 112, 26 98 Z" fill="@GetFill("rear-delts")" stroke="@GetStroke("rear-delts")" stroke-width="2" />
                    <path d="M90 78 C80 70, 72 70, 68 92 C76 112, 86 112, 94 98 Z" fill="@GetFill("rear-delts")" stroke="@GetStroke("rear-delts")" stroke-width="2" />
                    <ellipse cx="20" cy="96" rx="8" ry="18" fill="@GetFill("side-delts")" stroke="@GetStroke("side-delts")" stroke-width="2" />
                    <ellipse cx="100" cy="96" rx="8" ry="18" fill="@GetFill("side-delts")" stroke="@GetStroke("side-delts")" stroke-width="2" />
                    <ellipse cx="20" cy="138" rx="11" ry="34" fill="@GetFill("triceps")" stroke="@GetStroke("triceps")" stroke-width="2" />
                    <ellipse cx="100" cy="138" rx="11" ry="34" fill="@GetFill("triceps")" stroke="@GetStroke("triceps")" stroke-width="2" />
                    <rect x="11" y="176" width="16" height="56" rx="8" fill="@GetFill("forearms")" stroke="@GetStroke("forearms")" stroke-width="2" />
                    <rect x="93" y="176" width="16" height="56" rx="8" fill="@GetFill("forearms")" stroke="@GetStroke("forearms")" stroke-width="2" />
                    <path d="M60 82 L42 112 Q60 126 78 112 Z" fill="@GetFill("traps")" stroke="@GetStroke("traps")" stroke-width="2" />
                    <rect x="42" y="110" width="36" height="40" rx="12" fill="@GetFill("upper-back")" stroke="@GetStroke("upper-back")" stroke-width="2" />
                    <path d="M38 118 C24 130, 24 162, 42 190 C50 182, 50 144, 48 124 Z" fill="@GetFill("lats")" stroke="@GetStroke("lats")" stroke-width="2" />
                    <path d="M82 118 C96 130, 96 162, 78 190 C70 182, 70 144, 72 124 Z" fill="@GetFill("lats")" stroke="@GetStroke("lats")" stroke-width="2" />
                    <ellipse cx="46" cy="216" rx="16" ry="20" fill="@GetFill("glutes")" stroke="@GetStroke("glutes")" stroke-width="2" />
                    <ellipse cx="74" cy="216" rx="16" ry="20" fill="@GetFill("glutes")" stroke="@GetStroke("glutes")" stroke-width="2" />
                    <rect x="24" y="236" width="10" height="110" rx="5" fill="@GetFill("abductors")" stroke="@GetStroke("abductors")" stroke-width="2" />
                    <rect x="86" y="236" width="10" height="110" rx="5" fill="@GetFill("abductors")" stroke="@GetStroke("abductors")" stroke-width="2" />
                    <rect x="34" y="232" width="20" height="112" rx="10" fill="@GetFill("hamstrings")" stroke="@GetStroke("hamstrings")" stroke-width="2" />
                    <rect x="66" y="232" width="20" height="112" rx="10" fill="@GetFill("hamstrings")" stroke="@GetStroke("hamstrings")" stroke-width="2" />
                    <rect x="34" y="344" width="18" height="68" rx="9" fill="@GetFill("calves")" stroke="@GetStroke("calves")" stroke-width="2" />
                    <rect x="68" y="344" width="18" height="68" rx="9" fill="@GetFill("calves")" stroke="@GetStroke("calves")" stroke-width="2" />
                </g>
            }
        </svg>
    </div>

    <div class="hs-body-scale">
        <span>Low load</span>
        <div class="hs-body-scale-bar"></div>
        <span>High load</span>
    </div>

    <div class="hs-body-map-legend">
        @foreach (var region in VisibleRegions)
        {
            <div class="hs-body-map-legend-item">
                <div class="hs-body-map-legend-copy">
                    <span class="hs-body-map-legend-label">@region.Label</span>
                    <span class="hs-body-map-legend-meta">@region.Group</span>
                </div>
                <div class="hs-body-map-legend-metric">
                    <span>@FormatLoad(region.Load)</span>
                    <span class="hs-body-map-legend-dot" style="background:@GetFill(region.Key)"></span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<MuscleLoadRegionResource> Regions { get; set; } = Array.Empty<MuscleLoadRegionResource>();
    [Parameter] public string ViewMode { get; set; } = "both";
    [Parameter] public HealthBiologicalSex BiologicalSex { get; set; }

    private readonly Dictionary<string, MuscleLoadRegionResource> _regionsByKey = new(StringComparer.OrdinalIgnoreCase);

    private bool ShowFront => !string.Equals(ViewMode, "back", StringComparison.OrdinalIgnoreCase);
    private bool ShowBack => !string.Equals(ViewMode, "front", StringComparison.OrdinalIgnoreCase);
    private string BodyProfileKey
        => BiologicalSex switch
        {
            HealthBiologicalSex.Female => "female",
            HealthBiologicalSex.Male => "male",
            _ => "neutral"
        };
    private string BodyProfileClass => $"is-{BodyProfileKey}";
    private string BodyMapAriaLabel
        => $"{BodyProfileKey} weekly muscle load map";

    private IEnumerable<MuscleLoadRegionResource> VisibleRegions =>
        Regions
            .Where(region => region.Load > 0)
            .Where(region => string.Equals(ViewMode, "both", StringComparison.OrdinalIgnoreCase)
                || string.Equals(region.Side, "both", StringComparison.OrdinalIgnoreCase)
                || string.Equals(region.Side, ViewMode, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(region => region.Load)
            .ThenBy(region => region.Label)
            .Take(6);

    protected override void OnParametersSet()
    {
        _regionsByKey.Clear();

        foreach (var region in Regions)
        {
            _regionsByKey[region.Key] = region;
        }
    }

    private RenderFragment RenderBaseFigure() => builder =>
    {
        builder.OpenElement(0, "circle");
        builder.AddAttribute(1, "cx", "60");
        builder.AddAttribute(2, "cy", "46");
        builder.AddAttribute(3, "r", "24");
        builder.AddAttribute(4, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(5, "path");
        builder.AddAttribute(6, "d", GetTorsoPath());
        builder.AddAttribute(7, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(8, "path");
        builder.AddAttribute(9, "d", GetPelvisPath());
        builder.AddAttribute(10, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(11, "rect");
        builder.AddAttribute(12, "x", "8");
        builder.AddAttribute(13, "y", "96");
        builder.AddAttribute(14, "width", "18");
        builder.AddAttribute(15, "height", "146");
        builder.AddAttribute(16, "rx", "9");
        builder.AddAttribute(17, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(18, "rect");
        builder.AddAttribute(19, "x", "94");
        builder.AddAttribute(20, "y", "96");
        builder.AddAttribute(21, "width", "18");
        builder.AddAttribute(22, "height", "146");
        builder.AddAttribute(23, "rx", "9");
        builder.AddAttribute(24, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(25, "rect");
        builder.AddAttribute(26, "x", "30");
        builder.AddAttribute(27, "y", "236");
        builder.AddAttribute(28, "width", "26");
        builder.AddAttribute(29, "height", "188");
        builder.AddAttribute(30, "rx", "12");
        builder.AddAttribute(31, "class", "hs-body-base");
        builder.CloseElement();

        builder.OpenElement(32, "rect");
        builder.AddAttribute(33, "x", "64");
        builder.AddAttribute(34, "y", "236");
        builder.AddAttribute(35, "width", "26");
        builder.AddAttribute(36, "height", "188");
        builder.AddAttribute(37, "rx", "12");
        builder.AddAttribute(38, "class", "hs-body-base");
        builder.CloseElement();
    };

    private string GetTorsoPath()
        => BiologicalSex switch
        {
            HealthBiologicalSex.Female =>
                "M32 78 Q60 68 88 78 L82 176 Q78 196 60 204 Q42 196 38 176 Z",
            HealthBiologicalSex.Male =>
                "M22 80 Q60 62 98 80 L84 190 Q60 200 36 190 Z",
            _ =>
                "M28 78 Q60 68 92 78 L88 190 Q60 202 32 190 Z"
        };

    private string GetPelvisPath()
        => BiologicalSex switch
        {
            HealthBiologicalSex.Female =>
                "M34 184 Q60 174 86 184 L98 222 Q94 238 60 240 Q26 238 22 222 Z",
            HealthBiologicalSex.Male =>
                "M36 188 Q60 184 84 188 L90 224 Q84 238 60 238 Q36 238 30 224 Z",
            _ =>
                "M32 188 Q60 180 88 188 L96 224 Q88 238 60 238 Q32 238 24 224 Z"
        };

    private string GetFrontTransform()
        => ShowFront && ShowBack ? "translate(42 34)" : "translate(150 34)";

    private string GetBackTransform()
        => ShowFront && ShowBack ? "translate(218 34)" : "translate(150 34)";

    private string GetFill(string key)
    {
        if (!_regionsByKey.TryGetValue(key, out var region) || region.RelativeLoad <= 0)
        {
            return "rgba(215, 223, 226, 0.36)";
        }

        return InterpolateColor(region.RelativeLoad);
    }

    private string GetStroke(string key)
    {
        if (!_regionsByKey.TryGetValue(key, out var region) || region.RelativeLoad <= 0)
        {
            return "#d7dfe2";
        }

        return InterpolateColor(Math.Min(1d, region.RelativeLoad + 0.12d));
    }

    private static string InterpolateColor(double value)
    {
        var clamped = Math.Clamp(value, 0d, 1d);
        var start = (R: 233d, G: 239d, B: 240d);
        var end = (R: 174d, G: 29d, B: 13d);

        var r = (int)Math.Round(start.R + ((end.R - start.R) * clamped));
        var g = (int)Math.Round(start.G + ((end.G - start.G) * clamped));
        var b = (int)Math.Round(start.B + ((end.B - start.B) * clamped));

        return $"rgb({r}, {g}, {b})";
    }

    private static string FormatLoad(double load)
        => load >= 100
            ? $"{Math.Round(load):0} kg"
            : $"{load:0.#} kg";
}
