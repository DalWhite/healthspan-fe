@* Shared loading state indicator. Use this instead of bare MudProgressCircular. *@

<div class="hs-loading-state" role="status" aria-live="polite">
    <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="@Size" />
    @if (!string.IsNullOrEmpty(Message))
    {
        <MudText Typo="Typo.body2" Class="hs-state-copy mt-2">@Message</MudText>
    }
    else
    {
        <span class="hs-visually-hidden">Cargando</span>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
}
