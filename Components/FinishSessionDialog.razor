<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="px-0">
            <MudText Typo="Typo.h6">How hard was it?</MudText>
            <MudText Typo="Typo.body2" Class="hs-finish-fatigue-label">
                @PerceivedFatigue.Label(Value)
            </MudText>
            <MudSlider T="int" Value="Value" ValueChanged="@(value => Value = value)"
                      Min="@PerceivedFatigue.Min" Max="@PerceivedFatigue.Max" Step="1"
                      TickLabels="@TickLabels" TickPos="TickPos.Bottom" FullWidth="true"
                      aria-label="Perceived fatigue from 1 to 5" />
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Skip" Variant="Variant.Text" Color="Color.Default">Skip</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary">Save & finish</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int? InitialFatigue { get; set; }

    private int Value = 3;
    private string[] TickLabels = ["1", "2", "3", "4", "5"];

    protected override void OnInitialized()
    {
        Value = PerceivedFatigue.IsValid(InitialFatigue) ? InitialFatigue!.Value : 3;
    }

    private void Save() => MudDialog.Close(DialogResult.Ok<int?>(Value));

    // Skipping must never block the finish action: closing a session is one
    // tap more than before, never a wall.
    private void Skip() => MudDialog.Close(DialogResult.Ok<int?>(null));
}
