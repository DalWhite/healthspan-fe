@inject AppStateService AppState

<MudForm @ref="form" @bind-IsValid="@success">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4 hs-text-primary">Basic Info</MudText>

                    <MudTextField @bind-Value="Model.Name" Label="Exercise Name" Required="true"
                                  RequiredError="Name is required!" Variant="Variant.Outlined" Class="mb-3" />

                    <MudTextField @bind-Value="Model.Description" Label="Description" Lines="3"
                                  Variant="Variant.Outlined" Class="mb-3" />

                    @if (!string.IsNullOrEmpty(Model.ImageRoute))
                    {
                        <div class="mb-3">
                            <MudText Typo="Typo.caption" Class="mb-1 d-block">Current Image Preview:</MudText>
                            <MudImage Src="@Model.ImageRoute" Alt="Exercise Default Image" Width="100" Elevation="2" Class="rounded" />
                        </div>
                    }

                    <MudTextField @bind-Value="Model.ImageRoute" Label="Image URL"
                                  HelperText="Optional: Link to an image demonstrating the exercise"
                                  Variant="Variant.Outlined" Class="mb-3" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4 hs-text-primary">Target Muscles</MudText>

                    <MudSelect @bind-Value="Model.PrimaryMuscleId" Label="Primary Muscle"
                               Required="true" RequiredError="Primary muscle is required!"
                               Variant="Variant.Outlined" Class="mb-3">
                        @foreach (var muscle in Muscles)
                        {
                            <MudSelectItem Value="@( (int?) muscle.Id )">@muscle.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect @bind-Value="Model.SecondaryMuscleId" Label="Secondary Muscle (Optional)"
                               Clearable="true" Variant="Variant.Outlined" Class="mb-3">
                        @foreach (var muscle in Muscles)
                        {
                            <MudSelectItem Value="@( (int?) muscle.Id )">@muscle.Name</MudSelectItem>
                        }
                    </MudSelect>

                        <!-- WeightType does not exist on UpdateExerciseTypeResource yet, omitting from form temporarily -->
                    </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudForm>

<div class="d-flex justify-end pr-8 mt-4 gap-4">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="MudBlazor.Color.Primary"
               Variant="Variant.Outlined"
               Class="rounded-button"
               OnClick="OnCancel">
        Cancel
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="MudBlazor.Color.Primary"
               Disabled="@(!success)"
               Class="rounded-button hs-save-btn"
               OnClick="TriggerSubmit">
        Save Form
    </MudButton>
</div>

@code {
    [Parameter, EditorRequired]
    public UpdateExerciseTypeResource Model { get; set; } = new();
    
    [Parameter, EditorRequired]
    public EventCallback<UpdateExerciseTypeResource> OnSubmit { get; set; }
    
    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    private MudForm form;
    private bool success;
    private List<Muscle> Muscles = new();

    protected override async Task OnInitializedAsync()
    {
        Muscles = await AppState.GetMusclesAsync();
    }

    private async Task TriggerSubmit()
    {
        await form.Validate();
        if (success && OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(Model);
        }
    }
}
