@inject AppStateService AppState
@inject HttpClient Http
@implements IDisposable

<MudForm @ref="form" @bind-IsValid="@success">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4 hs-text-primary">Basic Info</MudText>

                    <MudTextField T="string?"
                                  Value="Model.Name"
                                  ValueChanged="OnNameChanged"
                                  Label="Exercise Name"
                                  Required="true"
                                  RequiredError="Name is required."
                                  MaxLength="100"
                                  HelperText="2-100 characters. Names must be unique."
                                  Error="@(_nameError is not null)"
                                  ErrorText="@_nameError"
                                  Adornment="@(_nameIsUniqueConfirmed ? Adornment.End : Adornment.None)"
                                  AdornmentIcon="@(_nameIsUniqueConfirmed ? Icons.Material.Filled.CheckCircle : "")"
                                  AdornmentColor="Color.Success"
                                  OnBlur="OnNameBlur"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    <MudTextField @bind-Value="Model.Description"
                                  Label="Description"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    @if (!string.IsNullOrEmpty(Model.ImageRoute))
                    {
                        <div class="mb-3">
                            <MudText Typo="Typo.caption" Class="mb-1 d-block">Current Image Preview:</MudText>
                            <MudImage Src="@Model.ImageRoute" Alt="Exercise Default Image" Width="100" Elevation="2" Class="rounded" />
                        </div>
                    }

                    <MudTextField @bind-Value="Model.ImageRoute"
                                  Label="Image URL"
                                  HelperText="Optional: link to an image demonstrating the exercise"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    <MudSelect T="ExerciseWeightType?"
                               @bind-Value="Model.WeightType"
                               Label="Weight Type"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="ExerciseWeightType?" Value="@((ExerciseWeightType?)ExerciseWeightType.Standard)">Standard</MudSelectItem>
                        <MudSelectItem T="ExerciseWeightType?" Value="@((ExerciseWeightType?)ExerciseWeightType.BodyWeight)">Bodyweight</MudSelectItem>
                        <MudSelectItem T="ExerciseWeightType?" Value="@((ExerciseWeightType?)ExerciseWeightType.None)">No weight</MudSelectItem>
                    </MudSelect>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4 hs-text-primary">Muscles And Variation</MudText>

                    <MudSelect T="int"
                               MultiSelection="true"
                               SelectedValues="_selectedPrimaryMuscleIds"
                               SelectedValuesChanged="OnPrimaryMusclesChanged"
                               Label="Primary muscles"
                               HelperText="Choose one or more main target muscles."
                               Error="@(_primaryMusclesError is not null)"
                               ErrorText="@_primaryMusclesError"
                               OnBlur="OnPrimaryMusclesBlur"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var muscle in Muscles)
                        {
                            if (muscle.Id.HasValue)
                            {
                                <MudSelectItem T="int" Value="@muscle.Id.Value">@muscle.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="int"
                               MultiSelection="true"
                               SelectedValues="_selectedSecondaryMuscleIds"
                               SelectedValuesChanged="OnSecondaryMusclesChanged"
                               Label="Secondary muscles"
                               HelperText="Secondary muscles cannot overlap with the primary list."
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var muscle in SecondaryMuscleOptions)
                        {
                            if (muscle.Id.HasValue)
                            {
                                <MudSelectItem T="int" Value="@muscle.Id.Value">@muscle.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="int?"
                               Value="Model.ParentExerciseTypeId"
                               ValueChanged="OnParentChanged"
                               Label="Variation Of"
                               Clearable="true"
                               Error="@(_parentError is not null)"
                               ErrorText="@_parentError"
                               OnBlur="OnParentBlur"
                               HelperText="Leave empty for a main exercise. Set a parent to create a variation like Romanian Sit-up under Sit-up."
                               Variant="Variant.Outlined">
                        @foreach (var exerciseType in ParentExerciseOptions)
                        {
                            <MudSelectItem T="int?" Value="@exerciseType.Id">@exerciseType.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4 hs-text-primary">Tags</MudText>

                    <MudSelect T="string"
                               MultiSelection="true"
                               SelectedValues="_selectedEquipmentTags"
                               SelectedValuesChanged="OnEquipmentTagsChanged"
                               Label="Equipment"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var tag in EquipmentTagOptions)
                        {
                            <MudSelectItem T="string" Value="@tag">@tag</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string"
                               MultiSelection="true"
                               SelectedValues="_selectedMechanicTags"
                               SelectedValuesChanged="OnMechanicTagsChanged"
                               Label="Movement"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var tag in MechanicTagOptions)
                        {
                            <MudSelectItem T="string" Value="@tag">@tag</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string"
                               MultiSelection="true"
                               SelectedValues="_selectedTypeTags"
                               SelectedValuesChanged="OnTypeTagsChanged"
                               Label="Type"
                               Variant="Variant.Outlined">
                        @foreach (var tag in TypeTagOptions)
                        {
                            <MudSelectItem T="string" Value="@tag">@tag</MudSelectItem>
                        }
                    </MudSelect>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudForm>

<div class="d-flex justify-end pr-8 mt-4 gap-4">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="MudBlazor.Color.Primary"
               Variant="Variant.Outlined"
               Class="rounded-button"
               OnClick="OnCancel">
        Cancel
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="MudBlazor.Color.Primary"
               Disabled="@(!success)"
               Class="rounded-button hs-save-btn"
               OnClick="TriggerSubmit">
        Save Form
    </MudButton>
</div>

@code {
    [Parameter, EditorRequired]
    public UpdateExerciseTypeResource Model { get; set; } = new();

    [Parameter, EditorRequired]
    public EventCallback<UpdateExerciseTypeResource> OnSubmit { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    private MudForm form = null!;
    private bool success;
    private List<Muscle> Muscles = new();
    private List<GetExerciseTypeResource> _exerciseTypes = new();
    private int _lastSyncedModelId = int.MinValue;
    private static readonly string[] EquipmentTagVocabulary =
        ["bodyweight", "dumbbell", "barbell", "kettlebell", "machine", "cable", "bands", "bench", "mat"];
    private static readonly string[] MechanicTagVocabulary =
        ["compound", "isolation", "rotation", "carry", "hinge", "squat", "push", "pull"];
    private static readonly string[] TypeTagVocabulary =
        ["core", "press", "row", "sit-up", "variation", "mobility"];

    private HashSet<string> _selectedEquipmentTags = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedMechanicTags = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedTypeTags = new(StringComparer.OrdinalIgnoreCase);
    private List<int> _selectedPrimaryMuscleIds = new();
    private List<int> _selectedSecondaryMuscleIds = new();

    // Inline per-field validation (NN/g rule 5): errors appear on blur, never while typing.
    private const int NameUniquenessDebounceMs = 400;
    private string? _nameError;
    private bool _nameIsUniqueConfirmed;
    private CancellationTokenSource? _nameCheckCts;
    private string? _parentError;
    private string? _primaryMusclesError;

    private IEnumerable<GetExerciseTypeResource> ParentExerciseOptions
        => _exerciseTypes
            .Where(exerciseType => exerciseType.ParentExerciseTypeId is null && exerciseType.Id != Model.Id)
            .OrderBy(exerciseType => exerciseType.Name);

    private IEnumerable<Muscle> SecondaryMuscleOptions
        => Muscles.Where(muscle => muscle.Id is int id && !_selectedPrimaryMuscleIds.Contains(id));

    private IEnumerable<string> EquipmentTagOptions => BuildTagOptions(EquipmentTagVocabulary, _selectedEquipmentTags);
    private IEnumerable<string> MechanicTagOptions => BuildTagOptions(MechanicTagVocabulary, _selectedMechanicTags);
    private IEnumerable<string> TypeTagOptions => BuildTagOptions(TypeTagVocabulary, _selectedTypeTags);

    protected override async Task OnInitializedAsync()
    {
        Muscles = (await AppState.GetMusclesAsync())
            .OrderBy(muscle => muscle.SortOrder <= 0 ? int.MaxValue : muscle.SortOrder)
            .ThenBy(muscle => muscle.Name)
            .ToList();
        // The parent picker and the "does not exist" validation must see every
        // type, not only the first page the library paints with (t_81a400b3). The
        // form still opens on what is already loaded instead of waiting for the
        // whole catalog: the rest lands through ExerciseTypesUpdated.
        _exerciseTypes = AppState.GetExerciseTypesSnapshot().ToList();
        AppState.ExerciseTypesUpdated += OnCatalogUpdated;
        _ = EnsureCatalogAsync();
        Model.WeightType ??= ExerciseWeightType.Standard;
        SyncTagEditorsFromModel();
        SyncMuscleSelectionsFromModel();
    }

    private async Task EnsureCatalogAsync()
    {
        try
        {
            await AppState.GetFullExerciseTypesAsync();
        }
        catch
        {
            // The page that opened the dialog reports the load failure.
        }
    }

    private void OnCatalogUpdated()
    {
        _exerciseTypes = AppState.GetExerciseTypesSnapshot().ToList();
        StateHasChanged();
    }

    public void Dispose() => AppState.ExerciseTypesUpdated -= OnCatalogUpdated;

    protected override void OnParametersSet()
    {
        Model.Tags ??= new List<ExerciseTag>();
        Model.MuscleAssignments ??= new List<ExerciseTypeMuscleAssignmentResource>();
        Model.WeightType ??= ExerciseWeightType.Standard;

        if (Model.Id != _lastSyncedModelId)
        {
            SyncTagEditorsFromModel();
            SyncMuscleSelectionsFromModel();
        }
    }

    private void SyncTagEditorsFromModel()
    {
        _selectedEquipmentTags = GetTags("equipment");
        _selectedMechanicTags = GetTags("mechanic");
        _selectedTypeTags = GetTags("type");
        _lastSyncedModelId = Model.Id;
    }

    private void SyncMuscleSelectionsFromModel()
    {
        Model.MuscleAssignments ??= new List<ExerciseTypeMuscleAssignmentResource>();

        _selectedPrimaryMuscleIds = ExerciseMuscleAssignmentHelper
            .GetAssignmentsByRole(Model.MuscleAssignments, "Primary")
            .Select(assignment => assignment.MuscleId)
            .Distinct()
            .ToList();

        _selectedSecondaryMuscleIds = ExerciseMuscleAssignmentHelper
            .GetAssignmentsByRole(Model.MuscleAssignments, "Secondary")
            .Select(assignment => assignment.MuscleId)
            .Where(muscleId => !_selectedPrimaryMuscleIds.Contains(muscleId))
            .Distinct()
            .ToList();

        SyncAssignmentsToModel();
    }

    private HashSet<string> GetTags(string category)
        => (Model.Tags ?? [])
            .Where(tag => string.Equals(tag.Category, category, StringComparison.OrdinalIgnoreCase))
            .Select(tag => tag.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Select(name => name.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private static IEnumerable<string> BuildTagOptions(IEnumerable<string> vocabulary, IEnumerable<string> selectedTags)
        => vocabulary
            .Concat(selectedTags.OrderBy(tag => tag))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private void OnEquipmentTagsChanged(IEnumerable<string> values)
        => _selectedEquipmentTags = NormalizeTags(values);

    private void OnMechanicTagsChanged(IEnumerable<string> values)
        => _selectedMechanicTags = NormalizeTags(values);

    private void OnTypeTagsChanged(IEnumerable<string> values)
        => _selectedTypeTags = NormalizeTags(values);

    private static HashSet<string> NormalizeTags(IEnumerable<string> values)
        => values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private void OnPrimaryMusclesChanged(IEnumerable<int> selectedValues)
    {
        _selectedPrimaryMuscleIds = OrderSelectedMuscleIds(selectedValues);
        _selectedSecondaryMuscleIds = _selectedSecondaryMuscleIds
            .Where(muscleId => !_selectedPrimaryMuscleIds.Contains(muscleId))
            .ToList();
        SyncAssignmentsToModel();
    }

    private void OnSecondaryMusclesChanged(IEnumerable<int> selectedValues)
    {
        _selectedSecondaryMuscleIds = OrderSelectedMuscleIds(selectedValues)
            .Where(muscleId => !_selectedPrimaryMuscleIds.Contains(muscleId))
            .ToList();
        SyncAssignmentsToModel();
    }

    private List<int> OrderSelectedMuscleIds(IEnumerable<int> selectedValues)
        => selectedValues
            .Distinct()
            .OrderBy(muscleId => Muscles.FirstOrDefault(muscle => muscle.Id == muscleId)?.SortOrder ?? int.MaxValue)
            .ThenBy(muscleId => Muscles.FirstOrDefault(muscle => muscle.Id == muscleId)?.Name)
            .ToList();

    private void SyncAssignmentsToModel()
    {
        // Selecting or clearing muscles is the user interacting with the field: drop any
        // stale inline feedback so it only reappears on blur/submit (NN/g: never while typing).
        _primaryMusclesError = null;
        Model.MuscleAssignments = _selectedPrimaryMuscleIds
            .Select((muscleId, index) => new ExerciseTypeMuscleAssignmentResource
            {
                MuscleId = muscleId,
                Role = "Primary",
                SortOrder = index + 1
            })
            .Concat(_selectedSecondaryMuscleIds.Select((muscleId, index) => new ExerciseTypeMuscleAssignmentResource
            {
                MuscleId = muscleId,
                Role = "Secondary",
                SortOrder = index + 1
            }))
            .ToList();
    }

    private void OnNameChanged(string? name)
    {
        Model.Name = name;
        // While typing we never validate; just drop stale feedback for the old value.
        _nameError = null;
        _nameIsUniqueConfirmed = false;
        _nameCheckCts?.Cancel();
    }

    private async Task OnNameBlur()
    {
        _nameCheckCts?.Cancel();
        if (!ValidateNameInline())
        {
            return;
        }

        // Debounced uniqueness check against the server, only after the user leaves the field.
        var cts = new CancellationTokenSource();
        _nameCheckCts = cts;
        var checkedName = Model.Name ?? string.Empty;
        try
        {
            await Task.Delay(NameUniquenessDebounceMs, cts.Token);
            var existing = await Http.GetFromJsonAsync<List<GetExerciseTypeResource>>("/ExerciseTypes");
            if (cts.IsCancellationRequested)
            {
                return;
            }

            var duplicate = existing is not null
                && existing.Any(et => et.Id != Model.Id
                    && string.Equals(et.Name?.Trim(), checkedName.Trim(), StringComparison.OrdinalIgnoreCase));
            if (duplicate)
            {
                _nameError = $"'{checkedName.Trim()}' already exists. Pick a different name.";
            }
            else
            {
                _nameError = null;
                _nameIsUniqueConfirmed = true;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // Offline/unreachable: keep quiet inline, the submit alert is the safety net.
        }
    }

    private bool ValidateNameInline()
    {
        var name = Model.Name?.Trim() ?? string.Empty;
        if (name.Length == 0)
        {
            _nameError = "Name is required.";
            return false;
        }

        if (name.Length < 2)
        {
            _nameError = "Name must be at least 2 characters.";
            return false;
        }

        if (name.Length > 100)
        {
            _nameError = "Name cannot exceed 100 characters.";
            return false;
        }

        _nameError = null;
        return true;
    }

    private void OnParentChanged(int? parentId)
    {
        Model.ParentExerciseTypeId = parentId;
        _parentError = null;
    }

    private async Task OnParentBlur()
    {
        if (Model.ParentExerciseTypeId is int parentId)
        {
            if (!_exerciseTypes.Any(exerciseType => exerciseType.Id == parentId))
            {
                // A parent that is not in the loaded page is valid data until the
                // catalog settles: asking for the full catalog here is what stops
                // the false "does not exist" on a real variation (t_81a400b3).
                try
                {
                    _exerciseTypes = (await AppState.GetFullExerciseTypesAsync()).ToList();
                }
                catch
                {
                    // The catalog really could not be read; the rule below still
                    // guards the write and the backend repeats it.
                }
            }

            var parent = _exerciseTypes.FirstOrDefault(et => et.Id == parentId);
            if (parent is null)
            {
                _parentError = "The selected parent exercise type does not exist.";
            }
            else if (parent.ParentExerciseTypeId is not null)
            {
                _parentError = "Variations can only belong to a main exercise type.";
            }
            else
            {
                _parentError = null;
            }
        }
        else
        {
            _parentError = null;
        }
    }

    private void OnPrimaryMusclesBlur()
    {
        ValidatePrimaryMusclesInline();
    }

    private void ValidatePrimaryMusclesInline()
    {
        _primaryMusclesError = _selectedPrimaryMuscleIds.Count == 0
            ? "Select at least one primary muscle."
            : null;
    }

    private async Task TriggerSubmit()
    {
        await form.Validate();

        // Surface per-field inline errors for the same rules the backend enforces.
        var nameOk = ValidateNameInline();
        await OnParentBlur();
        ValidatePrimaryMusclesInline();

        if (!success || !nameOk || _parentError is not null || _primaryMusclesError is not null || !OnSubmit.HasDelegate)
        {
            return;
        }

        Model.Tags = BuildTags();
        SyncAssignmentsToModel();
        await OnSubmit.InvokeAsync(Model);
    }

    private List<ExerciseTag> BuildTags()
    {
        var managedCategories = new HashSet<string>(["equipment", "mechanic", "type"], StringComparer.OrdinalIgnoreCase);
        var tags = (Model.Tags ?? [])
            .Where(tag => !managedCategories.Contains(tag.Category))
            .ToList();

        tags.AddRange(BuildTags("equipment", _selectedEquipmentTags));
        tags.AddRange(BuildTags("mechanic", _selectedMechanicTags));
        tags.AddRange(BuildTags("type", _selectedTypeTags));
        return tags;
    }

    private static IEnumerable<ExerciseTag> BuildTags(string category, IEnumerable<string> values)
        => values
            .OrderBy(value => value)
            .Select(value => new ExerciseTag
            {
                Category = category,
                Name = value
            });
}
