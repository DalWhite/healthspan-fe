@using System.Globalization

@*
    One logged exercise in the Today session (DESIGN.md §5.2): the log IS the
    interface — name, previous load, one row per logged set with its own
    reps/kg, and "+ serie" / "−".

    Each row is its own session exercise entry, so editing or removing a row
    only ever touches that row: no shared inputs, no overwrite. No edit link
    and no PR chip: the record lives in the history and in the end-of-session
    summary.
*@
<article class="hs-today-log">
    <header class="hs-today-log-head">
        <span class="hs-today-thumb @(ThumbUrl is null or "" ? "hs-today-thumb-empty" : null)" aria-hidden="true">
            @if (!string.IsNullOrEmpty(ThumbUrl))
            {
                <img src="@ThumbUrl" alt="" loading="lazy" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="MudBlazor.Size.Small" />
            }
        </span>
        <div class="hs-today-log-copy">
            <span class="hs-today-log-name">@DisplayName</span>
            <span class="hs-today-log-meta">Anterior: @(PreviousText ?? "—")</span>
        </div>
    </header>

    @if (AttemptsStyle)
    {
        <div class="hs-today-attempts">
            <div class="hs-today-attempt-row" role="group" aria-label="@($"Intentos de {DisplayName}")">
                <span class="hs-today-attempt-dots" role="img" aria-label="@($"{CompletedAttempts} de {Attempts} intentos")">
                    @foreach (var index in Enumerable.Range(1, Attempts))
                    {
                        <span class="hs-today-dot @(index <= CompletedAttempts ? "is-done" : null)"></span>
                    }
                </span>
                <span class="hs-today-attempt-count">@($"{CompletedAttempts}/{Attempts}")</span>
                <button type="button"
                        class="hs-chip hs-chip-accent hs-today-attempt-plus"
                        disabled="@(CompletedAttempts >= Attempts)"
                        aria-label="@($"Marcar un intento de {DisplayName} como completado")"
                        @onclick="CompleteAttempt">+</button>
                <button type="button"
                        class="hs-chip hs-today-attempt-minus"
                        disabled="@(CompletedAttempts <= 0)"
                        aria-label="@($"Deshacer un intento de {DisplayName}")"
                        @onclick="RemoveAttempt">−</button>
            </div>
        </div>
    }
    else
    {
        <table class="hs-settable" aria-label="@($"Series de {DisplayName}")">
            <thead>
                <tr>
                    <th scope="col">Serie</th>
                    <th scope="col">Repeticiones</th>
                    <th scope="col">Peso</th>
                    <th scope="col" aria-label="Quitar serie"></th>
                </tr>
            </thead>
            <tbody>
                @{ var rowIndex = 0; }
                @foreach (var entry in Entries)
                {
                    rowIndex++;
                    <tr class="hs-settable-row @(HasLoggedData(entry) ? "is-done" : null)">
                        <td class="hs-settable-index">
                            @rowIndex
                            @if ((entry.Series ?? 1) > 1)
                            {
                                <span class="hs-settable-sets">@($"×{entry.Series}")</span>
                            }
                        </td>
                        <td>
                            <input class="hs-settable-input"
                                   inputmode="numeric"
                                   aria-label="@($"Repeticiones de {DisplayName}, serie {rowIndex}")"
                                   value="@RepsText(entry.Id)"
                                   @oninput="@(value => SetReps(entry.Id, value))"
                                   @onblur="@(() => SaveEntryAsync(entry))" />
                        </td>
                        <td class="hs-settable-load">
                            <input class="hs-settable-input"
                                   inputmode="decimal"
                                   aria-label="@((IsBodyweightLoad(entry) ? "Kg añadidos" : "Kg") + $" de {DisplayName}, serie {rowIndex}")"
                                   value="@WeightText(entry.Id)"
                                   @oninput="@(value => SetWeight(entry.Id, value))"
                                   @onblur="@(() => SaveEntryAsync(entry))" />
                            @if (IsBodyweightLoad(entry))
                            {
                                <span class="hs-settable-unit">kg extra</span>
                            }
                        </td>
                        <td class="hs-settable-done">
                            <button type="button"
                                    class="hs-chip hs-settable-remove"
                                    aria-label="@($"Quitar la serie {rowIndex} de {DisplayName}")"
                                    @onclick="@(async () => await RemoveSetAsync(entry))">−</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="hs-settable-foot">
            <button type="button"
                    class="hs-chip hs-chip-accent hs-settable-add"
                    aria-label="@($"Añadir serie de {DisplayName}")"
                    @onclick="AddSetAsync">+ serie</button>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WorkoutSessionExerciseResource> Entries { get; set; } = default!;
    [Parameter] public string DisplayName { get; set; } = "Ejercicio";
    [Parameter] public string? ThumbUrl { get; set; }
    [Parameter] public string? PreviousText { get; set; }
    [Parameter] public EventCallback<WorkoutSessionExerciseResource> OnEntrySaved { get; set; }
    [Parameter] public EventCallback<WorkoutSessionExerciseResource> OnAddSet { get; set; }
    [Parameter] public EventCallback<WorkoutSessionExerciseResource> OnRemoveSet { get; set; }
    [Parameter] public EventCallback<WorkoutSessionExerciseResource> OnCompleteAttempt { get; set; }

    // Each row keeps its own draft text keyed by entry id: a row is a row, and
    // typing in one can never touch another.
    private readonly Dictionary<Guid, string> _reps = new();
    private readonly Dictionary<Guid, string> _weights = new();

    private int Attempts => Math.Max(1, Entries.FirstOrDefault()?.Attempts ?? 1);
    private int CompletedAttempts => Entries.Sum(entry => entry.CompletedAttempts ?? 0);
    private bool AttemptsStyle => Entries.Count == 1
        && Attempts > 1
        && (Entries[0].Series ?? 1) <= 1;

    protected override void OnParametersSet()
    {
        foreach (var entry in Entries)
        {
            if (_reps.ContainsKey(entry.Id))
            {
                continue;
            }

            if (!HasLoggedData(entry))
            {
                // A fresh series must read as an empty row, never as a fake "0 kg".
                _reps[entry.Id] = string.Empty;
                _weights[entry.Id] = string.Empty;
                continue;
            }

            _reps[entry.Id] = entry.Repetitions?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
            _weights[entry.Id] = (IsBodyweightLoad(entry) ? entry.AddedWeight : entry.Weight)
                ?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;
        }

        var stale = _reps.Keys.Where(id => !Entries.Any(entry => entry.Id == id)).ToList();
        foreach (var id in stale)
        {
            _reps.Remove(id);
            _weights.Remove(id);
        }
    }

    private static bool IsBodyweightLoad(WorkoutSessionExerciseResource entry)
        => TrainingIntent.ParseLoadType(entry.LoadType) == LoadType.Bodyweight
           || entry.BodyWeight.HasValue;

    private static bool HasLoggedData(WorkoutSessionExerciseResource entry)
        => entry.Repetitions.GetValueOrDefault() > 0
           || (IsBodyweightLoad(entry) ? entry.AddedWeight.GetValueOrDefault() : entry.Weight.GetValueOrDefault()) > 0;

    private string RepsText(Guid id) => _reps.GetValueOrDefault(id, string.Empty);
    private string WeightText(Guid id) => _weights.GetValueOrDefault(id, string.Empty);

    private void SetReps(Guid id, ChangeEventArgs args) => _reps[id] = args.Value?.ToString() ?? string.Empty;
    private void SetWeight(Guid id, ChangeEventArgs args) => _weights[id] = args.Value?.ToString() ?? string.Empty;

    private async Task SaveEntryAsync(WorkoutSessionExerciseResource entry)
    {
        var reps = ParseInt(_reps.GetValueOrDefault(entry.Id, string.Empty));
        var load = ParseDecimal(_weights.GetValueOrDefault(entry.Id, string.Empty));
        var bodyweight = IsBodyweightLoad(entry);

        var repsChanged = reps != entry.Repetitions;
        var loadChanged = bodyweight ? load != entry.AddedWeight : load != entry.Weight;
        if (!repsChanged && !loadChanged)
        {
            return;
        }

        entry.Repetitions = reps;
        if (bodyweight)
        {
            entry.AddedWeight = load;
        }
        else
        {
            entry.Weight = load ?? 0m;
        }

        await OnEntrySaved.InvokeAsync(entry);
    }

    private async Task AddSetAsync()
    {
        await OnAddSet.InvokeAsync(Entries.LastOrDefault());
    }

    private async Task RemoveSetAsync(WorkoutSessionExerciseResource entry)
    {
        await OnRemoveSet.InvokeAsync(entry);
    }

    private Task CompleteAttempt() => OnCompleteAttempt.InvokeAsync(Entries[0]);

    private Task RemoveAttempt()
    {
        var entry = Entries[0];
        entry.CompletedAttempts = Math.Max(0, entry.CompletedAttempts ?? 0) - 1;
        return OnEntrySaved.InvokeAsync(entry);
    }

    private static int? ParseInt(string raw)
    {
        var text = (raw ?? string.Empty).Trim().Replace(',', '.');
        if (text.Length == 0)
        {
            return null;
        }

        if (int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
        {
            return parsed;
        }

        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var decimalValue))
        {
            return (int)Math.Round(decimalValue, MidpointRounding.AwayFromZero);
        }

        return null;
    }

    private static decimal? ParseDecimal(string raw)
    {
        var text = (raw ?? string.Empty).Trim().Replace(',', '.');
        if (text.Length == 0)
        {
            return null;
        }

        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;
    }
}
