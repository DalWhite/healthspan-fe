<header class="@HeaderClass">
    <div class="hs-page-header-copy">
        <h1 class="hs-page-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.caption" Class="hs-muted-copy hs-page-subtitle">@Subtitle</MudText>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="hs-page-header-actions">
            @Actions
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private string HeaderClass
        => Actions is null
            ? "hs-page-header hs-page-header-title-only"
            : "hs-page-header hs-page-header-with-actions";
}
