<header class="@HeaderClass">
    <div class="hs-page-header-copy">
        <h1 class="hs-page-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.caption" Class="hs-muted-copy hs-page-subtitle">@Subtitle</MudText>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="hs-page-header-actions">
            @Actions
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    @* D6 (t_cae11b27): a Subtitle is substantive secondary copy (page identity +
       what to do next, e.g. 'Follow them in Training > Today'). The mobile rule that
       hides header copy to save vertical space turned the subtitle into a fake sr-only:
       1px overflow-hidden box + inherited white-space:nowrap, so the nowrap flex item
       sized to max-content (~482px) and escaped the clip at 390px (left 11 -> right 493).
       Pages that provide a Subtitle keep their header copy visible on mobile (the
       .hs-today-page precedent); only subtitle-less pages stay compact. *@
    private string HeaderClass
        => "hs-page-header "
            + (Actions is null ? "hs-page-header-title-only" : "hs-page-header-with-actions")
            + (string.IsNullOrWhiteSpace(Subtitle) ? "" : " hs-page-header-keeps-copy");
}
