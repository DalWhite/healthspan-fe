<header class="@HeaderClass">
    <div class="hs-page-header-copy">
        <h1 class="hs-page-title">@Title</h1>
    </div>

    @if (Actions is not null)
    {
        <div class="hs-page-header-actions">
            @Actions
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }

    private string HeaderClass
        => Actions is null
            ? "hs-page-header hs-page-header-title-only"
            : "hs-page-header hs-page-header-with-actions";
}
