@using MudBlazor

@if (Metrics != null)
{
    <MudPaper Elevation="3" Class="pa-4 ma-4">
        <MudText Typo="Typo.h5" GutterBottom="true">Exercise Metrics</MudText>
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" sm="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Max Repetition</MudText>
                        <MudText Typo="Typo.h4">@Metrics.MaxRepetition?.ToString("N1")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Volume</MudText>
                        <MudText Typo="Typo.h4">@Metrics.Volume?.ToString()</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Intensity</MudText>
                        <MudText Typo="Typo.h4">@Metrics.Intensity?.ToString("0")%</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter]
    public GetExerciseMetrics Metrics { get; set; }
}
