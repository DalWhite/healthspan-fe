@using MudBlazor

@if (WeightType != ExerciseWeightType.None)
{
<MudGrid Class="mt-4, justify-center" GutterSize="0">
    <MudItem xs="4">
        <MudTextField Label="RM"
                      Value="@MaxRepetitionDisplay"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      Adornment="Adornment.End"
                      FullWidth
                      class= "pr-0"/>
    </MudItem>
    <MudItem xs="4">
        <MudTextField Label="Volume"
                      Value="@VolumeDisplay"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      FullWidth />
    </MudItem>
    <MudItem xs="4">
        <MudTextField Label="Intensity"
                      Value="@IntensityDisplay"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      FullWidth />
    </MudItem>
</MudGrid>
}


@code {
    // Prepare display values for the text fields.
    private string MaxRepetitionDisplay
        => Metrics.MaxRepetition.HasValue
            ? $"{Metrics.MaxRepetition.Value:N1} kg"
            : "N/A";
    private string VolumeDisplay
        => Metrics.Volume.HasValue
            ? $"{Metrics.Volume.Value:N0} kg"
            : "N/A";
    private string IntensityDisplay
        => Metrics.Intensity.HasValue
            ? $"{Metrics.Intensity.Value:0}%"
            : "N/A";

    [Parameter, EditorRequired] public GetExerciseMetrics Metrics { get; set; } = new();
    [Parameter] public ExerciseWeightType? WeightType { get; set; }
}
