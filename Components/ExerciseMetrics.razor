@using MudBlazor

@if (Metrics != null)
{
<MudGrid Class="mt-4, justify-center" GutterSize="0">
    <MudItem xs="4">
        <MudTextField Label="RM"
                      Value="@MaxRepetitionDisplay"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      Adornment="Adornment.End"
                      FullWidth
                      class= "pr-0"/>
    </MudItem>
    <MudItem xs="4">
        <MudTextField Label="Volume"
                      Value="@VolumeDisplay"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      FullWidth />
    </MudItem>
    <MudItem xs="4">
        <MudTextField Label="Intensity"
                      Value="@IntensityDisplay"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      FullWidth />
    </MudItem>
</MudGrid>
}


@code {
    // Prepare display values for the text fields.
    private string MaxRepetitionDisplay => Metrics.MaxRepetition?.ToString("N1") + " Kg" ?? "N/A";
    private string VolumeDisplay => Metrics.Volume?.ToString() + " Kg" ?? "N/A";
    private string IntensityDisplay => Metrics.Intensity != null ? $"{Metrics.Intensity.Value.ToString("0")}%": "N/A";

    [Parameter]
    public GetExerciseMetrics Metrics { get; set; }
}
