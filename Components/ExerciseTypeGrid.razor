@inject HttpClient Http
@inject AppStateService AppState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

@if (_isLoading)
{
    <LoadingState Message="Loading exercises..." />
}
else
{
    <div class="hs-et-shell">
        @if (ShowSearch)
        {
            <section class="hs-et-toolbar">
                <MudTextField Value="_search"
                              ValueChanged="@((string value) => OnSearchChanged(value))"
                              Placeholder="Search exercises, variations, or tags..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="MudBlazor.Size.Medium"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Class="hs-et-search" />

                <div class="hs-et-toolbar-row">
                    <MudText Typo="Typo.body2" Class="hs-muted-copy hs-et-result-count">
                        @FormatResultCount(_visibleMainExercises.Count)
                    </MudText>

                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Tune"
                               OnClick="ToggleFilters"
                               aria-expanded="@_showFilters.ToString().ToLowerInvariant()"
                               aria-controls="exercise-library-filters"
                               Class="hs-et-filter-toggle">
                        <span>Filters</span>
                        @if (ActiveFilterCount > 0)
                        {
                            <span>&nbsp;(@ActiveFilterCount)</span>
                        }
                    </MudButton>
                </div>

                @if (_showFilters)
                {
                    <div id="exercise-library-filters" class="hs-et-filters">
                        <MudSelect T="string"
                                   Value="_selectedMuscleGroup"
                                   ValueChanged="OnMuscleGroupChanged"
                                   Label="Muscle group"
                                   Clearable="true"
                                   Dense="true"
                                   Variant="Variant.Outlined">
                            @foreach (var group in _muscleGroups)
                            {
                                <MudSelectItem T="string" Value="@group">@group</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Value="_selectedEquipment"
                                   ValueChanged="OnEquipmentChanged"
                                   Label="Equipment"
                                   Clearable="true"
                                   Dense="true"
                                   Variant="Variant.Outlined">
                            @foreach (var equipment in _equipmentOptions)
                            {
                                <MudSelectItem T="string" Value="@equipment">@equipment</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Value="_selectedMovement"
                                   ValueChanged="OnMovementChanged"
                                   Label="Movement"
                                   Clearable="true"
                                   Dense="true"
                                   Variant="Variant.Outlined">
                            @foreach (var movement in _movementOptions)
                            {
                                <MudSelectItem T="string" Value="@movement">@movement</MudSelectItem>
                            }
                        </MudSelect>

                        @if (!FavouritesOnly)
                        {
                            <MudSwitch T="bool"
                                       Value="_favouritesOnlyFilter"
                                       ValueChanged="OnFavouritesFilterChanged"
                                       Color="Color.Primary"
                                       Label="Favorites only"
                                       Class="hs-et-favourite-filter" />
                        }
                    </div>
                }

                @if (HasActiveFilters)
                {
                    <div class="hs-et-active-filters" aria-label="Active exercise filters">
                        @if (!string.IsNullOrWhiteSpace(_selectedMuscleGroup))
                        {
                            <MudChip Size="MudBlazor.Size.Small" OnClose="ClearMuscleGroup">@_selectedMuscleGroup</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(_selectedEquipment))
                        {
                            <MudChip Size="MudBlazor.Size.Small" OnClose="ClearEquipment">@_selectedEquipment</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(_selectedMovement))
                        {
                            <MudChip Size="MudBlazor.Size.Small" OnClose="ClearMovement">@_selectedMovement</MudChip>
                        }
                        @if (_favouritesOnlyFilter && !FavouritesOnly)
                        {
                            <MudChip Size="MudBlazor.Size.Small" OnClose="ClearFavouritesFilter">Favorites</MudChip>
                        }

                        <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small" OnClick="ClearFilters">
                            Clear
                        </MudButton>
                    </div>
                }
            </section>
        }

        @if (!_visibleMainExercises.Any())
        {
            <EmptyState Icon="@Icons.Material.Filled.FitnessCenter"
                        Title="@EmptyStateTitle"
                        Subtitle="@EmptyStateSubtitle"
                        ActionLabel="@EmptyStateActionLabel"
                        OnAction="HandleEmptyStateAction" />
        }
        else
        {
            <MudGrid Spacing="2" Class="hs-et-grid">
            @foreach (var exercise in _visibleMainExercises)
            {
                var variations = GetVariationsFor(exercise).ToList();
                var equipmentTags = GetTagNames(exercise, "equipment").ToList();
                var typeTags = GetTagNames(exercise, "type").ToList();

                <MudItem xs="12" sm="6" lg="4">
                    <MudCard Class="exercise-card hs-et-card"
                             role="link"
                             tabindex="0"
                             aria-label="@($"View {exercise.Name} stats")"
                             @onclick="() => OnCardClick(exercise)"
                             @onkeydown="args => OnCardKeyDown(args, exercise)">
                        <div class="hs-et-card-media">
                            <div class="hs-et-card-photo"
                                 role="img"
                                 aria-label="@exercise.Name"
                                 style="@GetImageStyle(exercise)"></div>

                            <div class="hs-et-media-overlay">
                                <div class="hs-et-media-top">
                                    <span class="hs-et-muscle-pill">@GetMuscleLine(exercise)</span>
                                </div>

                                @if (typeTags.Count > 0)
                                {
                                    <span class="hs-et-type-pill">@string.Join(" · ", typeTags.Take(2))</span>
                                }
                            </div>
                        </div>

                        <MudCardContent Class="hs-et-card-content">
                            <div class="hs-et-card-header">
                                <MudText Typo="Typo.h6" Class="hs-et-card-title">@exercise.Name</MudText>

                                @if (TraineeId is null)
                                {
                                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                        <MudIconButton Icon="@(exercise.IsFavourite ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                                       Color="@(exercise.IsFavourite ? Color.Error : Color.Default)"
                                                       Class="hs-favourite-btn"
                                                       aria-label="@(exercise.IsFavourite ? "Remove from favorites" : "Add to favorites")"
                                                       OnClick="@((e) => ToggleFavourite(e, exercise))" />
                                    </span>
                                }
                            </div>

                            @if (equipmentTags.Count > 0)
                            {
                                <div class="hs-card-tags">
                                    @foreach (var tag in equipmentTags.Take(3))
                                    {
                                        <MudChip Size="MudBlazor.Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Color="Color.Secondary">
                                            @tag
                                        </MudChip>
                                    }
                                </div>
                            }

                            @if (variations.Count > 0)
                            {
                                <div class="hs-et-variation-block">
                                    <MudText Typo="Typo.caption" Class="hs-muted-copy hs-et-section-label">
                                        @FormatVariationSummary(variations.Count)
                                    </MudText>

                                    <div class="hs-card-tags hs-et-variation-tags">
                                        @foreach (var variation in GetVisibleVariations(exercise, variations))
                                        {
                                            <span @onclick="@(args => OnVariationClick(args, variation))"
                                                  @onclick:stopPropagation="true">
                                                <MudChip Size="MudBlazor.Size.Small"
                                                         Variant="Variant.Filled"
                                                         Color="Color.Primary">
                                                    @variation.Name
                                                </MudChip>
                                            </span>
                                        }

                                        @if (variations.Count > 4)
                                        {
                                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                <MudButton Variant="Variant.Text"
                                                           Size="MudBlazor.Size.Small"
                                                           OnClick="@(() => ToggleVariations(exercise.Id))"
                                                           Class="hs-et-variation-toggle">
                                                    @(_expandedVariationGroups.Contains(exercise.Id) ? "Show less" : $"+{variations.Count - 4} more")
                                                </MudButton>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </MudCardContent>

                        <MudCardActions Class="hs-et-card-actions">
                            <span class="hs-et-action-slot" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.TrendingUp"
                                               Color="MudBlazor.Color.Primary"
                                               Size="MudBlazor.Size.Small"
                                               Variant="Variant.Filled"
                                               OnClick="@(() => OpenStats(exercise))"
                                               Title="View stats"
                                               aria-label="View stats"
                                               Class="hs-et-action-icon" />
                            </span>

                            @if (TraineeId is null)
                            {
                                <span class="hs-et-action-slot" title="Exercise options" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             Size="MudBlazor.Size.Small"
                                             Color="Color.Default"
                                             Variant="Variant.Text"
                                             Class="hs-et-card-menu">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                     OnClick="@(() => GoToEditExerciseType(exercise))">
                                            Edit exercise
                                        </MudMenuItem>
                                    </MudMenu>
                                </span>
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
            </MudGrid>
        }
    </div>
}

@code {
    [Parameter] public string? TraineeId { get; set; }
    [Parameter] public bool FavouritesOnly { get; set; }
    [Parameter] public bool TrainedOnly { get; set; }
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public EventCallback<GetExerciseTypeResource> OnCardClicked { get; set; }

    private GetExerciseTypeResource[] _all = Array.Empty<GetExerciseTypeResource>();
    private List<GetExerciseTypeResource> _visibleMainExercises = new();
    private IReadOnlyDictionary<int, Muscle> _musclesById = new Dictionary<int, Muscle>();
    private List<string> _muscleGroups = new();
    private List<string> _equipmentOptions = new();
    private List<string> _movementOptions = new();
    private HashSet<int> _expandedVariationGroups = new();
    private bool _isLoading = true;
    private bool _showFilters;
    private bool _favouritesOnlyFilter;
    private string _search = string.Empty;
    private string? _selectedMuscleGroup;
    private string? _selectedEquipment;
    private string? _selectedMovement;

    private int ActiveFilterCount
        => new[] { _selectedMuscleGroup, _selectedEquipment, _selectedMovement }.Count(value => !string.IsNullOrWhiteSpace(value))
           + (_favouritesOnlyFilter && !FavouritesOnly ? 1 : 0);

    private bool HasActiveFilters => ActiveFilterCount > 0;
    private bool HasQueryOrFilters => HasActiveFilters || !string.IsNullOrWhiteSpace(_search);
    private string EmptyStateTitle => HasQueryOrFilters ? "No matching exercises" : "No exercises yet";
    private string EmptyStateSubtitle => HasQueryOrFilters ? "Change or clear the current filters." : "Add your first exercise to the library.";
    private string EmptyStateActionLabel => HasQueryOrFilters ? "Clear filters" : "Add exercise";
    private bool ShouldPersistLibraryState
        => TraineeId is null && !FavouritesOnly;

    protected override async Task OnInitializedAsync()
    {
        RestoreLibraryState();
        await AppState.GetMusclesAsync();
        _musclesById = AppState.GetMuscleLookup();
        _muscleGroups = AppState.GetMuscleGroups();

        try
        {
            var userQuery = TraineeId is null ? string.Empty : $"?userId={TraineeId}";
            var endpoint = TrainedOnly ? "/ExerciseTypes/trained" : "/ExerciseTypes";
            _all = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>($"{endpoint}{userQuery}")
                ?? Array.Empty<GetExerciseTypeResource>();
        }
        catch
        {
            _all = Array.Empty<GetExerciseTypeResource>();
            Snackbar.Add("Couldn't load your exercises.", Severity.Error);
        }

        BuildFilterOptions();
        ApplyFilter();
        _isLoading = false;
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        ApplyFilter();
        PersistLibraryState();
    }

    private void BuildFilterOptions()
    {
        _equipmentOptions = GetDistinctTagOptions("equipment");
        _movementOptions = GetDistinctTagOptions("mechanic");
    }

    private List<string> GetDistinctTagOptions(string category)
        => _all
            .SelectMany(exercise => GetTagNames(exercise, category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value)
            .ToList();

    private void ApplyFilter()
    {
        var mainExercises = _all
            .Where(exercise => exercise.ParentExerciseTypeId is null)
            .Where(exercise => !(FavouritesOnly || _favouritesOnlyFilter) || ExerciseFamily(exercise).Any(item => item.IsFavourite))
            .Where(exercise => MatchesSearch(exercise, _search))
            .Where(exercise => MatchesTagFilter(exercise, "equipment", _selectedEquipment))
            .Where(exercise => MatchesTagFilter(exercise, "mechanic", _selectedMovement))
            .Where(MatchesMuscleGroupFilter)
            .OrderBy(exercise => exercise.Name)
            .ToList();

        _visibleMainExercises = mainExercises;
    }

    private IEnumerable<GetExerciseTypeResource> GetVariationsFor(GetExerciseTypeResource mainExercise)
        => _all
            .Where(exercise => exercise.ParentExerciseTypeId == mainExercise.Id)
            .OrderBy(exercise => exercise.Name);

    private IEnumerable<GetExerciseTypeResource> ExerciseFamily(GetExerciseTypeResource mainExercise)
        => new[] { mainExercise }.Concat(GetVariationsFor(mainExercise));

    private IEnumerable<GetExerciseTypeResource> GetVisibleVariations(
        GetExerciseTypeResource mainExercise,
        IReadOnlyCollection<GetExerciseTypeResource> variations)
        => _expandedVariationGroups.Contains(mainExercise.Id) ? variations : variations.Take(4);

    private void ToggleVariations(int mainExerciseId)
    {
        if (!_expandedVariationGroups.Add(mainExerciseId))
        {
            _expandedVariationGroups.Remove(mainExerciseId);
        }
    }

    private bool MatchesTagFilter(GetExerciseTypeResource mainExercise, string category, string? selectedValue)
        => string.IsNullOrWhiteSpace(selectedValue)
           || ExerciseFamily(mainExercise).Any(exercise => GetTagNames(exercise, category)
               .Contains(selectedValue, StringComparer.OrdinalIgnoreCase));

    private bool MatchesMuscleGroupFilter(GetExerciseTypeResource mainExercise)
        => string.IsNullOrWhiteSpace(_selectedMuscleGroup)
           || ExerciseFamily(mainExercise).Any(exercise => exercise.MuscleAssignments.Any(assignment =>
               _musclesById.TryGetValue(assignment.MuscleId, out var muscle)
               && string.Equals(muscle.MuscleGroup, _selectedMuscleGroup, StringComparison.OrdinalIgnoreCase)));

    private bool MatchesSearch(GetExerciseTypeResource mainExercise, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        if (AppStateService.MatchesSearch(mainExercise, query))
        {
            return true;
        }

        return GetVariationsFor(mainExercise).Any(variation => AppStateService.MatchesSearch(variation, query));
    }

    private static IEnumerable<string> GetTagNames(GetExerciseTypeResource exercise, string category)
        => (exercise.Tags ?? [])
            .Where(tag => string.Equals(tag.Category, category, StringComparison.OrdinalIgnoreCase))
            .Select(tag => tag.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private string GetImageUrl(GetExerciseTypeResource exercise)
        => !string.IsNullOrEmpty(exercise.ImageRoute)
            ? exercise.ImageRoute
            : $"ExerciseImages/{exercise.Name}.jpg";

    private string GetImageStyle(GetExerciseTypeResource exercise)
        => $"background-image: url('{GetImageUrl(exercise).Replace((char)39, '_')}'), url('icon-512.png');";

    private string GetMuscleLine(GetExerciseTypeResource exercise)
        => AppState.FormatExerciseTypeMuscleLine(exercise);

    private static string FormatVariationSummary(int variationCount)
        => variationCount == 1 ? "1 variation ready to track" : $"{variationCount} variations ready to track";

    private static string FormatResultCount(int count)
        => count == 1 ? "1 exercise" : $"{count} exercises";

    private async Task OnCardKeyDown(KeyboardEventArgs args, GetExerciseTypeResource exercise)
    {
        if (args.Key is "Enter" or " ")
        {
            await OnCardClick(exercise);
        }
    }

    private async Task OnCardClick(GetExerciseTypeResource exercise)
    {
        if (OnCardClicked.HasDelegate)
        {
            await OnCardClicked.InvokeAsync(exercise);
            return;
        }

        OpenStats(exercise);
    }

    private Task OnVariationClick(MouseEventArgs _, GetExerciseTypeResource variation)
    {
        OpenStats(variation);
        return Task.CompletedTask;
    }

    private void OpenStats(GetExerciseTypeResource exercise)
        => NavigationManager.NavigateTo(GetStatsRoute(exercise));

    private void GoToEditExerciseType(GetExerciseTypeResource exercise)
        => NavigationManager.NavigateTo(
            $"/training/library/{exercise.Id}/edit?returnUrl={Uri.EscapeDataString(GetCurrentRelativeUrl())}");

    private string GetStatsRoute(GetExerciseTypeResource exercise)
    {
        var baseRoute = TraineeId != null
            ? $"/exercises/types/{exercise.Id}/details/{TraineeId}"
            : $"/training/library/{exercise.Id}";
        var currentRoute = GetCurrentRelativeUrl();
        return $"{baseRoute}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private async Task ToggleFavourite(MouseEventArgs _, GetExerciseTypeResource exercise)
    {
        try
        {
            var isFavourite = !exercise.IsFavourite;
            var response = await Http.PutAsJsonAsync(
                $"/ExerciseTypes/{exercise.Id}/favourite",
                new SetExerciseTypeFavouriteResource { IsFavourite = isFavourite });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to update favourite.", Severity.Error);
                return;
            }

            exercise.IsFavourite = isFavourite;
            AppState.InvalidateExerciseTypes();
            ApplyFilter();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleFilters()
    {
        _showFilters = !_showFilters;
        PersistLibraryState();
    }

    private void OnMuscleGroupChanged(string? value)
    {
        _selectedMuscleGroup = value;
        ApplyFilter();
        PersistLibraryState();
    }

    private void OnEquipmentChanged(string? value)
    {
        _selectedEquipment = value;
        ApplyFilter();
        PersistLibraryState();
    }

    private void OnMovementChanged(string? value)
    {
        _selectedMovement = value;
        ApplyFilter();
        PersistLibraryState();
    }

    private void OnFavouritesFilterChanged(bool value)
    {
        _favouritesOnlyFilter = value;
        ApplyFilter();
        PersistLibraryState();
    }

    private void ClearMuscleGroup() => OnMuscleGroupChanged(null);
    private void ClearEquipment() => OnEquipmentChanged(null);
    private void ClearMovement() => OnMovementChanged(null);
    private void ClearFavouritesFilter() => OnFavouritesFilterChanged(false);

    private void ClearFilters()
    {
        _selectedMuscleGroup = null;
        _selectedEquipment = null;
        _selectedMovement = null;
        _favouritesOnlyFilter = false;
        ApplyFilter();
        PersistLibraryState();
    }

    private void HandleEmptyStateAction()
    {
        if (HasQueryOrFilters)
        {
            _search = string.Empty;
            ClearFilters();
            return;
        }

        GoToCreateExerciseType();
    }

    private void GoToCreateExerciseType()
        => NavigationManager.NavigateTo("/training/library/create");

    private void RestoreLibraryState()
    {
        if (!ShouldPersistLibraryState)
        {
            return;
        }

        var state = AppState.ExerciseLibraryView;
        _search = state.Search;
        _selectedMuscleGroup = state.MuscleGroup;
        _selectedEquipment = state.Equipment;
        _selectedMovement = state.Movement;
        _favouritesOnlyFilter = state.FavouritesOnly;
        _showFilters = state.FiltersExpanded;
    }

    private void PersistLibraryState()
    {
        if (!ShouldPersistLibraryState)
        {
            return;
        }

        var state = AppState.ExerciseLibraryView;
        state.Search = _search;
        state.MuscleGroup = _selectedMuscleGroup;
        state.Equipment = _selectedEquipment;
        state.Movement = _selectedMovement;
        state.FavouritesOnly = _favouritesOnlyFilter;
        state.FiltersExpanded = _showFilters;
    }

    private string GetCurrentRelativeUrl()
    {
        var relative = NavigationManager.ToBaseRelativePath(
            NavigationManager.Uri);
        return $"/{relative.TrimStart('/')}";
    }
}
