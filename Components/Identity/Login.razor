@layout LoginLayout
@page "/login"
@using Healthspan.Authentication
@using Microsoft.JSInterop
@inject IAccountManagement Acct
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

@using MudBlazor
@implements IAsyncDisposable

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-left">

        <div class="tagline-container">
            <div style=" top:30vh; left:0; right:0; text-align:center">
                <div id="slowLoadingAnimation"
                     style="width:130px; height:130px; margin:auto;">
                    <img src="icon-512.png"
                         alt="Loading"
                         style="width:100%; height:100%;">
                </div>
            </div>
            <h2 class="headline">Enhance Your Health Journey</h2>
            <ul class="features-list">
                <li>Track and improve your health with expert insights</li>
                <li>Connect with certified professionals in real-time</li>
                <li>Access personalized health and wellness plans</li>
                <li>Join a community focused on well-being and vitality</li>
            </ul>
        </div>
    </div>

    <div class="login-right">
        <MudContainer MaxWidth="MaxWidth.Small"
                      Class="login-container">
            <MudPaper Class="@LoginCardClass" Elevation="0">

                @* D2 (docs/design/unauth-redirect-state.md): when a returnUrl
                   survives from a protected route, the login is no longer
                   anonymous — it names the destination and puts Google first.
                   Without returnUrl the generic login is untouched. *@
                @if (Contextual)
                {
                    <div class="hs-chip-protected">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        <span>Vista protegida · @ProtectedViews.DestinationChipName(ReturnUrl)</span>
                    </div>

                    @* D5: arrived because the session expired, not a cold link. *@
                    @if (ExpiredFlag)
                    {
                        <MudAlert Severity="Severity.Info"
                                  Class="hs-login-expired">
                            Tu sesión caducó. Inicia sesión para continuar donde lo dejaste.
                        </MudAlert>
                    }

                    <h1 class="hs-page-title hs-login-title">Continúa donde lo dejaste</h1>
                    <MudText Typo="Typo.body2" Class="hs-login-value">
                        Tu plan, tus sesiones y tus métricas son privados: solo tú los ves.
                        Al entrar vuelves directamente a @ProtectedViews.DestinationName(ReturnUrl).
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               StartIcon="@Icons.Custom.Brands.Google"
                               Disabled="@(!GoogleButtonEnabled)"
                               Loading="@googleBusy"
                               OnClick="StartGoogleLoginAsync"
                               FullWidth="true"
                               Class="hs-google-primary mt-4">
                        Continuar con Google
                    </MudButton>

                    <div class="hs-divider">o con tu email</div>
                }
                else
                {
                    <h1 class="hs-page-title hs-login-title">Sign in</h1>
                }

                @* Form-level problems (Google init, failed sign-in). Field-level
                   problems live inline under their own field. *@
                @if (errors && errorList.Length > 0)
                {
                    <div class="hs-login-formerror" role="alert">
                        @foreach (var error in errorList)
                        {
                            <div class="hs-login-formerror-item">@error</div>
                        }
                    </div>
                }

                <MudForm @ref="_form">
                    @* On sign-in only the email is format-checked (it catches a
                       typo before a round-trip). The password is required but
                       never judged here: judging it on sign-in blames a user
                       whose password is simply wrong, and the server already
                       knows. *@
                    <MudTextField @bind-Value="email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Enter your email to sign in."
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  FullWidth="true"
                                  Class="input-field text-field outlined" />

                    <MudTextField @bind-Value="password"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="@PasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@PasswordInputIcon"
                                  OnAdornmentClick="ButtonTestclick"
                                  Required="true"
                                  RequiredError="Enter your password to sign in."
                                  FullWidth="true"
                                  Class="input-field text-field outlined" />


                    @if (!Contextual)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="MudBlazor.Color.Primary"
                                   OnClick="DoLoginAsync"
                                   FullWidth="true"
                                   Class="mb-3 rounded-button">Log In</MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="MudBlazor.Color.Secondary"
                                   StartIcon="@Icons.Custom.Brands.Google"
                                   Disabled="@(!GoogleButtonEnabled)"
                                   Loading="@googleBusy"
                                   OnClick="StartGoogleLoginAsync"
                                   FullWidth="true"
                                   Class="google-button rounded-button">
                            Continue with Google
                        </MudButton>
                    }

                    @* D2: login-first — in the contextual flow the email form
                       is the "o con tu email" alternative below the Google CTA. *@
                    @if (Contextual)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="MudBlazor.Color.Primary"
                                   OnClick="DoLoginAsync"
                                   FullWidth="true"
                                   Class="mt-3 rounded-button">Entrar con email</MudButton>
                    }

                    <MudText Typo="Typo.body2"
                             Align="Align.Center"
                             Class="mt-3">
                        @if (Contextual)
                        {
                            @* D3: the returnUrl survives the whole funnel —
                               Strava pattern: sign-in or create-account on the
                               same screen (spec §7). *@
                            <span>¿No tienes cuenta?</span> <MudButton Variant="Variant.Text"
                                               Color="MudBlazor.Color.Primary"
                                               OnClick="NavigateToRegister">Crear cuenta gratis</MudButton>
                        }
                        else
                        {
                            <span>New here?</span> <MudButton Variant="Variant.Text"
                                       Color="MudBlazor.Color.Primary"
                                       OnClick="NavigateToRegister">Create an account</MudButton>
                        }
                    </MudText>
                </MudForm>
            </MudPaper>
        </MudContainer>
    </div>
</div>

@code {
    private bool success, errors;
    private string email = string.Empty;
    private string password = string.Empty;
    private string[] errorList = [];
    private bool isShow;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private DotNetObjectReference<Login>? dotNetRef;
    private bool googleInitialized;
    private bool googleBusy;
    private string? googleClientId;
    private MudForm _form = null!;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "expired")]
    public string? Expired { get; set; }

    // D2: contextual mode is driven by a surviving safe returnUrl; D5 by the
    // expired flag RedirectToLogin appends when a session's token died.
    public bool Contextual => ProtectedViews.IsSafeReturnUrl(ReturnUrl);
    public bool ExpiredFlag => Expired == "1";

    // Kept as a computed string: Razor component attributes reject a ternary
    // with quoted literals inline (RZ9986).
    private string LoginCardClass => Contextual
        ? "login-form hs-login-card rounded-container hs-login-contextual"
        : "login-form hs-login-card rounded-container";

    private bool GoogleButtonEnabled => googleInitialized && !googleBusy;

    // NN/g: field errors appear after the user leaves the field, next to the
    // field, in plain language that names the fix — never while typing, never
    // blaming, and the typed value is always preserved.
    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Enter your email to sign in.";
        }

        if (!EmailPattern.IsMatch(value.Trim()))
        {
            return "Use an email address like name@example.com.";
        }

        return null;
    }

    private static readonly System.Text.RegularExpressions.Regex EmailPattern =
        new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    void ButtonTestclick()
    {
        isShow = !isShow;
        PasswordInputIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        googleClientId = Configuration["GoogleClientId"];

        if (string.IsNullOrWhiteSpace(googleClientId))
        {
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.initialize", dotNetRef, googleClientId);
            googleInitialized = true;
            StateHasChanged();
        }
        catch (JSException)
        {
            errors = true;
            errorList = ["Google Sign-In could not be initialized. Please refresh and try again."];
            StateHasChanged();
        }
    }

    public async Task DoLoginAsync()
    {
        success = errors = false;
        errorList = Array.Empty<string>();

        // Field errors are inline under each field; the form only blocks the
        // call when something is actually wrong with what was typed.
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        var result = await Acct.LoginAsync(email, password);

        if (result.Succeeded)
        {
            NavigateAfterLogin();
            return;
        }

        errors = true;
        errorList = result.ErrorList.Select(DescribeSignInError).Distinct().ToArray();
    }

    // The server returns generic Identity wording. Restate the problem in plain
    // language with the fix, without blaming the user; typed values stay put.
    private static string DescribeSignInError(string serverError)
    {
        if (string.IsNullOrWhiteSpace(serverError))
        {
            return "We couldn't sign you in. Check your email and password and try again.";
        }

        if (serverError.Contains("locked", StringComparison.OrdinalIgnoreCase))
        {
            return "Too many attempts. Wait a few minutes and try again.";
        }

        if (serverError.Contains("password", StringComparison.OrdinalIgnoreCase) ||
            serverError.Contains("login attempt", StringComparison.OrdinalIgnoreCase))
        {
            return "We couldn't match that email and password. Check them and try again.";
        }

        return serverError;
    }

    private async Task StartGoogleLoginAsync()
    {
        if (!GoogleButtonEnabled)
        {
            return;
        }

        errors = false;
        errorList = Array.Empty<string>();
        googleBusy = true;
        StateHasChanged();

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.prompt");
        }
        catch (JSException)
        {
            googleBusy = false;
            errors = true;
            errorList = ["Unable to start Google Sign-In. Please try again later."];
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleGoogleCredentialAsync(string credential)
    {
        googleBusy = false;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(credential))
        {
            errors = true;
            errorList = ["Google did not return a credential. Please try again."];
            StateHasChanged();
            return;
        }

        var result = await Acct.LoginWithGoogleAsync(credential);

        if (result.Succeeded)
        {
            NavigateAfterLogin();
        }
        else
        {
            errors = true;
            errorList = result.ErrorList.ToArray();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task HandleGooglePromptStatusAsync(string reason)
    {
        googleBusy = false;

        if (!string.IsNullOrWhiteSpace(reason) &&
            reason.StartsWith("not_displayed", System.StringComparison.OrdinalIgnoreCase))
        {
            errors = true;
            errorList = ["Google Sign-In was blocked by the browser. Please allow pop-ups and try again."];
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void NavigateToRegister()
    {
        // D3: the destination survives the whole funnel — a new user who
        // arrives through a shared link must be able to come back to it.
        Navigation.NavigateTo(Contextual
            ? $"/register?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
            : "/register");
    }

    private void NavigateAfterLogin()
        => Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);

    // Single validation contract shared with RedirectToLogin/Register
    // (ProtectedViews): internal path only, fallback /training/today.
    private string GetSafeReturnUrl() => ProtectedViews.SafeReturnUrl(ReturnUrl);

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.dispose");
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}
