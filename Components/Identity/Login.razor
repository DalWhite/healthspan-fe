@layout LoginLayout
@page "/login"
@using Healthspan.Authentication
@using Microsoft.JSInterop
@inject IAccountManagement Acct
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

@using MudBlazor
@implements IAsyncDisposable

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-left">

        <div class="tagline-container">
            <div style=" top:30vh; left:0; right:0; text-align:center">
                <div id="slowLoadingAnimation"
                     style="width:130px; height:130px; margin:auto;">
                    <img src="icon-512.png"
                         alt="Loading"
                         style="width:100%; height:100%;">
                </div>
            </div>
            <h1 class="headline">Enhance Your Health Journey</h1>
            <ul class="features-list">
                <li>Track and improve your health with expert insights</li>
                <li>Connect with certified professionals in real-time</li>
                <li>Access personalized health and wellness plans</li>
                <li>Join a community focused on well-being and vitality</li>
            </ul>
        </div>
    </div>

    <div class="login-right">
        <MudContainer MaxWidth="MaxWidth.Small"
                      Class="login-container">
            <MudPaper Class="login-form rounded-container"
                      Elevation="4"
                      Style="padding: 2rem;">

                @if (errors)
                {
                    @foreach (var error in errorList)
                    {
                        <MudAlert Severity="Severity.Error"
                                  Variant="Variant.Filled">@error</MudAlert>
                    }
                }

                <MudForm>
                    <MudTextField Placeholder="Enter your email"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  @bind-Value="email"
                                  FullWidth="true"
                                  RequiredError="Email is required"
                                  Class="input-field text-field outlined" />

                    <MudTextField Placeholder="Enter your password"
                                  Variant="Variant.Outlined"
                                  InputType="@PasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@PasswordInputIcon"
                                  @bind-Value="password"
                                  FullWidth="true"
                                  OnAdornmentClick="ButtonTestclick"
                                  RequiredError="Password is required"
                                  Class="input-field text-field outlined" />


                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               OnClick="DoLoginAsync"
                               FullWidth="true"
                               Class="mb-3 rounded-button">Log In</MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="MudBlazor.Color.Secondary"
                               StartIcon="@Icons.Custom.Brands.Google"
                               Disabled="@(!GoogleButtonEnabled)"
                               Loading="@googleBusy"
                               OnClick="StartGoogleLoginAsync"
                               FullWidth="true"
                               Class="google-button rounded-button">
                        Continue with Google
                    </MudButton>

                    <MudText Typo="Typo.body2"
                             Align="Align.Center"
                             Class="mt-3">
                        New here? <MudButton Variant="Variant.Text"
                                   Color="MudBlazor.Color.Primary"
                                   OnClick="NavigateToRegister">Create an account</MudButton>
                    </MudText>
                </MudForm>
            </MudPaper>
        </MudContainer>
    </div>
</div>

@code {
    private bool success, errors;
    private string email = string.Empty;
    private string password = string.Empty;
    private string[] errorList = [];
    private bool isShow;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private DotNetObjectReference<Login>? dotNetRef;
    private bool googleInitialized;
    private bool googleBusy;
    private string? googleClientId;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool GoogleButtonEnabled => googleInitialized && !googleBusy;

    void ButtonTestclick()
    {
        isShow = !isShow;
        PasswordInputIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        googleClientId = Configuration["GoogleClientId"];

        if (string.IsNullOrWhiteSpace(googleClientId))
        {
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.initialize", dotNetRef, googleClientId);
            googleInitialized = true;
            StateHasChanged();
        }
        catch (JSException)
        {
            errors = true;
            errorList = ["Google Sign-In could not be initialized. Please refresh and try again."];
            StateHasChanged();
        }
    }

    public async Task DoLoginAsync()
    {
        success = errors = false;
        errorList = Array.Empty<string>();

        if (string.IsNullOrWhiteSpace(email))
        {
            errors = true;
            errorList = new[] { "Email is required." };
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errors = true;
            errorList = new[] { "Password is required." };
            return;
        }

        var result = await Acct.LoginAsync(email, password);

        if (result.Succeeded)
        {
            NavigateAfterLogin();
        }
        else
        {
            errors = true;
            errorList = result.ErrorList.ToArray();
        }
    }

    private async Task StartGoogleLoginAsync()
    {
        if (!GoogleButtonEnabled)
        {
            return;
        }

        errors = false;
        errorList = Array.Empty<string>();
        googleBusy = true;
        StateHasChanged();

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.prompt");
        }
        catch (JSException)
        {
            googleBusy = false;
            errors = true;
            errorList = ["Unable to start Google Sign-In. Please try again later."];
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleGoogleCredentialAsync(string credential)
    {
        googleBusy = false;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(credential))
        {
            errors = true;
            errorList = ["Google did not return a credential. Please try again."];
            StateHasChanged();
            return;
        }

        var result = await Acct.LoginWithGoogleAsync(credential);

        if (result.Succeeded)
        {
            NavigateAfterLogin();
        }
        else
        {
            errors = true;
            errorList = result.ErrorList.ToArray();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task HandleGooglePromptStatusAsync(string reason)
    {
        googleBusy = false;

        if (!string.IsNullOrWhiteSpace(reason) &&
            reason.StartsWith("not_displayed", System.StringComparison.OrdinalIgnoreCase))
        {
            errors = true;
            errorList = ["Google Sign-In was blocked by the browser. Please allow pop-ups and try again."];
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void NavigateToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    private void NavigateAfterLogin()
        => Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);

    private string GetSafeReturnUrl()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) &&
            ReturnUrl.StartsWith('/') &&
            !ReturnUrl.StartsWith("//", StringComparison.Ordinal) &&
            !ReturnUrl.StartsWith("/\\", StringComparison.Ordinal))
        {
            return ReturnUrl;
        }

        return "/health/dashboard";
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.dispose");
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}
