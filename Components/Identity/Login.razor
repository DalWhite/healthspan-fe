@layout LoginLayout

@page "/login"
@using Healthspan.Authentication
@inject IAccountManagement Acct
@inject NavigationManager Navigation

@using MudBlazor

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <div style=" top:30vh; left:0; right:0; text-align:center">
        <div id="slowLoadingAnimation" style="width:100px; height:100px; margin:auto;">
            <img src="icon-512.png" alt="Loading" style="width:100%; height:100%;">
        </div>
    </div>  
    <AuthorizeView>
        <Authorized>
            <MudAlert Severity="Severity.Success">You're logged in as @context.User.Identity?.Name.</MudAlert>
        </Authorized>
        <NotAuthorized>
            @if (errors)
            {
                @foreach (var error in errorList)
                {
                    <MudAlert Severity="Severity.Error">@error</MudAlert>
                }
            }

            <MudForm>
                <MudTextField Label="Email" Required="true" Placeholder="Enter your email address"
                    Variant="Variant.Outlined" @bind-Value="email" />
                <MudTextField Label="Password" Required="true" Placeholder="Enter your password"
                    Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End"
                    AdornmentIcon="@PasswordInputIcon" @bind-Value="password" Class="mt-2"
                    OnAdornmentClick="ButtonTestclick" />
                <div style="display: flex; justify-content: flex-end;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DoLoginAsync">Login</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("register"))" Class="ml-2">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Style="vertical-align: middle;" /> Register
                    </MudButton>
                </div>
            </MudForm>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    private bool success, errors;
    private string email = string.Empty;
    private string password = string.Empty;
    private string[] errorList = [];
    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ButtonTestclick()
    {
        isShow = !isShow;
        PasswordInputIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
    }

    public async Task DoLoginAsync()
    {
        success = errors = false;
        errorList = Array.Empty<string>();

        if (string.IsNullOrWhiteSpace(email))
        {
            errors = true;
            errorList = new[] { "Email is required." };
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errors = true;
            errorList = new[] { "Password is required." };
            return;
        }

        var result = await Acct.LoginAsync(email, password);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            errors = true;
            errorList = result.ErrorList.ToArray();
        }
    }
}
