@layout LoginLayout
@page "/login"
@using Healthspan.Authentication
@using Microsoft.JSInterop
@inject IAccountManagement Acct
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

@using MudBlazor
@implements IAsyncDisposable

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-page">
    <div class="login-left">

        <div class="tagline-container">
            <div style=" top:30vh; left:0; right:0; text-align:center">
                <div id="slowLoadingAnimation"
                     style="width:130px; height:130px; margin:auto;">
                    <img src="icon-512.png"
                         alt="Cargando"
                         style="width:100%; height:100%;">
                </div>
            </div>
            <h2 class="headline">Potencia tu camino hacia la salud</h2>
            <ul class="features-list">
                <li>Registra y mejora tu salud con análisis de expertos</li>
                <li>Conecta con profesionales certificados en tiempo real</li>
                <li>Accede a planes de salud y bienestar personalizados</li>
                <li>Únete a una comunidad centrada en el bienestar y la vitalidad</li>
            </ul>
        </div>
    </div>

    <div class="login-right">
        <MudContainer MaxWidth="MaxWidth.Small"
                      Class="login-container">
            <MudPaper Class="login-form hs-login-card rounded-container"
                      Elevation="0">

                <h1 class="hs-page-title hs-login-title">Iniciar sesión</h1>

                @* Form-level problems (Google init, failed sign-in). Field-level
                   problems live inline under their own field. *@
                @if (errors && errorList.Length > 0)
                {
                    <div class="hs-login-formerror" role="alert">
                        @foreach (var error in errorList)
                        {
                            <div class="hs-login-formerror-item">@error</div>
                        }
                    </div>
                }

                <MudForm @ref="_form">
                    @* On sign-in only the email is format-checked (it catches a
                       typo before a round-trip). The password is required but
                       never judged here: judging it on sign-in blames a user
                       whose password is simply wrong, and the server already
                       knows. *@
                    <MudTextField @bind-Value="email"
                                  Label="Correo electrónico"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Introduce tu correo para iniciar sesión."
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  FullWidth="true"
                                  Class="input-field text-field outlined" />

                    <MudTextField @bind-Value="password"
                                  Label="Contraseña"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="@PasswordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@PasswordInputIcon"
                                  OnAdornmentClick="ButtonTestclick"
                                  Required="true"
                                  RequiredError="Introduce tu contraseña para iniciar sesión."
                                  FullWidth="true"
                                  Class="input-field text-field outlined" />


                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               OnClick="DoLoginAsync"
                               FullWidth="true"
                               Class="mb-3 rounded-button">Iniciar sesión</MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="MudBlazor.Color.Secondary"
                               StartIcon="@Icons.Custom.Brands.Google"
                               Disabled="@(!GoogleButtonEnabled)"
                               Loading="@googleBusy"
                               OnClick="StartGoogleLoginAsync"
                               FullWidth="true"
                               Class="google-button rounded-button">
                        Continuar con Google
                    </MudButton>

                    <MudText Typo="Typo.body2"
                             Align="Align.Center"
                             Class="mt-3">
                        ¿Nuevo aquí? <MudButton Variant="Variant.Text"
                                   Color="MudBlazor.Color.Primary"
                                   OnClick="NavigateToRegister">Crea una cuenta</MudButton>
                    </MudText>
                </MudForm>
            </MudPaper>
        </MudContainer>
    </div>
</div>

@code {
    private bool success, errors;
    private string email = string.Empty;
    private string password = string.Empty;
    private string[] errorList = [];
    private bool isShow;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private DotNetObjectReference<Login>? dotNetRef;
    private bool googleInitialized;
    private bool googleBusy;
    private string? googleClientId;
    private MudForm _form = null!;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool GoogleButtonEnabled => googleInitialized && !googleBusy;

    // NN/g: field errors appear after the user leaves the field, next to the
    // field, in plain language that names the fix — never while typing, never
    // blaming, and the typed value is always preserved.
    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Introduce tu correo para iniciar sesión.";
        }

        if (!EmailPattern.IsMatch(value.Trim()))
        {
            return "Usa un correo electrónico como nombre@ejemplo.com.";
        }

        return null;
    }

    private static readonly System.Text.RegularExpressions.Regex EmailPattern =
        new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    void ButtonTestclick()
    {
        isShow = !isShow;
        PasswordInputIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        googleClientId = Configuration["GoogleClientId"];

        if (string.IsNullOrWhiteSpace(googleClientId))
        {
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.initialize", dotNetRef, googleClientId);
            googleInitialized = true;
            StateHasChanged();
        }
        catch (JSException)
        {
            errors = true;
            errorList = ["No se pudo iniciar la autenticación con Google. Actualiza la página y vuelve a intentarlo."];
            StateHasChanged();
        }
    }

    public async Task DoLoginAsync()
    {
        success = errors = false;
        errorList = Array.Empty<string>();

        // Field errors are inline under each field; the form only blocks the
        // call when something is actually wrong with what was typed.
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        var result = await Acct.LoginAsync(email, password);

        if (result.Succeeded)
        {
            NavigateAfterLogin();
            return;
        }

        errors = true;
        errorList = result.ErrorList.Select(DescribeSignInError).Distinct().ToArray();
    }

    // The server returns generic Identity wording. Restate the problem in plain
    // language with the fix, without blaming the user; typed values stay put.
    private static string DescribeSignInError(string serverError)
    {
        if (string.IsNullOrWhiteSpace(serverError))
        {
            return "No pudimos iniciar tu sesión. Revisa tu correo y tu contraseña e inténtalo de nuevo.";
        }

        if (serverError.Contains("locked", StringComparison.OrdinalIgnoreCase))
        {
            return "Demasiados intentos. Espera unos minutos e inténtalo de nuevo.";
        }

        if (serverError.Contains("password", StringComparison.OrdinalIgnoreCase) ||
            serverError.Contains("login attempt", StringComparison.OrdinalIgnoreCase))
        {
            return "Ese correo y contraseña no coinciden. Revísalos e inténtalo de nuevo.";
        }

        return serverError;
    }

    private async Task StartGoogleLoginAsync()
    {
        if (!GoogleButtonEnabled)
        {
            return;
        }

        errors = false;
        errorList = Array.Empty<string>();
        googleBusy = true;
        StateHasChanged();

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.prompt");
        }
        catch (JSException)
        {
            googleBusy = false;
            errors = true;
            errorList = ["No se pudo iniciar el acceso con Google. Inténtalo de nuevo más tarde."];
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleGoogleCredentialAsync(string credential)
    {
        googleBusy = false;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(credential))
        {
            errors = true;
            errorList = ["Google no devolvió una credencial. Inténtalo de nuevo."];
            StateHasChanged();
            return;
        }

        var result = await Acct.LoginWithGoogleAsync(credential);

        if (result.Succeeded)
        {
            NavigateAfterLogin();
        }
        else
        {
            errors = true;
            errorList = result.ErrorList.ToArray();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task HandleGooglePromptStatusAsync(string reason)
    {
        googleBusy = false;

        if (!string.IsNullOrWhiteSpace(reason) &&
            reason.StartsWith("not_displayed", System.StringComparison.OrdinalIgnoreCase))
        {
            errors = true;
            errorList = ["El navegador bloqueó el acceso con Google. Permite las ventanas emergentes e inténtalo de nuevo."];
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void NavigateToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    private void NavigateAfterLogin()
        => Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);

    private string GetSafeReturnUrl()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) &&
            ReturnUrl.StartsWith('/') &&
            !ReturnUrl.StartsWith("//", StringComparison.Ordinal) &&
            !ReturnUrl.StartsWith("/\\", StringComparison.Ordinal))
        {
            return ReturnUrl;
        }

        return "/training/today";
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();

        try
        {
            await JSRuntime.InvokeVoidAsync("healthspanAuth.dispose");
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}
