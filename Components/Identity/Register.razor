@layout LoginLayout

@page "/register"
@using Healthspan.Authentication
@inject IAccountManagement Acct
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <h1 class="hs-page-title">Register</h1>

    <AuthorizeView>
        <Authorized>
            <MudAlert Severity="Severity.Success">You're already logged in as @context.User.Identity?.Name.</MudAlert>
        </Authorized>
        <NotAuthorized>
            @if (success)
            {
                @* D3 (docs/design/unauth-redirect-state.md): registering from a
                   shared deep link must pay the user back with the destination
                   they came for — in ≤2 taps. No auto-login: the identity
                   backend doesn't guarantee it today. *@
                @if (ProtectedViews.IsSafeReturnUrl(ReturnUrl))
                {
                    <MudAlert Severity="Severity.Success">
                        <div class="hs-register-success">
                            <div>Cuenta creada. Inicia sesión para volver a @ProtectedViews.DestinationName(ReturnUrl).</div>
                            <MudButton Variant="Variant.Filled"
                                       Color="MudBlazor.Color.Primary"
                                       FullWidth="true"
                                       Class="mt-3"
                                       OnClick="GoToLoginWithReturnUrl">Iniciar sesión y volver</MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="MudBlazor.Color.Primary"
                                       FullWidth="true"
                                       OnClick="GoToToday">Ir a mis entrenamientos</MudButton>
                        </div>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success">
                        You successfully registered. Now you can <MudLink Href="login">login</MudLink>.
                    </MudAlert>
                }
            }
            else
            {
                if (errors)
                {
                    foreach (var error in errorList)
                    {
                        <MudAlert Severity="Severity.Error">@error</MudAlert>
                    }
                }
                <MudForm>
                    <MudTextField Label="Email" Required="true" Placeholder="Enter your email address"
                        Variant="Variant.Outlined" @bind-Value="email" InputType="InputType.Email" />
                    <MudTextField Label="Password" Required="true" Placeholder="Enter your password"
                        Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End"
                        AdornmentIcon="@PasswordInputIcon" @bind-Value="password" Class="mt-2"
                        OnAdornmentClick="@ButtonTestclick" />
                    <MudTextField Label="Retype password" Required="true" Placeholder="Re-enter your password"
                        Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End"
                        AdornmentIcon="@PasswordInputIcon" @bind-Value="confirmPassword" Class="mt-2"
                        OnAdornmentClick="@ButtonTestclick" />
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="DoRegisterAsync" Class="mt-4">
                        Register</MudButton>
                </MudForm>
            }
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>


@code {
    private bool success, errors;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string[] errorList = [];
    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    // D3: returnUrl arrives from the contextual login link and is validated
    // with the same rule as login (safe internal path only).
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private void GoToLoginWithReturnUrl() =>
        Navigation.NavigateTo(ProtectedViews.LoginUrlFor(ReturnUrl));

    private void GoToToday() =>
        Navigation.NavigateTo(ProtectedViews.DefaultReturnUrl);

    void ButtonTestclick()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
    public async Task DoRegisterAsync()
    {
        success = errors = false;
        errorList = [];

        if (string.IsNullOrWhiteSpace(email))
        {
            errors = true;
            errorList = ["Email is required."];

            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errors = true;
            errorList = ["Password is required."];

            return;
        }

        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            errors = true;
            errorList = ["Please confirm your password."];

            return;
        }

        if (password != confirmPassword)
        {
            errors = true;
            errorList = ["Passwords don't match."];

            return;
        }

        var result = await Acct.RegisterAsync(email!, password!);

        if (result.Succeeded)
        {
            success = true;
            email = password = confirmPassword = string.Empty;
        }
        else
        {
            errors = true;
            errorList = result.ErrorList;
        }
    }
}
