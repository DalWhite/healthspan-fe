@page "/workouts/create"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create Workout</PageTitle>

<MudDatePicker Label="Workout date"
               Editable="true"
               @bind-Date="workout.Date"
               Placeholder="Select Date" />
<MudTextField @bind-Value="workout.Type"
              Label="Ej. Pull, strength, hypertrophy"
              Variant="Variant.Text"></MudTextField>
<div class="d-flex justify-end mt-2 mb-4">
    <MudButton @onclick="AddWorkout"
               Variant="Variant.Filled"
               Color="MudBlazor.Color.Primary">Create Workout
    </MudButton>
</div>

<MudText Typo="Typo.h4">Exercises</MudText>

@if (exercisesAdded.Any())
{
    <MudTable Items="@exercisesAdded"
              Hover="true"
              Breakpoint="Breakpoint.None"
              Dense="true">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Series</MudTh>
            <MudTh>Reps</MudTh>
            <MudTh>Weight</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Type">@(exerciseTypes?.FirstOrDefault(et => et.Id == context.TypeId)?.Name ?? "Unknown")</MudTd>
            <MudTd DataLabel="Series">@context.Series</MudTd>
            <MudTd DataLabel="Reps">@context.Repetitions</MudTd>
            <MudTd DataLabel="Weight">@context.Weight</MudTd>
        </RowTemplate>
    </MudTable>
    <br>
}

<ExerciseCreationForm ExerciseTypes="@exerciseTypes"
                      WorkoutId="@workoutId"
                      OnExerciseAdded="HandleExerciseAdded"></ExerciseCreationForm>


@code {
    private List<AddExerciseResource> exercisesAdded = new();
    private Guid workoutId;
    private GetExerciseTypeResource[]? exerciseTypes;
    public AddExerciseResource exercise { get; set; } = new();
    public AddWorkoutResource workout { get; set; } = new();
    public GetExerciseTypeResource? typeToAdd { get; set; }

    private async Task AddExerciseToTheForm()
    {
        exercise.WorkoutId = workoutId;
        exercise.TypeId = typeToAdd?.Id;

        var response = await Http.PostAsJsonAsync("/Exercises", exercise);

        if (response.IsSuccessStatusCode)
        {
            exercisesAdded.Add(exercise);
        }
        exercise = new();
    }
    private async Task AddWorkout()
    {
        var response = await Http.PostAsJsonAsync("/Workouts", workout);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<GetWorkoutResource>();
            if (result != null)
            {
                workoutId = result.Id;
                Snackbar.Add("Workout created successfully!", Severity.Success);
            }
        }
        else
        {
            Snackbar.Add("Failed to create workout. Please try again.", Severity.Error);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        workout.Date = DateTime.Now;
        exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
    }
    private void GoToCreateExerciseType()
    {
        NavigationManager.NavigateTo("/exercises/types");
    }
    private async Task HandleExerciseAdded(AddExerciseResource exercise)
    {
        exercisesAdded.Add(exercise);
    }
}