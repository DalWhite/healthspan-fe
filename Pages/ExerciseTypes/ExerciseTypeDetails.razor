@page "/exercises/types/{ExerciseTypeId:int}/details/{traineeId?}"
@inject HttpClient Http
@using ApexCharts
@inject TitleService TitleService
@inject IJSRuntime JSRuntime
@rendermode RenderMode.InteractiveWebAssembly

@implements IAsyncDisposable

<style>
    /* Exercise history table: ensure cells wrap and avoid forcing page horizontal scroll */
    .exercise-history-table { width: 100% !important; table-layout: fixed !important; border-collapse: collapse !important; display: table !important; }
    .exercise-history-table thead { display: table-header-group !important; }
    .exercise-history-table tbody { display: table-row-group !important; }
    .exercise-history-table tr { display: table-row !important; }
    .exercise-history-table th, .exercise-history-table td { display: table-cell !important; padding: 8px 6px !important; vertical-align: middle !important; font-size: 0.9rem; }
    .exercise-history-table td.no-break, .exercise-history-table span.no-break { white-space: nowrap !important; word-break: keep-all !important; overflow: visible !important; }
    .exercise-history-table thead th { text-align: left; font-weight: 600; font-size: 0.85rem; }

    /* List view defaults to hidden, shown only on mobile */
    .exercise-history-list { display: none; }

    @@media (max-width: 640px) {
        /* Hide table on mobile */
        .desktop-view { display: none !important; }

        /* Show list on mobile */
        .exercise-history-list { list-style: none; padding: 0; margin: 0; display: block; }
        .exercise-history-list li { padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,0.06); display: flex; gap: 12px; justify-content: space-between; align-items: flex-start; }
        .exercise-history-list li:last-child { border-bottom: none; }
        .exercise-history-list .date-details { flex: 1; display: flex; flex-direction: column; gap: 2px; }
        .exercise-history-list .date { font-size: 0.85rem; font-weight: 500; color: var(--mud-palette-text-secondary); }
        .exercise-history-list .details { font-size: 0.9rem; }
        .exercise-history-list .rm { font-size: 0.85rem; font-weight: 500; text-align: right; white-space: nowrap; }
        .exercise-history-list .rm.max { font-weight: bold; color: var(--mud-palette-primary); }
    }

    @@media (min-width: 641px) {
        /* Hide list on desktop */
        .exercise-history-list { display: none !important; }

        /* Show table on desktop */
        .desktop-view { display: block !important; }
        .exercise-history-table th { font-size: 0.85rem; }
        .exercise-history-table td { font-size: 0.9rem; }
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (exercises == null || kpis == null)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Large" />
            <MudText>Loading exercise data...</MudText>
        </MudStack>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-2" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 80%;">@Title</MudText>

        <MudGrid>
<MudItem xs="12">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Performance Summary</MudText>
    <MudGrid Spacing="1" Class="mt-1">
        <!-- Max RM Card -->
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="0" Style="background-color: #1976d2; color: white; border-radius: 8px; padding: 8px; cursor: pointer;"
                     @onclick="() => ScrollToExerciseDate(kpis.MaxRMDate)">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Style="color: white;">@kpis.MaxRM.ToString("F1") kg</MudText>
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">Theoretical Max RM</MudText>
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7); font-size: 0.75rem;">@kpis.MaxRMDate.ToShortDateString()</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <!-- Current 1RM Card -->
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="0" Style="background-color: white; border-radius: 8px; border: 1px solid #e0e0e0; padding: 8px;">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@kpis.Current1RM.ToString("F1") kg</MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">Current 1RM</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudIcon Icon="@(kpis.RMDiferentialInLast3Months >= 0 ? @Icons.Material.Filled.TrendingUp : @Icons.Material.Filled.TrendingDown)"
                                Size="MudBlazor.Size.Small"
                                Color="@(kpis.RMDiferentialInLast3Months >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)" />
                        <MudText Typo="Typo.caption" Style="font-size: 0.8rem;">@Math.Abs(kpis.RMDiferentialInLast3Months) kg</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudItem>

                <!-- Evolution Chart -->
                <MudItem xs="12" Class="mt-3">
                    <MudText Typo="Typo.h6" Class="mb-2">Performance Trends</MudText>
                    <div Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; overflow: hidden;">
                        @if (_rmTrends != null && _volumeTrends != null)
                        {
                            <div style="height: 300px; padding: 8px;">
                                <ApexChart @ref="rmChart"
                                           TItem="DataPoint"
                                           Options="options">
                                    <ApexPointSeries TItem="DataPoint"
                                                    Items="_rmTrends"
                                                    Name="RM"
                                                    SeriesType="ApexCharts.SeriesType.Line"
                                                    XValue='e => e.Time.ToString("yyyy-MM-dd")'
                                                    YAggregate="e => e.Average(e=> e.Data)" />
                                    <ApexPointSeries TItem="DataPoint"
                                                    Items="_volumeTrends"
                                                    Name="Volume"
                                                    SeriesType="ApexCharts.SeriesType.Line"
                                                    XValue='e => e.Time.ToString("yyyy-MM-dd")'
                                                    YAggregate="e => e.Average(e=> e.Data)" />
                                </ApexChart>
                            </div>
                        }
                    </div>
                </MudItem>

                <!-- Exercise History -->
                <MudItem xs="12" Class="mt-4">
                    <MudPaper Elevation="2" Class="px-3 py-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudText Typo="Typo.subtitle1">Exercise History</MudText>
                            <MudButton Variant="Variant.Text"
                                      Color="MudBlazor.Color.Primary"
                                      Size="MudBlazor.Size.Small"
                                      OnClick="OnExpandCollapseClick"
                                      EndIcon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">
                                @(_expanded ? "Collapse" : "Expand")
                            </MudButton>
                        </MudStack>

                        <MudCollapse Expanded="_expanded">
                            <div style="max-height: 500px; overflow-y: auto; margin-top: 8px;">
                                <!-- Desktop: Table view -->
                                <div style="overflow-x: auto; display: none;" class="desktop-view">
                                    <table class="exercise-history-table">
                                        <colgroup>
                                            <col style="width: 30%;" />
                                            <col style="width: 50%;" />
                                            <col style="width: 20%;" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Details</th>
                                                <th style="text-align: right;">1RM</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var context in exercises.OrderByDescending(e => e.Workout.Date))
                                        {
                                            <tr>
                                                <td class="no-break" data-label="Date" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    <MudText id="@($"exercise-{context.Workout.Date.Value.ToString("yyyyMMdd")}")" Typo="Typo.body2">
                                                            <span class="no-break value">@context.Workout.Date.Value.ToString("d MMM")</span>
                                                    </MudText>
                                                </td>
                                                <td data-label="Details">
                                                    <MudText Typo="Typo.body2"><span class="value">@context.Series × @context.Repetitions × @context.Weight kg</span></MudText>
                                                </td>
                                                <td class="no-break" data-label="1RM" style="text-align: right;">
                                                    <MudText Typo="Typo.body2" Style="@(context.Workout.Date.Value.Date == kpis.MaxRMDate.Date ? "font-weight: bold; color: var(--mud-palette-primary);" : "")">
                                                        <span class="no-break value">@string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:F1}\u00A0kg", context.MaxRepetition)</span>
                                                    </MudText>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Mobile: Simple list view -->
                                <ul class="exercise-history-list">
                                @foreach (var context in exercises.OrderByDescending(e => e.Workout.Date))
                                {
                                    <li id="@($"exercise-{context.Workout.Date.Value.ToString("yyyyMMdd")}")">
                                        <div class="date-details">
                                            <span class="date">@context.Workout.Date.Value.ToString("d MMM")</span>
                                            <span class="details">@context.Series×@context.Repetitions×@context.Weight kg</span>
                                        </div>
                                        <span class="rm @(context.Workout.Date.Value.Date == kpis.MaxRMDate.Date ? "max" : "")">
                                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:F1} kg", context.MaxRepetition)
                                        </span>
                                    </li>
                                }
                                </ul>
                            </div>
                        </MudCollapse>

                        @if (!_expanded && exercises.Length > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1">@exercises.Length sessions</MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>

@code {
    [Parameter]
    public int ExerciseTypeId { get; set; }

    [Parameter]
    public string? traineeId { get; set; }

    private string Title { get; set; } = "Exercise Details";
    private ApexChart<DataPoint> rmChart;
    private ApexChartOptions<DataPoint> options { get; set; } = new();
    private ApexChartOptions<DataPoint> mobileOptions { get; set; } = new();

    private List<DataPoint> _rmTrends { get; set; }
    private List<DataPoint> _volumeTrends { get; set; }
    private List<DataPoint> _intensityTrends { get; set; }

    private GetExerciseResource[]? exercises;
    private GetExerciseTypeKpis? kpis;
    bool _expanded = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        InitializeChartOptions();
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.scrollToElement = function(elementId) {
                    const element = document.getElementById(elementId);
                    if (element) {
                        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        element.parentElement.parentElement.style.backgroundColor = 'rgba(var(--mud-palette-primary-rgb), 0.1)';
                        setTimeout(() => {
                            element.parentElement.parentElement.style.backgroundColor = '';
                        }, 2000);
                    }
                }
            ");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try {
            await JSRuntime.InvokeVoidAsync("eval", "delete window.scrollToElement");
        } catch {}
    }

    private async Task LoadDataAsync()
    {
        var exercisesTask = Http.GetFromJsonAsync<GetExerciseResource[]>($"/Exercises?exerciseTypeId={ExerciseTypeId}&userId={traineeId}");
        var kpisTask = Http.GetFromJsonAsync<GetExerciseTypeKpis>($"/Exercises/{ExerciseTypeId}/kpis?userId={traineeId}");
        var rmTrendsTask = Http.GetFromJsonAsync<GetExerciseTypeTrends>($"/Exercises/{ExerciseTypeId}/trends?type=RM&userId={traineeId}");
        var volumeTrendsTask = Http.GetFromJsonAsync<GetExerciseTypeTrends>($"/Exercises/{ExerciseTypeId}/trends?type=Volume&userId={traineeId}");
        var intensityTrendsTask = Http.GetFromJsonAsync<GetExerciseTypeTrends>($"/Exercises/{ExerciseTypeId}/trends?type=Intensity&userId={traineeId}");

        var rmTrendsResult = await rmTrendsTask;
        var volumeTrendsResult = await volumeTrendsTask;
        var intensityTrendsResult = await intensityTrendsTask;
        exercises = await exercisesTask;
        kpis = await kpisTask;



        _rmTrends = rmTrendsResult?.Points ?? new List<DataPoint>();
        _volumeTrends = volumeTrendsResult?.Points ?? new List<DataPoint>();
        _intensityTrends = intensityTrendsResult?.Points ?? new List<DataPoint>();

        if (exercises?.Length > 0 && exercises.FirstOrDefault()?.Type != null)
        {
            Title = exercises.First().Type.Name;
            TitleService.Title = Title;
        }
    }

    private void InitializeChartOptions()
    {
        options.Chart = new Chart
        {
            Height = 350,
            Toolbar = new Toolbar { Show = true }
        };

        options.Title = new Title
        {
            Text = ""
        };

        options.Tooltip = new Tooltip
        {
            Shared = true,
            Intersect = false
        };

        options.Grid = new Grid
        {
            BorderColor = "#f1f1f1"
        };

        options.Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 };
        options.Yaxis = new List<YAxis>();

        // Colors for the series
        options.Colors = new List<string> { "#2196F3", "#00E396" };

        options.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "RM (kg)" },
                SeriesName = "RM",
                DecimalsInFloat = 0,
                Labels = new YAxisLabels { Formatter = @"function (value) {
                    return Number(value).toLocaleString() + ' kg';
                }" }
            });
        options.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "Volume (kg)" },
                SeriesName = "Volume",
                DecimalsInFloat = 0,
                Labels = new YAxisLabels { Formatter = @"function (value) {
                    return Number(value).toLocaleString() + ' kg';
                }" }
            });

        options.Legend = new Legend
        {
        };

        // Configure X-axis with minimal labels
        options.Xaxis = new XAxis
        {
            Labels = new XAxisLabels
            {
                ShowDuplicates = false,
                OffsetX = 0
            }
        };

        // Mobile-specific options
        mobileOptions = new ApexChartOptions<DataPoint>();
        mobileOptions.Chart = new Chart { Height = 300, Toolbar = new Toolbar { Show = false } };
        mobileOptions.Title = options.Title;
        mobileOptions.Tooltip = options.Tooltip;
        mobileOptions.Grid = options.Grid;
        mobileOptions.Stroke = options.Stroke;
        mobileOptions.Colors = options.Colors;
        mobileOptions.Legend = new Legend { };

        mobileOptions.Yaxis = new List<YAxis>();
        mobileOptions.Xaxis = new XAxis
        {
            Labels = new XAxisLabels
            {
                Rotate = -45,
                RotateAlways = true,
                MaxHeight = 60,
                ShowDuplicates = false
            }
        };

        mobileOptions.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "" },
                SeriesName = "RM",
                DecimalsInFloat = 0,
                Show = false,
                Labels = new YAxisLabels { Formatter = @"function (value) { return Number(value).toLocaleString() + ' kg'; }" }
            });
        mobileOptions.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "" },
                SeriesName = "Volume",
                DecimalsInFloat = 0,
                Show = false,
                Labels = new YAxisLabels { Formatter = @"function (value) { return Number(value).toLocaleString() + ' kg'; }" }
            });

        // Responsive design
        options.Responsive = new List<Responsive<DataPoint>> {
            new Responsive<DataPoint>() {
                Breakpoint = 768,
                Options = mobileOptions
            }
        };
    }

    private void OnExpandCollapseClick()
    {
        _expanded = !_expanded;
    }

    private async Task ScrollToExerciseDate(DateTime date)
    {
        _expanded = true;
        await Task.Delay(100); // Allow time for the collapse to expand
        await JSRuntime.InvokeVoidAsync("scrollToElement", $"exercise-{date.ToString("yyyyMMdd")}");
    }

    public class GetExerciseTypeTrends
    {
        public List<DataPoint> Points { get; set; }
    }

    public class DataPoint
    {
        public decimal Data { get; set; }
        public DateTime Time { get; set; }
    }

    public class GetExerciseTypeKpis
    {
        public float MaxRM { get; set; }
        public DateTime MaxRMDate { get; set; }
        public float Current1RM { get; set; }
        public int RMDiferentialInLast3Months { get; set; }
        public int WeeklyFrequency { get; set; }
        public int PerceibedEffortLastSession { get; set; }
    }

    public class GetExerciseResource
    {
        public Guid? Id { get; set; }
        public int? Series { get; set; }
        public int? Repetitions { get; set; }
        public double? Weight { get; set; }
        public double? MaxRepetition { get; set; }
        public int? Volume { get; set; }
        public double? Intensity { get; set; }
        public string? Comments { get; set; }
        public GetExerciseTypeResource? Type { get; set; }
        public GetWorkoutResource? Workout { get; set; }
    }

    public class GetExerciseTypeResource
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }

    public class GetWorkoutResource
    {
        public Guid Id { get; set; }
        public DateTime? Date { get; set; }
    }
}