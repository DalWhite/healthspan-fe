@page "/exercises/types/{ExerciseTypeId:int}/details/{TraineeId?}"
@page "/training/library/{ExerciseTypeId:int}"
@using ApexCharts
@inject AppStateService AppState
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject TitleService TitleService

<PageTitle>@_title</PageTitle>

<PageShell>
    <PageHeader Title="@_title">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           aria-label="Back"
                           OnClick="GoBack" />
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingState Message="Loading exercise..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Couldn't load this exercise"
                    Message="@_errorMessage"
                    ActionLabel="Retry"
                    OnAction="RetryAsync" />
    }
    else if (_exerciseType is not null)
    {
        <nav class="hs-exercise-detail-tabs" aria-label="Exercise details">
            @foreach (var tab in DetailSections)
            {
                var isActive = _activeSection == tab.Key;
                <button type="button"
                        class="hs-exercise-detail-tab @(isActive ? "is-active" : null)"
                        aria-selected="@isActive.ToString().ToLowerInvariant()"
                        aria-controls="@($"exercise-section-{tab.Key}")"
                        @onclick="() => SelectSection(tab.Key)">
                    @tab.Label
                </button>
            }
        </nav>

        @if (AvailableTrainingTags.Count > 0)
        {
            <div class="hs-analysis-tag-filter"
                 aria-label="Filter analysis by training tag">
                <span>Filter</span>
                <button type="button"
                        class="@(_selectedTrainingTag is null ? "is-active" : null)"
                        @onclick="() => SelectTrainingTagAsync(null)">
                    All
                </button>
                @foreach (var tag in AvailableTrainingTags)
                {
                    <button type="button"
                            class="@(string.Equals(
                                _selectedTrainingTag,
                                tag,
                                StringComparison.OrdinalIgnoreCase)
                                ? "is-active"
                                : null)"
                            @onclick="() => SelectTrainingTagAsync(tag)">
                        @tag
                    </button>
                }
            </div>
        }

        <div class="hs-exercise-detail-content">
            @switch (_activeSection)
            {
                case "history":
                    <section id="exercise-section-history"
                             class="hs-exercise-detail-section"
                             aria-label="History">
                        @if (_exercises.Count == 0)
                        {
                            <EmptyState Icon="@Icons.Material.Filled.History"
                                        Title="No history yet"
                                        Subtitle="Log this exercise in Today to start its history."
                                        ActionLabel="Open Today"
                                        OnAction="OpenToday" />
                        }
                        else
                        {
                            <div class="hs-exercise-history-list">
                                @foreach (var exercise in _exercises.OrderByDescending(item => item.Workout?.Date))
                                {
                                    var rowContent = FormatHistoryRow(exercise);
                                    if (TraineeId is null && exercise.Id.HasValue)
                                    {
                                        <a id="@HistoryRowId(exercise)"
                                           class="hs-exercise-history-row"
                                           href="@BuildEditRoute(exercise.Id.Value)">
                                            @rowContent
                                        </a>
                                    }
                                    else
                                    {
                                        <div id="@HistoryRowId(exercise)"
                                             class="hs-exercise-history-row">
                                            @rowContent
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </section>
                    break;

                case "trends":
                    <section id="exercise-section-trends"
                             class="hs-exercise-detail-section"
                             aria-label="Trends">
                        @if (_exercises.Count == 0)
                        {
                            <EmptyState Icon="@Icons.Material.Filled.ShowChart"
                                        Title="No trend yet"
                                        Subtitle="A trend appears after this exercise is logged." />
                        }
                        else if (!SupportsLoadMetrics)
                        {
                            <EmptyState Icon="@Icons.Material.Filled.Repeat"
                                        Title="Repetition-based exercise"
                                        Subtitle="Load and 1RM trends aren't used for this exercise." />
                        }
                        else if (!string.IsNullOrWhiteSpace(_performanceError))
                        {
                            <ErrorState Title="Couldn't load performance trends"
                                        Message="@_performanceError"
                                        ActionLabel="Retry"
                                        OnAction="RetryPerformanceAsync" />
                        }
                        else if (_rmTrends.Count == 0 && _volumeTrends.Count == 0)
                        {
                            <EmptyState Icon="@Icons.Material.Filled.ShowChart"
                                        Title="No trend data"
                                        Subtitle="More complete workout entries are needed." />
                        }
                        else
                        {
                            <div class="hs-exercise-trend-card hs-surface">
                                <ApexChart TItem="DataPoint" Options="_chartOptions">
                                    <ApexPointSeries TItem="DataPoint"
                                                     Items="_rmTrends"
                                                     Name="Estimated 1RM"
                                                     SeriesType="SeriesType.Line"
                                                     XValue='point => point.Time.ToString("yyyy-MM-dd")'
                                                     YAggregate="point => point.Average(item => item.Data)" />
                                    <ApexPointSeries TItem="DataPoint"
                                                     Items="_volumeTrends"
                                                     Name="Volume"
                                                     SeriesType="SeriesType.Line"
                                                     XValue='point => point.Time.ToString("yyyy-MM-dd")'
                                                     YAggregate="point => point.Average(item => item.Data)" />
                                </ApexChart>
                            </div>
                        }
                    </section>
                    break;

                case "variations":
                    <section id="exercise-section-variations"
                             class="hs-exercise-detail-section"
                             aria-label="Variations">
                        @if (_parentType is not null)
                        {
                            <a class="hs-exercise-related-card hs-surface"
                               href="@BuildRelatedDetailsRoute(_parentType.Id)">
                                <span class="hs-exercise-related-label">Main exercise</span>
                                <strong>@_parentType.Name</strong>
                            </a>
                        }

                        @if (RelatedVariations.Count > 0)
                        {
                            <div class="hs-exercise-related-list">
                                @foreach (var variation in RelatedVariations)
                                {
                                    <a class="hs-exercise-related-card hs-surface"
                                       href="@BuildRelatedDetailsRoute(variation.Id)">
                                        <strong>@variation.Name</strong>
                                        <span>@FormatTagLine(variation)</span>
                                    </a>
                                }
                            </div>
                        }
                        else if (_parentType is null)
                        {
                            <EmptyState Icon="@Icons.Material.Filled.AccountTree"
                                        Title="No variations"
                                        Subtitle="This exercise has no catalog variations." />
                        }
                    </section>
                    break;

                default:
                    <section id="exercise-section-overview"
                             class="hs-exercise-detail-section"
                             aria-label="Overview">
                        <div class="hs-exercise-kpi-grid">
                            <article class="hs-exercise-kpi hs-surface">
                                <strong>@_exercises.Count</strong>
                                <span>@FormatSessionLabel(_exercises.Count)</span>
                            </article>
                            <article class="hs-exercise-kpi hs-surface">
                                <strong>@FormatLastPerformed()</strong>
                                <span>Last performed</span>
                            </article>

                            @if (SupportsLoadMetrics && _kpis is not null && _kpis.MaxRM > 0)
                            {
                                <button type="button"
                                        class="hs-exercise-kpi hs-surface is-action"
                                        @onclick="() => OpenBestSessionAsync(_kpis.MaxRMDate)">
                                    <strong>@_kpis.MaxRM.ToString("N1") kg</strong>
                                    <span>Best estimated 1RM</span>
                                </button>
                                <article class="hs-exercise-kpi hs-surface">
                                    <strong>@_kpis.Current1RM.ToString("N1") kg</strong>
                                    <span>Current estimated 1RM</span>
                                </article>
                            }
                            else if (!SupportsLoadMetrics)
                            {
                                <article class="hs-exercise-kpi hs-surface">
                                    <strong>Reps</strong>
                                    <span>Tracking mode</span>
                                </article>
                                <article class="hs-exercise-kpi hs-surface">
                                    <strong>@(_kpis?.WeeklyFrequency ?? RecentSessionCount)</strong>
                                    <span>Last 7 days</span>
                                </article>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_performanceError) && SupportsLoadMetrics)
                        {
                            <div class="hs-exercise-inline-error" role="alert">
                                <span>@_performanceError</span>
                                <button type="button" @onclick="RetryPerformanceAsync">Retry</button>
                            </div>
                        }

                        <article class="hs-exercise-overview-card hs-surface">
                            @if (!string.IsNullOrWhiteSpace(_exerciseType.Description))
                            {
                                <p>@_exerciseType.Description</p>
                            }

                            <div class="hs-exercise-overview-line">
                                <span>Muscles</span>
                                <strong>@AppState.FormatExerciseTypeMuscleLine(_exerciseType)</strong>
                            </div>
                            <div class="hs-exercise-overview-line">
                                <span>Load</span>
                                <strong>@FormatWeightMode(_exerciseType.WeightType)</strong>
                            </div>

                            @if ((_exerciseType.Tags?.Count ?? 0) > 0)
                            {
                                <div class="hs-exercise-overview-tags" aria-label="Exercise tags">
                                    @foreach (var tag in _exerciseType.Tags!
                                        .Select(item => item.Name)
                                        .Where(name => !string.IsNullOrWhiteSpace(name))
                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                        .Take(6))
                                    {
                                        <span>@tag</span>
                                    }
                                </div>
                            }
                        </article>
                    </section>
                    break;
            }
        </div>
    }
</PageShell>

@code {
    private static readonly (string Key, string Label)[] DetailSections =
    [
        ("overview", "Overview"),
        ("history", "History"),
        ("trends", "Trends"),
        ("variations", "Variations")
    ];

    [Parameter] public int ExerciseTypeId { get; set; }
    [Parameter] public string? TraineeId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "tag")]
    public string? TrainingTag { get; set; }

    private readonly ApexChartOptions<DataPoint> _chartOptions = new();
    private GetExerciseTypeResource? _exerciseType;
    private GetExerciseTypeResource? _parentType;
    private List<GetExerciseResource> _allExercises = [];
    private List<GetExerciseResource> _exercises = [];
    private List<DataPoint> _rmTrends = [];
    private List<DataPoint> _volumeTrends = [];
    private ExerciseKpis? _kpis;
    private string _title = "Exercise details";
    private string _activeSection = "overview";
    private string? _errorMessage;
    private string? _performanceError;
    private bool _isLoading = true;
    private int _loadedExerciseTypeId;
    private string? _selectedTrainingTag;

    private bool SupportsLoadMetrics
        => (_exerciseType?.WeightType ?? ExerciseWeightType.Standard)
            != ExerciseWeightType.None;

    private int RecentSessionCount
        => _exercises.Count(exercise =>
            exercise.Workout?.Date >= DateTime.Today.AddDays(-7));

    private List<string> AvailableTrainingTags
        => _allExercises
            .SelectMany(exercise => exercise.Tags)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(tag => tag)
            .ToList();

    private List<GetExerciseTypeResource> RelatedVariations
        => ((_parentType?.Variations ?? _exerciseType?.Variations) ?? [])
            .Where(variation => variation.Id != ExerciseTypeId)
            .OrderBy(variation => variation.Name)
            .ToList();

    protected override void OnInitialized()
    {
        _chartOptions.Chart = new Chart
        {
            Height = 300,
            Toolbar = new Toolbar { Show = false }
        };
        _chartOptions.Stroke = new Stroke
        {
            Curve = Curve.Smooth,
            Width = 3
        };
        _chartOptions.Colors = ["#AE1D0D", "#035960"];
        _chartOptions.Tooltip = new Tooltip
        {
            Shared = true,
            Intersect = false
        };
        _chartOptions.Xaxis = new XAxis
        {
            Labels = new XAxisLabels
            {
                Rotate = -45,
                RotateAlways = true,
                ShowDuplicates = false
            }
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        _activeSection = NormalizeSection(Section);
        if (_loadedExerciseTypeId != ExerciseTypeId)
        {
            await LoadDataAsync();
            return;
        }

        var requestedTag = AvailableTrainingTags.FirstOrDefault(
            tag => string.Equals(
                tag,
                TrainingTag,
                StringComparison.OrdinalIgnoreCase));
        if (!string.Equals(
            requestedTag,
            _selectedTrainingTag,
            StringComparison.OrdinalIgnoreCase))
        {
            _selectedTrainingTag = requestedTag;
            ApplyTrainingTagFilter();
            await LoadPerformanceAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _performanceError = null;
        _exerciseType = null;
        _parentType = null;
        _allExercises = [];
        _exercises = [];
        _kpis = null;
        _rmTrends = [];
        _volumeTrends = [];

        try
        {
            var userQuery = string.IsNullOrWhiteSpace(TraineeId)
                ? string.Empty
                : $"&userId={Uri.EscapeDataString(TraineeId)}";
            var typeTask = Http.GetFromJsonAsync<GetExerciseTypeResource>(
                $"/ExerciseTypes/{ExerciseTypeId}");
            var exercisesTask = Http.GetFromJsonAsync<List<GetExerciseResource>>(
                $"/Exercises?exerciseTypeId={ExerciseTypeId}{userQuery}");
            var musclesTask = AppState.GetMusclesAsync();

            await Task.WhenAll(typeTask, exercisesTask, musclesTask);
            _exerciseType = await typeTask
                ?? throw new InvalidOperationException("The exercise type response was empty.");
            _allExercises = await exercisesTask ?? [];
            _selectedTrainingTag = AvailableTrainingTags.FirstOrDefault(
                tag => string.Equals(
                    tag,
                    TrainingTag,
                    StringComparison.OrdinalIgnoreCase));
            ApplyTrainingTagFilter();
            _title = _exerciseType.Name ?? "Exercise details";
            TitleService.Title = _title;
            _loadedExerciseTypeId = ExerciseTypeId;

            if (_exerciseType.ParentExerciseTypeId.HasValue)
            {
                try
                {
                    _parentType = await Http.GetFromJsonAsync<GetExerciseTypeResource>(
                        $"/ExerciseTypes/{_exerciseType.ParentExerciseTypeId.Value}");
                }
                catch
                {
                    _parentType = null;
                }
            }

            if (_exercises.Count > 0)
            {
                await LoadPerformanceAsync();
            }
        }
        catch
        {
            _title = "Exercise details";
            TitleService.Title = _title;
            _errorMessage = "Check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadPerformanceAsync()
    {
        _performanceError = null;

        try
        {
            if (!SupportsLoadMetrics)
            {
                return;
            }

            var queryParts = new List<string>();
            if (!string.IsNullOrWhiteSpace(TraineeId))
            {
                queryParts.Add(
                    $"userId={Uri.EscapeDataString(TraineeId)}");
            }
            if (!string.IsNullOrWhiteSpace(_selectedTrainingTag))
            {
                queryParts.Add(
                    $"tag={Uri.EscapeDataString(_selectedTrainingTag)}");
            }

            var userQuery = queryParts.Count == 0
                ? string.Empty
                : $"?{string.Join("&", queryParts)}";
            var separator = queryParts.Count == 0 ? "?" : "&";
            var kpisTask = Http.GetFromJsonAsync<ExerciseKpis>(
                $"/Exercises/{ExerciseTypeId}/kpis{userQuery}");

            var rmTask = Http.GetFromJsonAsync<TrendResult>(
                $"/Exercises/{ExerciseTypeId}/trends{userQuery}{separator}type=RM");
            var volumeTask = Http.GetFromJsonAsync<TrendResult>(
                $"/Exercises/{ExerciseTypeId}/trends{userQuery}{separator}type=Volume");

            await Task.WhenAll(kpisTask, rmTask, volumeTask);
            _kpis = await kpisTask;
            _rmTrends = (await rmTask)?.Points ?? [];
            _volumeTrends = (await volumeTask)?.Points ?? [];
        }
        catch
        {
            _performanceError = "Performance data is temporarily unavailable.";
            _kpis = null;
            _rmTrends = [];
            _volumeTrends = [];
        }
    }

    private Task RetryAsync()
    {
        _loadedExerciseTypeId = 0;
        return LoadDataAsync();
    }

    private async Task RetryPerformanceAsync()
    {
        await LoadPerformanceAsync();
    }

    private void SelectSection(string section)
    {
        _activeSection = NormalizeSection(section);
        var uri = NavigationManager.GetUriWithQueryParameter(
            "section",
            _activeSection == "overview" ? null : _activeSection);
        NavigationManager.NavigateTo(uri, replace: true);
    }

    private async Task SelectTrainingTagAsync(string? tag)
    {
        _selectedTrainingTag = AvailableTrainingTags.FirstOrDefault(
            candidate => string.Equals(
                candidate,
                tag,
                StringComparison.OrdinalIgnoreCase));
        ApplyTrainingTagFilter();
        _kpis = null;
        _rmTrends = [];
        _volumeTrends = [];

        var uri = NavigationManager.GetUriWithQueryParameter(
            "tag",
            _selectedTrainingTag);
        NavigationManager.NavigateTo(uri, replace: true);

        if (_exercises.Count > 0)
        {
            await LoadPerformanceAsync();
        }
    }

    private void ApplyTrainingTagFilter()
    {
        _exercises = string.IsNullOrWhiteSpace(_selectedTrainingTag)
            ? _allExercises.ToList()
            : _allExercises
                .Where(exercise => exercise.Tags.Contains(
                    _selectedTrainingTag,
                    StringComparer.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task OpenBestSessionAsync(DateTime date)
    {
        SelectSection("history");
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync(
            "scrollToElement",
            $"exercise-{date:yyyyMMdd}");
    }

    private RenderFragment FormatHistoryRow(GetExerciseResource exercise)
        => builder =>
        {
            var sequence = 0;
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "hs-exercise-history-date");
            builder.AddContent(
                sequence++,
                exercise.Workout?.Date?.ToString("d MMM yyyy") ?? "Date unavailable");
            builder.CloseElement();

            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "hs-exercise-history-prescription");
            builder.AddContent(sequence++, FormatPrescription(exercise));
            builder.CloseElement();

            if (exercise.Tags.Count > 0)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(
                    sequence++,
                    "class",
                    "hs-exercise-history-tags");
                foreach (var tag in exercise.Tags)
                {
                    builder.OpenElement(sequence++, "span");
                    builder.AddContent(sequence++, tag);
                    builder.CloseElement();
                }
                builder.CloseElement();
            }

            if (SupportsLoadMetrics && exercise.MaxRepetition is > 0)
            {
                builder.OpenElement(sequence++, "strong");
                builder.AddAttribute(sequence++, "class", "hs-exercise-history-rm");
                builder.AddContent(sequence++, $"{exercise.MaxRepetition.Value:N1} kg 1RM");
                builder.CloseElement();
            }
        };

    private string FormatPrescription(GetExerciseResource exercise)
    {
        var series = exercise.Series ?? 0;
        var repetitions = exercise.Repetitions ?? 0;
        var prescription = $"{series} sets × {repetitions} reps";

        if (SupportsLoadMetrics && exercise.Weight is > 0)
        {
            prescription += $" · {exercise.Weight.Value:N1} kg";
        }

        return prescription;
    }

    private string FormatLastPerformed()
        => _exercises
            .MaxBy(exercise => exercise.Workout?.Date)
            ?.Workout?.Date?.ToString("d MMM")
            ?? "Not yet";

    private string FormatTagLine(GetExerciseTypeResource exercise)
    {
        var tags = (exercise.Tags ?? [])
            .Select(tag => tag.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(2)
            .ToList();
        return tags.Count == 0 ? "Exercise variation" : string.Join(" · ", tags);
    }

    private string BuildEditRoute(Guid exerciseId)
    {
        var returnUrl = BuildCurrentDetailReturnUrl("history");
        return $"/training/history/{exerciseId}/edit?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private string BuildRelatedDetailsRoute(int exerciseTypeId)
    {
        var baseRoute = string.IsNullOrWhiteSpace(TraineeId)
            ? $"/training/library/{exerciseTypeId}"
            : $"/exercises/types/{exerciseTypeId}/details/{Uri.EscapeDataString(TraineeId)}";
        return $"{baseRoute}?returnUrl={Uri.EscapeDataString(BuildCurrentDetailReturnUrl("variations"))}";
    }

    private string BuildCurrentDetailReturnUrl(string section)
    {
        var baseRoute = string.IsNullOrWhiteSpace(TraineeId)
            ? $"/training/library/{ExerciseTypeId}"
            : $"/exercises/types/{ExerciseTypeId}/details/{Uri.EscapeDataString(TraineeId)}";
        var query = $"section={Uri.EscapeDataString(section)}";
        if (!string.IsNullOrWhiteSpace(_selectedTrainingTag))
        {
            query +=
                $"&tag={Uri.EscapeDataString(_selectedTrainingTag)}";
        }
        var safeParentReturn = GetSafeReturnUrl(ReturnUrl, string.Empty);
        if (!string.IsNullOrEmpty(safeParentReturn))
        {
            query += $"&returnUrl={Uri.EscapeDataString(safeParentReturn)}";
        }

        return $"{baseRoute}?{query}";
    }

    private string HistoryRowId(GetExerciseResource exercise)
        => $"exercise-{exercise.Workout?.Date?.ToString("yyyyMMdd") ?? exercise.Id?.ToString("N")}";

    private void OpenToday()
        => NavigationManager.NavigateTo("/training/today");

    private void GoBack()
        => NavigationManager.NavigateTo(
            GetSafeReturnUrl(ReturnUrl, "/training/library"));

    private static string NormalizeSection(string? section)
        => DetailSections.Any(item =>
            string.Equals(item.Key, section, StringComparison.OrdinalIgnoreCase))
            ? section!.ToLowerInvariant()
            : "overview";

    private static string GetSafeReturnUrl(string? returnUrl, string fallback)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || !returnUrl.StartsWith('/')
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || returnUrl.Contains('\\')
            || returnUrl.Any(char.IsControl))
        {
            return fallback;
        }

        return returnUrl;
    }

    private static string FormatSessionLabel(int count)
        => count == 1 ? "Session" : "Sessions";

    private static string FormatWeightMode(ExerciseWeightType? weightType)
        => weightType switch
        {
            ExerciseWeightType.None => "Repetitions only",
            ExerciseWeightType.BodyWeight => "Body weight + load",
            _ => "External load"
        };

    public sealed class TrendResult
    {
        public List<DataPoint> Points { get; set; } = [];
    }

    public sealed class DataPoint
    {
        public decimal Data { get; set; }
        public DateTime Time { get; set; }
    }

    public sealed class ExerciseKpis
    {
        public float MaxRM { get; set; }
        public DateTime MaxRMDate { get; set; }
        public float Current1RM { get; set; }
        public int RMDiferentialInLast3Months { get; set; }
        public int WeeklyFrequency { get; set; }
    }
}
