@page "/exercises/types/{ExerciseTypeId:int}/edit"
@inject HttpClient Http
@page "/training/library/{ExerciseTypeId:int}/edit"
@inject NavigationManager NavigationManager
@inject TitleService TitleService
@inject AppStateService AppState
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Edit Exercise</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="hs-page-shell">
    <PageHeader Title="@(_et?.Name is { Length: > 0 } ? $"Edit {_et.Name}" : "Edit Exercise")" />

    @if (_isLoading)
    {
        <LoadingState Message="Loading exercise..." />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <ErrorState Title="Couldn't load this exercise"
                    Message="@_errorMessage"
                    ActionLabel="Back"
                    OnAction="GoBack" />
    }
    else if (_et != null)
    {
        <ExerciseTypeForm Model="_model"
                          OnSubmit="SaveAsync"
                          OnCancel="Cancel" />

        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" role="alert">
                @_actionError
            </MudAlert>
        }
                          
        <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Error" OnClick="ConfirmDeleteAsync"
                   StartIcon="@Icons.Material.Filled.Delete" Class="mt-4">
            Delete Exercise
        </MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Warning">This exercise no longer exists.</MudAlert>
    }
</MudContainer>

@code {
    [Parameter] public int ExerciseTypeId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private GetExerciseTypeResource? _et;
    private UpdateExerciseTypeResource _model = new();
    private List<Muscle> _muscles = new();
    private bool _isLoading = true;
    private string _errorMessage = "";
    private string? _actionError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _muscles = await AppState.GetMusclesAsync();
            _et = await Http.GetFromJsonAsync<GetExerciseTypeResource>($"/ExerciseTypes/{ExerciseTypeId}");

            if (_et != null)
            {
                TitleService.Title = $"Edit — {_et.Name}";
                _model = new UpdateExerciseTypeResource
                {
                    Id = _et.Id,
                    Name = _et.Name,
                    Description = _et.Description,
                    ImageRoute = _et.ImageRoute,
                    MuscleAssignments = _et.MuscleAssignments
                        .Select(assignment => new ExerciseTypeMuscleAssignmentResource
                        {
                            MuscleId = assignment.MuscleId,
                            Role = assignment.Role,
                            SortOrder = assignment.SortOrder
                        })
                        .ToList(),
                    ParentExerciseTypeId = _et.ParentExerciseTypeId,
                    IsFavourite = _et.IsFavourite,
                    WeightType = _et.WeightType,
                    Tags = _et.Tags
                };
            }
            else
            {
                _errorMessage = "Exercise type not found.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Couldn't load this exercise: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync(UpdateExerciseTypeResource payload)
    {
        _actionError = null;
        try
        {
            var response = await Http.PutAsJsonAsync("/ExerciseTypes", payload);

            if (response.IsSuccessStatusCode)
            {
                AppState.InvalidateExerciseTypes();
                Snackbar.Add("Exercise saved.", Severity.Success);
                GoBack();
            }
            else
            {
                _actionError = await HttpProblemDetailsReader.ReadMessageAsync(
                    response,
                    "Couldn't save this exercise.");
            }
        }
        catch
        {
            _actionError = "Couldn't save this exercise.";
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete Exercise",
            $"Permanently delete '{_et?.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
            await DeleteAsync();
    }

    private async Task DeleteAsync()
    {
        if (_et == null) return;
        _actionError = null;
        try
        {
            var response = await Http.DeleteAsync($"/ExerciseTypes/{_et.Id}");
            if (response.IsSuccessStatusCode)
            {
                AppState.InvalidateExerciseTypes();
                Snackbar.Add("Exercise deleted.", Severity.Warning);
                GoBack();
            }
            else
            {
                _actionError = await HttpProblemDetailsReader.ReadMessageAsync(
                    response,
                    "Couldn't delete this exercise type.");
            }
        }
        catch
        {
            _actionError = "Couldn't delete this exercise type.";
        }
    }

    private void Cancel()
        => GoBack();

    private void GoBack()
        => NavigationManager.NavigateTo(
            GetSafeReturnUrl(ReturnUrl, "/training/library"));

    private static string GetSafeReturnUrl(
        string? returnUrl,
        string fallback)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || !returnUrl.StartsWith('/')
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || returnUrl.Contains('\\')
            || returnUrl.Any(char.IsControl))
        {
            return fallback;
        }

        return returnUrl;
    }
}
