@page "/exercises/types/create"
@inject HttpClient Http
@page "/training/library/create"
@using healthspan_fe_wasm_pwa.Shared
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AppStateService AppState
@inject TitleService TitleService

<PageTitle>Add Exercise Type</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="hs-page-shell">
    <PageHeader Title="Add Exercise Type" />

    <ExerciseTypeForm Model="_model"
                      OnSubmit="HandleSubmit"
                      OnCancel="NavigateBack" />
</MudContainer>
@code {
    private UpdateExerciseTypeResource _model = new();

    protected override void OnInitialized()
        => TitleService.Title = "Add Exercise Type";

    private async Task HandleSubmit(UpdateExerciseTypeResource model)
    {
        var createModel = new AddExerciseTypeResource
        {
            Name = model.Name,
            Description = model.Description,
            ImageRoute = model.ImageRoute,
            MuscleAssignments = model.MuscleAssignments
                .Select(assignment => new ExerciseTypeMuscleAssignmentResource
                {
                    MuscleId = assignment.MuscleId,
                    Role = assignment.Role,
                    SortOrder = assignment.SortOrder
                })
                .ToList(),
            ParentExerciseTypeId = model.ParentExerciseTypeId,
            WeightType = model.WeightType,
            Tags = model.Tags
        };

        var response = await Http.PostAsJsonAsync("/ExerciseTypes", createModel);
        if (response.IsSuccessStatusCode)
        {
            AppState.InvalidateExerciseTypes();
            Snackbar.Add("Exercise type created successfully!", Severity.Success);
            NavigationManager.NavigateTo("/training/library");
        }
        else
        {
            Snackbar.Add("Failed to create exercise type. Please try again.", Severity.Error);
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/training/library");
    }
}
