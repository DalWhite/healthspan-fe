@page "/exercises/types/create"
@inject HttpClient Http
@using healthspan_fe_wasm_pwa.Shared
@inject NavigationManager NavigationManager

<PageTitle>ExerciseTypesCreate</PageTitle>

<MudTextField @bind-Value="_addTypeResource.Name"
              Label="Name"
              Variant="Variant.Text"></MudTextField>
<MudTextField @bind-Value="_addTypeResource.Description"
              Label="Description"
              Variant="Variant.Text"></MudTextField>
<MudTextField @bind-Value="_addTypeResource.ImageRoute"
              Label="ImageUrl"
              Variant="Variant.Text"></MudTextField>

<MudSelect T="int?"
           Label="Primary Muscle"
           @bind-Value="_addTypeResource.PrimaryMuscleId">
    @foreach (var muscle in Muscles)
    {
        <MudSelectItem Value="@muscle.Id"> @muscle.Name </MudSelectItem>
    }
</MudSelect>

<MudSelect T="int?"
           Label="Secondary Muscle"
           @bind-Value="_addTypeResource.SecondaryMuscleId">
    @foreach (var muscle in Muscles)
    {
        <MudSelectItem Value="@muscle.Id"> @muscle.Name </MudSelectItem>
    }
</MudSelect>

<div style="float: right; margin-top: 30px;">
    <MudButton @onclick="AddExerciseType"
               Variant="Variant.Filled"
               Color="Color.Primary">Create</MudButton>
</div>
@code {
    private bool typeAdded = false;
    private AddExerciseTypeResource? _addTypeResource = new();
    private List<Muscle> Muscles = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Muscles = await Http.GetFromJsonAsync<List<Muscle>>("api/muscles");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading muscles: {ex.Message}");
            Muscles = new List<Muscle>();
        }

        await base.OnInitializedAsync();
    }

    private async Task AddExerciseType()
    {
        var response = await Http.PostAsJsonAsync("/ExerciseTypes", _addTypeResource);
        if (response.IsSuccessStatusCode)
        {
            typeAdded = true;
        }
        NavigationManager.NavigateTo("/exercises/types");
    }
}
