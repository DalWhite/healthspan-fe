@page "/exercises/types"
@inject TitleService TitleService
@page "/training/library"
@inject NavigationManager NavigationManager

<PageTitle>Exercise Library</PageTitle>

<div class="hs-page-shell">
    <PageHeader Title="Exercise Library">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="GoToCreate">
                New type
            </MudButton>
        </Actions>
    </PageHeader>

    <ExerciseTypeGrid FavouritesOnly="false" ShowSearch="true" TraineeId="@null" />
</div>

@code {
    protected override void OnInitialized()
    {
        TitleService.Title = "Exercise Library";
    }

    private void GoToCreate()
        => NavigationManager.NavigateTo("/training/library/create");
}

