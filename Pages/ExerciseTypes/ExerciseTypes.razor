@page "/exercises/types"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<PageTitle>Exercise Types</PageTitle>

<style>
    .exercise-types-container {
        padding: 24px 0;
    }

    .filters-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
        color: white;
    }

    .filters-section :deep .mud-textfield__adornment,
    .filters-section :deep .mud-textfield__input,
    .filters-section :deep .mud-textfield__label {
        color: white;
    }

    .filters-section :deep .mud-input-helper,
    .filters-section :deep .mud-textfield {
        color: white;
    }

    .search-input-wrapper {
        margin-bottom: 16px;
    }

    .filter-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    .filter-chip {
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .filter-chip.active {
        transform: scale(1.05);
    }

    .exercise-card {
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        border: 2px solid transparent;
        background: linear-gradient(135deg, #ffffff 0%, #f5f7fa 100%);
        position: relative;
        overflow: hidden;
    }

    .exercise-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(102, 126, 234, 0.15);
        border-color: #667eea;
    }

    .exercise-card-image {
        position: relative;
        overflow: hidden;
        height: 180px;
    }

    .exercise-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .exercise-card:hover .exercise-card-image img {
        transform: scale(1.05);
    }

    .card-muscle-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .card-content {
        padding: 16px;
    }

    .exercise-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
    }

    .tag-chip {
        font-size: 0.7rem;
        padding: 4px 8px;
        border-radius: 12px;
        font-weight: 500;
        white-space: nowrap;
        display: inline-block;
    }

    .tag-equipment {
        background: #E3F2FD;
        color: #1976D2;
    }

    .tag-mechanic {
        background: #F3E5F5;
        color: #7B1FA2;
    }

    .tag-level {
        background: #E8F5E9;
        color: #388E3C;
    }

    .tag-force {
        background: #FFF3E0;
        color: #F57C00;
    }

    .tag-type {
        background: #FCE4EC;
        color: #C2185B;
    }

    .favorite-btn {
        transition: transform 0.2s ease;
    }

    .favorite-btn:hover {
        transform: scale(1.15);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state-icon {
        font-size: 4rem;
        margin-bottom: 16px;
        opacity: 0.5;
    }

    .stats-bar {
        display: flex;
        gap: 32px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .stat-value {
        font-weight: 700;
        font-size: 1.1rem;
    }
</style>

<div class="exercise-types-container">
    @if (_exerciseTypes == null)
    {
        <MudProgressCircular Color="Color.Default" Indeterminate="true" />
    }
    else
    {
        <!-- Filters Section -->
        <div class="filters-section">
            <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Color="Color.Inherit" />
                <MudText Typo="Typo.h6" style="color: white; margin: 0;">Exercise Filters</MudText>
            </div>

            <!-- Search Input -->
            <div class="search-input-wrapper">
                <MudTextField Value="searchString" ValueChanged="@((string value) => OnSearchChanged(value))"
                              Placeholder="Search exercises by name or description..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Variant="Variant.Outlined"
                              Class="mt-0" Style="width: 100%;" />
            </div>

            <!-- Quick Filters -->
            <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-start;">
                <MudSwitch T="bool" ValueChanged="@HandleFavoritesChanged" Color="Color.Inherit" Label="Favorites Only" />
            </div>

            <!-- Stats Bar -->
            <div class="stats-bar" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.3);">
                <div class="stat-item">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Small" />
                    <span>Total: <span class="stat-value">@_exerciseTypes?.Length</span></span>
                </div>
                <div class="stat-item">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                    <span>Showing: <span class="stat-value">@_filteredExerciseTypes?.Length</span></span>
                </div>
                <div class="stat-item" style="margin-left: auto; display: flex; gap: 8px;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="@UpdateFilters"
                               StartIcon="@Icons.Material.Filled.Search" Size="Size.Small">
                        Apply Filters
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="@ResetFilters"
                               StartIcon="@Icons.Material.Filled.Clear" Size="Size.Small">
                        Clear Filters
                    </MudButton>
                </div>
            </div>
        </div>

        <!-- Exercises Grid -->
        @if (_filteredExerciseTypes?.Length == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🤷</div>
                <MudText Typo="Typo.h5">No exercises found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity: 0.6;">Try adjusting your filters</MudText>
            </div>
        }
        else
        {
            <MudGrid Class="exercise-types-grid" Spacing="2">
                @foreach (var exerciseType in _filteredExerciseTypes ?? Array.Empty<GetExerciseTypeResource>())
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Class="exercise-card" @onclick="() => GoToEditExerciseType(exerciseType)" Style="cursor: pointer;">
                            <div class="exercise-card-image">
                                <img src="@GetExerciseImageUrl(exerciseType)" alt="@exerciseType.Name" />
                                <div class="card-muscle-badge">@GetMuscleNameById(exerciseType.PrimaryMuscleId)</div>
                            </div>

                            <div class="card-content">
                                <div class="exercise-name">@exerciseType.Name</div>

                                <!-- Tags Display -->
                                @if (exerciseType.Tags?.Count > 0)
                                {
                                    <div class="card-tags">
                                        @foreach (var tag in exerciseType.Tags.Take(3))
                                        {
                                            <span class="tag-chip tag-@tag.Category.ToLower()">@tag.Name</span>
                                        }
                                        @if (exerciseType.Tags.Count > 3)
                                        {
                                            <span class="tag-chip" style="background: #ECEFF1; color: #455A64;">+@(exerciseType.Tags.Count - 3)</span>
                                        }
                                    </div>
                                }

                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <MudChip Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Style="cursor: pointer;">
                                        @GetExerciseTypeLabel(exerciseType)
                                    </MudChip>
                                    <MudIconButton Icon="@GetFavoriteIcon(exerciseType)"
                                                   Color="@(exerciseType.IsFavourite ? Color.Error : Color.Default)"
                                                   Class="favorite-btn"
                                                   OnClick="@((e) => MarkAsFavorite(e, exerciseType))" />
                                </div>
                            </div>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</div>

<MudFab @onclick="GoToCreateExerciseType" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" class="fixed-create-button" Label="New Exercise" />

@code {
    private bool favouriteOnly = false;
    private string searchString = "";
    private HashSet<string> selectedEquipment = new();
    private HashSet<string> selectedLevels = new();
    private GetExerciseTypeResource[]? _exerciseTypes;
    private GetExerciseTypeResource[]? _filteredExerciseTypes;
    private List<Muscle> Muscles = new();

    protected override async Task OnInitializedAsync()
    {
        _exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
        Muscles = await Http.GetFromJsonAsync<List<Muscle>>("api/muscles");
        _filteredExerciseTypes = _exerciseTypes;
        TitleService.Title = "Exercise types";
    }

    private async Task HandleFavoritesChanged(bool newValue)
    {
        favouriteOnly = newValue;
        await UpdateFilters();
    }

    private async Task OnSearchChanged(string value)
    {
        searchString = value;
        await UpdateFilters();
    }

    private async Task UpdateFilters()
    {
        await InnerUpdateFilters();
    }

    private async Task InnerUpdateFilters()
    {
        if (_exerciseTypes == null) return;

        _filteredExerciseTypes = _exerciseTypes
            .Where(et => !favouriteOnly || et.IsFavourite)
            .Where(et => FilterFunc(et, searchString))
            .Where(et => FilterByEquipment(et, selectedEquipment))
            .Where(et => FilterByLevel(et, selectedLevels))
            .ToArray();

        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        searchString = "";
        favouriteOnly = false;
        selectedEquipment.Clear();
        selectedLevels.Clear();
        await UpdateFilters();
    }

    private bool FilterFunc(GetExerciseTypeResource element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (element.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        return false;
    }

    private bool FilterByEquipment(GetExerciseTypeResource element, HashSet<string> selectedEquipment)
    {
        if (selectedEquipment.Count == 0) return true;
        return element.Tags?.Any(t => t.Category == "equipment" && selectedEquipment.Contains(t.Name, StringComparer.OrdinalIgnoreCase)) ?? false;
    }

    private bool FilterByLevel(GetExerciseTypeResource element, HashSet<string> selectedLevels)
    {
        if (selectedLevels.Count == 0) return true;
        return element.Tags?.Any(t => t.Category == "level" && selectedLevels.Contains(t.Name, StringComparer.OrdinalIgnoreCase)) ?? false;
    }

    private HashSet<string> GetAvailableEquipment()
    {
        var equipment = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (_exerciseTypes != null)
        {
            foreach (var exercise in _exerciseTypes)
            {
                foreach (var tag in exercise.Tags?.Where(t => t.Category == "equipment") ?? Enumerable.Empty<ExerciseTag>())
                {
                    equipment.Add(tag.Name);
                }
            }
        }
        return equipment;
    }

    private string GetFavoriteIcon(GetExerciseTypeResource exerciseType)
    {
        return exerciseType.IsFavourite ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder;
    }

    private string GetExerciseImageUrl(GetExerciseTypeResource exerciseType)
    {
        return !string.IsNullOrEmpty(exerciseType.ImageRoute)
            ? exerciseType.ImageRoute
            : $"ExerciseImages/{exerciseType.Name}.jpg";
    }

    private string GetMuscleNameById(int? muscleId)
    {
        return Muscles.FirstOrDefault(m => m.Id == muscleId)?.Name ?? "Unspecified";
    }

    private string GetExerciseTypeLabel(GetExerciseTypeResource exerciseType)
    {
        var mechanic = exerciseType.Tags?.FirstOrDefault(t => t.Category == "mechanic")?.Name ?? "Mixed";
        return mechanic;
    }

    private async Task MarkAsFavorite(MouseEventArgs e, GetExerciseTypeResource exerciseType)
    {
        try
        {
            var updateExerciseTypeResource = new UpdateExerciseTypeResource
            {
                Id = exerciseType.Id,
                Name = exerciseType.Name,
                Description = exerciseType.Description,
                ImageRoute = exerciseType.ImageRoute,
                PrimaryMuscleId = exerciseType.PrimaryMuscleId,
                SecondaryMuscleId = exerciseType.SecondaryMuscleId,
                IsFavourite = !exerciseType.IsFavourite,
                Tags = exerciseType.Tags
            };
            var response = await Http.PutAsJsonAsync($"/ExerciseTypes", updateExerciseTypeResource);

            if (response.IsSuccessStatusCode)
            {
                exerciseType.IsFavourite = !exerciseType.IsFavourite;
                StateHasChanged();
            }
            else
            {
                Console.WriteLine("Failed to mark exercise as favorite.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error occurred: {ex.Message}");
        }
    }

    private void GoToEditExerciseType(GetExerciseTypeResource exerciseType)
    {
        NavigationManager.NavigateTo($"/exercises/types/{exerciseType.Id}/edit");
    }

    private void GoToCreateExerciseType()
    {
        NavigationManager.NavigateTo("/exercises/types/create");
    }
}
