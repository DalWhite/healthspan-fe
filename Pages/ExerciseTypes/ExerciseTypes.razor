@page "/exercises/types"
@inject TitleService TitleService
@inject NavigationManager NavigationManager

<PageTitle>Exercise Types</PageTitle>

<ExerciseTypeGrid FavouritesOnly="false" ShowSearch="true" TraineeId="@null" />

<MudFab @onclick="GoToCreate" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        Class="fixed-create-button" Label="New Exercise Type" />

@code {
    protected override void OnInitialized()
    {
        TitleService.Title = "Exercise Types";
    }

    private void GoToCreate()
        => NavigationManager.NavigateTo("/exercises/types/create");
}

