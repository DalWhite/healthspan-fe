@page "/exercises/types/fav"
@inject TitleService TitleService
@inject NavigationManager NavigationManager

<PageTitle>Favourite Exercise Types</PageTitle>

<ExerciseTypeGrid FavouritesOnly="true" ShowSearch="true" />

<MudFab @onclick="GoToCreate" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="fixed-create-button" Label="New Exercise Type" />

@code {
    protected override void OnInitialized()
        => TitleService.Title = "Favourite Exercises";

    private void GoToCreate()
    {
        NavigationManager.NavigateTo("/exercises/types/create");
    }
}
