@page "/exercises/types/fav"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<PageTitle>Exercise Types</PageTitle>

@if (_exerciseTypes == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <ToolBarContent>
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <MudGrid Class="exercise-types-grid">
        @foreach (var exerciseType in FilteredExerciseTypes())
        {
            <MudItem xs="12" sm="6" md="4" lg="3" xl="2">
                <MudCard Class="exercise-card" @onclick="() => GoToDetails(exerciseType)">
                    <MudCardMedia Image="@GetExerciseImageUrl(exerciseType)" Alt="@exerciseType.Name" Height="140" />
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@exerciseType.Name</MudText>
                        <MudText Typo="Typo.body2">@GetMuscleNameById(exerciseType.PrimaryMuscleId)</MudText>
                    </MudCardContent>
                    <MudCardActions>
                         <MudIconButton Icon="@GetFavoriteIcon(exerciseType)" Color="Color.Primary" OnClick="(e) => MarkAsFavorite(e, exerciseType)" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudFab @onclick="GoToCreateExerciseType" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" class="fixed-create-button" />

@code {
    private string searchString1 = "";
    private GetExerciseTypeResource[]? _exerciseTypes;
    private List<Muscle> Muscles = new();
private string GetFavoriteIcon(GetExerciseTypeResource exerciseType)
    {
        return exerciseType.IsFavourite ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder;
    }
    protected override async Task OnInitializedAsync()
    {
        _exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes?favourite=true");
        Muscles = await Http.GetFromJsonAsync<List<Muscle>>("api/muscles");
        TitleService.Title = "Exercise types";
    }

    private string GetExerciseImageUrl(GetExerciseTypeResource exerciseType)
    {
        return $"ExerciseImages/{exerciseType.Name}.jpg";
    }

    private async Task MarkAsFavorite(MouseEventArgs e, GetExerciseTypeResource exerciseType)
    {
        try
        {
            var updateExerciseTypeResource = new UpdateExerciseTypeResource
            {
                Id = exerciseType.Id,
                Name = exerciseType.Name,
                Description = exerciseType.Description,
                ImageRoute = exerciseType.ImageRoute,
                PrimaryMuscleId = exerciseType.PrimaryMuscleId,
                SecondaryMuscleId = exerciseType.SecondaryMuscleId,
                IsFavourite = !exerciseType.IsFavourite
            };
            // PUT request to mark the exercise as a favorite
            var response = await Http.PutAsJsonAsync($"/ExerciseTypes", updateExerciseTypeResource);

            if (response.IsSuccessStatusCode)
            {
                 exerciseType.IsFavourite = !exerciseType.IsFavourite;
            }
            else
            {
                // Handle non-successful responses
                Console.WriteLine("Failed to mark exercise as favorite.");
            }
        }
        catch (Exception ex)
        {
            // Handle any exceptions
            Console.WriteLine($"Error occurred: {ex.Message}");
        }
    }

    private string GetMuscleNameById(int? muscleId)
    {
        return Muscles.FirstOrDefault(m => m.Id == muscleId)?.Name ?? "Not specified";
    }

    private void GoToDetails(GetExerciseTypeResource exerciseType)
    {
        NavigationManager.NavigateTo($"/exercises/types/{exerciseType.Id}/details");
    }

    private IEnumerable<GetExerciseTypeResource> FilteredExerciseTypes()
    {
        if (string.IsNullOrWhiteSpace(searchString1))
            return _exerciseTypes;

        return _exerciseTypes.Where(exerciseType => FilterFunc(exerciseType, searchString1));
    }

    private bool FilterFunc(GetExerciseTypeResource element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (element.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        return false;
    }

    private void GoToCreateExerciseType()
    {
        NavigationManager.NavigateTo("/exercises/types/create");
    }
}
