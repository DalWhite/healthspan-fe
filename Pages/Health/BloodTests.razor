@page "/health/blood-tests"
@inject HealthspanApiClient ApiClient
@inject TitleService TitleService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Analíticas</PageTitle>

<PageShell>
    <PageHeader Title="Analíticas">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ToggleUploadPanel">
                Subir
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="ToggleManualEntry">
                Introducir a mano
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error"
                  Dense="true"
                  ShowCloseIcon="true"
                  CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <MudAlert Severity="@_operationSeverity"
                  Dense="true"
                  ShowCloseIcon="true"
                  CloseIconClicked="() => _operationMessage = null">
            @_operationMessage
        </MudAlert>
    }

    @if (_showUploadPanel)
    {
        <section class="hs-health-panel hs-upload-panel"
                 aria-labelledby="upload-report-title">
            <div class="hs-detail-heading">
                <MudText Typo="Typo.h6" id="upload-report-title">
                    Subir informe
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               OnClick="CloseUploadPanel"
                               aria-label="Cerrar subida" />
            </div>

            <MudFileUpload T="IBrowserFile"
                           Accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp"
                           FilesChanged="OnFileSelected">
                <ButtonTemplate>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Class="hs-dropzone-btn"
                               for="@context">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" />
                        <span>
                            @(_selectedFile?.Name
                                ?? "Elige un PDF o imagen")
                        </span>
                    </MudButton>
                </ButtonTemplate>
            </MudFileUpload>

            @if (_selectedFile is not null)
            {
                <div class="hs-selected-file">
                    <span>
                        @FormatFileSize(_selectedFile.Size)
                        · @GetFileTypeLabel(_selectedFile)
                    </span>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               OnClick="ClearSelectedFile">
                        Cambiar
                    </MudButton>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_fileError))
            {
                <MudText Typo="Typo.caption"
                         Color="Color.Error">
                    @_fileError
                </MudText>
            }

            <div class="hs-upload-metadata">
                <MudDatePicker Label="Fecha de la analítica"
                               @bind-Date="_uploadDraft.TestDate"
                               MaxDate="DateTime.Today"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
                <MudTextField @bind-Value="_uploadDraft.LabName"
                              Label="Laboratorio (opcional)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <div class="hs-panel-primary-action">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="@(_selectedFile is null || _fileError is not null || _isUploading)"
                           Loading="_isUploading"
                           OnClick="UploadAsync">
                    @(_isUploading ? "Subiendo informe" : "Subir informe")
                </MudButton>
                <MudText Typo="Typo.caption"
                         Class="hs-muted-copy">
                    PDF, PNG, JPG, TIFF or BMP · 20 MB max
                </MudText>
            </div>
        </section>
    }

    @if (_showManualEntry)
    {
        <section class="hs-health-panel hs-upload-panel"
                 aria-labelledby="manual-test-title">
            <div class="hs-detail-heading">
                <MudText Typo="Typo.h6" id="manual-test-title">
                    Enter blood test
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               OnClick="CloseManualEntry"
                               aria-label="Cerrar entrada manual" />
            </div>

            <div class="hs-upload-metadata">
                <MudDatePicker Label="Fecha de la analítica"
                               @bind-Date="_manualTestDate"
                               MaxDate="DateTime.Today"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
                <MudTextField @bind-Value="_manualDraft.LabName"
                              Label="Laboratorio (opcional)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <div class="hs-manual-markers-grid">
                @foreach (var marker in _manualMarkers)
                {
                    <div class="hs-manual-marker-row">
                        <MudTextField @bind-Value="marker.Name"
                                      Label="Marcador"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudNumericField T="double?"
                                         @bind-Value="marker.Value"
                                         Label="Valor"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                        <MudTextField @bind-Value="marker.Unit"
                                      Label="Unidad"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       OnClick="() => RemoveManualMarker(marker)"
                                       aria-label="Quitar marcador" />
                    </div>
                }
            </div>

            <div class="hs-manual-entry-actions">
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddManualMarker">
                    Añadir marcador
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_isCreatingManual"
                           Loading="_isCreatingManual"
                           OnClick="CreateManualAsync">
                    Guardar analítica
                </MudButton>
            </div>
        </section>
    }

    @if (_isLoading)
    {
        <LoadingState Message="Cargando analíticas…" />
    }
    else
    {
        <div class="hs-compact-filters"
             role="group"
             aria-label="Estado de analíticas">
            @foreach (var filter in AvailableFilters)
            {
                <button type="button"
                        class="@(filter.Key == _activeFilter ? "is-active" : null)"
                        aria-pressed="@((filter.Key == _activeFilter).ToString().ToLowerInvariant())"
                        @onclick="() => _activeFilter = filter.Key">
                    @filter.Label
                    <span>@CountFor(filter.Key)</span>
                </button>
            }
        </div>

        @if (!FilteredTests.Any())
        {
            <div class="hs-health-panel">
                <EmptyState Icon="@Icons.Material.Filled.Science"
                            Title="Sin analíticas"
                            Subtitle="@EmptyStateText" />
            </div>
        }
        else
        {
            <div class="hs-health-record-list">
                @foreach (var item in FilteredTests)
                {
                    <a class="hs-list-card @GetStatusCardClass(item)"
                       href="@GetDetailRoute(item.Id)">
                        <div class="hs-list-card-row">
                            <div>
                                <div class="hs-list-card-title">
                                    @item.TestDate.ToString("dd MMM yyyy")
                                </div>
                                <div class="hs-list-card-subtitle">
                                    @(item.LabName ?? "Laboratorio desconocido")
                                    · @FormatMarkerCount(item)
                                </div>
                            </div>
                            <ClinicalStatusChip Status="@GetStatusLabel(item)" />
                        </div>

                        @if (item.ProcessingStatus
                            == BloodTestProcessingStatus.Processing
                            && !IsInterrupted(item))
                        {
                            <MudProgressLinear Color="Color.Info"
                                               Indeterminate="true"
                                               Size="Size.Small"
                                               Class="mt-2" />
                        }

                        @if (item.RequiresReview
                            || item.ProcessingStatus
                                == BloodTestProcessingStatus.ExtractionFailed
                            || IsInterrupted(item))
                        {
                            <div class="hs-list-card-callout">
                                @GetRequiredAction(item)
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                         Size="Size.Small" />
                            </div>
                        }
                    </a>
                }
            </div>
        }
    }
</PageShell>

@code {
    [SupplyParameterFromQuery(Name = "upload")]
    public bool OpenUpload { get; set; }

    private const long MaxFileSize = 20 * 1024 * 1024;
    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp"
        };
    private static readonly IReadOnlyList<FilterOption>
        AvailableFilters =
        [
            new(TestFilter.All, "Todos"),
            new(TestFilter.NeedsReview, "Revisión"),
            new(TestFilter.Processing, "En proceso"),
            new(TestFilter.Issues, "Incidencias")
        ];

    private readonly List<BloodTestSummaryResource> _bloodTests = [];
    private readonly List<BloodTestMarkerResource> _manualMarkers = [];
    private IBrowserFile? _selectedFile;
    private BloodTestUploadRequest _uploadDraft =
        new() { TestDate = DateTime.Today };
    private AddBloodTestResource _manualDraft =
        new() { TestDate = DateTime.Today };
    private DateTime? _manualTestDate = DateTime.Today;
    private bool _isLoading = true;
    private bool _isUploading;
    private bool _isCreatingManual;
    private bool _showUploadPanel;
    private bool _showManualEntry;
    private string? _errorMessage;
    private string? _operationMessage;
    private string? _fileError;
    private Severity _operationSeverity = Severity.Info;
    private TestFilter _activeFilter;
    private CancellationTokenSource? _pollCancellation;
    private Task? _pollTask;

    private IEnumerable<BloodTestSummaryResource> FilteredTests
        => _bloodTests
            .Where(item => _activeFilter switch
            {
                TestFilter.NeedsReview => item.RequiresReview,
                TestFilter.Processing =>
                    item.ProcessingStatus
                        == BloodTestProcessingStatus.Processing
                    && !IsInterrupted(item),
                TestFilter.Issues =>
                    item.ProcessingStatus
                        == BloodTestProcessingStatus.ExtractionFailed
                    || IsInterrupted(item),
                _ => true
            })
            .OrderByDescending(item => item.TestDate);

    private string EmptyStateText
        => _activeFilter == TestFilter.All
            ? "Sube un informe o introduce los resultados a mano."
            : "Ninguna analítica coincide con este estado.";

    protected override async Task OnParametersSetAsync()
    {
        TitleService.Title = "Analíticas";
        if (OpenUpload)
        {
            _showUploadPanel = true;
            _showManualEntry = false;
        }

        if (_isLoading)
        {
            AddManualMarker();
            await LoadAsync(showLoading: true);
        }
    }

    private async Task LoadAsync(bool showLoading)
    {
        if (showLoading)
        {
            _isLoading = true;
        }

        _errorMessage = null;
        try
        {
            var items = await ApiClient.GetBloodTestsAsync();
            _bloodTests.Clear();
            _bloodTests.AddRange(items);
            EnsureProcessingPoll();
        }
        catch
        {
            _errorMessage = "No se pudieron cargar las analíticas.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleUploadPanel()
    {
        _showUploadPanel = !_showUploadPanel;
        _showManualEntry = false;
    }

    private void CloseUploadPanel()
        => _showUploadPanel = false;

    private void ToggleManualEntry()
    {
        _showManualEntry = !_showManualEntry;
        _showUploadPanel = false;
    }

    private void CloseManualEntry()
        => _showManualEntry = false;

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        _fileError = ValidateFile(file);
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
        _fileError = null;
    }

    private static string? ValidateFile(IBrowserFile file)
    {
        if (file.Size > MaxFileSize)
        {
            return "Este archivo supera los 20 MB.";
        }

        var extension = Path.GetExtension(file.Name);
        return AllowedExtensions.Contains(extension)
            ? null
            : "Elige un archivo PDF, PNG, JPG, TIFF o BMP.";
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null
            || ValidateFile(_selectedFile) is not null)
        {
            return;
        }

        _isUploading = true;
        _operationMessage = null;
        try
        {
            var result = await ApiClient.UploadBloodReportAsync(
                _selectedFile,
                _uploadDraft);
            var duplicateQuery =
                result.PossibleDuplicateBloodTestId.HasValue
                    ? $"?duplicateOf={result.PossibleDuplicateBloodTestId}"
                    : string.Empty;
            NavigationManager.NavigateTo(
                $"/health/blood-tests/{result.Id}{duplicateQuery}");
        }
        catch (HealthApiException ex)
        {
            _operationSeverity = Severity.Error;
            _operationMessage = ex.Message;
        }
        catch
        {
            _operationSeverity = Severity.Error;
            _operationMessage = "No se pudo subir el informe.";
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task CreateManualAsync()
    {
        _isCreatingManual = true;
        _operationMessage = null;
        try
        {
            var markers = _manualMarkers
                .Where(marker =>
                    !string.IsNullOrWhiteSpace(marker.Name)
                    && marker.Value.HasValue)
                .ToList();
            if (markers.Count == 0)
            {
                _operationSeverity = Severity.Warning;
                _operationMessage =
                    "Añade al menos un marcador con valor.";
                return;
            }

            _manualDraft.TestDate =
                _manualTestDate ?? DateTime.Today;
            _manualDraft.Markers = markers;
            await ApiClient.CreateManualBloodTestAsync(
                _manualDraft);
            ResetManualEntry();
            await LoadAsync(showLoading: false);
            _operationSeverity = Severity.Success;
            _operationMessage = "Analítica guardada.";
        }
        catch (HealthApiException ex)
        {
            _operationSeverity = Severity.Error;
            _operationMessage = ex.Message;
        }
        catch
        {
            _operationSeverity = Severity.Error;
            _operationMessage = "No se pudo guardar la analítica.";
        }
        finally
        {
            _isCreatingManual = false;
        }
    }

    private void ResetManualEntry()
    {
        _manualDraft =
            new AddBloodTestResource
            {
                TestDate = DateTime.Today
            };
        _manualTestDate = DateTime.Today;
        _manualMarkers.Clear();
        AddManualMarker();
        _showManualEntry = false;
    }

    private void AddManualMarker()
        => _manualMarkers.Add(new BloodTestMarkerResource());

    private void RemoveManualMarker(
        BloodTestMarkerResource marker)
    {
        _manualMarkers.Remove(marker);
        if (_manualMarkers.Count == 0)
        {
            AddManualMarker();
        }
    }

    private int CountFor(TestFilter filter)
        => _bloodTests.Count(item => filter switch
        {
            TestFilter.NeedsReview => item.RequiresReview,
            TestFilter.Processing =>
                item.ProcessingStatus
                    == BloodTestProcessingStatus.Processing
                && !IsInterrupted(item),
            TestFilter.Issues =>
                item.ProcessingStatus
                    == BloodTestProcessingStatus.ExtractionFailed
                || IsInterrupted(item),
            _ => true
        });

    private static bool IsInterrupted(BloodTestSummaryResource item)
        => item.ProcessingStatus
               == BloodTestProcessingStatus.Processing
           && item.UpdatedAtUtc != default
           && DateTime.UtcNow - item.UpdatedAtUtc
               > TimeSpan.FromMinutes(15);

    private static string GetStatusLabel(
        BloodTestSummaryResource item)
        => IsInterrupted(item)
            ? "Interrumpida"
            : HealthDisplayHelpers.GetProcessingStatusLabel(
                item.ProcessingStatus);

    private static string GetRequiredAction(
        BloodTestSummaryResource item)
        => IsInterrupted(item)
            ? "Vuelve a subirla o introduce los resultados"
            : item.RequiresReview
                ? "Revisar resultados"
                : item.ProcessingStatus
                    == BloodTestProcessingStatus.ExtractionFailed
                    ? "Introducir resultados"
                    : "Abrir";

    private static string GetStatusCardClass(
        BloodTestSummaryResource item)
        => IsInterrupted(item)
            ? "hs-status-card-problem"
            : item.ProcessingStatus switch
            {
                BloodTestProcessingStatus.Processing =>
                    "hs-status-card-pending",
                BloodTestProcessingStatus.ExtractionFailed =>
                    "hs-status-card-problem",
                _ when item.RequiresReview =>
                    "hs-status-card-pending",
                _ => "hs-status-card-processed"
            };

    private static string FormatMarkerCount(
        BloodTestSummaryResource item)
    {
        var count = item.MarkerCount;
        return $"{count} {(count == 1 ? "marcador" : "marcadores")}";
    }

    private static string FormatFileSize(long bytes)
        => bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.0} MB"
            : $"{Math.Max(1, bytes / 1024d):0} KB";

    private static string GetFileTypeLabel(
        IBrowserFile file)
        => Path.GetExtension(file.Name)
            .TrimStart('.')
            .ToUpperInvariant();

    private static string GetDetailRoute(Guid id)
        => $"/health/blood-tests/{id}";

    private void EnsureProcessingPoll()
    {
        if (!_bloodTests.Any(item =>
                item.ProcessingStatus
                    == BloodTestProcessingStatus.Processing
                && !IsInterrupted(item))
            || _pollTask is { IsCompleted: false })
        {
            return;
        }

        _pollCancellation?.Dispose();
        _pollCancellation = new CancellationTokenSource();
        _pollTask = PollProcessingTestsAsync(
            _pollCancellation.Token);
    }

    private async Task PollProcessingTestsAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(
                TimeSpan.FromSeconds(8));
            while (await timer.WaitForNextTickAsync(
                       cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(showLoading: false);
                    StateHasChanged();
                });

                if (!_bloodTests.Any(item =>
                        item.ProcessingStatus
                            == BloodTestProcessingStatus.Processing
                        && !IsInterrupted(item)))
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollCancellation is null)
        {
            return;
        }

        await _pollCancellation.CancelAsync();
        _pollCancellation.Dispose();
    }

    private enum TestFilter
    {
        All,
        NeedsReview,
        Processing,
        Issues
    }

    private sealed record FilterOption(
        TestFilter Key,
        string Label);
}
