@page "/health"
@page "/health/dashboard"
@inject HealthspanApiClient ApiClient
@inject TitleService TitleService
@inject NavigationManager NavigationManager

<PageTitle>Health</PageTitle>

<PageShell>
    <PageHeader Title="Health">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.UploadFile"
                       OnClick="OpenUpload">
                Upload report
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingState Message="Loading health..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Health unavailable"
                    Message="@_errorMessage"
                    ActionLabel="Retry"
                    OnAction="LoadAsync" />
    }
    else
    {
        @if (NeedsAttention.Count > 0)
        {
            <section class="hs-health-panel hs-attention-panel">
                <div class="hs-section-heading">
                    <MudText Typo="Typo.h6">Needs attention</MudText>
                    <span>@NeedsAttention.Count</span>
                </div>
                <div class="hs-compact-action-list">
                    @foreach (var test in NeedsAttention.Take(3))
                    {
                        <a href="@GetTestActionRoute(test)">
                            <div>
                                <strong>@GetTestAction(test)</strong>
                                <span>
                                    @test.TestDate.ToString("dd MMM")
                                    · @(test.LabName ?? "Unknown lab")
                                </span>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                     Size="Size.Small" />
                        </a>
                    }
                </div>
            </section>
        }

        @if (ProfileIncomplete)
        {
            <a class="hs-profile-prompt"
               href="/health/profile">
                <MudIcon Icon="@Icons.Material.Filled.Badge"
                         Size="Size.Small" />
                <span>Complete profile for more accurate ranges</span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                         Size="Size.Small" />
            </a>
        }

        <div class="hs-health-overview-grid">
            @if (LatestFinalizedTest is not null)
            {
                <a class="hs-health-overview-card"
                   href="@GetTestDetailRoute(LatestFinalizedTest.Id)">
                    <span class="hs-overview-label">Latest blood test</span>
                    <strong>
                        @LatestFinalizedTest.TestDate.ToString("dd MMM yyyy")
                    </strong>
                    <span>
                        @LatestFinalizedTest.MarkerCount markers
                    </span>
                </a>
            }
            else
            {
                <button type="button"
                        class="hs-health-overview-card"
                        @onclick="OpenUpload">
                    <span class="hs-overview-label">Blood tests</span>
                    <strong>Add first report</strong>
                </button>
            }

            @if (_summary?.LatestAssessmentDate is not null)
            {
                <a class="hs-health-overview-card"
                   href="/health/assessments">
                    <span class="hs-overview-label">Latest assessment</span>
                    <strong>
                        @_summary.LatestAssessmentAverageScore?.ToString("0.0")
                    </strong>
                    <span>
                        @_summary.LatestAssessmentDate.Value.ToString("dd MMM yyyy")
                    </span>
                </a>
            }
            else
            {
                <a class="hs-health-overview-card"
                   href="/health/assessments">
                    <span class="hs-overview-label">Assessment</span>
                    <strong>Record baseline</strong>
                </a>
            }
        </div>

        @if (PriorityMarkers.Count > 0)
        {
            <section class="hs-health-panel">
                <div class="hs-section-heading">
                    <MudText Typo="Typo.h6">
                        @(OutOfRangeMarkers.Count > 0
                            ? "Outside range"
                            : "Latest biomarkers")
                    </MudText>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               OnClick="OpenBiomarkers">
                        View all
                    </MudButton>
                </div>
                <div class="hs-overview-marker-list">
                    @foreach (var marker in PriorityMarkers)
                    {
                        <button type="button"
                                @onclick="() => OpenMarker(marker)">
                            <span>
                                @(marker.DisplayName
                                    ?? marker.MetricKey)
                            </span>
                            <strong>
                                @FormatMarkerValue(marker)
                            </strong>
                            <ClinicalStatusChip Status="@HealthDisplayHelpers.GetMarkerStatusLabel(marker.Status, marker.Value, marker.ReferenceMinValue, marker.ReferenceMaxValue)" />
                        </button>
                    }
                </div>
            </section>
        }
    }
</PageShell>

@code {
    private GetHealthDashboardSummaryResource? _summary;
    private HealthProfileResource? _profile;
    private readonly List<BloodTestSummaryResource> _bloodTests = [];
    private readonly List<LatestMarkerSnapshotResource> _markers = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    private List<BloodTestSummaryResource> NeedsAttention
        => _bloodTests
            .Where(test =>
                test.RequiresReview
                || test.ProcessingStatus
                    == BloodTestProcessingStatus.ExtractionFailed
                || IsInterrupted(test))
            .OrderByDescending(test => test.TestDate)
            .ToList();

    private BloodTestSummaryResource? LatestFinalizedTest
        => _bloodTests
            .Where(test =>
                test.ProcessingStatus
                    == BloodTestProcessingStatus.Processed)
            .OrderByDescending(test => test.TestDate)
            .FirstOrDefault();

    private List<LatestMarkerSnapshotResource>
        OutOfRangeMarkers
        => _markers
            .Where(marker =>
                marker.Status is MarkerStatus.High
                    or MarkerStatus.Low
                || HealthDisplayHelpers.IsOutOfRange(
                    marker.Value,
                    marker.ReferenceMinValue,
                    marker.ReferenceMaxValue))
            .OrderByDescending(marker => marker.TestDate)
            .ToList();

    private List<LatestMarkerSnapshotResource>
        PriorityMarkers
        => (OutOfRangeMarkers.Count > 0
                ? OutOfRangeMarkers
                : _markers
                    .OrderByDescending(marker =>
                        marker.TestDate)
                    .ToList())
            .Take(4)
            .ToList();

    private bool ProfileIncomplete
        => _profile is null
           || _profile.BiologicalSex
               == HealthBiologicalSex.Unknown
           || !_profile.DateOfBirth.HasValue;

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Health";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var summaryTask =
                ApiClient.GetDashboardSummaryAsync();
            var testsTask = ApiClient.GetBloodTestsAsync();
            var markersTask = ApiClient.GetLatestMarkersAsync();
            var profileTask = ApiClient.GetHealthProfileAsync();
            await Task.WhenAll(
                summaryTask,
                testsTask,
                markersTask,
                profileTask);

            _summary = summaryTask.Result;
            _profile = profileTask.Result;
            _bloodTests.Clear();
            _bloodTests.AddRange(testsTask.Result);
            _markers.Clear();
            _markers.AddRange(markersTask.Result);
        }
        catch
        {
            _errorMessage =
                "Health information could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenUpload()
        => NavigationManager.NavigateTo(
            "/health/blood-tests?upload=true");

    private void OpenBiomarkers()
        => NavigationManager.NavigateTo(
            "/health/biomarkers");

    private void OpenMarker(
        LatestMarkerSnapshotResource marker)
        => NavigationManager.NavigateTo(
            $"/health/biomarkers?marker={Uri.EscapeDataString(marker.MetricKey ?? string.Empty)}");

    private static string GetTestAction(
        BloodTestSummaryResource test)
        => IsInterrupted(test)
            ? "Upload again"
            : test.RequiresReview
                ? "Review blood test"
                : "Enter results";

    private static string GetTestActionRoute(
        BloodTestSummaryResource test)
        => test.RequiresReview
           || test.ProcessingStatus
               == BloodTestProcessingStatus.ExtractionFailed
            ? $"/health/blood-tests/{test.Id}/review"
            : GetTestDetailRoute(test.Id);

    private static string GetTestDetailRoute(Guid id)
        => $"/health/blood-tests/{id}";

    private static bool IsInterrupted(
        BloodTestSummaryResource test)
        => test.ProcessingStatus
               == BloodTestProcessingStatus.Processing
           && test.UpdatedAtUtc != default
           && DateTime.UtcNow - test.UpdatedAtUtc
               > TimeSpan.FromMinutes(15);

    private static string FormatMarkerValue(
        LatestMarkerSnapshotResource marker)
        => marker.Value.HasValue
            ? $"{marker.Value:0.##} {marker.Unit}".Trim()
            : "—";
}
