@page "/health/blood-tests/{BloodTestId:guid}"
@inject HealthspanApiClient ApiClient
@inject TitleService TitleService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Blood Test</PageTitle>

<PageShell>
    <div class="hs-compact-page-heading">
        <div>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="BackToList">
                Blood tests
            </MudButton>
            @if (_bloodTest is not null)
            {
                <MudText Typo="Typo.h5">
                    @_bloodTest.TestDate.ToString("dd MMM yyyy")
                </MudText>
                <MudText Typo="Typo.caption"
                         Class="hs-muted-copy">
                    @(_bloodTest.LabName ?? "Unknown lab")
                </MudText>
            }
        </div>

        @if (_bloodTest is not null)
        {
            <ClinicalStatusChip Status="@StatusLabel" />
        }
    </div>

    @if (_isLoading)
    {
        <LoadingState Message="Loading blood test..." />
    }
    else if (_bloodTest is null)
    {
        <ErrorState Title="Blood test unavailable"
                    Message="@(_errorMessage ?? "This blood test could not be loaded.")"
                    ActionLabel="Retry"
                    OnAction="LoadAsync" />
    }
    else
    {
        @if (DuplicateOf.HasValue)
        {
            <MudAlert Severity="Severity.Warning"
                      Dense="true"
                      Class="hs-soft-alert">
                This file matches an earlier upload.
                <MudLink Href="@GetDetailRoute(DuplicateOf.Value)">
                    Open earlier test
                </MudLink>
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_operationMessage))
        {
            <MudAlert Severity="@_operationSeverity"
                      Dense="true">
                @_operationMessage
            </MudAlert>
        }

        <section class="hs-health-panel hs-blood-test-status">
            @if (_bloodTest.ProcessingStatus
                == BloodTestProcessingStatus.Processing
                && !IsInterrupted)
            {
                <div class="hs-status-progress">
                    <MudProgressCircular Indeterminate="true"
                                         Color="Color.Info"
                                         Size="Size.Medium" />
                    <div>
                        <MudText Typo="Typo.h6">Reading report</MudText>
                        <MudText Typo="Typo.body2"
                                 Class="hs-muted-copy">
                            You can leave this screen.
                        </MudText>
                    </div>
                </div>
            }
            else if (IsInterrupted)
            {
                <div class="hs-action-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                             Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.h6">
                            Processing was interrupted
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Class="hs-muted-copy">
                            Upload the report again or enter the results manually.
                        </MudText>
                    </div>
                </div>
                <div class="hs-detail-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="OpenDeleteAndReupload">
                        Upload again
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="OpenReview">
                        Enter results
                    </MudButton>
                </div>
            }
            else if (_bloodTest.ProcessingStatus
                == BloodTestProcessingStatus.ExtractionFailed)
            {
                <div class="hs-action-state">
                    <MudIcon Icon="@Icons.Material.Filled.EditNote"
                             Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.h6">
                            Results need manual entry
                        </MudText>
                    </div>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="OpenReview">
                    Enter results
                </MudButton>
            }
            else if (_bloodTest.RequiresReview)
            {
                <div class="hs-action-state">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck"
                             Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.h6">
                            Results ready to review
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Class="hs-muted-copy">
                            @_bloodTest.MarkerCount suggested markers
                        </MudText>
                    </div>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="OpenReview">
                    Review results
                </MudButton>
            }
            else
            {
                <div class="hs-detail-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="OpenBiomarkers">
                        View biomarkers
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               OnClick="OpenReview">
                        Edit results
                    </MudButton>
                </div>
            }
        </section>

        @if (_bloodTest.Markers?.Count > 0)
        {
            <section class="hs-health-panel">
                <div class="hs-section-heading">
                    <MudText Typo="Typo.h6">Results</MudText>
                    <span class="hs-muted-copy">
                        @_bloodTest.Markers.Count
                    </span>
                </div>
                <div class="hs-marker-grid">
                    @foreach (var marker in _bloodTest.Markers)
                    {
                        <div class="hs-marker-card">
                            <div class="hs-marker-card-header">
                                <div class="hs-biomarker-name">
                                    @(marker.Name ?? "Unnamed marker")
                                </div>
                                <ClinicalStatusChip Status="@HealthDisplayHelpers.GetMarkerStatusLabel(marker.Status, marker.Value, marker.ReferenceMinValue, marker.ReferenceMaxValue)" />
                            </div>
                            <div class="hs-biomarker-value">
                                @FormatMarkerValue(marker)
                            </div>
                            @if (marker.ReferenceMinValue.HasValue
                                || marker.ReferenceMaxValue.HasValue)
                            {
                                <div class="hs-biomarker-range">
                                    @FormatReferenceRange(marker)
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(
            _bloodTest.SourceFileName))
        {
            <section class="hs-health-panel">
                <div class="hs-section-heading">
                    <div>
                        <MudText Typo="Typo.h6">Original report</MudText>
                        <MudText Typo="Typo.caption"
                                 Class="hs-muted-copy">
                            @_bloodTest.SourceFileName
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Disabled="_isLoadingDocument"
                               Loading="_isLoadingDocument"
                               OnClick="LoadDocumentAsync">
                        @(_documentUrl is null ? "View" : "Reload")
                    </MudButton>
                </div>

                @if (!string.IsNullOrWhiteSpace(_documentError))
                {
                    <MudAlert Severity="Severity.Warning"
                              Dense="true"
                              Class="mt-3">
                        @_documentError
                    </MudAlert>
                }

                @if (_documentUrl is not null)
                {
                    <div class="hs-report-preview mt-3">
                        @if (IsImageDocument)
                        {
                            <img src="@_documentUrl"
                                 alt="Original blood test report" />
                        }
                        else if (IsPdfDocument)
                        {
                            <iframe src="@_documentUrl"
                                    title="Original blood test report">
                            </iframe>
                        }
                    </div>
                }
            </section>
        }

        <div class="hs-danger-zone">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       OnClick="OpenDeleteConfirmation">
                Delete blood test
            </MudButton>
        </div>

        @if (_deleteConfirmationOpen)
        {
            <section class="hs-delete-confirmation"
                     role="alertdialog"
                     aria-label="Delete blood test confirmation">
                <div>
                    <MudText Typo="Typo.h6">
                        Delete this blood test?
                    </MudText>
                    <MudText Typo="Typo.body2"
                             Class="hs-muted-copy">
                        The report and all marker results will be removed.
                    </MudText>
                </div>
                <div class="hs-delete-confirmation-actions">
                    <MudButton Variant="Variant.Text"
                               Disabled="_isDeleting"
                               OnClick="CloseDeleteConfirmation">
                        Cancel
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Disabled="_isDeleting"
                               Loading="_isDeleting"
                               OnClick="DeleteAsync">
                        @(_deleteAndReupload
                            ? "Delete and upload"
                            : "Delete")
                    </MudButton>
                </div>
            </section>
        }
    }
</PageShell>

@code {
    [Parameter] public Guid BloodTestId { get; set; }

    [SupplyParameterFromQuery(Name = "duplicateOf")]
    public Guid? DuplicateOf { get; set; }

    private GetBloodTestResource? _bloodTest;
    private bool _isLoading = true;
    private bool _isDeleting;
    private bool _deleteConfirmationOpen;
    private bool _deleteAndReupload;
    private bool _isLoadingDocument;
    private string? _errorMessage;
    private string? _operationMessage;
    private string? _documentError;
    private Severity _operationSeverity = Severity.Info;
    private BloodTestDocumentContent? _documentContent;
    private string? _documentUrl;
    private CancellationTokenSource? _pollCancellation;
    private Task? _pollTask;

    private bool IsInterrupted
        => _bloodTest?.ProcessingStatus
               == BloodTestProcessingStatus.Processing
           && _bloodTest.UpdatedAtUtc != default
           && DateTime.UtcNow - _bloodTest.UpdatedAtUtc
               > TimeSpan.FromMinutes(15);

    private string StatusLabel
        => IsInterrupted
            ? "Interrupted"
            : HealthDisplayHelpers.GetProcessingStatusLabel(
                _bloodTest!.ProcessingStatus);

    private bool IsPdfDocument
        => string.Equals(
            _documentContent?.ContentType,
            "application/pdf",
            StringComparison.OrdinalIgnoreCase);

    private bool IsImageDocument
        => _documentContent?.ContentType.StartsWith(
            "image/",
            StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnParametersSetAsync()
    {
        TitleService.Title = "Blood Test";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _bloodTest = await ApiClient.GetBloodTestAsync(
                BloodTestId);
            if (_bloodTest?.ProcessingStatus
                    == BloodTestProcessingStatus.Processing
                && !IsInterrupted)
            {
                EnsurePoll();
            }
        }
        catch
        {
            _bloodTest = null;
            _errorMessage = "Blood test could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void EnsurePoll()
    {
        if (_pollTask is { IsCompleted: false })
        {
            return;
        }

        _pollCancellation?.Dispose();
        _pollCancellation = new CancellationTokenSource();
        _pollTask = PollAsync(_pollCancellation.Token);
    }

    private async Task PollAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            var refreshCount = 0;
            while (true)
            {
                var delay = refreshCount <= 2
                    ? TimeSpan.FromSeconds(5)
                    : refreshCount <= 8
                        ? TimeSpan.FromSeconds(10)
                        : TimeSpan.FromSeconds(20);
                await Task.Delay(
                    delay,
                    cancellationToken);

                var updated = await ApiClient.GetBloodTestAsync(
                    BloodTestId,
                    cancellationToken);
                await InvokeAsync(() =>
                {
                    _bloodTest = updated;
                    StateHasChanged();
                });

                if (updated?.ProcessingStatus
                    != BloodTestProcessingStatus.Processing)
                {
                    break;
                }

                refreshCount++;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            await InvokeAsync(() =>
            {
                _operationSeverity = Severity.Warning;
                _operationMessage =
                    "Status could not be refreshed.";
                StateHasChanged();
            });
        }
    }

    private void OpenReview()
        => NavigationManager.NavigateTo(
            $"/health/blood-tests/{BloodTestId}/review");

    private void OpenBiomarkers()
        => NavigationManager.NavigateTo("/health/biomarkers");

    private void BackToList()
        => NavigationManager.NavigateTo("/health/blood-tests");

    private void OpenDeleteConfirmation()
    {
        _deleteAndReupload = false;
        _deleteConfirmationOpen = true;
    }

    private void OpenDeleteAndReupload()
    {
        _deleteAndReupload = true;
        _deleteConfirmationOpen = true;
    }

    private void CloseDeleteConfirmation()
    {
        _deleteConfirmationOpen = false;
        _deleteAndReupload = false;
    }

    private async Task DeleteAsync()
    {
        _isDeleting = true;
        try
        {
            await ApiClient.DeleteBloodTestAsync(BloodTestId);
            NavigationManager.NavigateTo(
                _deleteAndReupload
                    ? "/health/blood-tests?upload=true"
                    : "/health/blood-tests");
        }
        catch
        {
            _operationSeverity = Severity.Error;
            _operationMessage =
                "Blood test could not be deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task LoadDocumentAsync()
    {
        _isLoadingDocument = true;
        _documentError = null;
        try
        {
            await RevokeDocumentUrlAsync();
            _documentContent =
                await ApiClient.GetBloodTestDocumentAsync(
                    BloodTestId);
            if (_documentContent is null)
            {
                _documentError =
                    "The original report is unavailable.";
                return;
            }

            _documentUrl = await JS.InvokeAsync<string>(
                "healthspanDocuments.createObjectUrl",
                _documentContent.Content,
                _documentContent.ContentType);
        }
        catch
        {
            _documentError =
                "The original report could not be loaded.";
        }
        finally
        {
            _isLoadingDocument = false;
        }
    }

    private async Task RevokeDocumentUrlAsync()
    {
        if (_documentUrl is null)
        {
            return;
        }

        await JS.InvokeVoidAsync(
            "healthspanDocuments.revokeObjectUrl",
            _documentUrl);
        _documentUrl = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollCancellation is not null)
        {
            await _pollCancellation.CancelAsync();
            _pollCancellation.Dispose();
        }

        try
        {
            await RevokeDocumentUrlAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string FormatMarkerValue(
        BloodTestMarkerResource marker)
        => marker.Value.HasValue
            ? $"{marker.Value:0.##} {marker.Unit}".Trim()
            : marker.RawValueText ?? "—";

    private static string FormatReferenceRange(
        BloodTestMarkerResource marker)
        => (marker.ReferenceMinValue,
            marker.ReferenceMaxValue) switch
        {
            (not null, not null) =>
                $"{marker.ReferenceMinValue:0.##}–{marker.ReferenceMaxValue:0.##} {marker.Unit}".Trim(),
            (not null, null) =>
                $"≥ {marker.ReferenceMinValue:0.##} {marker.Unit}".Trim(),
            (null, not null) =>
                $"≤ {marker.ReferenceMaxValue:0.##} {marker.Unit}".Trim(),
            _ => "—"
        };

    private static string GetDetailRoute(Guid id)
        => $"/health/blood-tests/{id}";
}
