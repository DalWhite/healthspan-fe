@page "/profile"
@page "/training/insights"
@using System.Net.Http.Json
@using healthspan_fe_wasm_pwa.Components.Profile
@inject HealthspanApiClient ApiClient
@inject HttpClient Http
@inject TitleService TitleService
@inject BillingClient Billing

<PageTitle>Insights de entrenamiento</PageTitle>

<PageShell Class="hs-insights-page">
    <PageHeader Title="Insights" Subtitle="@SelectedWeekRangeLabel">
        <Actions>
            @if (_weeklySnapshots.Count > 0)
            {
                <MudSelect T="DateTime"
                           Value="_selectedWeekStart"
                           ValueChanged="OnWeekChanged"
                           Label="Semana"
                           Dense="true"
                           Variant="Variant.Outlined"
                           Class="hs-insights-week-select">
                    @foreach (var snapshot in _weeklySnapshots)
                    {
                        <MudSelectItem T="DateTime"
                                       Value="@snapshot.WeekStart">
                            @FormatWeekRange(snapshot.WeekStart)
                        </MudSelectItem>
                    }
                </MudSelect>
            }
        </Actions>
    </PageHeader>

    @* A1 (pago-ux-spec-t_5b46e650 §2): paywall SOLO en la capa de análisis
       avanzado. El log, las rutinas y el historial nunca se bloquean (D1):
       la card es un aviso con CTA, no un candado. *@
    @if (_showPaywall)
    {
        <PaywallUpgradeCard />
    }

    @if (_isLoading)
    {
        <LoadingState Message="Cargando insights…" />
    }
    else if (SelectedWeek is null)
    {
        <EmptyState Icon="@Icons.Material.Filled.Insights"
                    Title="Aún no hay datos de entrenamiento"
                    Subtitle="Registra un entreno para empezar a ver la carga semanal." />
    }
    else
    {
        @if (_errorMessages.Count > 0)
        {
            <MudAlert Severity="Severity.Warning"
                      Dense="true">
                @string.Join(" ", _errorMessages)
            </MudAlert>
        }

        <div class="hs-insights-kpis">
            <div class="hs-insights-kpi">
                <span>Carga</span>
                <strong>@FormatLoad(SelectedWeek.TotalLoad)</strong>
            </div>
            <div class="hs-insights-kpi">
                <span>Sesiones</span>
                <strong>@SelectedWeek.WorkoutCount</strong>
            </div>
            <div class="hs-insights-kpi">
                <span>Ejercicios</span>
                <strong>@SelectedWeek.ExerciseCount</strong>
            </div>
            <div class="hs-insights-kpi">
                <span>Cambio</span>
                <strong>@GetWeekDeltaLabel()</strong>
            </div>
        </div>

        <TrainingActivityHeatmap ActivityDays="_activityDays" />

        <div class="hs-insights-layout">
            <section class="hs-insights-map-card hs-surface"
                     aria-labelledby="muscle-load-title">
                <div class="hs-insights-section-head">
                    <div>
                        <MudText Typo="Typo.h6"
                                 id="muscle-load-title">
                            Carga muscular
                        </MudText>
                        @if (_healthProfile.BiologicalSex == HealthBiologicalSex.Unknown)
                        {
                            <a href="/health/profile"
                               class="hs-insights-profile-link">
                                Define tu perfil corporal
                            </a>
                        }
                    </div>

                    <div class="hs-insights-view-switch"
                         role="group"
                         aria-label="Vista corporal">
                        @foreach (var view in BodyViews)
                        {
                            <button type="button"
                                    class="@(_bodyViewMode == view.Key ? "is-active" : null)"
                                    aria-pressed="@((_bodyViewMode == view.Key).ToString().ToLowerInvariant())"
                                    @onclick="() => SetBodyViewMode(view.Key)">
                                @view.Label
                            </button>
                        }
                    </div>
                </div>

                <MuscleLoadBodyMap Regions="SelectedWeek.Regions"
                                   ViewMode="@_bodyViewMode"
                                   BiologicalSex="_healthProfile.BiologicalSex" />
            </section>

            <aside class="hs-insights-side">
                <section class="hs-insights-list-card hs-surface">
                    <MudText Typo="Typo.h6">Zonas más cargadas</MudText>
                    @if (!TopSelectedRegions.Any())
                    {
                        <span class="hs-muted-copy">Sin carga mapeada.</span>
                    }
                    else
                    {
                        @foreach (var region in TopSelectedRegions)
                        {
                            <div class="hs-insights-ranked-row">
                                <div>
                                    <strong>@region.Label</strong>
                                    <span>@region.Group</span>
                                </div>
                                <span>@FormatLoad(region.Load)</span>
                            </div>
                        }
                    }
                </section>

                <section class="hs-insights-list-card hs-surface">
                    <div class="hs-insights-section-head">
                        <MudText Typo="Typo.h6">Ejercicios destacados</MudText>
                        <a href="/training/history"
                           class="hs-insights-profile-link">
                            Historial
                        </a>
                    </div>

                    @if (!TopExercises.Any())
                    {
                        <span class="hs-muted-copy">Sin ejercicios esta semana.</span>
                    }
                    else
                    {
                        @foreach (var exercise in TopExercises)
                        {
                            <div class="hs-insights-ranked-row">
                                <div>
                                    <strong>@exercise.Name</strong>
                                    <span>@exercise.Prescription</span>
                                </div>
                                <span>@FormatLoad(exercise.Load)</span>
                            </div>
                        }
                    }
                </section>
            </aside>
        </div>
    }
</PageShell>

@code {
    private static readonly (string Key, string Label)[] BodyViews =
    [
        ("both", "Ambos"),
        ("front", "Frontal"),
        ("back", "Posterior")
    ];

    private bool _isLoading = true;
    private bool _showPaywall;
    private DateTime _selectedWeekStart;
    private string _bodyViewMode = "both";
    private HealthProfileResource _healthProfile = new();
    private readonly List<string> _errorMessages = [];
    private readonly List<WeeklyBodyLoadSnapshot> _weeklySnapshots = [];
    private readonly List<TrainingDayActivityResource> _activityDays = [];

    private WeeklyBodyLoadSnapshot? SelectedWeek
        => _weeklySnapshots.FirstOrDefault(
            snapshot => snapshot.WeekStart == _selectedWeekStart);

    private WeeklyBodyLoadSnapshot? PreviousSelectedWeek
    {
        get
        {
            var selectedIndex = _weeklySnapshots.FindIndex(
                snapshot => snapshot.WeekStart == _selectedWeekStart);
            return selectedIndex >= 0
                   && selectedIndex + 1 < _weeklySnapshots.Count
                ? _weeklySnapshots[selectedIndex + 1]
                : null;
        }
    }

    private IEnumerable<ExerciseInsight> TopExercises
        => (SelectedWeek?.Sessions ?? [])
            .SelectMany(session => session.Exercises)
            .Where(exercise => !string.IsNullOrWhiteSpace(exercise.Name))
            .GroupBy(
                exercise => exercise.Name,
                StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var representative = group
                    .OrderByDescending(exercise => exercise.Load)
                    .First();
                return new ExerciseInsight(
                    group.Key,
                    representative.Prescription,
                    group.Sum(exercise => exercise.Load));
            })
            .OrderByDescending(exercise => exercise.Load)
            .Take(5);

    private IEnumerable<MuscleLoadRegionResource> TopSelectedRegions
        => SelectedWeek is null
            ? []
            : SelectedWeek.Regions
                .Where(region => region.Load > 0)
                .OrderByDescending(region => region.Load)
                .Take(5);

    private string SelectedWeekRangeLabel
        => SelectedWeek is null
            ? "Carga muscular semanal"
            : FormatWeekRange(SelectedWeek.WeekStart);

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Insights de entrenamiento";
        _ = LoadPaywallStateAsync();
        await LoadInsightsAsync();
    }

    private async Task LoadPaywallStateAsync()
    {
        try
        {
            var subscription = await Billing.GetSubscriptionAsync();
            // Premium visible (trial/active/past_due o cancelación futura) →
            // sin paywall. none/canceled/incomplete → aviso de mejora (A1).
            var live = SubscriptionStates.IsLive(subscription.Status)
                || (subscription.CancelAtPeriodEnd
                    && subscription.Status is not SubscriptionStates.Canceled);
            _showPaywall = !live;
        }
        catch (BillingApiException)
        {
            // Sin confirmación de suscripción no se interrumpe el análisis.
            _showPaywall = false;
        }
        finally
        {
            // La carga arranca desacoplada de LoadInsightsAsync: sin este render
            // el aviso de Premium solo aparecía si otra carga terminaba después,
            // y bajo carga el orden se invertía (flake en CI).
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadInsightsAsync()
    {
        _isLoading = true;
        _errorMessages.Clear();

        try
        {
            var weeklyTask = LoadWeeklyTrainingSummaryAsync();
            var profileTask = LoadHealthProfileAsync();
            await Task.WhenAll(weeklyTask, profileTask);

            _healthProfile = await profileTask;
            var summary = await weeklyTask;
            _weeklySnapshots.Clear();
            _weeklySnapshots.AddRange(
                summary.Weeks
                .OrderByDescending(snapshot => snapshot.WeekStart));
            _activityDays.Clear();
            _activityDays.AddRange(summary.ActivityDays);
            if (_weeklySnapshots.Count > 0)
            {
                _selectedWeekStart = _weeklySnapshots[0].WeekStart;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<WeeklyTrainingSummaryResource>
        LoadWeeklyTrainingSummaryAsync()
    {
        try
        {
            return await Http.GetFromJsonAsync<WeeklyTrainingSummaryResource>(
                       "/Workouts/weekly-summary?weeks=12")
                   ?? new WeeklyTrainingSummaryResource();
        }
        catch
        {
            _errorMessages.Add("El resumen de entrenamiento no está disponible.");
            return new WeeklyTrainingSummaryResource();
        }
    }

    private async Task<HealthProfileResource> LoadHealthProfileAsync()
    {
        try
        {
            return await ApiClient.GetHealthProfileAsync();
        }
        catch
        {
            _errorMessages.Add("Tu perfil personal no está disponible.");
            return new HealthProfileResource();
        }
    }

    private void SetBodyViewMode(string viewMode)
        => _bodyViewMode = viewMode;

    private void OnWeekChanged(DateTime weekStart)
        => _selectedWeekStart = weekStart;

    private string GetWeekDeltaLabel()
    {
        var selected = SelectedWeek;
        var previous = PreviousSelectedWeek;
        if (selected is null || previous is null || previous.TotalLoad <= 0)
        {
            return "—";
        }

        var delta =
            (selected.TotalLoad - previous.TotalLoad)
            / previous.TotalLoad;
        return $"{delta:+0%;-0%;0%}";
    }

    private static string FormatWeekRange(DateTime weekStart)
        => $"{weekStart:dd MMM} – {weekStart.AddDays(6):dd MMM yyyy}";

    private static string FormatLoad(double load)
        => load <= 0
            ? "0 kg"
            : load >= 100
                ? $"{Math.Round(load):0} kg"
                : $"{load:0.#} kg";

    private sealed record ExerciseInsight(
        string Name,
        string? Prescription,
        double Load);
}
