@page "/health/profile"
@inject HealthspanApiClient ApiClient
@inject TitleService TitleService
@inject ISnackbar Snackbar

<PageTitle>Personal profile</PageTitle>

<PageShell Narrow="true" Class="hs-personal-profile-page">
    <PageHeader Title="Personal profile"
                Subtitle="Date of birth and biological sex adjust health ranges." />

    @if (_isLoading)
    {
        <LoadingState Message="Loading profile..." />
    }
    else
    {
        <div class="hs-personal-profile-card hs-surface">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Dense="true"
                          Class="mb-3">
                    @_errorMessage
                </MudAlert>
            }

            <div class="hs-personal-profile-grid">
                <MudTextField @bind-Value="_name"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100" />

                <MudDatePicker Label="Date of birth"
                               Date="_dateOfBirth"
                               DateChanged="OnDateOfBirthChanged"
                               MinDate="@MinDateOfBirth"
                               MaxDate="@MaxDateOfBirth"
                               Error="@(_dateOfBirthError is not null)"
                               ErrorText="@_dateOfBirthError"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />

                <MudSelect T="HealthBiologicalSex"
                           Label="Biological sex"
                           @bind-Value="_biologicalSex"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="HealthBiologicalSex.Unknown">Not specified</MudSelectItem>
                    <MudSelectItem Value="HealthBiologicalSex.Female">Female</MudSelectItem>
                    <MudSelectItem Value="HealthBiologicalSex.Male">Male</MudSelectItem>
                </MudSelect>

                <MudNumericField T="int?"
                                 @bind-Value="_heightCm"
                                 Label="Height (cm)"
                                 Min="80"
                                 Max="250"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />

                <MudNumericField T="int?"
                                 @bind-Value="_weightKg"
                                 Label="Current weight (kg)"
                                 Min="20"
                                 Max="500"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </div>

            <div class="hs-personal-profile-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_isSaving || _dateOfBirthError is not null"
                           OnClick="SaveAsync">
                    @(_isSaving ? "Saving..." : "Save")
                </MudButton>
            </div>
        </div>
    }
</PageShell>

@code {
    private string? _name;
    private DateTime? _dateOfBirth;
    private HealthBiologicalSex _biologicalSex;
    private int? _heightCm;
    private int? _weightKg;
    private DateOnly? _loadedDateOfBirth;
    private HealthBiologicalSex _loadedBiologicalSex;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _dateOfBirthError;

    // Same bounds the backend enforces on PUT /healthprofile: a date of birth
    // is only meaningful as a real past date.
    private static readonly DateTime MinDateOfBirth = new(1900, 1, 1);
    private static DateTime MaxDateOfBirth => DateTime.Today.AddDays(-1);

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Personal profile";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var profile = await ApiClient.GetHealthProfileAsync();
            _name = profile.Name;
            _dateOfBirth = profile.DateOfBirth?.ToDateTime(
                TimeOnly.MinValue);
            _biologicalSex = profile.BiologicalSex;
            _loadedDateOfBirth = profile.DateOfBirth;
            _loadedBiologicalSex = profile.BiologicalSex;
            _heightCm = profile.HeightCm;
            _weightKg = profile.WeightKg;
            // An impossible date already stored (the QA repro) must surface on
            // the field that fixes it, not stay hidden until the next save.
            _dateOfBirthError = ValidateDateOfBirthInline();
        }
        catch
        {
            _errorMessage = "Profile could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnDateOfBirthChanged(DateTime? value)
    {
        _dateOfBirth = value?.Date;
        // A picked or parsed date is a complete value, so it is safe to
        // validate now: Save can never fire with an impossible date and the
        // reason appears next to the field, not as a generic alert.
        _dateOfBirthError = ValidateDateOfBirthInline();
    }

    // null when the date is acceptable, otherwise the inline message.
    // Kept in sync with PUT /healthprofile so the form never accepts what
    // the backend would reject.
    private string? ValidateDateOfBirthInline()
    {
        if (_dateOfBirth is null)
        {
            return null;
        }

        if (_dateOfBirth.Value.Date > MaxDateOfBirth)
        {
            return "Date of birth must be a date before today.";
        }

        if (_dateOfBirth.Value.Date < MinDateOfBirth)
        {
            return $"Date of birth must be {MinDateOfBirth:yyyy-MM-dd} or later.";
        }

        return null;
    }

    private async Task SaveAsync()
    {
        _dateOfBirthError = ValidateDateOfBirthInline();
        if (_dateOfBirthError is not null)
        {
            // SAVE stays blocked; the field itself says what to fix.
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            DateOnly? submittedDate = _dateOfBirth.HasValue
                ? DateOnly.FromDateTime(_dateOfBirth.Value)
                : null;
            var rangeInputsChanged =
                submittedDate != _loadedDateOfBirth
                || _biologicalSex
                    != _loadedBiologicalSex;
            var saved = await ApiClient.UpdateHealthProfileAsync(
                new UpdateHealthProfileResource
                {
                    Name = _name,
                    DateOfBirth = submittedDate,
                    BiologicalSex = _biologicalSex,
                    HeightCm = _heightCm,
                    WeightKg = _weightKg
                });

            _name = saved.Name;
            _dateOfBirth = saved.DateOfBirth?.ToDateTime(
                TimeOnly.MinValue);
            _biologicalSex = saved.BiologicalSex;
            _heightCm = saved.HeightCm;
            _weightKg = saved.WeightKg;
            _loadedDateOfBirth = saved.DateOfBirth;
            _loadedBiologicalSex = saved.BiologicalSex;
            Snackbar.Add(
                rangeInputsChanged
                    ? "Profile saved. Blood test ranges refreshed."
                    : "Profile saved.",
                Severity.Success);
        }
        catch (HealthApiException ex)
            when (ex.Code == "date_of_birth_invalid")
        {
            // Backend rule mapped back onto the field. The typed date stays in
            // the picker, so nothing the user wrote is lost.
            _dateOfBirthError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Date of birth must be a date before today."
                : ex.Message;
        }
        catch
        {
            _errorMessage = "Profile could not be saved.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
