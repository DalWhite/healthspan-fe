@page "/exercises/types/{ExerciseTypeId:int}/details"
@inject HttpClient Http
@using ApexCharts
@inject TitleService TitleService
@rendermode RenderMode.InteractiveWebAssembly


@if (exercises == null)
{
    <MudProgressCircular Color="MudBlazor.Color.Default" Indeterminate="true" />
}
else
{
    <MudCollapse Expanded="_expanded">
        <MudStack>
            @foreach (var exercise in exercises)
            {
                <MudPaper Class="pa-3">@exercise.Workout.Date.ToShortDateString() - Series: @exercise.Series -
                    Reps: @exercise.Repetitions - V: @exercise.Volume Kg - RM: @exercise.MaxRepetition Kg - I:
                    @exercise.Intensity %</MudPaper>
            }
        </MudStack>
    </MudCollapse>
}
<MudDivider />
<MudButton style="float: right; margin-top: 30px;" OnClick="OnExpandCollapseClick">@(_expanded ? "Collapse" : "Expand")
</MudButton>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">Theoric RM Max: @kpis?.MaxRM Kg on
            @kpis?.MaxRMDate.ToShortDateString()</MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">Last theoric RM: @kpis?.Current1RM Kg
        </MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">ΔRM in last 3 months:
            @kpis?.RMDiferentialInLast3Months Kg</MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">Weekly workout frecuency:
            @kpis?.WeeklyFrequency</MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">Last session PE:
            @kpis?.PerceibedEffortLastSession</MudPaper>
    </MudItem>
    <MudItem xs="12">
        <div>
            @if (_rmTrends != null && _volumeTrends != null && _intensityTrends != null)
            {
                <ApexChart @ref="rmChart" TItem="DataPoint" Title="Evolution" Options="options">

                    <ApexPointSeries TItem="DataPoint" Items="_rmTrends" Name="RM" SeriesType="ApexCharts.SeriesType.Line"
                        XValue='e => e.Time.ToShortDateString()' YAggregate="e => e.Average(e=> e.Data)"/>
                    <ApexPointSeries TItem="DataPoint" Items="_volumeTrends" Name="Volume" SeriesType="ApexCharts.SeriesType.Line"
                        XValue='e => e.Time.ToShortDateString()' YAggregate="e => e.Average(e=> e.Data)"/>
                    <ApexPointSeries TItem="DataPoint" Items="_intensityTrends" Name="Intensity" SeriesType="ApexCharts.SeriesType.Line"
                        XValue='e => e.Time.ToShortDateString()' YAggregate="e => e.Average(e=> e.Data)" />

                </ApexChart>
            }
        </div>
    </MudItem>
</MudGrid>


@code {

    [Parameter]
    public int ExerciseTypeId { get; set; }

    private ApexChart<DataPoint> rmChart;
    private ApexChartOptions<DataPoint> options { get; set; } = new();
    private ApexChartOptions<DataPoint> mobileOptions { get; set; } = new();
        
    private List<DataPoint> _rmTrends { get; set; }
    private List<DataPoint> _volumeTrends { get; set; }
    private List<DataPoint> _intensityTrends { get; set; }

    private GetExerciseResource[]? exercises;
    private GetExerciseTypeKpis? kpis;
    bool _expanded = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        InitializeChartOptions();
        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync()
    {
        var exercisesTask = Http.GetFromJsonAsync<GetExerciseResource[]>($"/Exercises?exerciseTypeId={ExerciseTypeId}");
        var kpisTask = Http.GetFromJsonAsync<GetExerciseTypeKpis>($"/Exercises/{ExerciseTypeId}/kpis");
        var rmTrendsTask = Http.GetFromJsonAsync<GetExerciseTypeTrends>($"/Exercises/{ExerciseTypeId}/trends?type=RM");
        var volumeTrendsTask = Http.GetFromJsonAsync<GetExerciseTypeTrends>($"/Exercises/{ExerciseTypeId}/trends?type=Volume");
        var intensityTrendsTask = Http.GetFromJsonAsync<GetExerciseTypeTrends>($"/Exercises/{ExerciseTypeId}/trends?type=Intensity");

        await Task.WhenAll(new Task[] { rmTrendsTask, volumeTrendsTask, intensityTrendsTask, exercisesTask, kpisTask });

        _rmTrends = rmTrendsTask.Result.Points;
        _volumeTrends = volumeTrendsTask.Result.Points;
        _intensityTrends = intensityTrendsTask.Result.Points;

        exercises = exercisesTask.Result;
        kpis = kpisTask.Result;

        TitleService.Title = exercises.FirstOrDefault().Type.Name;

    }
    private void InitializeChartOptions()
    {
        options.Stroke = new Stroke {Curve = Curve.Smooth};
        options.Yaxis = new List<YAxis>();

        options.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "RM" },
                SeriesName = "RM",
                DecimalsInFloat = 0,
                Labels = new YAxisLabels{Formatter =  @"function (value) {
                    return Number(value).toLocaleString() + ' Kg';}"}
            });
        options.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "Volume" },
                SeriesName = "Volume",
                DecimalsInFloat = 0,
                Labels = new YAxisLabels{Formatter =  @"function (value) {
                    return Number(value).toLocaleString() + ' Kg';}"}
            });
        options.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "Intensity" },
                SeriesName = "Intensity",
                DecimalsInFloat = 0,
                Opposite = true,
                Labels = new YAxisLabels{Formatter =  @"function (value) {
                    return Number(value).toLocaleString() + ' %';}"}
            });

        mobileOptions.Chart.Toolbar = new Toolbar{Show = false};
        mobileOptions.Yaxis = new List<YAxis>();
        
        mobileOptions.Xaxis = new XAxis { Labels = new XAxisLabels {  Rotate = -45, RotateAlways = true } };
        mobileOptions.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "RM" },
                SeriesName = "RM",
                DecimalsInFloat = 0,
                Show = false,
                Labels = new YAxisLabels
                {
                    Formatter =  @"function (value) {
                    return Number(value).toLocaleString() + ' Kg';}"
                }
            });
        mobileOptions.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "Volume" },
                SeriesName = "Volume",
                DecimalsInFloat = 0,
                Show = false,
                Labels = new YAxisLabels
                {
                    Formatter =  @"function (value) {
                    return Number(value).toLocaleString() + ' Kg';}"
                }
            });
        mobileOptions.Yaxis.Add(new YAxis
            {
                Title = new AxisTitle { Text = "Intensity" },
                SeriesName = "Intensity",
                DecimalsInFloat = 0,
                Opposite = true,
                Show = false,
                Labels = new YAxisLabels
                {
                    Formatter =  @"function (value) {
                    return Number(value).toLocaleString() + ' %';}"
                }
            });

        options.Responsive = new List<Responsive>{new Responsive(){
            Breakpoint = 500,
            Options = mobileOptions}};
    }
    private void OnExpandCollapseClick()
    {
        _expanded = !_expanded;
    }
    public class GetExerciseTypeTrends
    {
        public List<DataPoint> Points { get; set; }
    }

    public class DataPoint
    {
        public decimal Data { get; set; }
        public DateTime Time { get; set; }
    }
    public class GetExerciseTypeKpis
    {
        public float MaxRM { get; set; }
        public DateTime MaxRMDate { get; set; }
        public float Current1RM { get; set; }
        public int RMDiferentialInLast3Months { get; set; }
        public int WeeklyFrequency { get; set; }
        public int PerceibedEffortLastSession { get; set; }
    }

    public class GetExerciseResource
    {
        public Guid? Id { get; set; }
        public int? Series { get; set; }
        public int? Repetitions { get; set; }
        public int? Weight { get; set; }
        public double? MaxRepetition { get; set; }
        public int? Volume { get; set; }
        public double? Intensity { get; set; }
        public GetExerciseTypeResource? Type { get; set; }
        public GetWorkoutResource? Workout { get; set; }
    }
}