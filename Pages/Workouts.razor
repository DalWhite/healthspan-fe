@page "/workouts"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<PageTitle>Workouts</PageTitle>

@if (workouts == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudTable Items="workouts" Hover="true" SortLabel="Sort By" Elevation="0" Dense="true" Breakpoint="Breakpoint.None"
        Filter="new Func<GetWorkoutResource,bool>(FilterFunc1)">
        <ToolBarContent>
            <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel InitialDirection="SortDirection.Ascending"
                    SortBy="new Func<GetWorkoutResource, object>(x=>x.Date)">Date</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<GetWorkoutResource, object>(x=>x.Type)">Type</MudTableSortLabel>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{50, 100}" />
        </PagerContent>
    </MudTable>
}
<MudFab @onclick="GoToCreateWorkout" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
    style="float: right;" />

@code {
    private GetWorkoutResource[]? workouts;
    private string searchString1 = "";

    protected override async Task OnInitializedAsync()
    {
        workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>("workouts");
    }
    protected override void OnInitialized()
    {
        TitleService.Title = "Workouts";
    }

    public class GetWorkoutResource
    {
        public Guid Id { get; set; }
        public DateTime Date { get; set; }
        public string? Type { get; set; }
        public Guid? UserId { get; set; }
    }
    private void GoToCreateWorkout()
    {
        NavigationManager.NavigateTo("/workouts/create");
    }
    private bool FilterFunc1(GetWorkoutResource element) => FilterFunc(element, searchString1);

    private bool FilterFunc(GetWorkoutResource element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (string.IsNullOrWhiteSpace(element.Type))
            return false;
        string dateString = element.Date.ToString("dd/MM/yyyy");

        if (dateString.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Type.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }
}
