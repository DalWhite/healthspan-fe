        => NavigationManager.NavigateTo("/training/today");

    private static string BuildProgressionRoute(int exerciseTypeId)
        => $"/training/library/{exerciseTypeId}?returnUrl={Uri.EscapeDataString("/training/history")}";

    private static string BuildExerciseEditRoute(Guid exerciseId)
        => $"/training/history/{exerciseId}/edit?returnUrl={Uri.EscapeDataString("/training/history")}";

    private static string BuildAddExerciseRoute(GetWorkoutResource workout)
    {
        var query =
            $"workoutId={workout.Id}&returnUrl={Uri.EscapeDataString("/training/history")}";
        if (workout.Date.HasValue)
        {
            query += $"&date={workout.Date.Value:yyyy-MM-dd}";
        }

        return $"/exercises/create?{query}";
    }

    private string FormatLoadedCount()
    {
        var loaded = _workouts?.Count ?? 0;
        return loaded == _totalCount
            ? FormatWorkoutCount(_totalCount)
            : $"{loaded} of {_totalCount} workouts";
    }

    private static int ReadTotalCount(HttpResponseMessage response, int fallback)
    {
        if (response.Headers.TryGetValues("X-Total-Count", out var values)
            && int.TryParse(values.FirstOrDefault(), out var totalCount))
        {
            return totalCount;
        }

        return fallback;
    }

    private static bool HasTrackerMeta(GetWorkoutResource workout)
        => !string.IsNullOrWhiteSpace(workout.Modality)
           || !string.IsNullOrWhiteSpace(workout.Goal)
           || workout.PerceivedFatigue is > 0;

    private static string FormatTrackerMeta(GetWorkoutResource workout)
    {
        var parts = new List<string>();

        if (TrainingIntent.ParseModality(workout.Modality) is { } modality)
        {
            parts.Add(modality.Label());
        }

        if (TrainingIntent.ParseGoal(workout.Goal) is { } goal)
        {
            parts.Add(goal.Label());
        }

        if (workout.PerceivedFatigue is > 0)
        {
            parts.Add($"Fatigue {workout.PerceivedFatigue}/5");
        }

        return string.Join(" · ", parts);
    }

    private sealed record WorkoutBlockGroup(
        string Title,
        int? Rounds,
        bool ShowHeader,
        List<WorkoutHistoryExerciseResource> Exercises);

    private static List<WorkoutBlockGroup> GroupExercisesByBlock(GetWorkoutResource detail)
    {
        var groups = new List<WorkoutBlockGroup>();

        // No explicit blocks: the workout renders exactly as it did before.
        if (detail.Blocks.Count == 0)
        {
            groups.Add(new WorkoutBlockGroup("Exercise", null, false, detail.Exercises));
            return groups;
        }

        var claimed = new HashSet<Guid>();
        foreach (var block in detail.Blocks)
        {
            var exercises = detail.Exercises.Where(exercise => exercise.BlockId == block.Id).ToList();
            claimed.Add(block.Id);

            var typeLabel = WorkoutBlockTypeLabels.Parse(block.Type) is { } type
                ? type.Label()
                : (block.Type ?? "Block");
            var title = string.IsNullOrWhiteSpace(block.Label) ? typeLabel : $"{typeLabel} · {block.Label}";

            // A lone implicit Normal block gets no header: same view as legacy data.
            var showHeader = exercises.Count > 0
                             && (detail.Blocks.Count > 1
                                 || WorkoutBlockTypeLabels.Parse(block.Type) != WorkoutBlockType.Normal
                                 || !string.IsNullOrWhiteSpace(block.Label)
                                 || block.Rounds is > 0);

            groups.Add(new WorkoutBlockGroup(title, block.Rounds, showHeader, exercises));
        }

        var orphans = detail.Exercises
            .Where(exercise => exercise.BlockId is null || !claimed.Contains(exercise.BlockId.Value))
            .ToList();
        if (orphans.Count > 0)
        {
            groups.Add(new WorkoutBlockGroup("Other", null, groups.Count > 0, orphans));
        }

        return groups;
    }

    private static string FormatWorkoutDate(DateTime? date)
    {
        if (!date.HasValue)
        {
            return "Date unavailable";
        }

        var workoutDate = date.Value.Date;
        if (workoutDate == DateTime.Today)
        {
            return "Today";
        }

        if (workoutDate == DateTime.Today.AddDays(-1))
        {
            return "Yesterday";
        }

        return workoutDate.ToString("ddd, d MMM yyyy");
    }

    private static string FormatWorkoutCount(int count)
        => count == 1 ? "1 workout" : $"{count} workouts";

    private static string FormatExerciseCount(int count)
        => count == 1 ? "1 exercise" : $"{count} exercises";

    private static string FormatLoggedExerciseRecords(int count)
        => count == 1
            ? "1 logged exercise record"
            : $"{count} logged exercise records";

    private static string FormatVolume(double volume)
        => $"{volume:N0} kg volume";

    private static string FormatExercisePrescription(WorkoutHistoryExerciseResource exercise)
    {
        var parts = new List<string>();

        if (exercise.Series.HasValue)
        {
            parts.Add($"{exercise.Series.Value} sets");
        }

        if (exercise.Repetitions.HasValue)
        {
            parts.Add($"{exercise.Repetitions.Value} reps");
        }

        var prescription = string.Join(" × ", parts);
        if (exercise.Weight is > 0)
        {
            prescription = string.IsNullOrEmpty(prescription)
                ? $"{exercise.Weight.Value:N1} kg"
                : $"{prescription} · {exercise.Weight.Value:N1} kg";
        }

        return string.IsNullOrEmpty(prescription)
            ? "No set details"
            : prescription;
    }

