@page "/workouts"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject TitleService TitleService

<PageTitle>Workouts</PageTitle>

<div class="hs-page-shell">
<PageHeader Title="Workouts" />

@if (_workouts == null)
{
    <LoadingState Message="Loading workouts..." />
}
else if (!_workouts.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.CalendarToday"
                Title="No workouts yet"
                Subtitle="Log your first workout to get started."
                ActionLabel="Create Workout"
                OnAction="GoToCreate" />
}
else
{
    <MudTable Items="@_workouts" Hover="true" SortLabel="Sort By" Elevation="0" Dense="true"
              Breakpoint="Breakpoint.None"
              Filter="@((GetWorkoutResource x) => FilterWorkout(x))">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="Search"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="MudBlazor.Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                   SortBy="@((GetWorkoutResource x) => x.Date)">Date</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="@((GetWorkoutResource x) => x.Type ?? "")">Type</MudTableSortLabel>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date?.ToShortDateString()</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 50, 100 }" />
        </PagerContent>
    </MudTable>
}

<MudFab @onclick="GoToCreate" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        Class="fixed-create-button" />
</div>

@code {
    private GetWorkoutResource[]? _workouts;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Workouts";
        _workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>("workouts");
    }

    private bool FilterWorkout(GetWorkoutResource item) => AppStateService.MatchesSearch(item, _search);

    private void GoToCreate() => NavigationManager.NavigateTo("/workouts/create");
}
