@page "/workouts"
@page "/training/history"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject TitleService TitleService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Training History</PageTitle>

<PageShell>
    <PageHeader Title="Training History" />

    <div class="hs-history-filter-toggle">
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Tune"
                   OnClick="() => _showFilters = !_showFilters">
            Filters@(HasActiveFilters ? $" ({ActiveFilterCount})" : "")
        </MudButton>
    </div>

    @if (_showFilters)
    {
        <MudPaper Class="hs-history-filter-panel">
            <MudTextField @bind-Value="_search"
                          Label="Workout or exercise"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudDatePicker @bind-Date="_fromDate"
                           Label="From"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true" />
            <MudDatePicker @bind-Date="_toDate"
                           Label="To"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true" />
            <MudTextField @bind-Value="_tag"
                          Label="Training tag"
                          Placeholder="Bilbo"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <div class="hs-history-filter-actions">
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Disabled="@(!HasFilterInput)"
                           OnClick="ClearFiltersAsync">
                    Clear
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="ApplyFiltersAsync">
                    Apply
                </MudButton>
            </div>
            @if (_knownTags.Count > 0)
            {
                <div class="hs-history-tag-filters" aria-label="Available training tags">
                    @foreach (var knownTag in _knownTags)
                    {
                        <button type="button"
                                class="hs-history-tag-filter @(string.Equals(_tag, knownTag, StringComparison.OrdinalIgnoreCase) ? "is-selected" : null)"
                                @onclick="() => SelectTagAsync(knownTag)">
                            @knownTag
                        </button>
                    }
                </div>
            }
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="hs-workout-status" role="status">@_statusMessage</div>
    }

    @if (_isLoading)
    {
        <LoadingState Message="Loading workouts..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Couldn't load your workouts"
                    Message="@_errorMessage"
                    ActionLabel="Retry"
                    OnAction="RetryAsync" />
    }
    else if (_workouts is null || _workouts.Count == 0)
    {
        @if (HasActiveFilters)
        {
            <EmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                        Title="No matching workouts"
                        Subtitle="Try another filter."
                        ActionLabel="Clear filters"
                        OnAction="ClearFiltersAsync" />
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Filled.CalendarToday"
                        Title="No workouts yet"
                        Subtitle="Start today's workout when you're ready."
                        ActionLabel="Start workout"
                        OnAction="GoToToday" />
        }
    }
    else
    {
        <div class="hs-workout-history-summary" aria-live="polite">
            @FormatLoadedCount()
        </div>

        <div class="hs-workout-history-list">
            @foreach (var workout in _workouts)
            {
                var isExpanded = _expandedWorkoutId == workout.Id;
                var detailsId = $"workout-details-{workout.Id:N}";
                var cardId = $"workout-card-{workout.Id:N}";

                <article id="@cardId" class="hs-workout-session-card hs-surface @(isExpanded ? "is-expanded" : null)">
                    <button type="button"
                            class="hs-workout-session-toggle"
                            aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                            aria-controls="@detailsId"
                            aria-label="@($"{(isExpanded ? "Hide" : "Show")} {workout.Type ?? "workout"} workout details")"
                            @onclick="() => ToggleWorkoutAsync(workout)">
                        <span class="hs-workout-date-block">
                            <span class="hs-workout-date">@FormatWorkoutDate(workout.Date)</span>
                            <span class="hs-workout-type">@(workout.Type ?? "Workout")</span>
                        </span>

                        <span class="hs-workout-summary-block">
                            <span class="hs-workout-metrics">
                                <span>@FormatExerciseCount(workout.ExerciseCount)</span>
                                @if (workout.TotalVolume > 0)
                                {
                                    <span aria-hidden="true">•</span>
                                    <span>@FormatVolume(workout.TotalVolume)</span>
                                }
                            </span>

                            @if (HasTrackerMeta(workout))
                            {
                                <span class="hs-workout-tracker-meta">@FormatTrackerMeta(workout)</span>
                            }

                            @if (workout.LeadingMuscles.Count > 0)
                            {
                                <span class="hs-workout-muscles" aria-label="Leading muscles">
                                    @foreach (var muscle in workout.LeadingMuscles.Take(3))
                                    {
                                        <span class="hs-workout-muscle-chip">@muscle</span>
                                    }
                                </span>
                            }
                        </span>

                        <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Class="hs-workout-expand-icon"
                                 aria-hidden="true" />
                    </button>

                    @if (isExpanded)
                    {
                        <div id="@detailsId" class="hs-workout-detail">
                            @if (_detailsLoading.Contains(workout.Id))
                            {
                                <LoadingState Message="Loading workout details..." Size="MudBlazor.Size.Small" />
                            }
                            else if (_detailErrors.TryGetValue(workout.Id, out var detailError))
                            {
                                <div class="hs-workout-detail-error" role="alert">
                                    <span>@detailError</span>
                                    <MudButton Variant="Variant.Text"
                                               Size="MudBlazor.Size.Small"
                                               OnClick="() => LoadWorkoutDetailsAsync(workout.Id)">
                                        Retry
                                    </MudButton>
                                </div>
                            }
                            else if (_details.TryGetValue(workout.Id, out var detail))
                            {
                                @if (detail.Exercises.Count == 0)
                                {
                                    <p class="hs-workout-detail-empty">No exercises were logged in this workout.</p>
                                }
                                else
                                {
                                    <div class="hs-workout-exercise-list">
                                        @foreach (var group in GroupExercisesByBlock(detail))
                                        {
                                            @if (group.ShowHeader)
                                            {
                                                <div class="hs-workout-block-head">
                                                    <span class="hs-workout-block-type">@group.Title</span>
                                                    @if (group.Rounds is > 0)
                                                    {
                                                        <span class="hs-workout-block-rounds">@group.Rounds rounds</span>
                                                    }
                                                </div>
                                            }

                                            @foreach (var exercise in group.Exercises)
                                            {
                                                <div class="hs-workout-exercise-row">
                                                    <div class="hs-workout-exercise-copy">
                                                        <span class="hs-workout-exercise-name">
                                                            @(exercise.Name ?? "Exercise")
                                                        </span>
                                                        <span class="hs-workout-exercise-prescription">
                                                            @FormatExercisePrescription(exercise)
                                                        </span>
                                                        @if (exercise.Attempts is > 0)
                                                        {
                                                            <span class="hs-workout-exercise-attempts">
                                                                @($"{exercise.CompletedAttempts ?? 0} of @exercise.Attempts attempts")
                                                            </span>
                                                        }
                                                        @if (exercise.Tags.Count > 0)
                                                        {
                                                            <span class="hs-training-tag-inline">
                                                                @string.Join(" · ", exercise.Tags)
                                                            </span>
                                                        }
                                                        @if (exercise.Muscles.Count > 0)
                                                        {
                                                            <span class="hs-workout-exercise-muscles">
                                                                @string.Join(" · ", exercise.Muscles)
                                                            </span>
                                                        }
                                                    </div>

                                                    <div class="hs-workout-exercise-actions">
                                                        <a class="hs-workout-edit-link"
                                                           href="@BuildExerciseEditRoute(exercise.Id)"
                                                           aria-label="@($"Edit {exercise.Name ?? "exercise"} entry")">
                                                            <MudIcon Icon="@Icons.Material.Filled.Edit"
                                                                     aria-hidden="true" />
                                                        </a>

                                                        @if (exercise.TypeId > 0)
                                                        {
                                                            <a class="hs-workout-progression-link"
                                                               href="@BuildProgressionRoute(exercise.TypeId)"
                                                               aria-label="@($"View {exercise.Name ?? "exercise"} progression")">
                                                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                                                                         aria-hidden="true" />
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }

                                <div class="hs-workout-detail-actions">
                                    <a class="hs-workout-action hs-workout-add-exercise"
                                       href="@BuildAddExerciseRoute(detail)">
                                        Add exercise
                                    </a>
                                    <button type="button"
                                            class="hs-workout-action"
                                            @onclick="() => OpenEdit(detail)">
                                        Edit workout
                                    </button>
                                    <button type="button"
                                            class="hs-workout-action"
                                            @onclick="() => OpenDuplicate(detail)">
                                        Duplicate
                                    </button>
                                    <button type="button"
                                            class="hs-workout-action is-danger"
                                            @onclick="() => OpenDelete(detail)">
                                        Delete
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        </div>

        @if (HasMoreWorkouts)
        {
            <div class="hs-workout-load-more">
                <MudButton Variant="Variant.Outlined"
                           Color="MudBlazor.Color.Primary"
                           Disabled="@_isLoadingMore"
                           OnClick="LoadMoreAsync">
                    @(_isLoadingMore ? "Loading..." : "Load more")
                </MudButton>
                @if (!string.IsNullOrWhiteSpace(_loadMoreError))
                {
                    <span class="hs-workout-load-error" role="alert">@_loadMoreError</span>
                }
            </div>
        }
    }
</PageShell>

@if (_editModel is not null)
{
    <div class="hs-workout-sheet-backdrop" @onclick="CloseEdit">
        <section class="hs-workout-sheet"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="edit-workout-title"
                 @onclick:stopPropagation="true">
            <div class="hs-workout-sheet-handle" aria-hidden="true"></div>
            <h2 id="edit-workout-title">Edit workout</h2>

            <EditForm Model="_editModel" OnValidSubmit="SaveWorkoutAsync">
                <DataAnnotationsValidator />

                <div class="hs-workout-sheet-fields">
                    <label for="edit-workout-date">Date</label>
                    <InputDate id="edit-workout-date"
                               class="hs-workout-sheet-input"
                               @bind-Value="_editModel.Date" />
                    <ValidationMessage For="@(() => _editModel.Date)" />

                    <label for="edit-workout-type">Name</label>
                    <InputText id="edit-workout-type"
                               class="hs-workout-sheet-input"
                               maxlength="100"
                               @bind-Value="_editModel.Type" />
                    <ValidationMessage For="@(() => _editModel.Type)" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_dialogError))
                {
                    <p class="hs-workout-sheet-error" role="alert">@_dialogError</p>
                }

                <div class="hs-workout-sheet-actions">
                    <button type="button"
                            class="hs-workout-sheet-button"
                            disabled="@_isSaving"
                            @onclick="CloseEdit">
                        Cancel
                    </button>
                    <button type="submit"
                            class="hs-workout-sheet-button is-primary"
                            disabled="@_isSaving">
                        @(_isSaving ? "Saving..." : "Save")
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@if (_deleteCandidate is not null)
{
    <div class="hs-workout-sheet-backdrop" @onclick="CloseDelete">
        <section class="hs-workout-sheet"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="delete-workout-title"
                 @onclick:stopPropagation="true">
            <div class="hs-workout-sheet-handle" aria-hidden="true"></div>
            <h2 id="delete-workout-title">Delete workout?</h2>
            <p class="hs-workout-sheet-copy">
                This permanently deletes the workout and its
                @FormatLoggedExerciseRecords(_deleteCandidate.ExerciseCount).
            </p>

            @if (!string.IsNullOrWhiteSpace(_dialogError))
            {
                <p class="hs-workout-sheet-error" role="alert">@_dialogError</p>
            }

            <div class="hs-workout-sheet-actions">
                <button type="button"
                        class="hs-workout-sheet-button"
                        disabled="@_isSaving"
                        @onclick="CloseDelete">
                    Cancel
                </button>
                <button type="button"
                        class="hs-workout-sheet-button is-danger"
                        disabled="@_isSaving"
                        @onclick="DeleteWorkoutAsync">
                    @(_isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </section>
    </div>
}

@if (_duplicateCandidate is not null)
{
    <div class="hs-workout-sheet-backdrop" @onclick="CloseDuplicate">
        <section class="hs-workout-sheet"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="duplicate-workout-title"
                 @onclick:stopPropagation="true">
            <div class="hs-workout-sheet-handle" aria-hidden="true"></div>
            <h2 id="duplicate-workout-title">Duplicate workout</h2>
            <p class="hs-workout-sheet-copy">
                Copies @FormatLoggedExerciseRecords(_duplicateCandidate.ExerciseCount)
                to another date — today by default. Pick the exercises you want to copy.
            </p>

            <div class="hs-workout-sheet-fields">
                <label for="duplicate-workout-date">New date</label>
                <InputDate id="duplicate-workout-date"
                           class="hs-workout-sheet-input"
                           @bind-Value="_duplicateDate" />

                <label for="duplicate-workout-type">Name</label>
                <InputText id="duplicate-workout-type"
                           class="hs-workout-sheet-input"
                           maxlength="100"
                           @bind-Value="_duplicateType" />
            </div>

            <div class="hs-workout-duplicate-exercises"
                 role="group"
                 aria-label="Exercises to copy">
                <label class="hs-workout-duplicate-all">
                    <input type="checkbox"
                           checked="@(_duplicateSelected.Count == _duplicateCandidate.Exercises.Count)"
                           @onchange="ToggleAllDuplicateExercises" />
                    All exercises
                </label>
                @foreach (var exercise in _duplicateCandidate.Exercises)
                {
                    <label class="hs-workout-duplicate-exercise">
                        <input type="checkbox"
                               checked="@_duplicateSelected.Contains(exercise.Id)"
                               @onchange="(e) => ToggleDuplicateExercise(exercise.Id, e)" />
                        <span>@(exercise.Name ?? "Exercise")</span>
                        <span class="hs-workout-exercise-prescription">
                            @FormatExercisePrescription(exercise)
                        </span>
                    </label>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_dialogError))
            {
                <p class="hs-workout-sheet-error" role="alert">@_dialogError</p>
            }

            <div class="hs-workout-sheet-actions">
                <button type="button"
                        class="hs-workout-sheet-button"
                        disabled="@_isSaving"
                        @onclick="CloseDuplicate">
                    Cancel
                </button>
                <button type="button"
                        class="hs-workout-sheet-button is-primary"
                        disabled="@(_isSaving || _duplicateSelected.Count == 0)"
                        @onclick="DuplicateWorkoutAsync">
                    @(_isSaving ? "Duplicating..." : "Duplicate")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private const int PageSize = 20;

    private readonly Dictionary<Guid, GetWorkoutResource> _details = new();
    private readonly Dictionary<Guid, string> _detailErrors = new();
    private readonly HashSet<Guid> _detailsLoading = new();

    private List<GetWorkoutResource>? _workouts;
    private Guid? _expandedWorkoutId;
    private string? _errorMessage;
    private string? _loadMoreError;
    private string? _dialogError;
    private string? _statusMessage;
    private WorkoutEditModel? _editModel;
    private GetWorkoutResource? _deleteCandidate;
    private GetWorkoutResource? _duplicateCandidate;
    private DateTime _duplicateDate = DateTime.Today;
    private string _duplicateType = string.Empty;
    private readonly HashSet<Guid> _duplicateSelected = new();
    private bool _isLoading = true;
    private bool _isLoadingMore;
    private bool _isSaving;
    private bool _showFilters;
    private string _search = string.Empty;
    private string _tag = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _appliedSearch = string.Empty;
    private string _appliedTag = string.Empty;
    private DateTime? _appliedFromDate;
    private DateTime? _appliedToDate;
    private readonly SortedSet<string> _knownTags =
        new(StringComparer.OrdinalIgnoreCase);
    private int _currentPage;
    private int _totalCount;

    private bool HasActiveFilters
        => !string.IsNullOrWhiteSpace(_appliedSearch)
           || !string.IsNullOrWhiteSpace(_appliedTag)
           || _appliedFromDate.HasValue
           || _appliedToDate.HasValue;
    private bool HasFilterInput
        => HasActiveFilters
           || !string.IsNullOrWhiteSpace(_search)
           || !string.IsNullOrWhiteSpace(_tag)
           || _fromDate.HasValue
           || _toDate.HasValue;
    private int ActiveFilterCount
        => (string.IsNullOrWhiteSpace(_appliedSearch) ? 0 : 1)
           + (string.IsNullOrWhiteSpace(_appliedTag) ? 0 : 1)
           + (_appliedFromDate.HasValue ? 1 : 0)
           + (_appliedToDate.HasValue ? 1 : 0);

    private bool HasMoreWorkouts
        => _workouts is not null && _workouts.Count < _totalCount;

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Training History";
        await LoadHistoryAsync(append: false);
    }

    private async Task LoadHistoryAsync(bool append)
    {
        var requestedPage = append ? _currentPage + 1 : 1;

        if (append)
        {
            _isLoadingMore = true;
            _loadMoreError = null;
        }
        else
        {
            _isLoading = true;
            _errorMessage = null;
        }

        try
        {
            using var response = await Http.GetAsync(
                BuildHistoryUrl(requestedPage));
            response.EnsureSuccessStatusCode();

            var page = await response.Content.ReadFromJsonAsync<List<GetWorkoutResource>>() ?? [];
            var totalCount = ReadTotalCount(response, page.Count);

            if (append)
            {
                _workouts ??= [];
                _workouts.AddRange(page.Where(item =>
                    _workouts.All(existing => existing.Id != item.Id)));
            }
            else
            {
                _workouts = page;
            }

            _currentPage = requestedPage;
            _totalCount = Math.Max(totalCount, _workouts.Count);
            foreach (var knownTag in page
                         .SelectMany(workout => workout.Tags)
                         .Where(value =>
                             !string.IsNullOrWhiteSpace(value)))
            {
                _knownTags.Add(knownTag);
            }
        }
        catch (Exception)
        {
            if (append)
            {
                _loadMoreError = "Couldn't load more workouts.";
            }
            else
            {
                _errorMessage = "Check your connection and try again.";
                _workouts = null;
            }
        }
        finally
        {
            _isLoading = false;
            _isLoadingMore = false;
        }
    }

    private async Task ToggleWorkoutAsync(GetWorkoutResource workout)
    {
        if (_expandedWorkoutId == workout.Id)
        {
            _expandedWorkoutId = null;
            return;
        }

        _expandedWorkoutId = workout.Id;
        if (!_details.ContainsKey(workout.Id))
        {
            await LoadWorkoutDetailsAsync(workout.Id);
        }
    }

    private async Task LoadWorkoutDetailsAsync(Guid workoutId)
    {
        _detailsLoading.Add(workoutId);
        _detailErrors.Remove(workoutId);

        try
        {
            using var response = await Http.GetAsync($"workouts/{workoutId}");
            response.EnsureSuccessStatusCode();

            var detail = await response.Content.ReadFromJsonAsync<GetWorkoutResource>();
            if (detail is null)
            {
                throw new InvalidOperationException("The workout response was empty.");
            }

            _details[workoutId] = detail;
        }
        catch (Exception)
        {
            _detailErrors[workoutId] = "Couldn't load this workout.";
        }
        finally
        {
            _detailsLoading.Remove(workoutId);
        }
    }

    private Task RetryAsync()
        => LoadHistoryAsync(append: false);

    private Task LoadMoreAsync()
        => LoadHistoryAsync(append: true);

    private Task ApplyFiltersAsync()
    {
        if (_fromDate.HasValue
            && _toDate.HasValue
            && _fromDate.Value.Date > _toDate.Value.Date)
        {
            _errorMessage =
                "The start date cannot be after the end date.";
            return Task.CompletedTask;
        }

        _appliedSearch = _search.Trim();
        _appliedTag = _tag.Trim();
        _appliedFromDate = _fromDate?.Date;
        _appliedToDate = _toDate?.Date;
        ResetLoadedDetails();
        return LoadHistoryAsync(append: false);
    }

    private async Task ClearFiltersAsync()
    {
        _search = string.Empty;
        _tag = string.Empty;
        _fromDate = null;
        _toDate = null;
        _appliedSearch = string.Empty;
        _appliedTag = string.Empty;
        _appliedFromDate = null;
        _appliedToDate = null;
        ResetLoadedDetails();
        await LoadHistoryAsync(append: false);
    }

    private async Task SelectTagAsync(string tag)
    {
        _tag = string.Equals(
            _tag,
            tag,
            StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : tag;
        _appliedTag = _tag;
        ResetLoadedDetails();
        await LoadHistoryAsync(append: false);
    }

    private string BuildHistoryUrl(int page)
    {
        var query = new List<string>
        {
            $"page={page}",
            $"pageSize={PageSize}"
        };

        if (!string.IsNullOrWhiteSpace(_appliedSearch))
        {
            query.Add(
                $"search={Uri.EscapeDataString(_appliedSearch)}");
        }

        if (!string.IsNullOrWhiteSpace(_appliedTag))
        {
            query.Add($"tag={Uri.EscapeDataString(_appliedTag)}");
        }

        if (_appliedFromDate.HasValue)
        {
            query.Add($"from={_appliedFromDate.Value:yyyy-MM-dd}");
        }

        if (_appliedToDate.HasValue)
        {
            query.Add($"to={_appliedToDate.Value:yyyy-MM-dd}");
        }

        return $"workouts?{string.Join("&", query)}";
    }

    private void ResetLoadedDetails()
    {
        _expandedWorkoutId = null;
        _details.Clear();
        _detailErrors.Clear();
        _detailsLoading.Clear();
    }

    private void OpenEdit(GetWorkoutResource workout)
    {
        _dialogError = null;
        _statusMessage = null;
        _editModel = new WorkoutEditModel
        {
            Id = workout.Id,
            Date = workout.Date?.Date ?? DateTime.Today,
            Type = string.IsNullOrWhiteSpace(workout.Type) ? "Workout" : workout.Type
        };
    }

    private void CloseEdit()
    {
        if (_isSaving)
        {
            return;
        }

        _editModel = null;
        _dialogError = null;
    }

    private async Task SaveWorkoutAsync()
    {
        if (_editModel is null)
        {
            return;
        }

        _isSaving = true;
        _dialogError = null;

        try
        {
            using var response = await Http.PutAsJsonAsync(
                "workouts",
                new
                {
                    _editModel.Id,
                    _editModel.Date,
                    Type = _editModel.Type.Trim()
                });
            if (!response.IsSuccessStatusCode)
            {
                _dialogError = await ReadProblemTitleAsync(
                    response,
                    "Couldn't update this workout.");
                return;
            }

            var updated = await response.Content.ReadFromJsonAsync<GetWorkoutResource>();
            if (updated is null)
            {
                throw new InvalidOperationException("The workout response was empty.");
            }

            ReplaceWorkout(updated);
            _editModel = null;
            _statusMessage = "Workout updated.";
        }
        catch (Exception)
        {
            _dialogError = "Couldn't update this workout.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDelete(GetWorkoutResource workout)
    {
        _dialogError = null;
        _statusMessage = null;
        _deleteCandidate = workout;
    }

    private void OpenDuplicate(GetWorkoutResource workout)
    {
        _dialogError = null;
        _statusMessage = null;
        _duplicateCandidate = workout;
        // The intuitive default is "repeat this workout today"; the user can move it to another date.
        _duplicateDate = DateTime.Today;
        _duplicateType = string.IsNullOrWhiteSpace(workout.Type)
            ? "Workout"
            : workout.Type;
        _duplicateSelected.Clear();
        foreach (var exercise in workout.Exercises)
        {
            _duplicateSelected.Add(exercise.Id);
        }
    }

    private void CloseDuplicate()
    {
        if (_isSaving)
        {
            return;
        }

        _duplicateCandidate = null;
        _duplicateSelected.Clear();
        _dialogError = null;
    }

    private void ToggleAllDuplicateExercises(ChangeEventArgs changeEventArgs)
    {
        if (_duplicateCandidate is null)
        {
            return;
        }

        _duplicateSelected.Clear();
        if (Convert.ToBoolean(changeEventArgs.Value))
        {
            foreach (var exercise in _duplicateCandidate.Exercises)
            {
                _duplicateSelected.Add(exercise.Id);
            }
        }
    }

    private void ToggleDuplicateExercise(Guid exerciseId, ChangeEventArgs changeEventArgs)
    {
        if (Convert.ToBoolean(changeEventArgs.Value))
        {
            _duplicateSelected.Add(exerciseId);
        }
        else
        {
            _duplicateSelected.Remove(exerciseId);
        }
    }

    private async Task DuplicateWorkoutAsync()
    {
        if (_duplicateCandidate is null || _workouts is null)
        {
            return;
        }

        var sourceWorkoutId = _duplicateCandidate.Id;
        var targetDate = _duplicateDate.Date;
        _isSaving = true;
        _dialogError = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"workouts/{sourceWorkoutId}/duplicate",
                new
                {
                    Date = targetDate.ToString("yyyy-MM-dd"),
                    Type = _duplicateType.Trim(),
                    ExerciseIds = _duplicateSelected.ToList()
                });
            if (!response.IsSuccessStatusCode)
            {
                _dialogError = await ReadProblemTitleAsync(
                    response,
                    "Couldn't duplicate this workout.");
                return;
            }

            var result = await response.Content
                .ReadFromJsonAsync<DuplicatedWorkoutResource>();
            if (result is null)
            {
                throw new InvalidOperationException("The workout response was empty.");
            }

            _duplicateCandidate = null;
            _duplicateSelected.Clear();

            // Rule 2 (ux-ui-good-apps): after the action the user lands in their
            // context — the editable copy — not back in the history catalog.
            if (targetDate == DateTime.Today)
            {
                Snackbar.Add("Workout copied to today.", Severity.Success);
                NavigationManager.NavigateTo("/training/today");
                return;
            }

            InsertWorkout(result.Workout);
            _statusMessage = "Workout duplicated.";
            await FocusDuplicatedWorkoutAsync(result.Workout.Id);
        }
        catch (Exception)
        {
            _dialogError = "Couldn't duplicate this workout.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task FocusDuplicatedWorkoutAsync(Guid workoutId)
    {
        _expandedWorkoutId = workoutId;
        if (!_details.TryGetValue(workoutId, out var detail))
        {
            await LoadWorkoutDetailsAsync(workoutId);
        }

        try
        {
            await JS.InvokeVoidAsync(
                "scrollToElement",
                $"workout-card-{workoutId:N}");
        }
        catch (Exception)
        {
            // Scrolling is a nicety; the duplicated card is already in place.
        }
    }

    private void InsertWorkout(GetWorkoutResource workout)
    {
        if (_workouts is null)
        {
            return;
        }

        if (_workouts.All(existing => existing.Id != workout.Id))
        {
            _workouts.Add(workout);
            _totalCount = Math.Max(_totalCount + 1, _workouts.Count);
        }

        _details[workout.Id] = workout;
        _workouts = _workouts
            .OrderByDescending(item => item.Date)
            .ThenByDescending(item => item.Id)
            .ToList();
    }

    private void CloseDelete()
    {
        if (_isSaving)
        {
            return;
        }

        _deleteCandidate = null;
        _dialogError = null;
    }

    private async Task DeleteWorkoutAsync()
    {
        if (_deleteCandidate is null || _workouts is null)
        {
            return;
        }

        var workoutId = _deleteCandidate.Id;
        _isSaving = true;
        _dialogError = null;

        try
        {
            using var response = await Http.DeleteAsync($"workouts/{workoutId}");
            if (!response.IsSuccessStatusCode)
            {
                _dialogError = await ReadProblemTitleAsync(
                    response,
                    "Couldn't delete this workout.");
                return;
            }

            _workouts.RemoveAll(workout => workout.Id == workoutId);
            _details.Remove(workoutId);
            _detailErrors.Remove(workoutId);
            _detailsLoading.Remove(workoutId);
            _totalCount = Math.Max(0, _totalCount - 1);
            if (_expandedWorkoutId == workoutId)
            {
                _expandedWorkoutId = null;
            }

            _deleteCandidate = null;
            _statusMessage = "Workout deleted.";
            if (_workouts.Count < _totalCount)
            {
                await LoadHistoryAsync(append: false);
            }
        }
        catch (Exception)
        {
            _dialogError = "Couldn't delete this workout.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ReplaceWorkout(GetWorkoutResource updated)
    {
        if (_workouts is null)
        {
            return;
        }

        var index = _workouts.FindIndex(workout => workout.Id == updated.Id);
        if (index >= 0)
        {
            _workouts[index] = updated;
        }

        _details[updated.Id] = updated;
        _workouts = _workouts
            .OrderByDescending(workout => workout.Date)
            .ThenByDescending(workout => workout.Id)
            .ToList();
    }

    private static async Task<string> ReadProblemTitleAsync(
        HttpResponseMessage response,
        string fallback)
    {
        try
        {
            using var problem = await JsonDocument.ParseAsync(
                await response.Content.ReadAsStreamAsync());
            if (problem.RootElement.TryGetProperty("title", out var title)
                && !string.IsNullOrWhiteSpace(title.GetString()))
            {
                return title.GetString()!;
            }
        }
        catch (JsonException)
        {
        }

        return fallback;
    }

