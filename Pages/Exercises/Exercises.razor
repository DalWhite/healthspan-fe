@page "/exercises"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<PageTitle>Exercises</PageTitle>


@if (exercises != null)
{
    <div class="table-responsive">
    <MudTable Items="exercises"
              Hover="true"
              Elevation="0"
              Breakpoint="Breakpoint.None"
              Dense="true"
              Filter="new Func<GetExerciseResource,bool>(FilterFunc1)"
              GroupBy="@_groupDefinition"
              T="GetExerciseResource"
              OnRowClick="GoToEditExercise"
              SelectedItem="selectedItem">
        <ColGroup>
            <col style="width: 10%;" />
            <col style="width: 20%;" />
            <col style="width: 20%;" />
            <col style="width: 10%;" />
            <col style="width: 10%;" />
            <col style="width: 10%;" />
            <col style="width: 10%;" />
            <col style="width: 10%;" />
        </ColGroup>
        <ToolBarContent>
            <MudTextField @bind-Value="searchString1"
                          Placeholder="Search"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                   SortBy="new Func<GetExerciseResource, object>(x => x.Workout.Date)"
                                   Class="small-indentation-column">
                                   Date
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x => x.Type.Name)" Class="compact-column">Exercise
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x => x.Series)" Class="compact-column">S x R x W
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x => x.MaxRepetition)" Class="compact-column">1RM
                </MudTableSortLabel>
            </MudTh>
            <MudTh Class="hide-on-mobile compact-column">
            <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x => x.Volume)">Volume</MudTableSortLabel>
        </MudTh>
        <MudTh Class="hide-on-mobile compact-column">
            <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x => x.Intensity)">Intensity</MudTableSortLabel>
        </MudTh>
        </HeaderContent>
        <GroupHeaderTemplate>
            <MudTh Class="mud-table-cell-custom-group" colspan="6">
                @if (DateTime.TryParse(context.Key.ToString(), out DateTime groupDate))
                {
                    var daysAgo = (DateTime.Now - groupDate).Days;
                    <text>@($"{context.GroupName}: {context.Key} ({daysAgo} days ago)")</text>
                }
                else
                {
                    <text>Invalid Date</text>
                }
            </MudTh>
        </GroupHeaderTemplate>
        <RowTemplate>
    <MudTd DataLabel="Date" Class="small-indentation-column"></MudTd> <!-- Indentation column -->
    <MudTd DataLabel="Exercise" Class="compact-column">@context.Type?.Name</MudTd>
    <MudTd DataLabel="Series x Reps x Weight" Class="compact-column">@($"{context.Series} x {context.Repetitions} x {context.Weight} kg")</MudTd>
    <MudTd DataLabel="1RM" Class="compact-column">@context.MaxRepetition?.ToString("N1") kg</MudTd>
    <MudTd DataLabel="Volume" Class="compact-column hide-on-mobile">@context.Volume kg</MudTd>
    <MudTd DataLabel="Intensity" Class="compact-column hide-on-mobile">@context.Intensity %</MudTd>
</RowTemplate>
    </MudTable>
</div>

<MudFab @onclick="GoToCreateExercise"
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add"
        Class="fixed-create-button" />

}

@code {
    private GetExerciseResource[]? exercises;
    private GetExerciseResource? selectedItem;
    private string searchString1 = "";
    private TableGroupDefinition<GetExerciseResource> _groupDefinition = new()
        {
            GroupName = "Date",
            Indentation = true,
            Expandable = false,
            Selector = (e) => e.Workout?.Date.Value.ToShortDateString()
        };

    protected override async Task OnInitializedAsync()
    {
        exercises = await Http.GetFromJsonAsync<GetExerciseResource[]>("/Exercises");
    }
    protected override void OnInitialized()
    {
        TitleService.Title = "Exercises";
    }

    private bool FilterFunc1(GetExerciseResource element) => FilterFunc(element, searchString1);

    private bool FilterFunc(GetExerciseResource element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        string dateString = element.Workout.Date.Value.ToString("dd/MM/yyyy");

        if (dateString.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Type?.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (element.Type?.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;

        return false;
    }
    private void GoToCreateExercise()
    {
        NavigationManager.NavigateTo("/exercises/create");
    }
    private void GoToEditExercise(TableRowClickEventArgs<GetExerciseResource> tableRowClickEventArgs)
    {
        NavigationManager.NavigateTo($"/exercises/edit/{tableRowClickEventArgs.Item.Id}");
    }
}
