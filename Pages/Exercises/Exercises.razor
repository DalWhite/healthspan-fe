@page "/exercises"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<PageTitle>Exercises</PageTitle>

<div class="container">
    <div class="search-bar mb-3">
        <MudTextField @bind-Value="searchString"
                      Placeholder="Search for an exercise..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small"
                      Class="mt-0"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="HandleSearch" />
    </div>

    <div class="sort-controls mb-3">
        <MudText Typo="Typo.subtitle1" Class="mr-2">Sort by:</MudText>
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            <MudButton OnClick="@(() => SortExercisesBy("date"))" Variant="@GetSortButtonVariant("date")">Date</MudButton>
            <MudButton OnClick="@(() => SortExercisesBy("name"))" Variant="@GetSortButtonVariant("name")">Exercise</MudButton>
            <MudButton OnClick="@(() => SortExercisesBy("1rm"))" Variant="@GetSortButtonVariant("1rm")">1RM</MudButton>
            <MudButton OnClick="@(() => SortExercisesBy("volume"))" Variant="@GetSortButtonVariant("volume")">Volume</MudButton>
        </MudButtonGroup>
        <MudIconButton Icon="@(sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                       OnClick="ToggleSortDirection"
                       Size="Size.Small"
                       Class="ml-2" />
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (pagedData?.Items == null || !pagedData.Items.Any())
    {
        <MudAlert Severity="Severity.Info" Class="my-4">No exercises found. Try adjusting your search or add a new exercise.</MudAlert>
    }
    else
    {
        <!-- Desktop View -->
        <div class="hide-on-mobile desktop-card-view">
            @{
                // Group by date, but only include dates that have matching exercises
                var dateGroups = pagedData.Items
                    .GroupBy(e => e.Workout?.Date.Value.ToShortDateString())
                    .OrderByDescending(g => DateTime.Parse(g.Key));
            }

            @foreach (var dateGroup in dateGroups)
            {
                @if (DateTime.TryParse(dateGroup.Key, out DateTime groupDate))
                {
                    var daysAgo = (DateTime.Now - groupDate).Days;
                    var volumeSummary = GetVolumeSummaryByMuscleForDate(dateGroup.Key, dateGroup.ToList());
                    var isExpanded = expandedDates.ContainsKey(dateGroup.Key) ? expandedDates[dateGroup.Key] : true;

                    <div class="date-header mb-3">
                        <div class="d-flex justify-space-between align-center" @onclick="() => ToggleDateExpand(dateGroup.Key)">
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.h5" Class="mb-0">@dateGroup.Key</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Dark" Class="ml-1">(@daysAgo days ago)</MudText>
                                <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Medium" />
                            </div>

                            @if (volumeSummary.Any())
                            {
                                <div class="d-flex gap-2">
                                    @foreach (var muscleGroup in volumeSummary.Take(3))
                                    {
                                        <MudChip Color="Color.Error"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small"
                                                 Class="muscle-volume-chip-desktop px-3 py-1">
                                            @muscleGroup.Key: @muscleGroup.Value kg
                                        </MudChip>
                                    }
                                    @if (volumeSummary.Count > 3)
                                    {
                                        <MudChip Color="Color.Default"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small"
                                                 Class="muscle-volume-chip-desktop px-3 py-1">
                                            +@(volumeSummary.Count - 3) more
                                        </MudChip>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (expandedDates.ContainsKey(dateGroup.Key) && expandedDates[dateGroup.Key])
                {
                    var mainExercise = FindMainExerciseForDate(dateGroup.Key, dateGroup.ToList());

                    <div class="desktop-exercise-grid">
                        @foreach (var exerciseTypeGroup in dateGroup.GroupBy(e => e.Type?.Name))
                        {
                            bool isMainExercise = exerciseTypeGroup.Key == mainExercise;
                            string cardClass = isMainExercise ? "exercise-card main-exercise-card" : "exercise-card";
                            var exerciseType = exerciseTypeGroup.FirstOrDefault()?.Type;
                            var exerciseId = exerciseTypeGroup.FirstOrDefault()?.Id;

                            <MudCard Class="@cardClass">
                                <MudCardContent Class="py-3 px-4">
                                    <div class="d-flex justify-space-between align-center mb-3">
                                        <div class="d-flex align-center exercise-title-container">
                                            @if (isMainExercise)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Star"
                                                        Color="Color.Warning"
                                                        Size="Size.Medium"
                                                        Class="mr-2 flex-shrink-0" />
                                            }
                                            <MudText Typo="Typo.h6" Class="exercise-title text-truncate mb-0">
                                                @exerciseTypeGroup.Key
                                            </MudText>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <MudIconButton Icon="@Icons.Material.Filled.TrendingUp"
                                                        Color="Color.Primary"
                                                        Size="Size.Small"
                                                        Variant="Variant.Filled"
                                                        OnClick="() => GoToExerciseTypeDetails(exerciseType?.Id)"
                                                        Class="action-button-desktop"
                                                        Title="View History & Trends" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                        Color="Color.Secondary"
                                                        Size="Size.Small"
                                                        Variant="Variant.Filled"
                                                        OnClick="() => GoToEditExercise(exerciseId)"
                                                        Class="action-button-desktop"
                                                        Title="Edit Exercise" />
                                        </div>
                                    </div>

                                    <div class="exercise-instances">
                                        @foreach (var exercise in exerciseTypeGroup.Take(3)) // Limit to 3 instances for performance
                                        {
                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                <MudChip Variant="Variant.Outlined" Size="Size.Medium" Class="rep-chip-desktop">
                                                    @($"{exercise.Series} sets")
                                                </MudChip>
                                                <MudChip Variant="Variant.Outlined" Size="Size.Medium" Class="rep-chip-desktop">
                                                    @($"{exercise.Repetitions} reps")
                                                </MudChip>
                                                <MudChip Variant="Variant.Outlined" Size="Size.Medium" Class="rep-chip-desktop">
                                                    @($"{exercise.Weight} kg")
                                                </MudChip>
                                            </div>
                                        }
                                        @if (exerciseTypeGroup.Count() > 3)
                                        {
                                            <MudButton Color="Color.Default" Variant="Variant.Text" Size="Size.Small" Class="mt-2">
                                                Show @(exerciseTypeGroup.Count() - 3) more
                                            </MudButton>
                                        }
                                    </div>

                                    <div class="d-flex justify-space-between mt-4">
                                        <div>
                                            <MudText Typo="Typo.caption" Class="text-muted">1RM</MudText>
                                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                                @exerciseTypeGroup.Max(e => e.MaxRepetition)?.ToString("N1") kg
                                            </MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Class="text-muted">Volume</MudText>
                                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                                @exerciseTypeGroup.Sum(e => e.Volume) kg
                                            </MudText>
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                }
            }
        </div>

        <!-- Mobile View -->
        <div class="only-mobile">
            @{
                // Group by date, but only include dates that have matching exercises
                var filteredDateGroups = pagedData.Items
                    .GroupBy(e => e.Workout?.Date.Value.ToShortDateString())
                    .OrderByDescending(g => DateTime.Parse(g.Key));
            }

            @foreach (var dateGroup in filteredDateGroups)
            {
                @if (DateTime.TryParse(dateGroup.Key, out DateTime groupDate))
                {
                    var daysAgo = (DateTime.Now - groupDate).Days;
                    var volumeSummary = GetVolumeSummaryByMuscleForDate(dateGroup.Key, dateGroup.ToList());
                    var isExpanded = expandedDates.ContainsKey(dateGroup.Key) ? expandedDates[dateGroup.Key] : true;

                    <div class="date-header mb-2">
                        <div class="d-flex justify-space-between align-center" @onclick="() => ToggleDateExpand(dateGroup.Key)">
                            <div class="d-flex align-center gap-1">
                                <MudText Typo="Typo.h6" Class="mb-0">@dateGroup.Key</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Dark" Class="ml-1 mt-1">(@daysAgo days ago)</MudText>
                                <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Size="Size.Small" />
                            </div>

                            @if (volumeSummary.Any())
                            {
                                <div class="d-flex overflow-x-auto volume-tags-container">
                                    @foreach (var muscleGroup in volumeSummary.Take(2))
                                    {
                                        <MudChip Color="Color.Error"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small"
                                                 Class="muscle-volume-chip px-2 py-0 ml-1">
                                            @muscleGroup.Key: @muscleGroup.Value kg
                                        </MudChip>
                                    }
                                    @if (volumeSummary.Count > 2)
                                    {
                                        <MudChip Color="Color.Default"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small"
                                                 Class="muscle-volume-chip px-2 py-0 ml-1">
                                            +@(volumeSummary.Count - 2)
                                        </MudChip>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (expandedDates.ContainsKey(dateGroup.Key) && expandedDates[dateGroup.Key])
                {
                    var mainExercise = FindMainExerciseForDate(dateGroup.Key, dateGroup.ToList());

                    @foreach (var exerciseTypeGroup in dateGroup.GroupBy(e => e.Type?.Name))
                    {
                        bool isMainExercise = exerciseTypeGroup.Key == mainExercise;
                        string cardClass = isMainExercise ? "mb-4 exercise-card main-exercise-card" : "mb-4 exercise-card";
                        var exerciseType = exerciseTypeGroup.FirstOrDefault()?.Type;
                        var exerciseId = exerciseTypeGroup.FirstOrDefault()?.Id;

                        <MudCard Class="@cardClass">
                            <MudCardContent Class="py-2 px-3">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <div class="d-flex align-center exercise-title-container">
                                        @if (isMainExercise)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Star"
                                                     Color="Color.Warning"
                                                     Size="Size.Small"
                                                     Class="mr-1 flex-shrink-0" />
                                        }
                                        <MudText Typo="Typo.h6" Class="exercise-title text-truncate mb-0">
                                            @exerciseTypeGroup.Key
                                        </MudText>
                                    </div>
                                    <div class="d-flex gap-1 ml-2 flex-shrink-0">
                                        <MudIconButton Icon="@Icons.Material.Filled.TrendingUp"
                                                      Color="Color.Primary"
                                                      Size="Size.Small"
                                                      Variant="Variant.Filled"
                                                      OnClick="() => GoToExerciseTypeDetails(exerciseType?.Id)"
                                                      Class="action-button"
                                                      Title="View History & Trends" />

                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                      Color="Color.Secondary"
                                                      Size="Size.Small"
                                                      Variant="Variant.Filled"
                                                      OnClick="() => GoToEditExercise(exerciseId)"
                                                      Class="action-button"
                                                      Title="Edit Exercise" />
                                    </div>
                                </div>

                                <div class="exercise-instances">
                                    @foreach (var exercise in exerciseTypeGroup.Take(2)) // Limit to 2 for mobile
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <MudChip Variant="Variant.Outlined" Size="Size.Small" Class="rep-chip">
                                                @($"{exercise.Series} sets")
                                            </MudChip>
                                            <MudChip Variant="Variant.Outlined" Size="Size.Small" Class="rep-chip">
                                                @($"{exercise.Repetitions} reps")
                                            </MudChip>
                                            <MudChip Variant="Variant.Outlined" Size="Size.Small" Class="rep-chip">
                                                @($"{exercise.Weight} kg")
                                            </MudChip>
                                        </div>
                                    }
                                    @if (exerciseTypeGroup.Count() > 2)
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1">
                                            +@(exerciseTypeGroup.Count() - 2) more sets
                                        </MudText>
                                    }
                                </div>

                                <div class="d-flex justify-space-between mt-3">
                                    <div>
                                        <MudText Typo="Typo.caption" Class="text-muted">1RM</MudText>
                                        <MudText Typo="Typo.body1" Class="font-weight-bold">
                                            @exerciseTypeGroup.Max(e => e.MaxRepetition)?.ToString("N1") kg
                                        </MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Class="text-muted">Volume</MudText>
                                        <MudText Typo="Typo.body1" Class="font-weight-bold">
                                            @exerciseTypeGroup.Sum(e => e.Volume) kg
                                        </MudText>
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                }
            }
        </div>

        <!-- Pagination Controls -->
        <div class="d-flex justify-center my-4">
            <MudPagination Count="@pagedData.TotalPages"
                           SelectedChanged="OnPageChanged"
                           Selected="@currentPage"
                           Class="mt-4" />
        </div>
    }
</div>

<MudFab @onclick="GoToCreateExercise"
        Color="Color.Error"
        StartIcon="@Icons.Material.Filled.Add"
        Class="fixed-create-button" />

