@code {
    // Models
    private class PagedResult<T>
    {
        public List<T> Items { get; set; }
        public int TotalCount { get; set; }
        public int PageSize { get; set; }
        public int CurrentPage { get; set; }
        public int TotalPages { get; set; }
    }

    // State variables
    private PagedResult<GetExerciseResource> pagedData;
    private string searchString = "";
    private string sortBy = "date";
    private bool sortDescending = true;
    private int currentPage = 1;
    private int pageSize = 20;
    private bool isLoading = true;
    private Dictionary<string, bool> expandedDates = new Dictionary<string, bool>();
    private string lastSearchQuery = "";
    private string currentSortField = "date";

    // Muscle name mapping
    private Dictionary<int, string> muscleNames = new Dictionary<int, string>
    {
        { 1, "Chest" },
        { 2, "Back" },
        { 3, "Legs" },
        { 4, "Shoulders" },
        { 5, "Arms" },
        { 6, "Core" },
        { 10, "Muscle 10" }
        // Add more muscle mappings as needed
    };

    // Lifecycle methods
    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Exercises";
        await LoadExercises();
    }

    // Data loading
    private async Task LoadExercises()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"/Exercises?page={currentPage}&pageSize={pageSize}&sortBy={sortBy}&descending={sortDescending}";

            if (!string.IsNullOrWhiteSpace(searchString))
            {
                url += $"&search={Uri.EscapeDataString(searchString)}";
            }

            pagedData = await Http.GetFromJsonAsync<PagedResult<GetExerciseResource>>(url);

            // Initialize expanded state for dates if not already done
            if (pagedData?.Items != null)
            {
                var dates = pagedData.Items
                    .Select(e => e.Workout?.Date.Value.ToShortDateString())
                    .Where(d => !string.IsNullOrEmpty(d))
                    .Distinct();

                foreach (var date in dates)
                {
                    if (!expandedDates.ContainsKey(date))
                    {
                        expandedDates[date] = true;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading exercises: {ex.Message}");
            pagedData = new PagedResult<GetExerciseResource>
            {
                Items = new List<GetExerciseResource>(),
                TotalCount = 0,
                PageSize = pageSize,
                CurrentPage = 1,
                TotalPages = 0
            };
        }

        isLoading = false;
        StateHasChanged();
    }

    // Event handlers
    private async Task OnPageChanged(int page)
    {
        if (currentPage != page)
        {
            currentPage = page;
            await LoadExercises();
        }
    }

    private async Task HandleSearch()
    {
        if (searchString != lastSearchQuery)
        {
            lastSearchQuery = searchString;
            currentPage = 1; // Reset to first page on new search
            await LoadExercises();
        }
    }

    private async Task SortExercisesBy(string field)
    {
        if (field == currentSortField)
        {
            // Toggle sort direction if same field clicked
            sortDescending = !sortDescending;
        }
        else
        {
            currentSortField = field;
            sortBy = field;
            sortDescending = true; // Default to descending for new field
        }

        await LoadExercises();
    }

    private async Task ToggleSortDirection()
    {
        sortDescending = !sortDescending;
        await LoadExercises();
    }

    private void ToggleDateExpand(string date)
    {
        if (!expandedDates.ContainsKey(date))
            expandedDates[date] = false;
        else
            expandedDates[date] = !expandedDates[date];

        StateHasChanged();
    }

    private Variant GetSortButtonVariant(string field)
    {
        return field == currentSortField ? Variant.Filled : Variant.Outlined;
    }

    // Navigation methods
    private void GoToCreateExercise()
    {
        NavigationManager.NavigateTo("/exercises/create");
    }

    private void GoToExerciseTypeDetails(int? exerciseTypeId)
    {
        if (exerciseTypeId.HasValue)
        {
            NavigationManager.NavigateTo($"/exercises/types/{exerciseTypeId}/details");
        }
    }

    private void GoToEditExercise(Guid? exerciseId)
    {
        if (exerciseId.HasValue)
        {
            NavigationManager.NavigateTo($"/exercises/edit/{exerciseId}");
        }
    }

    // Helper methods
    private string GetMuscleName(int muscleId)
    {
        return muscleNames.ContainsKey(muscleId) ? muscleNames[muscleId] : $"Muscle {muscleId}";
    }

    // Find the exercise type name with the highest 1RM for a given date
    private string FindMainExerciseForDate(string date, List<GetExerciseResource> exercises)
    {
        if (exercises == null || !exercises.Any())
            return null;

        var dateExercises = exercises
            .Where(e => e.Workout?.Date.Value.ToShortDateString() == date && e.MaxRepetition.HasValue)
            .ToList();

        if (!dateExercises.Any())
            return null;

        // Cache the result to avoid recalculation
        var mainExercise = dateExercises
            .OrderByDescending(e => e.MaxRepetition)
            .FirstOrDefault();

        return mainExercise?.Type?.Name;
    }

    // Get volume summary for exercises on a specific date
    private Dictionary<string, int> GetVolumeSummaryByMuscleForDate(string date, List<GetExerciseResource> exercises)
    {
        var summary = new Dictionary<string, int>();

        if (exercises == null || !exercises.Any())
            return summary;

        var dateExercises = exercises.Where(e => e.Workout?.Date.Value.ToShortDateString() == date);

        // If no muscle ID is found, group by exercise type name instead as a fallback
        var hasMuscleData = dateExercises.Any(e => e.Type?.PrimaryMuscleId.HasValue == true);

        if (hasMuscleData)
        {
            // Group exercises by primary muscle ID and sum volumes
            var muscleGroups = dateExercises
                .Where(e => e.Type?.PrimaryMuscleId.HasValue == true && e.Volume.HasValue)
                .GroupBy(e => e.Type.PrimaryMuscleId.Value);

            foreach (var group in muscleGroups)
            {
                string muscleName = GetMuscleName(group.Key);
                int totalVolume = group.Sum(e => e.Volume ?? 0);
                summary[muscleName] = totalVolume;
            }
        }
        else
        {
            // Fallback: group by exercise type instead
            var typeGroups = dateExercises
                .Where(e => e.Type?.Name != null && e.Volume.HasValue)
                .GroupBy(e => e.Type.Name);

            foreach (var group in typeGroups)
            {
                string typeName = group.Key ?? "Unknown";
                int totalVolume = group.Sum(e => e.Volume ?? 0);

                // Infer muscle group from exercise name
                string muscleName = InferMuscleFromExerciseName(typeName);

                // Add or update volume for this muscle
                if (summary.ContainsKey(muscleName))
                    summary[muscleName] += totalVolume;
                else
                    summary[muscleName] = totalVolume;
            }
        }

        return summary.OrderByDescending(x => x.Value)
                     .ToDictionary(x => x.Key, x => x.Value);
    }

    // Helper method to infer muscle group from exercise name
    private string InferMuscleFromExerciseName(string exerciseName)
    {
        exerciseName = exerciseName.ToLower();

        if (exerciseName.Contains("bench") || exerciseName.Contains("chest") || exerciseName.Contains("pec"))
            return "👕 Chest";
        else if (exerciseName.Contains("squat") || exerciseName.Contains("leg") || exerciseName.Contains("calf") ||
                exerciseName.Contains("lunge") || exerciseName.Contains("deadlift"))
            return "🦿 Legs";
        else if (exerciseName.Contains("shoulder") || exerciseName.Contains("press") || exerciseName.Contains("delt"))
            return "🛡️ Shoulders";
        else if (exerciseName.Contains("bicep") || exerciseName.Contains("curl") || exerciseName.Contains("tricep") ||
                exerciseName.Contains("extension"))
            return "💪 Arms";
        else if (exerciseName.Contains("back") || exerciseName.Contains("row") || exerciseName.Contains("pull") ||
                exerciseName.Contains("lat"))
            return "🔄 Back";
        else if (exerciseName.Contains("ab") || exerciseName.Contains("core") || exerciseName.Contains("crunch"))
            return "🧱 Core";
        else
            return "🔘 Other";
    }
}