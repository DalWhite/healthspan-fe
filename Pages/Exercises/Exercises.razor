@page "/exercises"
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject TitleService TitleService
@inject AppStateService AppState
@inject IDialogService DialogService
@using static healthspan_fe_wasm_pwa.Components.ExerciseFilterDialog

<PageTitle>Training History</PageTitle>

<PageShell>
    <PageHeader Title="Training History" />

<!-- Sort & Filter Controls -->
<PageToolbar Class="sort-controls" AriaLabel="Training history controls">
    <MudButtonGroup Color="MudBlazor.Color.Primary" Variant="Variant.Outlined" Size="MudBlazor.Size.Small">
        <MudButton OnClick="@(() => SortExercisesBy("date"))" Variant="@GetSortButtonVariant("date")">Date</MudButton>
        <MudButton OnClick="OpenFilterDialog" Variant="@(_isFilterActive ? Variant.Filled : Variant.Outlined)">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />Filter
        </MudButton>
    </MudButtonGroup>
    <MudIconButton Icon="@(_sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                   OnClick="ToggleSortDirection"
                   Size="MudBlazor.Size.Small"
                   Class="ml-2" />

    @if (_isFilterActive)
    {
        <div class="d-flex flex-wrap mt-2">
            @if (_selectedExerciseTypeId.HasValue && !string.IsNullOrWhiteSpace(_selectedExerciseTypeLabel))
            {
                <MudChip Class="mr-2 mb-1" Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                         Size="MudBlazor.Size.Small" OnClose="ClearExerciseTypeFilter">
                    Exercise: @_selectedExerciseTypeLabel
                </MudChip>
            }
            @foreach (var muscle in _selectedMuscleGroups)
            {
                <MudChip Class="mr-2 mb-1" Variant="Variant.Filled" Color="MudBlazor.Color.Secondary"
                         Size="MudBlazor.Size.Small" OnClose="() => RemoveMuscleFilter(muscle)">
                    Muscle: @muscle
                </MudChip>
            }
            <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small"
                       OnClick="ClearAllFilters" StartIcon="@Icons.Material.Filled.Clear">
                Clear All
            </MudButton>
        </div>
    }
</PageToolbar>

<!-- Content -->
@if (_isLoading)
{
    <LoadingState Message="Loading exercises..." />
}
else if (_pagedData?.Items == null || !_pagedData.Items.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.FitnessCenter"
                Title="No exercises found"
                Subtitle="Try adjusting your filters or add a new exercise."
                ActionLabel="Add Exercise"
                OnAction="GoToCreateExercise" />
}
else
{
    @foreach (var dateGroup in GetDateGroups())
    {
        @if (DateTime.TryParse(dateGroup.Key, out DateTime groupDate))
        {
            var daysAgo = (DateTime.Now - groupDate).Days;
            var volumeSummary = GetVolumeSummaryByMuscleForDate(dateGroup.Key, dateGroup.ToList());
            var isExpanded = _expandedDates.GetValueOrDefault(dateGroup.Key, true);

            <!-- Date Header — clickable expand/collapse, responsive -->
            <div class="date-header mb-3" @onclick="() => ToggleDateExpand(dateGroup.Key)">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h5" Class="mb-0">@dateGroup.Key</MudText>
                        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Dark" Class="ml-1">(@daysAgo days ago)</MudText>
                        <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="MudBlazor.Size.Medium" />
                    </div>

                    @if (volumeSummary.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var muscleGroup in volumeSummary.Take(3))
                            {
                                <MudChip Color="MudBlazor.Color.Error" Variant="Variant.Filled"
                                         Size="MudBlazor.Size.Small" Class="hs-volume-chip">
                                    @muscleGroup.Key: @muscleGroup.Value.ToString("0.#") kg
                                </MudChip>
                            }
                            @if (volumeSummary.Count > 3)
                            {
                                <MudChip Color="MudBlazor.Color.Default" Variant="Variant.Filled"
                                         Size="MudBlazor.Size.Small" Class="hs-volume-chip">
                                    +@(volumeSummary.Count - 3) more
                                </MudChip>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (isExpanded)
            {
                var mainExercise = FindMainExerciseForDate(dateGroup.Key, dateGroup.ToList());
                <div class="hs-exercise-grid">
                    @foreach (var exerciseTypeGroup in dateGroup.GroupBy(e => e.Type?.Name))
                    {
                        bool isMain = exerciseTypeGroup.Key == mainExercise;
                        var exerciseType = exerciseTypeGroup.FirstOrDefault()?.Type;
                        var exerciseId = exerciseTypeGroup.FirstOrDefault()?.Id;

                        <MudCard Class="@($"exercise-card {(isMain ? "hs-main-exercise-card" : "")} mb-3")">
                            <MudCardContent Class="py-3 px-4">
                                <!-- Title Row -->
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <div class="d-flex align-center hs-exercise-title">
                                        @if (isMain)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="MudBlazor.Color.Warning"
                                                     Size="MudBlazor.Size.Small" Class="mr-1 flex-shrink-0" />
                                        }
                                        <MudText Typo="Typo.h6" Class="text-truncate mb-0">@exerciseTypeGroup.Key</MudText>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <MudIconButton Icon="@Icons.Material.Filled.TrendingUp"
                                                       Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                                       OnClick="() => GoToExerciseTypeDetails(exerciseType?.Id)"
                                                       Title="View History & Trends" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="MudBlazor.Color.Secondary" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                                       OnClick="() => GoToEditExercise(exerciseId)"
                                                       Title="Edit Exercise" />
                                    </div>
                                </div>

                                @if (exerciseType is not null)
                                {
                                    <MudText Typo="Typo.caption" Class="hs-muted-copy">@GetExerciseTypeMuscleLine(exerciseType)</MudText>
                                }

                                <!-- Sets/Reps chips — desktop shows 3 items, mobile shows 2 -->
                                <div class="exercise-instances">
                                    @foreach (var exercise in exerciseTypeGroup.Take(3))
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <MudChip Variant="Variant.Outlined" Size="MudBlazor.Size.Small" Class="hs-rep-chip">
                                                @($"{exercise.Series} sets")
                                            </MudChip>
                                            <MudChip Variant="Variant.Outlined" Size="MudBlazor.Size.Small" Class="hs-rep-chip">
                                                @($"{exercise.Repetitions} reps")
                                            </MudChip>
                                            <MudChip Variant="Variant.Outlined" Size="MudBlazor.Size.Small" Class="hs-rep-chip">
                                                @($"{exercise.Weight} kg")
                                            </MudChip>
                                        </div>
                                    }
                                    @if (exerciseTypeGroup.Count() > 3)
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1">+@(exerciseTypeGroup.Count() - 3) more sets</MudText>
                                    }
                                </div>

                                <!-- Stats Row -->
                                <div class="d-flex justify-space-between mt-3">
                                    <div>
                                        <MudText Typo="Typo.caption">1RM</MudText>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                                            @exerciseTypeGroup.Max(e => e.MaxRepetition)?.ToString("N1") kg
                                        </MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption">Volume</MudText>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                                            @exerciseTypeGroup.Sum(e => e.Volume) kg
                                        </MudText>
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                </div>
            }
        }
    }

    <!-- Pagination -->
    <div class="d-flex justify-center my-4">
        <MudPagination Count="@_pagedData.TotalPages" SelectedChanged="OnPageChanged"
                       Selected="@_currentPage" Class="mt-4" />
    </div>
}

</PageShell>

@code {
    // ── State ──────────────────────────────────────────────────────────────────

    private PagedResult<GetExerciseResource>? _pagedData;
    private List<Muscle> _muscles = new();
    private Dictionary<int, Muscle> _musclesById = new();
    private Dictionary<int, string> _muscleNames = new();
    private List<ExerciseTypeFilterOption> _exerciseTypeOptions = new();
    private List<string> _muscleGroupOptions = new();

    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 20;
    private string _sortField = "date";
    private bool _sortDescending = true;

    private int? _selectedExerciseTypeId;
    private string? _selectedExerciseTypeLabel;
    private List<string> _selectedMuscleGroups = new();
    private bool _isFilterActive => _selectedExerciseTypeId.HasValue || _selectedMuscleGroups.Any();

    private readonly Dictionary<string, bool> _expandedDates = new();

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Training History";

        // Load muscles and exercise type options (both cached in AppStateService)
        _muscles = await AppState.GetMusclesAsync();
        _musclesById = _muscles
            .Where(muscle => muscle.Id.HasValue)
            .ToDictionary(muscle => muscle.Id!.Value, muscle => muscle);
        _muscleNames = _muscles
            .Where(m => m.Id.HasValue)
            .ToDictionary(m => m.Id!.Value, m => m.Name ?? $"Muscle {m.Id}");
        _muscleGroupOptions = AppState.GetMuscleGroups();

        // The catalog paints from its first page and keeps hydrating in the
        // background. Building the filter options once would cap the dialog at the
        // first page's types and never refresh it during this visit, so rebuild on
        // every chunk (t_81a400b3).
        AppState.ExerciseTypesUpdated += OnExerciseTypesUpdated;
        await AppState.GetExerciseTypesAsync();
        RebuildExerciseTypeOptions();

        await LoadExercisesAsync();
    }

    private void OnExerciseTypesUpdated()
    {
        // AppState raises this on the sync context, after a chunk has landed.
        RebuildExerciseTypeOptions();
        StateHasChanged();
    }

    private void RebuildExerciseTypeOptions()
        => _exerciseTypeOptions = BuildExerciseTypeOptions(AppState.GetExerciseTypesSnapshot());

    public void Dispose() => AppState.ExerciseTypesUpdated -= OnExerciseTypesUpdated;

    // ── Data Loading ───────────────────────────────────────────────────────────

    private async Task LoadExercisesAsync()
    {
        _isLoading = true;
        try
        {
            var url = BuildExercisesUrl();
            _pagedData = await Http.GetFromJsonAsync<PagedResult<GetExerciseResource>>(url);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading exercises: {ex.Message}");
            _pagedData = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string BuildExercisesUrl()
    {
        var query = new System.Text.StringBuilder($"/Exercises?page={_currentPage}&pageSize={_pageSize}&sortBy={_sortField}&descending={_sortDescending}");

        if (_selectedExerciseTypeId.HasValue)
        {
            query.Append($"&exerciseTypeId={_selectedExerciseTypeId.Value}");
        }

        if (_selectedMuscleGroups.Any())
        {
            foreach (var muscle in _selectedMuscleGroups)
                query.Append($"&muscleGroup={Uri.EscapeDataString(muscle)}");
        }

        return query.ToString();
    }

    // ── Filter / Sort ──────────────────────────────────────────────────────────

    private async Task OpenFilterDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters
        {
            { "ExerciseTypes", _exerciseTypeOptions },
            { "MuscleGroups", _muscleGroupOptions },
            { "SelectedExerciseTypeId", _selectedExerciseTypeId },
            { "SelectedMuscleGroups", new List<string>(_selectedMuscleGroups) }
        };

        var dialog = await DialogService.ShowAsync<ExerciseFilterDialog>("Filter Exercises", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is FilterSettings filterSettings)
        {
            _selectedExerciseTypeId = filterSettings.ExerciseTypeId;
            _selectedExerciseTypeLabel = filterSettings.ExerciseTypeLabel;
            _selectedMuscleGroups = filterSettings.MuscleGroups;
            _currentPage = 1;
            await LoadExercisesAsync();
        }
    }

    private async Task SortExercisesBy(string field)
    {
        if (field == _sortField)
            _sortDescending = !_sortDescending;
        else
        {
            _sortField = field;
            _sortDescending = true;
        }
        await LoadExercisesAsync();
    }

    private async Task ToggleSortDirection()
    {
        _sortDescending = !_sortDescending;
        await LoadExercisesAsync();
    }

    private async Task OnPageChanged(int page)
    {
        if (_currentPage != page)
        {
            _currentPage = page;
            await LoadExercisesAsync();
        }
    }

    private async Task ClearExerciseTypeFilter()
    {
        _selectedExerciseTypeId = null;
        _selectedExerciseTypeLabel = null;
        _currentPage = 1;
        await LoadExercisesAsync();
    }

    private async Task RemoveMuscleFilter(string muscle)
    {
        _selectedMuscleGroups.Remove(muscle);
        _currentPage = 1;
        await LoadExercisesAsync();
    }

    private async Task ClearAllFilters()
    {
        _selectedExerciseTypeId = null;
        _selectedExerciseTypeLabel = null;
        _selectedMuscleGroups.Clear();
        _currentPage = 1;
        await LoadExercisesAsync();
    }

    // ── UI Helpers ─────────────────────────────────────────────────────────────

    private void ToggleDateExpand(string date)
        => _expandedDates[date] = !_expandedDates.GetValueOrDefault(date, true);

    private Variant GetSortButtonVariant(string field)
        => field == _sortField ? Variant.Filled : Variant.Outlined;

    // ── Navigation ─────────────────────────────────────────────────────────────

    private void GoToCreateExercise() => NavigationManager.NavigateTo("/training/today");
    private void GoToExerciseTypeDetails(int? id)
    {
        if (id.HasValue) NavigationManager.NavigateTo($"/training/library/{id}");
    }
    private void GoToEditExercise(Guid? id)
    {
        if (id.HasValue) NavigationManager.NavigateTo($"/training/history/{id}/edit");
    }

    // ── Date/Volume Helpers ────────────────────────────────────────────────────

    private string? FindMainExerciseForDate(string date, List<GetExerciseResource> exercises)
        => exercises
            .Where(e => e.Workout?.Date?.ToShortDateString() == date && e.MaxRepetition.HasValue)
            .OrderByDescending(e => e.MaxRepetition)
            .FirstOrDefault()?.Type?.Name;

    private Dictionary<string, double> GetVolumeSummaryByMuscleForDate(string date, List<GetExerciseResource> exercises)
    {
        var summary = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        var dateExercises = exercises.Where(e => e.Workout?.Date?.ToShortDateString() == date);

        foreach (var exercise in dateExercises)
        {
            var load = ComputeExerciseLoad(exercise);
            var distributedLoads = ExerciseMuscleAssignmentHelper.DistributeLoad(exercise.Type?.MuscleAssignments, load);

            if (distributedLoads.Count > 0)
            {
                foreach (var share in distributedLoads)
                {
                    var key = AddEmojiToMuscleName(GetMuscleNameById(share.MuscleId));
                    summary[key] = summary.GetValueOrDefault(key) + share.Load;
                }

                continue;
            }

            var fallbackKey = InferMuscleFromExerciseName(exercise.Type?.Name ?? "Other");
            summary[fallbackKey] = summary.GetValueOrDefault(fallbackKey) + load;
        }

        return summary.OrderByDescending(x => x.Value).ToDictionary(x => x.Key, x => x.Value);
    }

    private IEnumerable<IGrouping<string, GetExerciseResource>> GetDateGroups()
    {
        if (_pagedData?.Items == null)
            return Enumerable.Empty<IGrouping<string, GetExerciseResource>>();

        return _pagedData.Items
            .GroupBy(e => e.Workout?.Date?.ToShortDateString() ?? "No Date")
            .OrderByDescending(g => { DateTime.TryParse(g.Key, out var d); return d; });
    }

    private string GetMuscleNameById(int muscleId)
        => _muscleNames.GetValueOrDefault(muscleId, $"Muscle {muscleId}");

    private string GetExerciseTypeMuscleLine(GetExerciseTypeResource exerciseType)
        => AppState.FormatExerciseTypeMuscleLine(exerciseType);

    private static List<ExerciseTypeFilterOption> BuildExerciseTypeOptions(IEnumerable<GetExerciseTypeResource> allTypes)
    {
        var exerciseTypes = allTypes
            .Where(type => type.Id > 0 && !string.IsNullOrWhiteSpace(type.Name))
            .ToList();

        var duplicateNames = exerciseTypes
            .GroupBy(type => type.Name!, StringComparer.OrdinalIgnoreCase)
            .Where(group => group.Count() > 1)
            .Select(group => group.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return exerciseTypes
            .Select(type => new ExerciseTypeFilterOption
            {
                Id = type.Id,
                Label = duplicateNames.Contains(type.Name!)
                    ? $"{type.Name} / #{type.Id}"
                    : type.Name!
            })
            .OrderBy(option => option.Label)
            .ToList();
    }

    private string AddEmojiToMuscleName(string muscleName)
    {
        if (string.IsNullOrEmpty(muscleName)) return "🔘 Other";
        var muscle = _muscles.FirstOrDefault(m => m.Name?.Equals(muscleName, StringComparison.OrdinalIgnoreCase) == true);
        return (!string.IsNullOrEmpty(muscle?.MuscleGroup)
               ? GetEmojiForMuscleGroup(muscle.MuscleGroup)
               : InferMuscleGroupEmoji(muscleName)) + " " + muscleName;
    }

    private static string GetEmojiForMuscleGroup(string g) => g.ToLower() switch
    {
        "chest" => "👕", "back" => "🔄", "legs" => "🦿",
        "shoulders" => "🛡️", "arms" => "💪", "core" => "🧱",
        _ => "🔘"
    };

    private static string InferMuscleGroupEmoji(string name)
    {
        name = name.ToLower();
        if (name.Contains("bicep") || name.Contains("tricep") || name.Contains("arm")) return "💪";
        if (name.Contains("chest") || name.Contains("pec")) return "👕";
        if (name.Contains("shoulder") || name.Contains("delt")) return "🛡️";
        if (name.Contains("abs") || name.Contains("core") || name.Contains("abdomin")) return "🧱";
        if (name.Contains("back") || name.Contains("lat") || name.Contains("trap")) return "🔄";
        if (name.Contains("leg") || name.Contains("quad") || name.Contains("hamstring") || name.Contains("glute") || name.Contains("calf")) return "🦿";
        return "🔘";
    }

    private static string InferMuscleFromExerciseName(string name)
    {
        name = name.ToLower();
        if (name.Contains("bench") || name.Contains("chest") || name.Contains("pec")) return "👕 Chest";
        if (name.Contains("squat") || name.Contains("leg") || name.Contains("lunge") || name.Contains("deadlift")) return "🦿 Legs";
        if (name.Contains("shoulder") || name.Contains("press") || name.Contains("delt")) return "🛡️ Shoulders";
        if (name.Contains("bicep") || name.Contains("curl") || name.Contains("tricep") || name.Contains("extension")) return "💪 Arms";
        if (name.Contains("back") || name.Contains("row") || name.Contains("pull") || name.Contains("lat")) return "🔄 Back";
        if (name.Contains("ab") || name.Contains("core") || name.Contains("crunch")) return "🧱 Core";
        return "🔘 Other";
    }

    private static double ComputeExerciseLoad(GetExerciseResource exercise)
    {
        if (exercise.Volume.HasValue && exercise.Volume.Value > 0)
        {
            return exercise.Volume.Value;
        }

        if (!exercise.Series.HasValue || !exercise.Repetitions.HasValue || exercise.Series.Value <= 0 || exercise.Repetitions.Value <= 0)
        {
            return 0;
        }

        var weightType = exercise.WeightType ?? exercise.Type?.WeightType ?? ExerciseWeightType.Standard;
        decimal effectiveWeight = weightType switch
        {
            ExerciseWeightType.BodyWeight => (exercise.BodyWeight ?? exercise.Weight ?? 0) + (exercise.AddedWeight ?? 0),
            ExerciseWeightType.None => 0,
            _ => exercise.Weight ?? 0
        };

        return effectiveWeight <= 0
            ? 0
            : (double)(effectiveWeight * exercise.Series.Value * exercise.Repetitions.Value);
    }

}
