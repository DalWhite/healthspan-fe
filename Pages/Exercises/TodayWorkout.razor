@page "/training/today"
@inject HttpClient Http
@inject HealthspanApiClient ApiClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject TitleService TitleService
@using System.Net
@using System.Text.Json

<PageTitle>Train</PageTitle>

<PageShell Narrow="true" Class="hs-today-page">
    <div class="hs-today-heading">
        <div>
            <MudText Typo="Typo.h5">Training</MudText>
            <MudText Typo="Typo.caption" Class="hs-muted-copy">@DateLabel</MudText>
        </div>

        @if (_session is not null)
        {
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Outlined"
                           Color="MudBlazor.Color.Primary"
                           Disabled="@_isStarting"
                           OnClick="StartWorkout">
                    New session
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="MudBlazor.Color.Primary"
                           OnClick="FinishWorkout">
                    Finish
                </MudButton>
            </MudStack>
        }
    </div>

    @if (_isLoading)
    {
        <LoadingState Message="Loading training sessions..." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined"
                   Color="MudBlazor.Color.Primary"
                   Class="mt-3"
                   OnClick="LoadPageAsync">
            Retry
        </MudButton>
    }
    else if (_session is null)
    {
        <MudPaper Class="hs-surface hs-today-start" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter"
                     Color="MudBlazor.Color.Primary"
                     Size="MudBlazor.Size.Large" />
            <MudButton Variant="Variant.Filled"
                       Color="MudBlazor.Color.Primary"
                       FullWidth="true"
                       Loading="@_isStarting"
                       Disabled="@_isStarting"
                       OnClick="StartWorkout">
                Start workout
            </MudButton>
        </MudPaper>
    }
    else
    {
        @if (_sessions.Count > 1)
        {
            <div class="hs-today-session-switcher"
                 role="tablist"
                 aria-label="Training sessions">
                @for (var index = 0; index < _sessions.Count; index++)
                {
                    var session = _sessions[index];
                    var sessionNumber = index + 1;
                    <button type="button"
                            role="tab"
                            aria-selected="@((_session?.Id == session.Id).ToString().ToLowerInvariant())"
                            class="@(_session?.Id == session.Id ? "is-active" : null)"
                            @onclick="() => SelectSession(session)">
                        Session @sessionNumber
                        <span>@session.Exercises.Count</span>
                    </button>
                }
            </div>
        }

        <section class="hs-today-session" aria-label="Current workout">
            <div class="hs-today-session-summary">
                <span>@ExerciseSummary</span>
            </div>

            @if (_session!.Exercises.Count == 0)
            {
                <div class="hs-today-empty-session">No exercises yet.</div>
            }
            else
            {
                <div class="hs-today-exercise-list">
                    @foreach (var exercise in _session.Exercises)
                    {
                        <article class="hs-today-exercise-item">
                            <div class="hs-today-exercise-copy">
                                <span class="hs-today-exercise-name">
                                    @exercise.Name
                                    @if (exercise.Tags.Count > 0)
                                    {
                                        <span class="hs-training-tag-inline">
                                            @string.Join(" · ", exercise.Tags)
                                        </span>
                                    }
                                </span>
                                <span class="hs-today-exercise-load">@FormatExerciseLoad(exercise)</span>
                            </div>
                            <a class="hs-workout-edit-link hs-today-exercise-edit-link"
                               href="@BuildEditRoute(exercise.Id)"
                               aria-label="@($"Edit {exercise.Name ?? "exercise"} entry")">
                                <MudIcon Icon="@Icons.Material.Filled.Edit"
                                         aria-hidden="true" />
                            </a>
                        </article>
                    }
                </div>
            }
        </section>

        <MudPaper Class="hs-surface hs-today-add" Elevation="0">
            <MudText Typo="Typo.h6" Class="hs-today-add-title">Add exercise</MudText>
            <ExerciseCreationForm ExerciseTypes="@_exerciseTypes"
                                  CurrentUserBodyWeight="@_currentUserBodyWeight"
                                  WorkoutId="@_session.Id"
                                  ShowDatePicker="false"
                                  ShowQuickPicks="true"
                                  UseWorkoutSessionEndpoint="true"
                                  SubmitLabel="Add exercise"
                                  RecentExerciseTypeIds="@_session.RecentExerciseTypeIds"
                                  OnSessionUpdated="HandleSessionUpdated" />
        </MudPaper>
    }
</PageShell>

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private GetExerciseTypeResource[] _exerciseTypes = Array.Empty<GetExerciseTypeResource>();
    private readonly List<WorkoutSessionResource> _sessions = [];
    private WorkoutSessionResource? _session;
    private decimal? _currentUserBodyWeight;
    private string? _error;
    private bool _isLoading = true;
    private bool _isStarting;

    private string DateLabel
        => _today.ToDateTime(TimeOnly.MinValue).ToString("dddd, d MMMM");

    private string ExerciseSummary
    {
        get
        {
            var exerciseCount = _session?.Exercises.Count ?? 0;
            var totalSets = _session?.Exercises.Sum(exercise => exercise.Series ?? 0) ?? 0;
            return $"{exerciseCount} {(exerciseCount == 1 ? "exercise" : "exercises")} · {totalSets} sets";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Train";
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var typesTask = Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
            var sessionsTask = LoadSessionsAsync();
            var profileWeightTask = LoadProfileWeightAsync();
            await Task.WhenAll(
                typesTask,
                sessionsTask,
                profileWeightTask);

            _exerciseTypes = typesTask.Result ?? Array.Empty<GetExerciseTypeResource>();
            _sessions.Clear();
            _sessions.AddRange(sessionsTask.Result);
            _session = _sessions.LastOrDefault();
            _currentUserBodyWeight = profileWeightTask.Result;
        }
        catch (HttpRequestException)
        {
            _error = "Training sessions could not be loaded.";
        }
        catch (TaskCanceledException)
        {
            _error = "Loading took too long. Please try again.";
        }
        catch (JsonException)
        {
            _error = "The workout response was incomplete. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<List<WorkoutSessionResource>> LoadSessionsAsync()
    {
        using var response = await Http.GetAsync(
            $"/Workouts/today/sessions?date={_today:yyyy-MM-dd}");
        response.EnsureSuccessStatusCode();
        return await response.Content
                   .ReadFromJsonAsync<List<WorkoutSessionResource>>()
               ?? [];
    }

    private async Task<decimal?> LoadProfileWeightAsync()
    {
        try
        {
            var profile = await ApiClient.GetHealthProfileAsync();
            return profile.WeightKg;
        }
        catch
        {
            return null;
        }
    }

    private async Task StartWorkout()
    {
        if (_isStarting)
        {
            return;
        }

        _isStarting = true;
        _error = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "/Workouts/today",
                new StartWorkoutSessionResource
                {
                    Date = _today,
                    CreateNew = _sessions.Count > 0
                });

            if (!response.IsSuccessStatusCode)
            {
                _error = "The workout could not be started.";
                return;
            }

            _session = await response.Content.ReadFromJsonAsync<WorkoutSessionResource>();
            if (_session is null)
            {
                _error = "The workout response was incomplete.";
                return;
            }

            var existingIndex = _sessions.FindIndex(
                session => session.Id == _session.Id);
            if (existingIndex >= 0)
            {
                _sessions[existingIndex] = _session;
            }
            else
            {
                _sessions.Add(_session);
            }
        }
        catch (HttpRequestException)
        {
            _error = "The workout could not be started.";
        }
        catch (TaskCanceledException)
        {
            _error = "Starting took too long. Please try again.";
        }
        catch (JsonException)
        {
            _error = "The workout response was incomplete. Please try again.";
        }
        finally
        {
            _isStarting = false;
        }
    }

    private Task HandleSessionUpdated(WorkoutSessionResource session)
    {
        _session = session;
        var index = _sessions.FindIndex(
            item => item.Id == session.Id);
        if (index >= 0)
        {
            _sessions[index] = session;
        }
        else
        {
            _sessions.Add(session);
        }

        Snackbar.Add("Exercise added.", Severity.Success);
        return Task.CompletedTask;
    }

    private void SelectSession(WorkoutSessionResource session)
        => _session = session;

    private void FinishWorkout()
        => NavigationManager.NavigateTo("/training/history");

    private static string BuildEditRoute(Guid exerciseId)
        => $"/training/history/{exerciseId}/edit?returnUrl={Uri.EscapeDataString("/training/today")}";

    private static string FormatExerciseLoad(
        WorkoutSessionExerciseResource exercise)
    {
        var sets = exercise.Series ?? 0;
        var repetitions = exercise.Repetitions ?? 0;
        var load = exercise.BodyWeight.GetValueOrDefault() > 0
            ? $" · {exercise.BodyWeight:0.#} kg BW"
              + (exercise.AddedWeight.GetValueOrDefault() > 0
                  ? $" + {exercise.AddedWeight:0.#} kg"
                  : string.Empty)
            : exercise.Weight.GetValueOrDefault() > 0
                ? $" · {exercise.Weight:0.#} kg"
                : string.Empty;

        return $"{sets} × {repetitions}{load}";
    }

}
