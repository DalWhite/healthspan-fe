    private List<WorkoutSessionExerciseResource> UnassignedExercises
    {
        get
        {
            if (_session is null || _session.Blocks.Count == 0)
            {
                return [];
            }

            var assigned = _session.Blocks
                .SelectMany(block => block.Exercises)
                .Select(exercise => exercise.Id)
                .ToHashSet();

            return _session.Exercises
                .Where(exercise => !assigned.Contains(exercise.Id))
                .ToList();
        }
    }

    private Task SetIntentAsync(TrainingGoal? goal = null, TrainingModality? modality = null)
    {
        if (_session is null)
        {
            return Task.CompletedTask;
        }

        if (goal is not null)
        {
            _session.Goal = goal.ToString();
        }

        if (modality is not null)
        {
            _session.Modality = modality.ToString();
        }

        return PatchSessionAsync(new
        {
            goal = goal?.ToString(),
            modality = modality?.ToString()
        });
    }

    private Task ToggleSecondaryGoalAsync(TrainingGoal goal)
    {
        if (_session is null)
        {
            return Task.CompletedTask;
        }

        var name = goal.ToString();
        if (_session.SecondaryGoals.Contains(name))
        {
            _session.SecondaryGoals.Remove(name);
        }
        else
        {
            _session.SecondaryGoals.Add(name);
        }

        return PatchSessionAsync(new { secondaryGoals = _session.SecondaryGoals });
    }

    // sessionId lets the post-finish summary patch the session it closed:
    // FinishWorkout nulls _session before the summary renders, so a fatigue
    // tap there must patch the closed session, not the (now null) live one.
    private async Task PatchSessionAsync(object payload, Guid? sessionId = null)
    {
        var targetId = sessionId ?? _session?.Id;
        if (targetId is null)
        {
            return;
        }

        try
        {
            using var response = await Http.PatchAsJsonAsync(
                $"/Workouts/{targetId}",
                payload);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "The training intent could not be saved. It will retry on the next sync.",
                    Severity.Warning);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(
                "The training intent could not be saved. It will retry on the next sync.",
                Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add(
                "Saving took too long. It will retry on the next sync.",
                Severity.Warning);
        }
    }

    // ── Universal tracker: blocks ─────────────────────────────────────────────

    private void ToggleBlockCreator()
    {
        _showBlockCreator = !_showBlockCreator;
        if (!_showBlockCreator)
        {
            _newBlockLabel = null;
            _newBlockRounds = 1;
            _newBlockType = WorkoutBlockType.Normal.ToString();
        }
    }

    private void AddExerciseToBlock(WorkoutBlockResource block)
    {
        _formBlockId = block.Id;
        _showBlockCreator = false;
    }

    private async Task AddBlockAsync()
    {
        if (_busyBlock)
        {
            return;
        }

        _busyBlock = true;
        try
        {
            var workoutId = await EnsureTodaySessionAsync();
            var session = _session;
            if (session is null)
            {
                return;
            }

            var order = session.Blocks.Count > 0
                ? session.Blocks.Max(block => block.Order) + 1
                : 1;

            using var response = await Http.PostAsJsonAsync(
                $"/Workouts/{workoutId}/blocks",
                new
                {
                    order,
                    type = _newBlockType,
                    label = string.IsNullOrWhiteSpace(_newBlockLabel)
                        ? null
                        : _newBlockLabel.Trim(),
                    rounds = NeedsRounds(_newBlockType) ? _newBlockRounds : (int?)null
                });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo añadir el bloque.", Severity.Warning);
                return;
            }

            // Both the API and the offline mirror answer a block create with the
            // whole session, so the session is what we adopt — never a lone block.
            var updated = await response.Content
                .ReadFromJsonAsync<WorkoutSessionResource>();
            if (updated?.Blocks is { Count: > 0 } blocks)
            {
                session.Blocks = blocks;
                _formBlockId = blocks
                    .OrderBy(block => block.Order)
                    .Last().Id;
            }

            _showBlockCreator = false;
            _newBlockLabel = null;
            _newBlockRounds = 1;
            _newBlockType = WorkoutBlockType.Normal.ToString();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo añadir el bloque.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Tardó demasiado en añadir el bloque. Inténtalo de nuevo.", Severity.Warning);
        }
        catch (JsonException)
        {
            Snackbar.Add("La respuesta del bloque fue incompleta. Inténtalo de nuevo.", Severity.Warning);
        }
        finally
        {
            _busyBlock = false;
        }
    }

    // ── Universal tracker: attempts ───────────────────────────────────────────

    private async Task CompleteAttemptAsync(WorkoutSessionExerciseResource exercise)
    {
        var attempts = Math.Max(1, exercise.Attempts ?? 1);
        var completed = Math.Min(attempts, (exercise.CompletedAttempts ?? 0) + 1);

        // The row ticks first: the tap is the workout, the save is background.
        exercise.CompletedAttempts = completed;


        try
        {
            using var response = await Http.PutAsJsonAsync("/Exercises", new UpdateExerciseResource
            {
                Id = exercise.Id,
                Series = exercise.Series,
                Repetitions = exercise.Repetitions,
                Weight = exercise.Weight,
                BodyWeight = exercise.BodyWeight,
                AddedWeight = exercise.AddedWeight,
                Tags = exercise.Tags,
                Attempts = attempts,
                CompletedAttempts = completed,
                QualityIntent = exercise.QualityIntent,
                LoadType = exercise.LoadType
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo guardar el intento.", Severity.Warning);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo guardar. Se sincronizará al reconectar.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Tardó demasiado. Se sincronizará al reconectar.", Severity.Warning);
        }
    }

    // ── Universal tracker: closing the session ────────────────────────────────

    private async Task FinishWorkout()
    {
        if (_session is null)
        {
            NavigationManager.NavigateTo("/training/history");
            return;
        }

        // Closing is one tap: no dialog, no second step. The user lands on their
        // own result (DESIGN.md §5.3) and perceived fatigue is asked there, once.
        var session = _session;
        _summarySession = session;
        _summaryRecords = BuildRecordList(session);
        _showSummary = true;
        _session = null;
        ActiveSession.SetSession(null);

        // When finish is triggered from the shell FAB (ActiveSession.FinishAsync),
        // the event belongs to MainLayout and only the layout re-renders; the page
        // must render its own summary explicitly (t_745b4960 regression). The
        // continuation can resume off the Blazor dispatcher, so the render is
        // marshalled through InvokeAsync.
        await InvokeAsync(StateHasChanged);
    }

    private async Task BackToTodayAsync()
    {
        _showSummary = false;
        _summarySession = null;
        _summaryRecords = [];
        await LoadPageAsync();
    }

    private async Task SaveFatigueAsync(int fatigue)
    {
        if (_summarySession is null)
        {
            return;
        }

        _summarySession.PerceivedFatigue = fatigue;
        await PatchSessionAsync(new { perceivedFatigue = fatigue }, _summarySession.Id);
    }

    // A PR is this session beating the load logged in the previous one.
    private List<string> BuildRecordList(WorkoutSessionResource session)
    {
        var records = new List<string>();
        foreach (var exercise in session.Exercises)
        {
            if (!IsRecordFor(exercise))
            {
                continue;
            }

            var name = ExerciseDisplayName(exercise);
            var current = ExerciseLoadValue(exercise);
            var previous = _previousLoads.TryGetValue(exercise.TypeId, out var baseline)
                ? HistoryLoadValue(baseline)
                : 0;
            var delta = current - previous;
            records.Add(delta > 0
                ? $"{name} · {FormatNumber(current)} kg (+{FormatNumber(delta)})"
                : $"{name} · {FormatNumber(current)} kg");
        }
        return records;
    }

    // ── Universal tracker: saving a logged set ────────────────────────────────
    // The row updates on the tap and the save happens after; a failed save is
    // retried by the offline mirror, never by asking the user to type again.

    private async Task SaveExerciseAsync(WorkoutSessionExerciseResource exercise)
    {
        try
        {
            using var response = await Http.PutAsJsonAsync("/Exercises", new UpdateExerciseResource
            {
                Id = exercise.Id,
                Series = exercise.Series,
                Repetitions = exercise.Repetitions,
                Weight = exercise.Weight,
                BodyWeight = exercise.BodyWeight,
                AddedWeight = exercise.AddedWeight,
                Tags = exercise.Tags,
                Attempts = exercise.Attempts,
                CompletedAttempts = exercise.CompletedAttempts,
                QualityIntent = exercise.QualityIntent,
                LoadType = exercise.LoadType
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo guardar la serie. Se sincronizará al reconectar.", Severity.Warning);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo guardar. Se sincronizará al reconectar.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Tardó demasiado. Se sincronizará al reconectar.", Severity.Warning);
        }
    }

    // ── Universal tracker: one row per set (DESIGN.md §5.2) ───────────────────
    // Every logged set is its own session exercise row. Rows of the same
    // exercise in the same block render as one group, but each row saves, adds
    // and removes on its own.

    private static List<List<WorkoutSessionExerciseResource>> ExerciseGroups(
        IEnumerable<WorkoutSessionExerciseResource> exercises)
        => exercises
            .GroupBy(exercise => (exercise.TypeId, exercise.Name, exercise.BlockId))
            .Select(group => group.OrderBy(exercise => exercise.Order ?? 0).ToList())
            .ToList();

    private async Task AddSetAsync(WorkoutSessionExerciseResource? template)
    {
        if (template is null || _session is null)
        {
            return;
        }

        var nextOrder = (_session.Exercises.Count > 0
            ? _session.Exercises.Max(exercise => exercise.Order ?? 0)
            : 0) + 1;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"/Workouts/{_session.Id}/exercises",
                new AddExerciseResource
                {
                    WorkoutId = _session.Id,
                    TypeId = template.TypeId,
                    Series = 1,
                    Weight = 0m,
                    BlockId = template.BlockId,
                    Order = nextOrder,
                    Attempts = template.Attempts ?? 1,
                    CompletedAttempts = 0,
                    QualityIntent = template.QualityIntent,
                    LoadType = template.LoadType
                });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo añadir la serie.", Severity.Warning);
                return;
            }

            var session = await response.Content
                .ReadFromJsonAsync<WorkoutSessionResource>();
            if (session is not null)
            {
                AdoptSession(session);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo guardar. Se sincronizará al reconectar.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Tardó demasiado. Se sincronizará al reconectar.", Severity.Warning);
        }
    }

    private async Task RemoveSetAsync(WorkoutSessionExerciseResource entry)
    {
        if (_session is null)
        {
            return;
        }

        var sessionId = _session.Id;
        try
        {
            using var response = await Http.DeleteAsync($"/Exercises/{entry.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo quitar la serie.", Severity.Warning);
                return;
            }

            _sessions.Clear();
            _sessions.AddRange(await LoadSessionsAsync());
            _session = _sessions.FirstOrDefault(session => session.Id == sessionId)
                       ?? _sessions.LastOrDefault();
            ActiveSession.SetSession(_session?.Id);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo guardar. Se sincronizará al reconectar.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Tardó demasiado. Se sincronizará al reconectar.", Severity.Warning);
        }
    }

    private void AdoptSession(WorkoutSessionResource session)
    {
        _session = session;
        var index = _sessions.FindIndex(item => item.Id == session.Id);
        if (index >= 0)
        {
            _sessions[index] = session;
        }
        else
        {
            _sessions.Add(session);
        }

        ActiveSession.SetSession(session.Id);
    }


    // ── Universal tracker: names, thumbnails and baselines ────────────────────

    private static string BlockName(WorkoutBlockResource block)
    {
        if (!string.IsNullOrWhiteSpace(block.Label))
        {
            return block.Label!;
        }

        return WorkoutBlockTypeLabels.Parse(block.Type) is { } parsed
            ? SpanishBlockTypeLabel(parsed)
            : "Bloque";
    }

    private string ExerciseDisplayName(WorkoutSessionExerciseResource exercise)
    {
        if (!string.IsNullOrWhiteSpace(exercise.Name))
        {
            return exercise.Name!;
        }

        return _exerciseTypes.FirstOrDefault(type => type.Id == exercise.TypeId)?.Name
               ?? "Ejercicio";
    }

    private string ExerciseThumbUrl(WorkoutSessionExerciseResource exercise)
        => _exerciseTypes.FirstOrDefault(type => type.Id == exercise.TypeId)?.ImageRoute
           ?? string.Empty;

    private string PreviousTextFor(WorkoutSessionExerciseResource exercise)
        => _previousLoads.TryGetValue(exercise.TypeId, out var previous) && HasLoggedHistory(previous)
            ? FormatHistoryLoad(previous)
            : "—";

    // A previous row with no reps and no load is an empty placeholder, not a
    // reference value: rendering it as "1x0" invents a number the athlete never
    // logged (t_0f19c744).
    private static bool HasLoggedHistory(WorkoutHistoryExerciseResource exercise)
        => (exercise.Repetitions ?? 0) > 0 || HistoryLoadValue(exercise) > 0;

    private static string FormatHistoryLoad(WorkoutHistoryExerciseResource exercise)
    {
        var sets = Math.Max(1, exercise.Series ?? 1);
        var reps = exercise.Repetitions ?? 0;
        var load = HistoryLoadValue(exercise);
        return load > 0
            ? $"{sets}x{reps} · {FormatNumber(load)} kg"
            : $"{sets}x{reps}";
    }

    private static decimal HistoryLoadValue(WorkoutHistoryExerciseResource exercise)
        => (decimal)(exercise.AddedWeight ?? exercise.Weight ?? 0);

    private static decimal ExerciseLoadValue(WorkoutSessionExerciseResource exercise)
        => exercise.AddedWeight ?? exercise.Weight ?? 0;

    private bool IsRecordFor(WorkoutSessionExerciseResource exercise)
    {
        var current = ExerciseLoadValue(exercise);
        if (current <= 0)
        {
            return false;
        }

        return _previousLoads.TryGetValue(exercise.TypeId, out var previous)
               && current > HistoryLoadValue(previous);
    }

    private static string FormatNumber(decimal value)
        => value == Math.Truncate(value)
            ? EsFormat.Decimal(value, "0")
            : EsFormat.Decimal(value, "0.0");

}