@page "/training/today"
@inject HttpClient Http
@inject HealthspanApiClient ApiClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject TitleService TitleService
@inject ActiveSessionState ActiveSession
@using System.Net
@using System.Globalization
@using System.Text.Json

<PageTitle>Hoy</PageTitle>

<PageShell Narrow="true" Class="hs-today-page">
    <PageHeader Title="Hoy" Subtitle="@DateLabel">
        <Actions>
            @if (_session is not null && !_showSummary)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="MudBlazor.Color.Primary"
                           Disabled="@_isStarting"
                           OnClick="StartWorkout">
                    Nueva sesión
                </MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingState Message="Cargando tus entrenos..." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined"
                   Color="MudBlazor.Color.Primary"
                   Class="mt-3"
                   OnClick="LoadPageAsync">
            Reintentar
        </MudButton>
    }

    @* The three screens of the flow (DESIGN.md §5.1-5.3): activation, the log
       in progress, and the summary. Only one is on screen at a time. *@
    @if (_showSummary && _summarySession is not null)
    {
        <TodaySessionSummary Session="@_summarySession"
                             Records="@_summaryRecords"
                             OnFatigueSelected="SaveFatigueAsync"
                             OnBackToToday="BackToTodayAsync" />
    }
    else if (_session is null)
    {
        <section class="hs-today-activation" aria-label="Empezar">
            @if (ShowFirstRunEmpty)
            {
                <EmptyState Icon="@Icons.Material.Filled.FitnessCenter"
                            Title="Aún no hay entrenos"
                            Subtitle="Toca + para registrar tu primer ejercicio. Aquí verás la sesión de hoy, tu racha y tus marcas." />
            }
            @if (_lastWorkout is not null)
            {
                <button type="button"
                        class="hs-cta hs-cta-secondary"
                        disabled="@_isRepeating"
                        @onclick="RepeatLastWorkout">@($"↻ Repetir «{LastWorkoutName}» · {LastWorkoutWhen}")</button>
            }
            @if (RecentSessionRows.Count > 0)
            {
                <MudPaper Class="hs-surface hs-today-recent" Elevation="0">
                    <span class="hs-micro-label">Últimos entrenos</span>
                    @foreach (var row in RecentSessionRows)
                    {
                        <div class="hs-today-recent-row">
                            <div>
                                <div class="hs-today-recent-name">@row.Name</div>
                                <div class="hs-today-recent-meta">@row.Meta</div>
                            </div>
                            <div class="hs-today-recent-metric">
                                <span class="hs-today-recent-metric-value">@row.Metric</span>
                                <small>@row.MetricLabel</small>
                            </div>
                        </div>
                    }
                </MudPaper>
            }
            @if (_streakDays >= 1)
            {
                <span class="hs-chip hs-today-streak"
                      aria-label="@($"Racha de {_streakDays} días")">@($"Racha: {_streakDays} días")</span>
            }
        </section>
    }

    else
    {
        var current = _session;

        @if (_sessions.Count > 1)
        {
            <div class="hs-today-session-switcher"
                 role="tablist"
                 aria-label="Entrenos de hoy">
                @for (var index = 0; index < _sessions.Count; index++)
                {
                    var session = _sessions[index];
                    var sessionNumber = index + 1;
                    <button type="button"
                            role="tab"
                            aria-selected="@((_session?.Id == session.Id).ToString().ToLowerInvariant())"
                            class="@(_session?.Id == session.Id ? "is-active" : null)"
                            @onclick="() => SelectSession(session)">
                        Sesión @sessionNumber
                        <span>@session.Exercises.Count</span>
                    </button>
                }
            </div>
        }

        <section class="hs-today-session" aria-label="Entreno en curso">
            <div class="hs-today-session-bar">
                <span class="hs-chip hs-chip-accent hs-today-session-bar-intent">@SessionIntentLabel</span>
                <span class="hs-today-session-summary">@ExerciseSummary</span>
                <button type="button"
                        class="hs-chip hs-today-block-add"
                        aria-label="Añadir bloque"
                        @onclick="ToggleBlockCreator">Bloque</button>
            </div>

            <div class="hs-today-intent" aria-label="Intención del entreno">
                <div class="hs-today-chip-row" role="group" aria-label="Tipo de entreno">
                    @foreach (var modality in ModalityChoices)
                    {
                        <button type="button"
                                class="@IntentChipClass(current.Modality == modality.ToString())"
                                aria-pressed="@(current.Modality == modality.ToString())"
                                @onclick="() => SetIntentAsync(modality: modality)">
                            @SpanishModalityLabel(modality)
                        </button>
                    }
                    @if (!_showAllModalities)
                    {
                        <button type="button"
                                class="hs-chip hs-chip-more"
                                @onclick="@(() => _showAllModalities = true)">
                            Otros
                        </button>
                    }
                </div>
                <div class="hs-today-chip-row" role="group" aria-label="Objetivo principal">
                    @foreach (var goal in TrainingIntent.GoalOrder)
                    {
                        <button type="button"
                                class="@IntentChipClass(current.Goal == goal.ToString())"
                                aria-pressed="@(current.Goal == goal.ToString())"
                                @onclick="() => SetIntentAsync(goal: goal)">
                            @SpanishGoalLabel(goal)
                        </button>
                    }
                </div>
                @if (_showSecondaryGoals || current.SecondaryGoals.Count > 0)
                {
                    <div class="hs-today-chip-row" role="group" aria-label="Objetivos secundarios">
                        <span class="hs-today-chip-label">También para</span>
                        @foreach (var goal in TrainingIntent.GoalOrder)
                        {
                            <button type="button"
                                    class="@IntentChipClass(current.SecondaryGoals.Contains(goal.ToString()))"
                                    aria-pressed="@(current.SecondaryGoals.Contains(goal.ToString()))"
                                    @onclick="() => ToggleSecondaryGoalAsync(goal)">
                                @SpanishGoalLabel(goal)
                            </button>
                        }
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => _showSecondaryGoals = true)">
                        También entrenas para
                    </MudButton>
                }
            </div>

            @if (_showBlockCreator)
            {
                <div class="hs-today-block-creator" role="group" aria-label="Nuevo bloque">
                    @foreach (var blockType in WorkoutBlockTypeLabels.PickerOrder)
                    {
                        <button type="button"
                                class="@IntentChipClass(_newBlockType == blockType.ToString())"
                                aria-pressed="@(_newBlockType == blockType.ToString())"
                                @onclick="() => _newBlockType = blockType.ToString()">
                            @SpanishBlockTypeLabel(blockType)
                        </button>
                    }
                    <MudTextField @bind-Value="_newBlockLabel"
                                  Placeholder="Nombre (opcional)"
                                  MaxLength="120"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                    @if (NeedsRounds(_newBlockType))
                    {
                        <MudNumericField T="int"
                                         Value="_newBlockRounds"
                                         ValueChanged="@(value => _newBlockRounds = value)"
                                         Label="Rondas"
                                         Min="1"
                                         Max="50"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                    }
                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               Size="Size.Small"
                               Disabled="@_busyBlock"
                               OnClick="AddBlockAsync">
                        Añadir bloque
                    </MudButton>
                </div>
            }

            @if (current.Exercises.Count == 0 && current.Blocks.Count == 0)
            {
                <div class="hs-today-empty-session">
                    <p>Toca «+ serie» para registrar tu primera serie.</p>
                    <p class="hs-today-empty-hint">¿Repetir el entreno de ayer? Toca <strong>Repetir</strong> en Hoy.</p>
                </div>
            }
            else if (current.Blocks.Count > 0)
            {
                <div class="hs-today-blocks">
                    @foreach (var block in current.Blocks)
                    {
                        <article class="hs-today-block">
                            <header class="hs-today-block-head">
                                <span class="hs-today-block-title">@BlockName(block)</span>
                                <span class="hs-chip hs-chip-accent hs-today-block-chip">@BlockTypeLabel(block.Type)</span>
                                @if (block.Rounds is > 0)
                                {
                                    <span class="hs-chip hs-today-block-chip">@($"{block.Rounds} rondas")</span>
                                }
                                <span class="hs-today-block-spacer"></span>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           aria-label="Añadir ejercicio a este bloque"
                                           OnClick="@(() => AddExerciseToBlock(block))">
                                    Ejercicio
                                </MudButton>
                            </header>
                            <div class="hs-today-exercise-list">
                                @foreach (var group in ExerciseGroups(block.Exercises))
                                {
                                    <TodayExerciseLog Entries="@group"
                                                      DisplayName="@ExerciseDisplayName(group[0])"
                                                      ThumbUrl="@ExerciseThumbUrl(group[0])"
                                                      PreviousText="@PreviousTextFor(group[0])"
                                                      OnEntrySaved="SaveExerciseAsync"
                                                      OnAddSet="AddSetAsync"
                                                      OnRemoveSet="RemoveSetAsync"
                                                      OnCompleteAttempt="CompleteAttemptAsync" />
                                }
                            </div>
                        </article>
                    }
                    @if (UnassignedExercises.Count > 0)
                    {
                        <div class="hs-today-exercise-list">
                            @foreach (var group in ExerciseGroups(UnassignedExercises))
                            {
                                <TodayExerciseLog Entries="@group"
                                                  DisplayName="@ExerciseDisplayName(group[0])"
                                                  ThumbUrl="@ExerciseThumbUrl(group[0])"
                                                  PreviousText="@PreviousTextFor(group[0])"
                                                  OnEntrySaved="SaveExerciseAsync"
                                                  OnAddSet="AddSetAsync"
                                                  OnRemoveSet="RemoveSetAsync"
                                                  OnCompleteAttempt="CompleteAttemptAsync" />
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="hs-today-exercise-list">
                    @foreach (var group in ExerciseGroups(current.Exercises))
                    {
                        <TodayExerciseLog Entries="@group"
                                          DisplayName="@ExerciseDisplayName(group[0])"
                                          ThumbUrl="@ExerciseThumbUrl(group[0])"
                                          PreviousText="@PreviousTextFor(group[0])"
                                          OnEntrySaved="SaveExerciseAsync"
                                          OnAddSet="AddSetAsync"
                                          OnRemoveSet="RemoveSetAsync"
                                          OnCompleteAttempt="CompleteAttemptAsync" />
                    }
                </div>
            }

        </section>
    }

    <MudPaper Class="hs-surface hs-today-add" Elevation="0">
        <MudText Typo="Typo.h6" Class="hs-today-add-title">Añadir ejercicio</MudText>
        <ExerciseCreationForm ExerciseTypes="@_exerciseTypes"
                              CurrentUserBodyWeight="@_currentUserBodyWeight"
                              WorkoutId="@(_session?.Id ?? Guid.Empty)"
                              ShowDatePicker="false"
                              ShowQuickPicks="true"
                              UseWorkoutSessionEndpoint="true"
                              SubmitLabel="Añadir ejercicio"
                              RecentExerciseTypeIds="@(_session?.RecentExerciseTypeIds ?? (IReadOnlyCollection<int>)Array.Empty<int>())"
                              PrescriptionHints="@_session?.Exercises"
                              Blocks="@(_session?.Blocks)"
                              InitialBlockId="@_formBlockId"
                              ShowQualityOptions="true"
                              WorkoutIdResolver="@(() => EnsureTodaySessionAsync())"
                              OnSessionUpdated="HandleSessionUpdated" />
    </MudPaper>
</PageShell>

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private GetExerciseTypeResource[] _exerciseTypes = Array.Empty<GetExerciseTypeResource>();
    private Task<GetExerciseTypeResource[]?>? _exerciseTypesTask;
    private bool _exerciseTypesLoaded;

    private readonly List<WorkoutSessionResource> _sessions = [];
    private WorkoutSessionResource? _session;
    private readonly List<GetWorkoutResource> _recentWorkouts = [];
    private GetWorkoutResource? _lastWorkout;
    private decimal? _currentUserBodyWeight;
    private string? _error;
    private bool _isLoading = true;
    private bool _isStarting;
    private bool _isRepeating;
    private bool _showSecondaryGoals;
    private bool _showAllModalities;
    private bool _showBlockCreator;
    private bool _busyBlock;
    private string _newBlockType = WorkoutBlockType.Normal.ToString();
    private string? _newBlockLabel;
    private int _newBlockRounds = 1;
    private Guid? _formBlockId;

    // Post-session summary (DESIGN.md §5.3): closing a session lands the user
    // on their own result, never on a catalog or on History.
    private bool _showSummary;
    private WorkoutSessionResource? _summarySession;
    private List<string> _summaryRecords = [];
    private int _streakDays;

    // Load done in the previous session, per exercise type: feeds the
    // "Anterior" column and the PR badge (DESIGN.md §3).
    private readonly Dictionary<int, WorkoutHistoryExerciseResource> _previousLoads = [];

    private string DateLabel
        => EsFormat.WeekdayDayMonth(_today);

    // The repeat CTA names the workout it repeats: a bare "Repetir" is a
    // mystery button, a named one is a decision the user can already make.
    private string LastWorkoutName
    {
        get
        {
            if (_lastWorkout is not { } workout) return "tu entreno anterior";
            if (workout.Blocks.FirstOrDefault(block => !string.IsNullOrWhiteSpace(block.Label)) is { } named)
                return named.Label!;
            if (TrainingIntent.ParseModality(workout.Modality) is { } modality)
                return SpanishModalityLabel(modality);
            return "tu entreno anterior";
        }
    }

    private string LastWorkoutWhen => DaysAgoLabel(_lastWorkout?.Date?.Date);

    private static string DaysAgoLabel(DateTime? date)
    {
        if (date?.Date is not { } workoutDate)
        {
            return string.Empty;
        }

        if (workoutDate == DateTime.Today)
        {
            return "hoy";
        }

        if (workoutDate == DateTime.Today.AddDays(-1))
        {
            return "ayer";
        }

        var days = (DateTime.Today - workoutDate).Days;
        return days <= 7
            ? $"{days} días"
            : EsFormat.DayMonth(workoutDate);
    }

    private static string WorkoutName(GetWorkoutResource workout)
    {
        if (workout.Blocks.FirstOrDefault(block => !string.IsNullOrWhiteSpace(block.Label)) is { } named)
            return named.Label!;
        if (TrainingIntent.ParseModality(workout.Modality) is { } modality)
            return SpanishModalityLabel(modality);
        return "Entreno";
    }

    private sealed record RecentSessionRow(string Name, string Meta, string Metric, string MetricLabel);

    private IReadOnlyList<RecentSessionRow> RecentSessionRows
    {
        get
        {
            var rows = new List<RecentSessionRow>();
            foreach (var workout in _recentWorkouts.Take(2))
            {
                var exercises = workout.Exercises;
                var heaviest = exercises
                    .OrderByDescending(exercise => exercise.AddedWeight.GetValueOrDefault() + (exercise.Weight ?? 0))
                    .FirstOrDefault();
                var attemptRows = exercises.Where(exercise => (exercise.Attempts ?? 0) > 0).ToList();
                var (metric, metricLabel) = attemptRows.Count > 0
                    ? ($"{attemptRows.Sum(exercise => exercise.CompletedAttempts ?? 0)}/{attemptRows.Sum(exercise => exercise.Attempts ?? 0)}", "completados")
                    : heaviest is null
                        ? ("—", string.Empty)
                        : (FormatHistoryLoad(heaviest), "última serie");
                rows.Add(new RecentSessionRow(
                    WorkoutName(workout),
                    $"{DaysAgoLabel(workout.Date?.Date)} · {workout.ExerciseCount} ejercicios",
                    metric,
                    metricLabel));
            }
            return rows;
        }
    }

    private string SessionIntentLabel
    {
        get
        {
            var segments = new List<string>();
            if (TrainingIntent.ParseModality(_session?.Modality) is { } modality) segments.Add(SpanishModalityLabel(modality));
            if (TrainingIntent.ParseGoal(_session?.Goal) is { } goal) segments.Add(SpanishGoalLabel(goal));
            return segments.Count > 0 ? string.Join(" · ", segments) : "Entreno";
        }
    }

    private string ExerciseSummary
    {
        get
        {
            if (_session is null) return string.Empty;
            var attemptRows = _session.Exercises.Where(exercise => (exercise.Attempts ?? 0) > 0).ToList();
            if (attemptRows.Count > 0)
                return $"{attemptRows.Sum(exercise => exercise.CompletedAttempts ?? 0)}/{attemptRows.Sum(exercise => exercise.Attempts ?? 0)} intentos";
            var exerciseCount = _session.Exercises.Count;
            var totalSets = _session.Exercises.Sum(exercise => exercise.Series ?? 0);
            return $"{exerciseCount} {(exerciseCount == 1 ? "ejercicio" : "ejercicios")} · {totalSets} series";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Hoy";
        // The shell FAB turns into "Finalizar" while a session is open and must
        // run exactly the page's own finish flow, not a second one (DESIGN.md §5.2).
        ActiveSession.RegisterFinish(FinishWorkout);
        await LoadPageAsync();

        // Quick start (shell FAB, DESIGN.md §5.2): the FAB is not a second route
        // to Today, it is one tap straight into the logging state. The query flag
        // is dropped so a refresh does not silently open another session.
        if (_session is null && _error is null && QuickStartRequested())
        {
            NavigationManager.NavigateTo("/training/today", forceLoad: false);
            await StartWorkout();
        }
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var sessionsTask = LoadSessionsAsync();
            var profileWeightTask = LoadProfileWeightAsync();
            await Task.WhenAll(
                sessionsTask,
                profileWeightTask);

            _sessions.Clear();
            _sessions.AddRange(sessionsTask.Result);
            _session = _sessions.LastOrDefault();
            _currentUserBodyWeight = profileWeightTask.Result;

            // The exercise catalog is ~1.4MB and is only needed to name and pick
            // exercises for a session being logged. Fetching it before knowing
            // whether there is a session put it on the critical path of the empty
            // day and kept "Cargando tus entrenos" on screen for tens of seconds,
            // so it now loads with the session, not before it.
            if (_session is not null)
            {
                await EnsureExerciseTypesAsync();
            }

            // Recent sessions feed the streak chip, the "Últimos entrenos" rows
            // and the "Anterior" column of the set table.
            _recentWorkouts.Clear();
            _recentWorkouts.AddRange(await LoadRecentWorkoutsAsync());
            _lastWorkout = _recentWorkouts.FirstOrDefault();
            _streakDays = ComputeStreakDays();

            if (_session is not null)
            {
                ActiveSession.SetSession(_session.Id);
                await LoadPreviousLoadsAsync();
            }
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar tus entrenos. Comprueba tu conexión.";
        }
        catch (TaskCanceledException)
        {
            _error = "Tardó demasiado. Vuelve a intentarlo.";
        }
        catch (JsonException)
        {
            _error = "La respuesta del entreno estaba incompleta. Vuelve a intentarlo.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool QuickStartRequested()
        => NavigationManager.ToAbsoluteUri(NavigationManager.Uri)
               .Query?.Contains("start=1", StringComparison.Ordinal) == true;

    private async Task<List<WorkoutSessionResource>> LoadSessionsAsync()
    {
        using var response = await Http.GetAsync(
            $"/Workouts/today/sessions?date={_today:yyyy-MM-dd}");
        response.EnsureSuccessStatusCode();
        return await response.Content
                   .ReadFromJsonAsync<List<WorkoutSessionResource>>()
               ?? [];
    }

    private async Task<List<GetWorkoutResource>> LoadRecentWorkoutsAsync()
    {
        try
        {
            // Most recent workouts that actually have logged exercises; empty
            // placeholder days are not worth repeating or showing.
            using var response = await Http.GetAsync("/workouts?page=1&pageSize=14");
            if (!response.IsSuccessStatusCode)
            {
                return [];
            }

            var page = await response.Content
                .ReadFromJsonAsync<List<GetWorkoutResource>>();
            return page?.Where(workout => workout.ExerciseCount > 0).ToList() ?? [];
        }
        catch (Exception)
        {
            // Recent rows are context, not core: never block Today for them.
            return [];
        }
    }

    private int ComputeStreakDays()
    {
        var days = _recentWorkouts
            .Where(workout => workout.Date is not null)
            .Select(workout => workout.Date!.Value.Date)
            .ToHashSet();
        if (days.Count == 0)
        {
            return 0;
        }

        // A streak may start today or yesterday; older than that it is broken
        // and the chip must not pretend otherwise.
        var cursor = DateTime.Today;
        if (!days.Contains(cursor))
        {
            cursor = cursor.AddDays(-1);
            if (!days.Contains(cursor))
            {
                return 0;
            }
        }

        var streak = 0;
        while (days.Contains(cursor))
        {
            streak++;
            cursor = cursor.AddDays(-1);
        }
        return streak;
    }

    // Exercise catalog (1.4MB, 979 rows): loaded on demand, once, only when a
    // session is on screen. See LoadPageAsync for why it is not prefetched.
    private bool ShowFirstRunEmpty =>
        _lastWorkout is null && RecentSessionRows.Count == 0 && _streakDays < 1;

    private async Task EnsureExerciseTypesAsync()
    {
        if (_exerciseTypesLoaded)
        {
            return;
        }

        _exerciseTypesTask ??= Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
        try
        {
            _exerciseTypes = await _exerciseTypesTask
                ?? Array.Empty<GetExerciseTypeResource>();
            _exerciseTypesLoaded = true;
        }
        catch
        {
            // A retry after the failure starts from a clean task.
            _exerciseTypesTask = null;
            throw;
        }
    }

    // "Anterior" column + PR badge: the load the user lifted last time for each
    // exercise type, read from the two most recent sessions.
    private async Task LoadPreviousLoadsAsync()
    {
        _previousLoads.Clear();
        foreach (var workout in _recentWorkouts
                     .Where(workout => _session is null || workout.Id != _session.Id)
                     .Take(2))
        {
            try
            {
                var detail = await Http.GetFromJsonAsync<GetWorkoutResource>($"/Workouts/{workout.Id}");
                if (detail is null)
                {
                    continue;
                }

                foreach (var exercise in detail.Exercises)
                {
                    if (exercise.TypeId == 0 || _previousLoads.ContainsKey(exercise.TypeId))
                    {
                        continue;
                    }

                    if (exercise.Series > 0 || exercise.Repetitions > 0 || exercise.Weight > 0)
                    {
                        _previousLoads[exercise.TypeId] = exercise;
                    }
                }
            }
            catch (Exception)
            {
                // Baselines are a nicety; a failed detail read just leaves the
                // column empty rather than breaking the log.
            }
        }
    }

    private async Task RepeatLastWorkout()
    {
        if (_isRepeating || _lastWorkout is null)
        {
            return;
        }

        _isRepeating = true;
        _error = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"/Workouts/{_lastWorkout.Id}/duplicate",
                new { Date = _today.ToString("yyyy-MM-dd") });
            if (!response.IsSuccessStatusCode)
            {
                _error = "No se pudo repetir el entreno. Vuelve a intentarlo.";
                return;
            }

            // Land in context: reload Today so the copy is already there,
            // exercises ready to edit. Never a wizard, never a catalog.
            await LoadPageAsync();
            Snackbar.Add("Entreno anterior copiado a hoy.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo repetir el entreno. Comprueba tu conexión.";
        }
        catch (TaskCanceledException)
        {
            _error = "Tardó demasiado. Vuelve a intentarlo.";
        }
        finally
        {
            _isRepeating = false;
        }
    }

    private async Task<decimal?> LoadProfileWeightAsync()
    {
        try
        {
            var profile = await ApiClient.GetHealthProfileAsync();
            return profile.WeightKg;
        }
        catch
        {
            return null;
        }
    }

    private async Task StartWorkout()
    {
        if (_isStarting)
        {
            return;
        }

        _isStarting = true;
        _error = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "/Workouts/today",
                new StartWorkoutSessionResource
                {
                    Date = _today,
                    CreateNew = _sessions.Count > 0
                });

            if (!response.IsSuccessStatusCode)
            {
                _error = "No se pudo empezar el entreno. Vuelve a intentarlo.";
                return;
            }

            var started = await response.Content
                .ReadFromJsonAsync<WorkoutSessionResource>();
            if (started is null)
            {
                _error = "La respuesta del entreno estaba incompleta.";
                return;
            }

            // The form renders with the session, so the catalog has to be in
            // memory before the session is assigned.
            await EnsureExerciseTypesAsync();
            _session = started;

            var existingIndex = _sessions.FindIndex(
                session => session.Id == _session.Id);
            if (existingIndex >= 0)
            {
                _sessions[existingIndex] = _session;
            }
            else
            {
                _sessions.Add(_session);
            }

            ActiveSession.SetSession(_session.Id);
            await LoadPreviousLoadsAsync();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo empezar el entreno. Comprueba tu conexión.";
        }
        catch (TaskCanceledException)
        {
            _error = "Tardó demasiado. Vuelve a intentarlo.";
        }
        catch (JsonException)
        {
            _error = "La respuesta del entreno estaba incompleta. Vuelve a intentarlo.";
        }
        finally
        {
            _isStarting = false;
        }
    }

    private async Task<Guid> EnsureTodaySessionAsync()
    {
        if (_session is not null)
        {
            return _session.Id;
        }

        // Today never asks the user to "start" a session first: the session is
        // created at the moment the first exercise is actually logged, so an
        // empty day never appears in the history.
        using var response = await Http.PostAsJsonAsync(
            "/Workouts/today",
            new StartWorkoutSessionResource
            {
                Date = _today,
                CreateNew = false
            });
        response.EnsureSuccessStatusCode();

        var session = await response.Content
            .ReadFromJsonAsync<WorkoutSessionResource>();
        if (session is null)
        {
            return Guid.Empty;
        }

        await EnsureExerciseTypesAsync();
        _session = session;
        _sessions.Add(session);
        ActiveSession.SetSession(session.Id);
        return session.Id;
    }

    private Task HandleSessionUpdated(WorkoutSessionResource session)
    {
        AdoptSession(session);
        Snackbar.Add("Ejercicio añadido.", Severity.Success);
        return Task.CompletedTask;
    }

    private void SelectSession(WorkoutSessionResource session)
    {
        _session = session;
        ActiveSession.SetSession(session.Id);
    }

    // ── Universal tracker: intent chips ───────────────────────────────────────
    // The intent is a tap, not a form: the wire keeps the API names and the
    // page updates itself immediately, so a tap never waits for the network.

    private List<TrainingModality> ModalityChoices
    {
        get
        {
            var recent = new List<TrainingModality>();
            foreach (var value in _sessions.Select(session => session.Modality)
                        .Append(_lastWorkout?.Modality))
            {
                if (TrainingIntent.ParseModality(value) is { } parsed
                    && !recent.Contains(parsed))
                {
                    recent.Add(parsed);
                }
            }

            var ordered = _showAllModalities
                ? TrainingIntent.ModalityOrder.ToList()
                : recent
                    .Concat(TrainingIntent.ModalityOrder
                        .Where(modality => !recent.Contains(modality)))
                    .Take(6)
                    .ToList();

            if (TrainingIntent.ParseModality(_session?.Modality) is { } current
                && !ordered.Contains(current))
            {
                ordered.Add(current);
            }

            return ordered;
        }
    }

