@page "/training/today"
@inject HttpClient Http
@inject HealthspanApiClient ApiClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject TitleService TitleService
@inject IDialogService DialogService
@using System.Net
@using System.Text.Json

<PageTitle>Train</PageTitle>

<PageShell Narrow="true" Class="hs-today-page">
    <PageHeader Title="Training" Subtitle="@DateLabel">
        <Actions>
            @if (_session is not null)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="MudBlazor.Color.Primary"
                           Disabled="@_isStarting"
                           OnClick="StartWorkout">
                    New session
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="MudBlazor.Color.Primary"
                           OnClick="FinishWorkout">
                    Finish
                </MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingState Message="Loading training sessions..." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined"
                   Color="MudBlazor.Color.Primary"
                   Class="mt-3"
                   OnClick="LoadPageAsync">
            Retry
        </MudButton>
    }
    else if (_session is null && _lastWorkout is not null)
    {
        <MudPaper Class="hs-surface hs-today-start" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter"
                     Color="MudBlazor.Color.Primary"
                     Size="MudBlazor.Size.Large" />
            <MudButton Variant="Variant.Outlined"
                       Color="MudBlazor.Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Replay"
                       Loading="@_isRepeating"
                       Disabled="@_isRepeating"
                       OnClick="RepeatLastWorkout">
                Repeat last workout
            </MudButton>
            <MudText Typo="Typo.caption" Class="hs-muted-copy">@LastWorkoutLabel</MudText>
        </MudPaper>
    }

    @if (_session is not null)
    {
        var current = _session;

        @if (_sessions.Count > 1)
        {
            <div class="hs-today-session-switcher"
                 role="tablist"
                 aria-label="Training sessions">
                @for (var index = 0; index < _sessions.Count; index++)
                {
                    var session = _sessions[index];
                    var sessionNumber = index + 1;
                    <button type="button"
                            role="tab"
                            aria-selected="@((_session?.Id == session.Id).ToString().ToLowerInvariant())"
                            class="@(_session?.Id == session.Id ? "is-active" : null)"
                            @onclick="() => SelectSession(session)">
                        Session @sessionNumber
                        <span>@session.Exercises.Count</span>
                    </button>
                }
            </div>
        }

        <section class="hs-today-session" aria-label="Current workout">
            <div class="hs-today-session-summary">
                <span>@ExerciseSummary</span>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ViewAgenda"
                           aria-label="Add block"
                           OnClick="ToggleBlockCreator">
                    Block
                </MudButton>
            </div>

            <div class="hs-today-intent" aria-label="Training intent">
                <div class="hs-today-chip-row" role="group" aria-label="Training type">
                    @foreach (var modality in ModalityChoices)
                    {
                        <button type="button"
                                class="@IntentChipClass(current.Modality == modality.ToString())"
                                aria-pressed="@(current.Modality == modality.ToString())"
                                @onclick="() => SetIntentAsync(modality: modality)">
                            @modality.Label()
                        </button>
                    }
                    @if (!_showAllModalities)
                    {
                        <button type="button"
                                class="hs-chip hs-chip-more"
                                @onclick="@(() => _showAllModalities = true)">
                            Other
                        </button>
                    }
                </div>
                <div class="hs-today-chip-row" role="group" aria-label="Main goal">
                    @foreach (var goal in TrainingIntent.GoalOrder)
                    {
                        <button type="button"
                                class="@IntentChipClass(current.Goal == goal.ToString())"
                                aria-pressed="@(current.Goal == goal.ToString())"
                                @onclick="() => SetIntentAsync(goal: goal)">
                            @goal.Label()
                        </button>
                    }
                </div>
                @if (_showSecondaryGoals || current.SecondaryGoals.Count > 0)
                {
                    <div class="hs-today-chip-row" role="group" aria-label="Secondary goals">
                        <span class="hs-today-chip-label">Also for</span>
                        @foreach (var goal in TrainingIntent.GoalOrder)
                        {
                            <button type="button"
                                    class="@IntentChipClass(current.SecondaryGoals.Contains(goal.ToString()))"
                                    aria-pressed="@(current.SecondaryGoals.Contains(goal.ToString()))"
                                    @onclick="() => ToggleSecondaryGoalAsync(goal)">
                                @goal.Label()
                            </button>
                        }
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => _showSecondaryGoals = true)">
                        Also training for
                    </MudButton>
                }
            </div>

            @if (_showBlockCreator)
            {
                <div class="hs-today-block-creator" role="group" aria-label="New block">
                    @foreach (var blockType in WorkoutBlockTypeLabels.PickerOrder)
                    {
                        <button type="button"
                                class="@IntentChipClass(_newBlockType == blockType.ToString())"
                                aria-pressed="@(_newBlockType == blockType.ToString())"
                                @onclick="() => _newBlockType = blockType.ToString()">
                            @blockType.Label()
                        </button>
                    }
                    <MudTextField @bind-Value="_newBlockLabel"
                                  Placeholder="Name (optional)"
                                  MaxLength="120"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                    @if (NeedsRounds(_newBlockType))
                    {
                        <MudNumericField T="int"
                                         Value="_newBlockRounds"
                                         ValueChanged="@(value => _newBlockRounds = value)"
                                         Label="Rounds"
                                         Min="1"
                                         Max="50"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                    }
                    <MudButton Variant="Variant.Filled"
                               Color="MudBlazor.Color.Primary"
                               Size="Size.Small"
                               Disabled="@_busyBlock"
                               OnClick="AddBlockAsync">
                        Add block
                    </MudButton>
                </div>
            }

            @if (current.Exercises.Count == 0 && current.Blocks.Count == 0)
            {
                <div class="hs-today-empty-session">No exercises yet.</div>
            }
            else if (current.Blocks.Count > 0)
            {
                <div class="hs-today-blocks">
                    @foreach (var block in current.Blocks)
                    {
                        <article class="hs-today-block">
                            <header class="hs-today-block-head">
                                <span class="hs-today-block-title">
                                    @(string.IsNullOrWhiteSpace(block.Label) ? BlockTypeLabel(block.Type) : block.Label)
                                </span>
                                <span class="hs-today-block-meta">
                                    @BlockTypeLabel(block.Type)
                                    @if (block.Rounds is > 0)
                                    {
                                        <span>@($"{block.Rounds} rounds")</span>
                                    }
                                </span>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           aria-label="Add exercise to this block"
                                           OnClick="@(() => AddExerciseToBlock(block))">
                                    Exercise
                                </MudButton>
                            </header>
                            <div class="hs-today-exercise-list">
                                @foreach (var exercise in block.Exercises)
                                {
                                    <TodayExerciseItem Exercise="exercise"
                                                       EditRoute="@BuildEditRoute(exercise.Id)"
                                                       OnCompleteAttempt="CompleteAttemptAsync" />
                                }
                            </div>
                        </article>
                    }
                    @if (UnassignedExercises.Count > 0)
                    {
                        <div class="hs-today-exercise-list">
                            @foreach (var exercise in UnassignedExercises)
                            {
                                <TodayExerciseItem Exercise="exercise"
                                                   EditRoute="@BuildEditRoute(exercise.Id)"
                                                   OnCompleteAttempt="CompleteAttemptAsync" />
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="hs-today-exercise-list">
                    @foreach (var exercise in current.Exercises)
                    {
                        <TodayExerciseItem Exercise="exercise"
                                           EditRoute="@BuildEditRoute(exercise.Id)"
                                           OnCompleteAttempt="CompleteAttemptAsync" />
                    }
                </div>
            }
        </section>
    }

    <MudPaper Class="hs-surface hs-today-add" Elevation="0">
        <MudText Typo="Typo.h6" Class="hs-today-add-title">Add exercise</MudText>
        <ExerciseCreationForm ExerciseTypes="@_exerciseTypes"
                              CurrentUserBodyWeight="@_currentUserBodyWeight"
                              WorkoutId="@(_session?.Id ?? Guid.Empty)"
                              ShowDatePicker="false"
                              ShowQuickPicks="true"
                              UseWorkoutSessionEndpoint="true"
                              SubmitLabel="Add exercise"
                              RecentExerciseTypeIds="@(_session?.RecentExerciseTypeIds ?? (IReadOnlyCollection<int>)Array.Empty<int>())"
                              PrescriptionHints="@_session?.Exercises"
                              Blocks="@(_session?.Blocks)"
                              InitialBlockId="@_formBlockId"
                              ShowQualityOptions="true"
                              WorkoutIdResolver="@(() => EnsureTodaySessionAsync())"
                              OnSessionUpdated="HandleSessionUpdated" />
    </MudPaper>
</PageShell>

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private GetExerciseTypeResource[] _exerciseTypes = Array.Empty<GetExerciseTypeResource>();
    private readonly List<WorkoutSessionResource> _sessions = [];
    private WorkoutSessionResource? _session;
    private GetWorkoutResource? _lastWorkout;
    private decimal? _currentUserBodyWeight;
    private string? _error;
    private bool _isLoading = true;
    private bool _isStarting;
    private bool _isRepeating;
    private bool _showSecondaryGoals;
    private bool _showAllModalities;
    private bool _showBlockCreator;
    private bool _busyBlock;
    private string _newBlockType = WorkoutBlockType.Normal.ToString();
    private string? _newBlockLabel;
    private int _newBlockRounds = 1;
    private Guid? _formBlockId;

    private string DateLabel
        => _today.ToDateTime(TimeOnly.MinValue).ToString("dddd, d MMMM");

    private string LastWorkoutLabel
    {
        get
        {
            if (_lastWorkout?.Date is not { } date)
            {
                return string.Empty;
            }

            var workoutDate = date.Date;
            var days = (DateTime.Today - workoutDate).Days;
            var when = days switch
            {
                0 => "today",
                1 => "yesterday",
                _ => $"{days} days ago"
            };
            var exerciseCount = _lastWorkout.ExerciseCount;
            return $"From {workoutDate:ddd, d MMM} · {exerciseCount} {(exerciseCount == 1 ? "exercise" : "exercises")}";
        }
    }

    private string ExerciseSummary
    {
        get
        {
            var exerciseCount = _session?.Exercises.Count ?? 0;
            var totalSets = _session?.Exercises.Sum(exercise => exercise.Series ?? 0) ?? 0;
            return $"{exerciseCount} {(exerciseCount == 1 ? "exercise" : "exercises")} · {totalSets} sets";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Train";
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var typesTask = Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
            var sessionsTask = LoadSessionsAsync();
            var profileWeightTask = LoadProfileWeightAsync();
            await Task.WhenAll(
                typesTask,
                sessionsTask,
                profileWeightTask);

            _exerciseTypes = typesTask.Result ?? Array.Empty<GetExerciseTypeResource>();
            _sessions.Clear();
            _sessions.AddRange(sessionsTask.Result);
            _session = _sessions.LastOrDefault();
            _currentUserBodyWeight = profileWeightTask.Result;

            // "Repeat last workout" is the activation shortcut: only relevant when
            // there is no session for today yet.
            if (_session is null)
            {
                _lastWorkout = await LoadLastWorkoutAsync();
            }
        }
        catch (HttpRequestException)
        {
            _error = "Training sessions could not be loaded.";
        }
        catch (TaskCanceledException)
        {
            _error = "Loading took too long. Please try again.";
        }
        catch (JsonException)
        {
            _error = "The workout response was incomplete. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<List<WorkoutSessionResource>> LoadSessionsAsync()
    {
        using var response = await Http.GetAsync(
            $"/Workouts/today/sessions?date={_today:yyyy-MM-dd}");
        response.EnsureSuccessStatusCode();
        return await response.Content
                   .ReadFromJsonAsync<List<WorkoutSessionResource>>()
               ?? [];
    }

    private async Task<GetWorkoutResource?> LoadLastWorkoutAsync()
    {
        try
        {
            // Most recent workout that actually has logged exercises; empty
            // placeholder days are not worth repeating.
            using var response = await Http.GetAsync("/workouts?page=1&pageSize=10");
            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            var page = await response.Content
                .ReadFromJsonAsync<List<GetWorkoutResource>>();
            return page?.FirstOrDefault(workout => workout.ExerciseCount > 0);
        }
        catch (Exception)
        {
            // The shortcut is optional; never block Today for it.
            return null;
        }
    }

    private async Task RepeatLastWorkout()
    {
        if (_isRepeating || _lastWorkout is null)
        {
            return;
        }

        _isRepeating = true;
        _error = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"/Workouts/{_lastWorkout.Id}/duplicate",
                new { Date = _today.ToString("yyyy-MM-dd") });
            if (!response.IsSuccessStatusCode)
            {
                _error = "The workout could not be repeated.";
                return;
            }

            // Land in context: reload Today so the copy is already there,
            // exercises ready to edit.
            await LoadPageAsync();
            Snackbar.Add("Last workout copied to today.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            _error = "The workout could not be repeated.";
        }
        catch (TaskCanceledException)
        {
            _error = "Repeating took too long. Please try again.";
        }
        finally
        {
            _isRepeating = false;
        }
    }

    private async Task<decimal?> LoadProfileWeightAsync()
    {
        try
        {
            var profile = await ApiClient.GetHealthProfileAsync();
            return profile.WeightKg;
        }
        catch
        {
            return null;
        }
    }

    private async Task StartWorkout()
    {
        if (_isStarting)
        {
            return;
        }

        _isStarting = true;
        _error = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "/Workouts/today",
                new StartWorkoutSessionResource
                {
                    Date = _today,
                    CreateNew = _sessions.Count > 0
                });

            if (!response.IsSuccessStatusCode)
            {
                _error = "The workout could not be started.";
                return;
            }

            _session = await response.Content.ReadFromJsonAsync<WorkoutSessionResource>();
            if (_session is null)
            {
                _error = "The workout response was incomplete.";
                return;
            }

            var existingIndex = _sessions.FindIndex(
                session => session.Id == _session.Id);
            if (existingIndex >= 0)
            {
                _sessions[existingIndex] = _session;
            }
            else
            {
                _sessions.Add(_session);
            }
        }
        catch (HttpRequestException)
        {
            _error = "The workout could not be started.";
        }
        catch (TaskCanceledException)
        {
            _error = "Starting took too long. Please try again.";
        }
        catch (JsonException)
        {
            _error = "The workout response was incomplete. Please try again.";
        }
        finally
        {
            _isStarting = false;
        }
    }

    private async Task<Guid> EnsureTodaySessionAsync()
    {
        if (_session is not null)
        {
            return _session.Id;
        }

        // Today never asks the user to "start" a session first: the session is
        // created at the moment the first exercise is actually logged, so an
        // empty day never appears in the history.
        using var response = await Http.PostAsJsonAsync(
            "/Workouts/today",
            new StartWorkoutSessionResource
            {
                Date = _today,
                CreateNew = false
            });
        response.EnsureSuccessStatusCode();

        var session = await response.Content
            .ReadFromJsonAsync<WorkoutSessionResource>();
        if (session is null)
        {
            return Guid.Empty;
        }

        _session = session;
        _sessions.Add(session);
        return session.Id;
    }

    private Task HandleSessionUpdated(WorkoutSessionResource session)
    {
        _session = session;
        var index = _sessions.FindIndex(
            item => item.Id == session.Id);
        if (index >= 0)
        {
            _sessions[index] = session;
        }
        else
        {
            _sessions.Add(session);
        }

        Snackbar.Add("Exercise added.", Severity.Success);
        return Task.CompletedTask;
    }

    private void SelectSession(WorkoutSessionResource session)
        => _session = session;

    // ── Universal tracker: intent chips ───────────────────────────────────────
    // The intent is a tap, not a form: the wire keeps the API names and the
    // page updates itself immediately, so a tap never waits for the network.

    private List<TrainingModality> ModalityChoices
    {
        get
        {
            var recent = new List<TrainingModality>();
            foreach (var value in _sessions.Select(session => session.Modality)
                        .Append(_lastWorkout?.Modality))
            {
                if (TrainingIntent.ParseModality(value) is { } parsed
                    && !recent.Contains(parsed))
                {
                    recent.Add(parsed);
                }
            }

            var ordered = _showAllModalities
                ? TrainingIntent.ModalityOrder.ToList()
                : recent
                    .Concat(TrainingIntent.ModalityOrder
                        .Where(modality => !recent.Contains(modality)))
                    .Take(6)
                    .ToList();

            if (TrainingIntent.ParseModality(_session?.Modality) is { } current
                && !ordered.Contains(current))
            {
                ordered.Add(current);
            }

            return ordered;
        }
    }

    private static string IntentChipClass(bool selected)
        => selected ? "hs-chip hs-chip-selected" : "hs-chip";

    private static string BlockTypeLabel(string? type)
        => WorkoutBlockTypeLabels.Parse(type) is { } parsed
            ? parsed.Label()
            : type ?? "Block";

    private static bool NeedsRounds(string? blockType)
        => WorkoutBlockTypeLabels.Parse(blockType) is WorkoutBlockType.EMOM
            or WorkoutBlockType.AMRAP
            or WorkoutBlockType.Tabata
            or WorkoutBlockType.Ronda;

    private List<WorkoutSessionExerciseResource> UnassignedExercises
    {
        get
        {
            if (_session is null || _session.Blocks.Count == 0)
            {
                return [];
            }

            var assigned = _session.Blocks
                .SelectMany(block => block.Exercises)
                .Select(exercise => exercise.Id)
                .ToHashSet();

            return _session.Exercises
                .Where(exercise => !assigned.Contains(exercise.Id))
                .ToList();
        }
    }

    private Task SetIntentAsync(TrainingGoal? goal = null, TrainingModality? modality = null)
    {
        if (_session is null)
        {
            return Task.CompletedTask;
        }

        if (goal is not null)
        {
            _session.Goal = goal.ToString();
        }

        if (modality is not null)
        {
            _session.Modality = modality.ToString();
        }

        return PatchSessionAsync(new
        {
            goal = goal?.ToString(),
            modality = modality?.ToString()
        });
    }

    private Task ToggleSecondaryGoalAsync(TrainingGoal goal)
    {
        if (_session is null)
        {
            return Task.CompletedTask;
        }

        var name = goal.ToString();
        if (_session.SecondaryGoals.Contains(name))
        {
            _session.SecondaryGoals.Remove(name);
        }
        else
        {
            _session.SecondaryGoals.Add(name);
        }

        return PatchSessionAsync(new { secondaryGoals = _session.SecondaryGoals });
    }

    private async Task PatchSessionAsync(object payload)
    {
        if (_session is null)
        {
            return;
        }

        try
        {
            using var response = await Http.PatchAsJsonAsync(
                $"/Workouts/{_session.Id}",
                payload);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "The training intent could not be saved. It will retry on the next sync.",
                    Severity.Warning);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(
                "The training intent could not be saved. It will retry on the next sync.",
                Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add(
                "Saving took too long. It will retry on the next sync.",
                Severity.Warning);
        }
    }

    // ── Universal tracker: blocks ─────────────────────────────────────────────

    private void ToggleBlockCreator()
    {
        _showBlockCreator = !_showBlockCreator;
        if (!_showBlockCreator)
        {
            _newBlockLabel = null;
            _newBlockRounds = 1;
            _newBlockType = WorkoutBlockType.Normal.ToString();
        }
    }

    private void AddExerciseToBlock(WorkoutBlockResource block)
    {
        _formBlockId = block.Id;
        _showBlockCreator = false;
    }

    private async Task AddBlockAsync()
    {
        if (_busyBlock)
        {
            return;
        }

        _busyBlock = true;
        try
        {
            var workoutId = await EnsureTodaySessionAsync();
            var session = _session;
            if (session is null)
            {
                return;
            }

            var order = session.Blocks.Count > 0
                ? session.Blocks.Max(block => block.Order) + 1
                : 1;

            using var response = await Http.PostAsJsonAsync(
                $"/Workouts/{workoutId}/blocks",
                new
                {
                    order,
                    type = _newBlockType,
                    label = string.IsNullOrWhiteSpace(_newBlockLabel)
                        ? null
                        : _newBlockLabel.Trim(),
                    rounds = NeedsRounds(_newBlockType) ? _newBlockRounds : (int?)null
                });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("The block could not be added.", Severity.Warning);
                return;
            }

            var block = await response.Content
                .ReadFromJsonAsync<WorkoutBlockResource>();
            if (block is not null)
            {
                session.Blocks.Add(block);
                _formBlockId = block.Id;
            }

            _showBlockCreator = false;
            _newBlockLabel = null;
            _newBlockRounds = 1;
            _newBlockType = WorkoutBlockType.Normal.ToString();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The block could not be added.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Adding the block took too long. Please try again.", Severity.Warning);
        }
        catch (JsonException)
        {
            Snackbar.Add("The block response was incomplete. Please try again.", Severity.Warning);
        }
        finally
        {
            _busyBlock = false;
        }
    }

    // ── Universal tracker: attempts ───────────────────────────────────────────

    private async Task CompleteAttemptAsync(WorkoutSessionExerciseResource exercise)
    {
        var attempts = Math.Max(1, exercise.Attempts ?? 1);
        var completed = Math.Min(attempts, (exercise.CompletedAttempts ?? 0) + 1);

        // The row ticks first: the tap is the workout, the save is background.
        exercise.CompletedAttempts = completed;

        try
        {
            using var response = await Http.PutAsJsonAsync("/Exercises", new UpdateExerciseResource
            {
                Id = exercise.Id,
                Series = exercise.Series,
                Repetitions = exercise.Repetitions,
                Weight = exercise.Weight,
                BodyWeight = exercise.BodyWeight,
                AddedWeight = exercise.AddedWeight,
                Tags = exercise.Tags,
                Attempts = attempts,
                CompletedAttempts = completed,
                QualityIntent = exercise.QualityIntent,
                LoadType = exercise.LoadType
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("The attempt could not be saved.", Severity.Warning);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("The attempt could not be saved. It will retry on the next sync.", Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Saving took too long. It will retry on the next sync.", Severity.Warning);
        }
    }

    // ── Universal tracker: closing the session ────────────────────────────────

    private async Task FinishWorkout()
    {
        if (_session is null)
        {
            NavigationManager.NavigateTo("/training/history");
            return;
        }

        var parameters = new DialogParameters
        {
            { "InitialFatigue", _session.PerceivedFatigue }
        };

        var reference = await DialogService.ShowAsync<FinishSessionDialog>(
            string.Empty,
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall
            });

        var result = await reference.Result;
        if (!result.Canceled && result.Data is int fatigue)
        {
            _session.PerceivedFatigue = fatigue;
            await PatchSessionAsync(new { perceivedFatigue = fatigue });
        }

        NavigationManager.NavigateTo("/training/history");
    }

    private static string BuildEditRoute(Guid exerciseId)
        => $"/training/history/{exerciseId}/edit?returnUrl={Uri.EscapeDataString("/training/today")}";

}