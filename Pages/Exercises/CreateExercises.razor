@page "/exercises/create/{traineeId?}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create Exercise</PageTitle>

<MudPaper Class="pa-4">
    <MudContainer>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4" OnClick="GoBack">
            Back
        </MudButton>
        <ExerciseCreationForm ExerciseTypes="@exerciseTypes" WorkoutId="@workoutId" OnExerciseAdded="HandleExerciseAdded" traineeId="@traineeId"/>
    </MudContainer>
</MudPaper>

@code {
    [Parameter]
    public string? traineeId { get; set; }
    private GetExerciseTypeResource[] exerciseTypes;
    private Guid workoutId;

    protected override async Task OnInitializedAsync()
    {
        exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
        workoutId = Guid.Empty;
    }

    private void HandleExerciseAdded(AddExerciseResource exercise)
    {
        Snackbar.Add("Exercise added successfully!", Severity.Success);
    }
    private void GoBack()
    {
        NavigationManager.NavigateTo("/Exercises", forceLoad: false);
    }
}
