@page "/exercises/create/{TraineeId?}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create Exercise</PageTitle>

<MudPaper Class="pa-4">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <ExerciseForm Exercise="_exercise"
                      @bind-Date="_workoutDate"
                      ExerciseTypes="@_exerciseTypes"
                      OnSubmit="HandleSubmit" />

        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="MudBlazor.Color.Primary"
                   Variant="Variant.Outlined"
                   Class="ml-8 mt-4 rounded-button"
                   OnClick="NavigateBack">
            Back
        </MudButton>
    </MudContainer>
</MudPaper>

@code {
    [Parameter] public string? TraineeId { get; set; }

    private GetExerciseTypeResource[] _exerciseTypes = Array.Empty<GetExerciseTypeResource>();
    private AddExerciseResource _exercise = new();
    private DateTime? _workoutDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        _exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes")
                         ?? Array.Empty<GetExerciseTypeResource>();
    }

    private async Task HandleSubmit(AddExerciseResource exercise)
    {
        // Resolve workout ID logic here if required, or let API handle it
        exercise.WorkoutId = await ResolveWorkoutIdAsync(_workoutDate);
        var response = await Http.PostAsJsonAsync("/Exercises", exercise);
        
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Exercise added successfully!", Severity.Success);
            NavigateBack();
        }
        else
        {
            Snackbar.Add("Failed to add exercise.", Severity.Error);
        }
    }

    private async Task<Guid> ResolveWorkoutIdAsync(DateTime? date)
    {
        var url = TraineeId != null ? $"/workouts?traineeId={TraineeId}" : "/workouts";
        var workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>(url);

        var existing = workouts?.FirstOrDefault(w =>
            w.Date.HasValue && date.HasValue && w.Date.Value.Date == date.Value.Date);

        if (existing != null) return existing.Id;

        var newWorkout = new WorkoutPostResource { Type = "default", UserId = TraineeId, Date = date ?? DateTime.Now };
        var resp = await Http.PostAsJsonAsync("/Workouts", newWorkout);
        var created = await resp.Content.ReadFromJsonAsync<GetWorkoutResource>();
        return created?.Id ?? Guid.NewGuid();
    }

    private void NavigateBack()
        => NavigationManager.NavigateTo("/Exercises", forceLoad: false);
}
