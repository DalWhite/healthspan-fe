@page "/exercises/create/{TraineeId?}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject TitleService TitleService
@using Microsoft.AspNetCore.Components

<PageTitle>@PageTitleText</PageTitle>

<PageShell Narrow="true">
    <PageHeader Title="@PageTitleText" />

    <MudPaper Class="hs-surface hs-form-surface">
        <MudContainer MaxWidth="MaxWidth.Medium">
            <ExerciseCreationForm ExerciseTypes="@_exerciseTypes"
                                  TraineeId="@TraineeId"
                                  WorkoutId="@WorkoutId.GetValueOrDefault()"
                                  InitialExerciseTypeId="@ExerciseTypeId"
                                  InitialDate="@InitialWorkoutDate"
                                  ShowDatePicker="@(!HasExistingWorkout)"
                                  ShowQuickPicks="@HasExistingWorkout"
                                  UseWorkoutSessionEndpoint="@HasExistingWorkout"
                                  SubmitLabel="@SubmitLabel"
                                  OnExerciseAdded="HandleExerciseAdded" />

            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="MudBlazor.Color.Primary"
                       Variant="Variant.Outlined"
                       Class="mt-4 rounded-button"
                       OnClick="NavigateBack">
                @(HasExistingWorkout ? "Done" : "Back to history")
            </MudButton>
        </MudContainer>
    </MudPaper>
</PageShell>

@code {
    [Parameter] public string? TraineeId { get; set; }
    [SupplyParameterFromQuery(Name = "exerciseTypeId")]
    public int? ExerciseTypeId { get; set; }
    [SupplyParameterFromQuery(Name = "workoutId")]
    public Guid? WorkoutId { get; set; }
    [SupplyParameterFromQuery(Name = "date")]
    public DateTime? WorkoutDate { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private GetExerciseTypeResource[] _exerciseTypes = Array.Empty<GetExerciseTypeResource>();
    private bool HasExistingWorkout
        => WorkoutId.HasValue && WorkoutId.Value != Guid.Empty;
    private DateTime InitialWorkoutDate => WorkoutDate?.Date ?? DateTime.Today;
    private string PageTitleText => HasExistingWorkout ? "Add to workout" : "Log Exercise";
    private string SubmitLabel => HasExistingWorkout ? "Add exercise" : "Save exercise";

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = PageTitleText;
        _exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes")
                         ?? Array.Empty<GetExerciseTypeResource>();
    }

    private Task HandleExerciseAdded(AddExerciseResource _)
    {
        Snackbar.Add("Exercise added successfully!", Severity.Success);
        if (!HasExistingWorkout)
        {
            NavigateBack();
        }

        return Task.CompletedTask;
    }

    private void NavigateBack()
        => NavigationManager.NavigateTo(
            GetSafeReturnUrl(
                ReturnUrl,
                TraineeId is null
                    ? "/training/history"
                    : $"/trainees/{TraineeId}/exercises"),
            forceLoad: false);

    private static string GetSafeReturnUrl(string? returnUrl, string fallback)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || !returnUrl.StartsWith('/')
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || returnUrl.Contains('\\')
            || returnUrl.Any(char.IsControl))
        {
            return fallback;
        }

        return returnUrl;
    }
}
