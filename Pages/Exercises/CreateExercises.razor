@page "/exercises/create/{traineeId?}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create Exercise</PageTitle>

<MudPaper Class="pa-4">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <ExerciseCreationForm ExerciseTypes="@exerciseTypes"
                              WorkoutId="@workoutId"
                              OnExerciseAdded="OnExerciseAdded"
                              traineeId="@traineeId" />

        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Primary"
                   Variant="Variant.Outlined"
                   Class="ml-8 rounded-button"
                   OnClick="NavigateBack">
            Back
        </MudButton>
    </MudContainer>
</MudPaper>

@code {
    [Parameter] public string? traineeId { get; set; }

    private GetExerciseTypeResource[] exerciseTypes = Array.Empty<GetExerciseTypeResource>();
    private Guid workoutId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>(("/ExerciseTypes"))
                        ?? Array.Empty<GetExerciseTypeResource>();
    }

    private void OnExerciseAdded(AddExerciseResource resource)
        => Snackbar.Add("Exercise added successfully!", Severity.Success);

    private void NavigateBack()
        => NavigationManager.NavigateTo("/Exercises", forceLoad: false);
}
