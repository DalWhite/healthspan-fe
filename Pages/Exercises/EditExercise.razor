@page "/exercises/edit/{ExerciseId}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar


<PageTitle>Edit Exercise</PageTitle>

@if (Exercise == null)
{
    <MudProgressCircular Color="MudBlazor.Color.Default"
                         Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4">
        <ExerciseForm Exercise="_editModel"
                      @bind-Date="_workoutDate"
                      ExerciseTypes="exerciseTypes"
                      OnSubmit="UpdateExercise" />

        <ExerciseMetrics Metrics="ExerciseMetrics"></ExerciseMetrics>

        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="MudBlazor.Color.Primary"
                   Variant="Variant.Outlined"
                   Class="ml-0 mt-4 rounded-button"
                   OnClick="GoBack">
            Back
        </MudButton>
        <MudButton Color="MudBlazor.Color.Warning"
                   Variant="Variant.Outlined"
                   Class="ml-0 mt-4 rounded-button"
                   OnClick="Delete">Delete</MudButton>
    </MudPaper>
}
@code {
    [Parameter]
    public string ExerciseId { get; set; }
    public GetExerciseResource? Exercise { get; set; }
    private AddExerciseResource _editModel = new();
    private DateTime? _workoutDate = DateTime.Now;
    private GetExerciseMetrics ExerciseMetrics { get; set; }
    private GetExerciseTypeResource[] exerciseTypes;

    protected override async Task OnInitializedAsync()
    {
        exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
        await LoadExercise();
        await LoadMetrics();
    }
    private async Task LoadMetrics()
    {
        ExerciseMetrics = await Http.GetFromJsonAsync<GetExerciseMetrics?>($"/exercises/{ExerciseId}/metrics");
    }

    private async Task LoadExercise()
    {
        Exercise = await Http.GetFromJsonAsync<GetExerciseResource?>($"/exercises/{ExerciseId}");
        if (Exercise != null)
        {
            _editModel = new AddExerciseResource
            {
                WorkoutId = Exercise.Workout?.Id,
                TypeId = Exercise.Type?.Id,
                Series = Exercise.Series ?? 0,
                Repetitions = Exercise.Repetitions ?? 0,
                Weight = (decimal)(Exercise.Weight ?? 0),
                BodyWeight = (decimal?)(Exercise.BodyWeight),
                AddedWeight = (decimal?)(Exercise.AddedWeight),
                WeightType = Exercise.Type?.WeightType ?? ExerciseWeightType.Standard
            };
            _workoutDate = Exercise.Workout?.Date ?? DateTime.Now;
        }
    }

    private async Task UpdateExercise()
    {
        try
        {
            _editModel.WorkoutId = await ResolveWorkoutIdAsync(_workoutDate);
            var response = await Http.PutAsJsonAsync($"/exercises/{ExerciseId}", _editModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Exercise updated successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update exercise.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task<Guid> ResolveWorkoutIdAsync(DateTime? date)
    {
        var workouts = await Http.GetFromJsonAsync<GetWorkoutResource[]>("/workouts");
        var existing = workouts?.FirstOrDefault(w => w.Date.HasValue && date.HasValue && w.Date.Value.Date == date.Value.Date);
        if (existing != null) return existing.Id;

        var newWorkout = new WorkoutPostResource { Type = "default", Date = date ?? DateTime.Now };
        var resp = await Http.PostAsJsonAsync("/Workouts", newWorkout);
        var created = await resp.Content.ReadFromJsonAsync<GetWorkoutResource>();
        return created?.Id ?? Guid.NewGuid();
    }
    
    private async Task Delete()
    {
        await Http.DeleteAsync($"/exercises/{ExerciseId}");
        Snackbar.Add("exercise Deleted.", Severity.Warning);
    }
    private void GoBack()
    {
        NavigationManager.NavigateTo("/Exercises", forceLoad: false);
    }
}
