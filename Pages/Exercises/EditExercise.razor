@page "/exercises/edit/{ExerciseId}"
@page "/training/history/{ExerciseId}/edit"
@inject HttpClient Http
@inject HealthspanApiClient ApiClient
@inject NavigationManager NavigationManager
@inject TitleService TitleService

<PageTitle>@_title</PageTitle>

<PageShell Narrow="true" Class="hs-exercise-edit-page">
    <PageHeader Title="@ExerciseName" Subtitle="Edit entry">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Size="MudBlazor.Size.Small"
                           OnClick="GoBack"
                           aria-label="Back" />
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingState Message="Loading exercise..." />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <ErrorState Title="Couldn't load this exercise"
                    Message="@_loadError"
                    ActionLabel="Back"
                    OnAction="GoBack" />
    }
    else if (Exercise is not null)
    {
        <div class="hs-surface hs-form-surface hs-exercise-edit-surface">
            <ExerciseForm Exercise="_editModel"
                          @bind-Date="_workoutDate"
                          ExerciseTypes="_exerciseTypes"
                          CurrentUserBodyWeight="@_currentUserBodyWeight"
                          IsSaving="@_isSaving"
                          OnSubmit="UpdateExerciseAsync" />

            @if (_exerciseMetrics is not null)
            {
                <ExerciseMetrics Metrics="_exerciseMetrics"
                                 WeightType="_editModel.WeightType" />
            }

            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <p class="hs-exercise-edit-error" role="alert">@_actionError</p>
            }

            <div class="hs-exercise-edit-footer">
                <button type="button"
                        class="hs-exercise-edit-button"
                        disabled="@_isSaving"
                        @onclick="GoBack">
                    Back
                </button>
                <button type="button"
                        class="hs-exercise-edit-button is-danger"
                        disabled="@_isSaving"
                        @onclick="OpenDeleteConfirmation">
                    Delete
                </button>
            </div>

            @if (_deleteConfirmationOpen)
            {
                <section class="hs-exercise-delete-confirmation"
                         role="alertdialog"
                         aria-labelledby="delete-exercise-title">
                    <h2 id="delete-exercise-title">Delete this entry?</h2>
                    <p>
                        This removes only this logged exercise.
                        Your workout and exercise library stay intact.
                    </p>

                    <div class="hs-exercise-edit-actions">
                        <button type="button"
                                class="hs-exercise-edit-button"
                                disabled="@_isSaving"
                                @onclick="CloseDeleteConfirmation">
                            Cancel
                        </button>
                        <button type="button"
                                class="hs-exercise-edit-button is-danger-filled"
                                disabled="@_isSaving"
                                @onclick="DeleteExerciseAsync">
                            @(_isSaving ? "Deleting..." : "Delete entry")
                        </button>
                    </div>
                </section>
            }
        </div>
    }
</PageShell>

@code {
    [Parameter] public string ExerciseId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "traineeId")]
    public string? TraineeId { get; set; }

    public GetExerciseResource? Exercise { get; set; }

    private AddExerciseResource _editModel = new();
    private DateTime? _workoutDate = DateTime.Today;
    private DateTime? _originalWorkoutDate;
    private GetExerciseMetrics? _exerciseMetrics;
    private GetExerciseTypeResource[] _exerciseTypes = [];
    private decimal? _currentUserBodyWeight;
    private string _title = "Edit exercise";
    private string? _loadError;
    private string? _actionError;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _deleteConfirmationOpen;
    private string ExerciseName
        => Exercise?.Type?.Name is { Length: > 0 } name
            ? name
            : "Exercise";

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = _title;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var typesTask = Http.GetFromJsonAsync<GetExerciseTypeResource[]>(
                "/ExerciseTypes");
            var exerciseTask = Http.GetFromJsonAsync<GetExerciseResource>(
                $"/exercises/{ExerciseId}{BuildUserQuery()}");
            var profileWeightTask = string.IsNullOrWhiteSpace(TraineeId)
                ? LoadProfileWeightAsync()
                : Task.FromResult<decimal?>(null);
            await Task.WhenAll(typesTask, exerciseTask, profileWeightTask);

            _exerciseTypes = await typesTask ?? [];
            _currentUserBodyWeight = await profileWeightTask;
            Exercise = await exerciseTask
                ?? throw new InvalidOperationException("The exercise response was empty.");
            _title = Exercise.Type?.Name is { Length: > 0 } name
                ? $"Edit {name}"
                : "Edit exercise";
            TitleService.Title = _title;

            var weightType = Exercise.Type?.WeightType
                ?? Exercise.WeightType
                ?? ExerciseWeightType.Standard;
            _editModel = new AddExerciseResource
            {
                WorkoutId = Exercise.Workout?.Id,
                TypeId = Exercise.Type?.Id,
                Series = Exercise.Series ?? 1,
                Repetitions = Exercise.Repetitions ?? 0,
                Weight = Exercise.Weight ?? 0,
                WeightType = weightType,
                BodyWeight = weightType == ExerciseWeightType.BodyWeight
                    ? Exercise.BodyWeight ?? Exercise.Weight
                    : null,
                AddedWeight = weightType == ExerciseWeightType.BodyWeight
                    ? Exercise.AddedWeight ?? 0
                    : null,
                Tags = ExerciseTagText.Normalize(Exercise.Tags)
            };
            _workoutDate = Exercise.Workout?.Date?.Date ?? DateTime.Today;
            _originalWorkoutDate = _workoutDate;

            if (weightType != ExerciseWeightType.None)
            {
                try
                {
                    _exerciseMetrics =
                        await Http.GetFromJsonAsync<GetExerciseMetrics>(
                            $"/exercises/{ExerciseId}/metrics{BuildUserQuery()}");
                }
                catch
                {
                    _exerciseMetrics = null;
                }
            }
        }
        catch
        {
            Exercise = null;
            _loadError = "Check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateExerciseAsync()
    {
        if (Exercise is null
            || !Guid.TryParse(ExerciseId, out var exerciseId))
        {
            _actionError = "This exercise is unavailable.";
            return;
        }

        _isSaving = true;
        _actionError = null;

        try
        {
            var workoutId = await ResolveWorkoutIdAsync();
            if (!workoutId.HasValue)
            {
                return;
            }

            var response = await Http.PutAsJsonAsync(
                $"/exercises{BuildUserQuery()}",
                new UpdateExerciseResource
                {
                    Id = exerciseId,
                    Series = _editModel.Series,
                    Repetitions = _editModel.Repetitions,
                    Weight = _editModel.Weight,
                    BodyWeight = _editModel.BodyWeight,
                    AddedWeight = _editModel.AddedWeight,
                    WeightType = _editModel.WeightType,
                    Tags = ExerciseTagText.Normalize(_editModel.Tags),
                    Type = _exerciseTypes.FirstOrDefault(
                        type => type.Id == _editModel.TypeId),
                    Workout = new GetWorkoutResource
                    {
                        Id = workoutId.Value,
                        Date = _workoutDate
                    }
                });

            if (!response.IsSuccessStatusCode)
            {
                _actionError = await HttpProblemDetailsReader.ReadMessageAsync(
                    response,
                    "Couldn't update this exercise.");
                return;
            }

            GoBack();
        }
        catch
        {
            _actionError = "Couldn't update this exercise.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<Guid?> ResolveWorkoutIdAsync()
    {
        if (Exercise?.Workout?.Id is Guid currentWorkoutId
            && _workoutDate.HasValue
            && _originalWorkoutDate.HasValue
            && _workoutDate.Value.Date == _originalWorkoutDate.Value.Date)
        {
            return currentWorkoutId;
        }

        if (!_workoutDate.HasValue)
        {
            _actionError = "Choose a workout date.";
            return null;
        }

        using var response = string.IsNullOrWhiteSpace(TraineeId)
            ? await Http.PostAsJsonAsync(
                "/workouts/today",
                new StartWorkoutSessionResource
                {
                    Date = DateOnly.FromDateTime(
                        _workoutDate.Value),
                    Type = "Training"
                })
            : await Http.PostAsJsonAsync(
                "/workouts",
                new WorkoutPostResource
                {
                    Date = _workoutDate.Value,
                    Type = "Training",
                    UserId = TraineeId
                });
        if (!response.IsSuccessStatusCode)
        {
            _actionError = await HttpProblemDetailsReader.ReadMessageAsync(
                response,
                "Couldn't prepare the workout for that date.");
            return null;
        }

        var workout = await response.Content
            .ReadFromJsonAsync<GetWorkoutResource>();
        if (workout is null || workout.Id == Guid.Empty)
        {
            _actionError = "The workout response was empty.";
            return null;
        }

        return workout.Id;
    }

    private async Task<decimal?> LoadProfileWeightAsync()
    {
        try
        {
            var profile = await ApiClient.GetHealthProfileAsync();
            return profile.WeightKg;
        }
        catch
        {
            return null;
        }
    }

    private void OpenDeleteConfirmation()
    {
        _actionError = null;
        _deleteConfirmationOpen = true;
    }

    private void CloseDeleteConfirmation()
    {
        if (!_isSaving)
        {
            _deleteConfirmationOpen = false;
        }
    }

    private async Task DeleteExerciseAsync()
    {
        _isSaving = true;
        _actionError = null;

        try
        {
            using var response = await Http.DeleteAsync(
                $"/exercises/{ExerciseId}{BuildUserQuery()}");
            if (!response.IsSuccessStatusCode)
            {
                _actionError = await HttpProblemDetailsReader.ReadMessageAsync(
                    response,
                    "Couldn't delete this exercise.");
                return;
            }

            GoBack();
        }
        catch
        {
            _actionError = "Couldn't delete this exercise.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void GoBack()
        => NavigationManager.NavigateTo(
            GetSafeReturnUrl(ReturnUrl, "/training/history"));

    private string BuildUserQuery()
        => string.IsNullOrWhiteSpace(TraineeId)
            ? string.Empty
            : $"?userId={Uri.EscapeDataString(TraineeId)}";

    private static string GetSafeReturnUrl(
        string? returnUrl,
        string fallback)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || !returnUrl.StartsWith('/')
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || returnUrl.Contains('\\')
            || returnUrl.Any(char.IsControl))
        {
            return fallback;
        }

        return returnUrl;
    }
}
