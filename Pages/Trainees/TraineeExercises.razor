@page "/trainees/{traineeId}/exercises"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<style>
    @@media (max-width: 600px) {
        .hide-on-mobile {
            display: none;
        }

        .table-responsive {
            overflow-x: auto;
        }
    }

    .mud-table-cell-custom-group {
        font-weight: 500;
    }

    .mud-table-cell-custom-group-footer {
        padding-bottom: 50px;
        text-align: right;
    }
</style>

<PageTitle>Exercises</PageTitle>

@if (exercises == null)
{
    <MudProgressCircular Color="Color.Default"
                         Indeterminate="true" />
}
else
{
    <div class="table-responsive">
        <MudTable Items="exercises"
                  Hover="true"
                  SortLabel="Sort By"
                  Elevation="0"
                  Breakpoint="Breakpoint.None"
                  Dense="true"
                  Filter="new Func<GetExerciseResource,bool>(FilterFunc1)"
                  GroupBy="@_groupDefinition"
                  T="GetExerciseResource"
                  OnRowClick="GoToEditExercise"
                  SelectedItem="selectedItem">
            <ColGroup>
                <col style="width: 5%;" />
                <col />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
            </ColGroup>
            <ToolBarContent>
                <MudTextField @bind-Value="searchString1"
                              Placeholder="Search"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                       SortBy="new Func<GetExerciseResource, object>(x=>x.Workout.Date)">Date
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.Type.Name)">Type
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.Series)">Series
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.Repetitions)">Repetitions
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.Weight)">Weight
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.MaxRepetition)">1RM
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.Volume)">Volume
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetExerciseResource, object>(x=>x.Intensity)">Intensity
                    </MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="mud-table-cell-custom-group"
                       colspan="8">
                    @{
                        var currentDate = DateTime.Now;
                        DateTime groupDate;
                        if (DateTime.TryParse(context.Key.ToString(), out groupDate))
                        {
                            var daysAgo = (currentDate - groupDate).Days;
                            <text>@($"{context.GroupName}: {context.Key}, ({daysAgo} days ago)")</text>
                        }
                        else
                        {
                            <text>Invalid Date</text>
                        }
                    }
                </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Date"></MudTd>
                <MudTd DataLabel="Type">@context.Type?.Name</MudTd>
                <MudTd DataLabel="Series">@context.Series</MudTd>
                <MudTd DataLabel="Reps">@context.Repetitions</MudTd>
                <MudTd DataLabel="Weight">@context.Weight kg</MudTd>
                <MudTd DataLabel="1RM">@context.MaxRepetition kg</MudTd>
                <MudTd DataLabel="Volume">@context.Volume kg</MudTd>
                <MudTd DataLabel="Intensity">@context.Intensity %</MudTd>
            </RowTemplate>
        </MudTable>
    </div>
    <MudFab @onclick="GoToCreateExercise"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Add"
            class="fixed-create-button" />
}

@code {
     [Parameter]
    public string traineeId { get; set; }
    private GetExerciseResource[]? exercises;
    private GetExerciseResource? selectedItem;
    private string searchString1 = "";
    private TableGroupDefinition<GetExerciseResource> _groupDefinition = new()
        {
            GroupName = "Date",
            Indentation = true,
            Expandable = false,
            Selector = (e) => e.Workout?.Date.Value.ToShortDateString()
        };

    protected override async Task OnInitializedAsync()
    {
        exercises = await Http.GetFromJsonAsync<GetExerciseResource[]>($"/Exercises?userId={traineeId}");
    }
    protected override void OnInitialized()
    {
        TitleService.Title = "Exercises";
    }

    private bool FilterFunc1(GetExerciseResource element) => FilterFunc(element, searchString1);

    private bool FilterFunc(GetExerciseResource element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        string dateString = element.Workout.Date.Value.ToString("dd/MM/yyyy");

        if (dateString.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Type?.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (element.Type?.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;

        return false;
    }
    private void GoToCreateExercise()
    {
        NavigationManager.NavigateTo($"/exercises/create/{traineeId}");
    }
    private void GoToEditExercise(TableRowClickEventArgs<GetExerciseResource> tableRowClickEventArgs)
    {
        NavigationManager.NavigateTo($"/exercises/edit/{tableRowClickEventArgs.Item.Id}");
    }
}
