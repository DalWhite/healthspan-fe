@page "/trainees/{TraineeId}/exercises"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject TitleService TitleService

<PageTitle>Exercises</PageTitle>

<div class="hs-page-shell">
<PageHeader Title="Trainee Training History" />

@if (_exercises == null)
{
    <LoadingState Message="Loading exercises..." />
}
else
{
    <div class="table-responsive">
        <MudTable Items="@_exercises"
                  Hover="true"
                  SortLabel="Sort By"
                  Elevation="0"
                  Breakpoint="Breakpoint.None"
                  Dense="true"
                  Filter="@((GetExerciseResource x) => FilterExercise(x))"
                  GroupBy="@_groupDefinition"
                  T="GetExerciseResource"
                  OnRowClick="@GoToEditExercise"
                  SelectedItem="@_selected">
            <ColGroup>
                <col style="width: 5%;" />
                <col />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
                <col style="width: 5%;" />
            </ColGroup>
            <ToolBarContent>
                <MudTextField @bind-Value="_search" Placeholder="Search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="MudBlazor.Size.Medium" Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="@((GetExerciseResource x) => x.Workout?.Date ?? DateTime.MinValue)">Date</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.Type?.Name ?? "")">Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.Series ?? 0)">Series</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.Repetitions ?? 0)">Reps</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.Weight ?? 0)">Weight</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.MaxRepetition ?? 0)">1RM</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.Volume ?? 0)">Volume</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@((GetExerciseResource x) => x.Intensity ?? 0)">Intensity</MudTableSortLabel></MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="hs-table-cell-custom-group" colspan="8">
                    @{
                        if (DateTime.TryParse(context.Key?.ToString(), out var groupDate))
                        {
                            var daysAgo = (DateTime.Now - groupDate).Days;
                            <text>@($"{context.GroupName}: {context.Key}, ({daysAgo} days ago)")</text>
                        }
                        else { <text>Unknown Date</text> }
                    }
                </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Date"></MudTd>
                <MudTd DataLabel="Type">@context.Type?.Name</MudTd>
                <MudTd DataLabel="Series">@context.Series</MudTd>
                <MudTd DataLabel="Reps">@context.Repetitions</MudTd>
                <MudTd DataLabel="Weight">@context.Weight kg</MudTd>
                <MudTd DataLabel="1RM">@context.MaxRepetition kg</MudTd>
                <MudTd DataLabel="Volume">@context.Volume kg</MudTd>
                <MudTd DataLabel="Intensity">@context.Intensity %</MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    <MudFab @onclick="GoToCreate" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            Class="fixed-create-button" />
}
</div>

@code {
    [Parameter] public string TraineeId { get; set; } = "";

    private GetExerciseResource[]? _exercises;
    private GetExerciseResource? _selected;
    private string _search = "";

    private readonly TableGroupDefinition<GetExerciseResource> _groupDefinition = new()
    {
        GroupName = "Date",
        Indentation = true,
        Expandable = false,
        Selector = e => e.Workout?.Date?.ToString("d") ?? "No Date"
    };

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Trainee Training History";
        _exercises = await Http.GetFromJsonAsync<GetExerciseResource[]>($"/Exercises?userId={TraineeId}");
    }

    private bool FilterExercise(GetExerciseResource item) => AppStateService.MatchesSearch(item, _search);

    private void GoToCreate() => NavigationManager.NavigateTo($"/exercises/create/{TraineeId}");

    private void GoToEditExercise(TableRowClickEventArgs<GetExerciseResource> args)
        => NavigationManager.NavigateTo($"/exercises/edit/{args.Item.Id}");
}
