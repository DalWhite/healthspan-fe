@page "/trainees/{TraineeId}/exercises"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject TitleService TitleService

<PageTitle>Trainee Training</PageTitle>

<PageShell>
    <PageHeader Title="Trainee training">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="GoToCreate">
                Log exercise
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingState Message="Loading workouts..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="Couldn't load trainee workouts"
                    Message="@_errorMessage"
                    ActionLabel="Retry"
                    OnAction="RetryAsync" />
    }
    else if (_workouts.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.CalendarToday"
                    Title="No workouts yet"
                    Subtitle="Log the trainee's first exercise when ready."
                    ActionLabel="Log exercise"
                    OnAction="GoToCreate" />
    }
    else
    {
        <div class="hs-workout-history-summary" aria-live="polite">
            @FormatLoadedCount()
        </div>

        <div class="hs-workout-history-list">
            @foreach (var workout in _workouts)
            {
                var isExpanded = _expandedWorkoutId == workout.Id;
                var detailsId = $"trainee-workout-{workout.Id:N}";

                <article class="hs-workout-session-card hs-surface @(isExpanded ? "is-expanded" : null)">
                    <button type="button"
                            class="hs-workout-session-toggle"
                            aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                            aria-controls="@detailsId"
                            @onclick="() => ToggleWorkoutAsync(workout)">
                        <span class="hs-workout-date-block">
                            <span class="hs-workout-date">@FormatWorkoutDate(workout.Date)</span>
                            <span class="hs-workout-type">@(workout.Type ?? "Workout")</span>
                        </span>

                        <span class="hs-workout-summary-block">
                            <span class="hs-workout-metrics">
                                <span>@FormatExerciseCount(workout.ExerciseCount)</span>
                                @if (workout.TotalVolume > 0)
                                {
                                    <span aria-hidden="true">•</span>
                                    <span>@($"{workout.TotalVolume:N0} kg")</span>
                                }
                            </span>
                            @if (workout.LeadingMuscles.Count > 0)
                            {
                                <span class="hs-workout-muscles">
                                    @foreach (var muscle in workout.LeadingMuscles.Take(3))
                                    {
                                        <span class="hs-workout-muscle-chip">@muscle</span>
                                    }
                                </span>
                            }
                        </span>

                        <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Class="hs-workout-expand-icon" />
                    </button>

                    @if (isExpanded)
                    {
                        <div id="@detailsId" class="hs-workout-detail">
                            @if (_detailsLoading.Contains(workout.Id))
                            {
                                <LoadingState Message="Loading workout..." Size="Size.Small" />
                            }
                            else if (_detailErrors.TryGetValue(workout.Id, out var detailError))
                            {
                                <div class="hs-workout-detail-error" role="alert">
                                    <span>@detailError</span>
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="() => LoadWorkoutDetailsAsync(workout.Id)">
                                        Retry
                                    </MudButton>
                                </div>
                            }
                            else if (_details.TryGetValue(workout.Id, out var detail))
                            {
                                <div class="hs-workout-exercise-list">
                                    @foreach (var exercise in detail.Exercises)
                                    {
                                        <div class="hs-workout-exercise-row">
                                            <div class="hs-workout-exercise-copy">
                                                <span class="hs-workout-exercise-name">@(exercise.Name ?? "Exercise")</span>
                                                <span class="hs-workout-exercise-prescription">@FormatExercisePrescription(exercise)</span>
                                                @if (exercise.Tags.Count > 0)
                                                {
                                                    <span class="hs-training-tag-inline">@string.Join(" · ", exercise.Tags)</span>
                                                }
                                            </div>
                                            <a class="hs-workout-edit-link"
                                               href="@BuildExerciseEditRoute(exercise.Id)"
                                               aria-label="@($"Edit {exercise.Name ?? "exercise"}")">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" />
                                            </a>
                                        </div>
                                    }
                                </div>

                                <div class="hs-workout-detail-actions">
                                    <a class="hs-workout-action hs-workout-add-exercise"
                                       href="@BuildAddExerciseRoute(detail)">
                                        Add exercise
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        </div>

        @if (HasMoreWorkouts)
        {
            <div class="hs-workout-load-more">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="_isLoadingMore"
                           OnClick="LoadMoreAsync">
                    @(_isLoadingMore ? "Loading..." : "Load more")
                </MudButton>
            </div>
        }
    }
</PageShell>

@code {
    private const int PageSize = 20;

    [Parameter] public string TraineeId { get; set; } = string.Empty;

    private readonly List<GetWorkoutResource> _workouts = [];
    private readonly Dictionary<Guid, GetWorkoutResource> _details = [];
    private readonly Dictionary<Guid, string> _detailErrors = [];
    private readonly HashSet<Guid> _detailsLoading = [];
    private Guid? _expandedWorkoutId;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isLoadingMore;
    private int _currentPage;
    private int _totalCount;

    private bool HasMoreWorkouts => _workouts.Count < _totalCount;
    private string ReturnRoute => $"/trainees/{TraineeId}/exercises";

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Trainee Training";
        await LoadHistoryAsync(append: false);
    }

    private async Task LoadHistoryAsync(bool append)
    {
        var requestedPage = append ? _currentPage + 1 : 1;
        _isLoading = !append;
        _isLoadingMore = append;
        _errorMessage = null;

        try
        {
            using var response = await Http.GetAsync(
                $"/workouts{TraineeRoute.TraineeQuery(TraineeId)}&page={requestedPage}&pageSize={PageSize}");
            response.EnsureSuccessStatusCode();
            var items = await response.Content
                .ReadFromJsonAsync<List<GetWorkoutResource>>() ?? [];

            if (!append)
            {
                _workouts.Clear();
            }

            _workouts.AddRange(items.Where(item =>
                _workouts.All(existing => existing.Id != item.Id)));
            _currentPage = requestedPage;
            _totalCount = ReadTotalCount(response, _workouts.Count);
        }
        catch
        {
            _errorMessage = "Check access and connection, then try again.";
        }
        finally
        {
            _isLoading = false;
            _isLoadingMore = false;
        }
    }

    private async Task ToggleWorkoutAsync(GetWorkoutResource workout)
    {
        if (_expandedWorkoutId == workout.Id)
        {
            _expandedWorkoutId = null;
            return;
        }

        _expandedWorkoutId = workout.Id;
        if (!_details.ContainsKey(workout.Id))
        {
            await LoadWorkoutDetailsAsync(workout.Id);
        }
    }

    private async Task LoadWorkoutDetailsAsync(Guid workoutId)
    {
        _detailsLoading.Add(workoutId);
        _detailErrors.Remove(workoutId);

        try
        {
            var detail = await Http.GetFromJsonAsync<GetWorkoutResource>(
                $"/workouts/{workoutId}{TraineeRoute.TraineeQuery(TraineeId)}");
            _details[workoutId] = detail
                ?? throw new InvalidOperationException();
        }
        catch
        {
            _detailErrors[workoutId] = "Couldn't load this workout.";
        }
        finally
        {
            _detailsLoading.Remove(workoutId);
        }
    }

    private Task RetryAsync() => LoadHistoryAsync(append: false);
    private Task LoadMoreAsync() => LoadHistoryAsync(append: true);

    private void GoToCreate()
        => NavigationManager.NavigateTo(
            $"/exercises/create/{TraineeRoute.Escape(TraineeId)}?returnUrl={Uri.EscapeDataString(ReturnRoute)}");

    private string BuildAddExerciseRoute(GetWorkoutResource workout)
        => $"/exercises/create/{TraineeRoute.Escape(TraineeId)}?workoutId={workout.Id}&date={workout.Date:yyyy-MM-dd}&returnUrl={Uri.EscapeDataString(ReturnRoute)}";

    private string BuildExerciseEditRoute(Guid exerciseId)
        => $"/training/history/{exerciseId}/edit{TraineeRoute.TraineeQuery(TraineeId)}&returnUrl={Uri.EscapeDataString(ReturnRoute)}";

    private string FormatLoadedCount()
        => _workouts.Count == _totalCount
            ? FormatWorkoutCount(_totalCount)
            : $"{_workouts.Count} of {_totalCount} workouts";

    private static int ReadTotalCount(
        HttpResponseMessage response,
        int fallback)
        => response.Headers.TryGetValues(
               "X-Total-Count",
               out var values)
           && int.TryParse(values.FirstOrDefault(), out var count)
            ? count
            : fallback;

    private static string FormatWorkoutDate(DateTime? date)
        => date?.Date switch
        {
            null => "Date unavailable",
            var value when value == DateTime.Today => "Today",
            var value when value == DateTime.Today.AddDays(-1) => "Yesterday",
            var value => value.Value.ToString("ddd, d MMM yyyy")
        };

    private static string FormatWorkoutCount(int count)
        => count == 1 ? "1 workout" : $"{count} workouts";

    private static string FormatExerciseCount(int count)
        => count == 1 ? "1 exercise" : $"{count} exercises";

    private static string FormatExercisePrescription(
        WorkoutHistoryExerciseResource exercise)
    {
        var prescription =
            $"{exercise.Series ?? 0} × {exercise.Repetitions ?? 0}";
        return exercise.Weight is > 0
            ? $"{prescription} · {exercise.Weight:N1} kg"
            : prescription;
    }
}
