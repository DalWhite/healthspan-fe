@page "/trainees"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject TitleService TitleService

<PageTitle>Trainees</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (_trainees == null)
    {
        <LoadingState Message="Loading trainees..." />
    }
    else if (!_trainees.Any())
    {
        <EmptyState Icon="@Icons.Material.Filled.People"
                    Title="No trainees yet"
                    Subtitle="Trainees assigned to you will appear here." />
    }
    else
    {
        <MudGrid>
            @foreach (var trainee in _trainees)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="pa-4">
                        <MudAvatar Icon="@Icons.Material.Filled.Person" Size="MudBlazor.Size.Large" />
                        <MudText Typo="Typo.h5" Class="mt-2">@trainee.Name</MudText>

                        <MudCardActions Class="mt-4">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                                               FullWidth="true"
                                               OnClick='@(() => NavigationManager.NavigateTo("/trainees/" + trainee.Id + "/exercises"))'>
                                        Exercises
                                    </MudButton>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary"
                                               FullWidth="true"
                                               OnClick='@(() => NavigationManager.NavigateTo("/trainees/" + trainee.Id + "/favourite-exercises"))'>
                                        Favourites
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<UserResource>? _trainees;

    protected override async Task OnInitializedAsync()
    {
        TitleService.Title = "Trainees";
        _trainees = await Http.GetFromJsonAsync<List<UserResource>>("/users/trainees");
    }
}
