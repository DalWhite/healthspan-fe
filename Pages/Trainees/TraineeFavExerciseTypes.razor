@page "/trainees/{TraineeId}/favourite-exercises"
@inject TitleService TitleService
@inject NavigationManager NavigationManager

<PageTitle>Favourite Exercises</PageTitle>

<ExerciseTypeGrid TraineeId="@TraineeId" FavouritesOnly="true" ShowSearch="true" />

<MudFab @onclick="GoToCreate" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="fixed-create-button" />

@code {
    [Parameter] public string TraineeId { get; set; } = "";

    protected override void OnInitialized()
        => TitleService.Title = "Favourite Exercises";

    private void GoToCreate()
        => NavigationManager.NavigateTo("/exercises/types/create");
}
