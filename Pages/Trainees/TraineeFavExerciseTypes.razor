@page "/trainees/{TraineeId}/favourite-exercises"
@inject TitleService TitleService

<PageTitle>Favourite Exercises</PageTitle>

<div class="hs-page-shell">
    <PageHeader Title="Favourite Exercises" />

    <ExerciseTypeGrid TraineeId="@TraineeId" FavouritesOnly="true" ShowSearch="true" />
</div>

@code {
    [Parameter] public string TraineeId { get; set; } = "";

    protected override void OnInitialized()
        => TitleService.Title = "Favourite Exercises";

}
