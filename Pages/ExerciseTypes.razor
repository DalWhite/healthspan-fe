@page "/exercises/types"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using healthspan_fe_wasm_pwa.Shared
@inject TitleService TitleService

<PageTitle>Exercise Types</PageTitle>

@if (_exerciseTypes == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudTable Items="_exerciseTypes" Hover="true" SortLabel="Sort By" Elevation="0" Dense="true" Breakpoint="Breakpoint.None" Filter="new Func<GetExerciseTypeResource,bool>(FilterFunc1)">
    <ToolBarContent>
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<GetExerciseTypeResource, object>(x => x?.Name ?? string.Empty)">Name</MudTableSortLabel>
        </MudTh>
        <MudTh>Muscle</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Muscle">@GetMuscleNameById(context.PrimaryMuscleId)</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{50, 100}" />
    </PagerContent>
</MudTable>

}
<MudFab @onclick="GoToCreateExerciseType" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" style="float: right;"/>
@code {
    private string searchString1 = "";
    private GetExerciseTypeResource[]? _exerciseTypes;
    private List<Muscle> Muscles = new List<Muscle>
    {
        new Muscle { Id = 1, Name = "Biceps brachii" },
        new Muscle { Id = 3, Name = "Serratus anterior" },
        new Muscle { Id = 4, Name = "Pectoralis major" },
        new Muscle { Id = 5, Name = "Triceps brachii" },
        new Muscle { Id = 6, Name = "Rectus abdominis" },
        new Muscle { Id = 7, Name = "Gastrocnemius" },
        new Muscle { Id = 8, Name = "Gluteus maximus" },
        new Muscle { Id = 9, Name = "Trapezius" },
        new Muscle { Id = 10, Name = "Quadriceps femoris" },
        new Muscle { Id = 11, Name = "Biceps femoris" },
        new Muscle { Id = 12, Name = "Latissimus dorsi" },
        new Muscle { Id = 13, Name = "Brachialis" },
        new Muscle { Id = 14, Name = "Obliquus externus abdominis" },
        new Muscle { Id = 15, Name = "Soleus" }
    };
    private string GetMuscleNameById(int? muscleId)
    {
        return Muscles.FirstOrDefault(m => m.Id == muscleId)?.Name ?? "Not specified";
    }

    protected override async Task OnInitializedAsync()
    {
        _exerciseTypes = await Http.GetFromJsonAsync<GetExerciseTypeResource[]>("/ExerciseTypes");
    }
    protected override void OnInitialized()
    {
        TitleService.Title = "Exercise types";
    }
    private void GoToCreateExerciseType()
    {
        NavigationManager.NavigateTo("/exercises/types/create");
    }
    private bool FilterFunc1(GetExerciseTypeResource element) => FilterFunc(element, searchString1);

    private bool FilterFunc(GetExerciseTypeResource element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Name?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (element.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        return false;
    }
}
