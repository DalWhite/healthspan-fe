@page "/settings"
@using Healthspan.Authentication
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountManagement Acct
@inject Blazored.LocalStorage.ISyncLocalStorageService LocalStorage
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ThemeState ThemeState
@inject AppStateService AppState
@inject CsvImportTracker Tracker
@implements IDisposable

<PageTitle>Ajustes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="hs-page-shell">
    <PageHeader Title="Ajustes" />

    <!-- Account Section -->
    <MudCard Class="mb-4 hs-surface">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Cuenta</MudText>
            <MudText Typo="Typo.subtitle1">@_displayName</MudText>
            @if (!string.IsNullOrWhiteSpace(_email))
            {
                <MudText Typo="Typo.body2" Class="hs-muted-copy mb-3">@_email</MudText>
            }
            <MudButton OnClick="Logout" Color="MudBlazor.Color.Error" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Logout">
                Cerrar sesión
            </MudButton>
        </MudCardContent>
    </MudCard>

    <!-- Theme Section -->
    <!-- Design system v1 is dark-only (docs/design/DESIGN.md §6); the light
         theme toggle is a later option, so no Appearance control here. -->

    <!-- Data Section -->
    <MudCard Class="mb-4 hs-surface">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Tus datos</MudText>

            <div class="d-flex flex-wrap gap-3 align-center">
                <MudButton OnClick="ExportData" Color="MudBlazor.Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           Disabled="_isExporting">
                    @(_isExporting ? "Exportando…" : "Exportar mis datos")
                </MudButton>

                <MudButton OnClick="DownloadTemplate" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Download">
                           Descargar plantilla
                           </MudButton>

                <MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="OnFileSelected" MaximumFileCount="1">
                    <ButtonTemplate>
                        <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   for="@context.Id">
                            Seleccionar CSV
                        </MudButton>
                    </ButtonTemplate>
                </MudFileUpload>

                @if (_selectedFile != null)
                {
                    <MudButton OnClick="ImportFile" Color="MudBlazor.Color.Success" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Upload"
                               Disabled="_isImportStarting || Tracker.IsBusy">
                        @(_isImportStarting ? "Iniciando…" : $"Importar \"{_selectedFile.Name}\"")
                    </MudButton>
                }
            </div>

            @if (_preflightError is not null)
            {
                <div class="hs-import-inline-error mt-3" role="alert">@_preflightError</div>
            }

            @if (_structuralErrors.Count > 0)
            {
                <div class="hs-import-structural mt-3" role="alert">
                    @foreach (var error in _structuralErrors)
                    {
                        <MudText Typo="Typo.body2">@error</MudText>
                    }
                </div>
            }

            @* Panel closed while the job runs: compact row keeps the result
               reachable without hijacking the page (spec §6). Hide ≠ cancel. *@
            @if (Tracker.HasJob && !_panelVisible)
            {
                <div class="hs-import-compact mt-3" role="status">
                    <span>@(Tracker.IsBusy ? $"Importación en curso — {ProcessedText}" : ChipLabel)</span>
                    <MudSpacer />
                    <MudButton OnClick="ShowPanel" Variant="Variant.Text" Color="MudBlazor.Color.Primary" Class="hs-import-action">Ver</MudButton>
                </div>
            }
        </MudCardContent>
    </MudCard>

    <!-- Payment link section (Flujo B, solo entrenadores) -->
    @if (_isTrainer)
    {
        <MudCard Class="mb-4 hs-surface">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Método de pago</MudText>
                <PaymentLinkForm />
            </MudCardContent>
        </MudCard>
    }

    @* Inline progress panel (ux spec t_d1db9866): 202 → poll → real states.
       Not a dialog/snackbar — the page stays navigable while importing. *@
    @if (Tracker.HasJob && _panelVisible)
    {
        <MudCard Class="mb-4 hs-surface hs-import-panel">
            <MudCardContent>
                <div class="d-flex align-center gap-3">
                    <MudChip T="string" Variant="Variant.Text" Class="@ChipCss">@ChipLabel</MudChip>
                    <MudSpacer />
                    @if (Tracker.IsBusy)
                    {
                        <MudButton OnClick="HidePanel" Variant="Variant.Text" Color="MudBlazor.Color.Primary" Class="hs-import-action">
                            Ocultar progreso
                        </MudButton>
                    }
                </div>

                <div class="hs-import-bar-wrap mt-3"
                     role="progressbar"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Tracker.Percent)"
                     aria-valuetext="@BarValueText">
                    <MudProgressLinear Value="@Tracker.Percent" Height="10" Color="@BarColor"
                                       Class="hs-import-bar" aria-hidden="true" />
                </div>

                <MudText Typo="Typo.body2" Class="hs-import-count mt-2">@ProcessedText</MudText>
                <MudText Typo="Typo.caption" Class="hs-import-stats">@StatsText</MudText>

                @if (Tracker.PollingFailed)
                {
                    @* A poll failure is a visibility loss, never a job failure. *@
                    <MudText Typo="Typo.body2" Class="hs-import-reconnect mt-2">
                        Sin conexión — reconectando… el progreso puede retrasarse unos segundos.
                    </MudText>
                }
                else if (Tracker.IsBusy)
                {
                    <MudText Typo="Typo.caption" Class="hs-import-stats mt-1">
                        Puedes seguir usando la app: la importación continúa en segundo plano.
                    </MudText>
                }

                @if (Tracker.Status == "not_found")
                {
                    <MudText Typo="Typo.body2" Class="hs-import-failure mt-2">
                        No encontramos esta importación. Puede que terminara hace más de 24 horas.
                    </MudText>
                }
                else if (Tracker.Status == "failed")
                {
                    <MudText Typo="Typo.body2" Class="hs-import-failure mt-2">
                        La importación se detuvo de forma inesperada. No se guardó ninguna fila: nada se añadió a tu historial. Vuelve a subir el mismo CSV; es seguro y no duplicará nada.
                    </MudText>
                }
                else if (Tracker.Status is "completed" or "completed_with_errors")
                {
                    <MudText Typo="Typo.body2" Class="hs-import-finished mt-2">@FinishedText</MudText>
                }

                @if (Tracker.Errors.Count > 0)
                {
                    <MudExpansionPanel Class="hs-import-errors mt-2"
                                       Text="@($"Errores por fila ({Tracker.ErrorCount})")"
                                       Expanded="@(Tracker.Status == "completed_with_errors")">
                        @foreach (var error in Tracker.Errors)
                        {
                            <MudText Typo="Typo.body2" Class="hs-import-error-row">Fila @error.Row — @error.Message</MudText>
                        }
                        @if (Tracker.ErrorCount > Tracker.Errors.Count)
                        {
                            <MudText Typo="Typo.caption" Class="hs-import-stats">
                                Mostrando los primeros @Tracker.Errors.Count de @Tracker.ErrorCount errores.
                            </MudText>
                        }
                    </MudExpansionPanel>
                }

                <div class="d-flex gap-3 mt-3">
                    @if (Tracker.Status is "completed" or "completed_with_errors")
                    {
                        <MudButton OnClick="DismissJob" Color="MudBlazor.Color.Primary" Variant="Variant.Filled">Hecho</MudButton>
                    }
                    else if (Tracker.Status is "failed" or "cancelled" or "not_found")
                    {
                        <MudButton OnClick="DismissJob" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary">Descartar</MudButton>
                    }
                </div>

                @* aria-live announces state changes only, never counter ticks
                   (spec §9: avoid screen-reader spam). *@
                <div class="mud-sr-only" aria-live="polite">@_statusAnnouncement</div>
            </MudCardContent>
        </MudCard>
    }

</MudContainer>

@code {
    private IBrowserFile? _selectedFile;
    private string _displayName = "Usuario con sesión iniciada";
    private string? _email;
    private bool _isExporting;
    private bool _isTrainer;
    private bool _isImportStarting;
    private bool _panelVisible = true;
    private string? _preflightError;
    private IReadOnlyList<string> _structuralErrors = [];
    private string _statusAnnouncement = string.Empty;
    private string _lastStatus = "idle";

    protected override async Task OnInitializedAsync()
    {
        Tracker.Changed += HandleTrackerChanged;

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isTrainer = (await AppState.GetUserRolesAsync()).Contains("Trainer");
        _email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.Identity?.Name;
        _displayName = user.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("name")?.Value
            ?? _email
            ?? "Usuario con sesión iniciada";

        // Reload / re-attach: a job started earlier (or from another page)
        // resumes its panel here (spec §4, localStorage key hs.import.job).
        await Tracker.AttachAsync();
        _lastStatus = Tracker.Status;
    }

    private async Task Logout()
    {
        if (await Acct.CheckAuthenticatedAsync())
            await Acct.LogoutAsync();
        NavigationManager.NavigateTo("/login", true);
    }

    private async Task DownloadTemplate()
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync("/data/import/template");
            using var stream = new DotNetStreamReference(new MemoryStream(bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", "exercises-template.csv", stream);
        }
        catch
        {
            Snackbar.Add("No se pudo descargar la plantilla.", Severity.Error);
        }
    }

    private async Task ExportData()
    {
        _isExporting = true;

        try
        {
            var bytes = await Http.GetByteArrayAsync(
                "/data/export");
            using var stream = new DotNetStreamReference(
                new MemoryStream(bytes));
            await JS.InvokeVoidAsync(
                "downloadFileFromStream",
                $"healthspan-export-{DateTime.Today:yyyyMMdd}.json",
                stream);
        }
        catch
        {
            Snackbar.Add(
                "No se pudieron exportar tus datos.",
                Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        _preflightError = null;
        _structuralErrors = [];
    }

    private async Task ImportFile()
    {
        if (_selectedFile == null)
        {
            Snackbar.Add("Selecciona primero un archivo.", Severity.Warning);
            return;
        }

        _preflightError = null;
        _structuralErrors = [];

        // Client preflight (spec §2.2): the contract limits are 5 MB / ~50k
        // rows; catch the predictable failures without a round-trip.
        if (!_selectedFile.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            _preflightError = "Las importaciones admiten archivos CSV de hasta 5 MB (unas 50.000 filas).";
            return;
        }

        if (_selectedFile.Size > CsvImportTracker.MaxUploadBytes)
        {
            var sizeMb = _selectedFile.Size / (1024.0 * 1024.0);
            _preflightError =
                $"Ese archivo pesa {sizeMb:0.#} MB. Las importaciones admiten archivos CSV de hasta 5 MB (unas 50.000 filas).";
            return;
        }

        var dataRows = await CountCsvDataRowsAsync(_selectedFile);
        if (dataRows > CsvImportTracker.MaxUploadRows)
        {
            _preflightError =
                $"Ese archivo tiene {dataRows:N0} filas. Las importaciones admiten archivos CSV de hasta 5 MB (unas 50.000 filas).";
            return;
        }

        _isImportStarting = true;
        try
        {
            // QA t_79d39b1e finding: OpenReadStream() with no argument capped
            // the upload at the 512 KB default. Stream the full 5 MB the API
            // accepts.
            using var stream = _selectedFile.OpenReadStream(CsvImportTracker.MaxUploadBytes);
            var (started, errors) = await Tracker.StartAsync(
                stream, _selectedFile.Name, _selectedFile.ContentType);

            if (started)
            {
                _selectedFile = null;
                _panelVisible = true;
            }
            else
            {
                _structuralErrors = errors;
            }
        }
        catch (IOException)
        {
            _preflightError = "El archivo es demasiado grande para subirlo (máx. 5 MB).";
        }
        finally
        {
            _isImportStarting = false;
        }
    }

    private void HidePanel() => _panelVisible = false;

    /// <summary>
    /// Client row-count preflight (spec §2.2): cheap newline count over the
    /// upload stream, stopping as soon as the 50k limit is exceeded. The
    /// server stays the authority; this only avoids a pointless round-trip.
    /// </summary>
    private static async Task<int> CountCsvDataRowsAsync(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(CsvImportTracker.MaxUploadBytes);
        using var reader = new System.IO.StreamReader(stream);
        var newLines = 0;
        var buffer = new char[16384];
        int read;
        while ((read = await reader.ReadAsync(buffer, 0, buffer.Length)) > 0)
        {
            for (var i = 0; i < read; i++)
            {
                if (buffer[i] == '\n') newLines++;
            }
            if (newLines > CsvImportTracker.MaxUploadRows) break; // header + >50k rows
        }
        return Math.Max(0, newLines - 1);
    }
    private void ShowPanel() => _panelVisible = true;

    private void DismissJob()
    {
        Tracker.Dismiss();
        _selectedFile = null;
        _panelVisible = true;
    }

    private void HandleTrackerChanged()
    {
        if (Tracker.Status != _lastStatus)
        {
            _lastStatus = Tracker.Status;
            _statusAnnouncement = ChipLabel;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private string ChipLabel => Tracker.Status switch
    {
        // A poll failure only costs visibility: the job is still importing
        // (spec §3 — never show a job failure because of a failed fetch).
        _ when Tracker.PollingFailed && Tracker.IsBusy => "Importando",
        "queued" => "En cola",
        "running" => "Importando",
        "completed" => "Completada",
        "completed_with_errors" => "Completada con incidencias",
        "failed" => "Detenida",
        "cancelled" => "Cancelada",
        "not_found" => "No encontrada",
        _ => ""
    };

    private string ChipCss => Tracker.Status switch
    {
        "queued" or "running" => "hs-import-chip hs-import-chip-accent",
        "completed" => "hs-import-chip hs-import-chip-done",
        "completed_with_errors" => "hs-import-chip hs-import-chip-pr",
        _ => "hs-import-chip hs-import-chip-err"
    };

    private MudBlazor.Color BarColor => Tracker.Status switch
    {
        "completed" => MudBlazor.Color.Success,
        "completed_with_errors" => MudBlazor.Color.Warning,
        "failed" or "cancelled" or "not_found" => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Primary
    };

    // t_4965e7c7 + t_a0c76b0e: with the single transaction, "failed" and
    // "cancelled" both mean 0 committed rows — the counters are diagnostic
    // only, so they must never read as a count of saved rows in those states.
    // Live progress (running/queued) keeps the numbers as-is.
    private string ProcessedText => Tracker.Status is "failed" or "cancelled"
        ? "No se guardó ninguna fila"
        : $"{Tracker.Processed:N0} de {Tracker.Total:N0} filas";

    private string BarValueText => Tracker.Status switch
    {
        "failed" => "Importación detenida — no se guardó ninguna fila",
        "cancelled" => "Importación cancelada — no se guardó ninguna fila",
        _ => $"{Tracker.Processed:N0} de {Tracker.Total:N0} filas importadas"
    };

    private string StatsText
    {
        get
        {
            if (!Tracker.HasJob)
            {
                return string.Empty;
            }

            var rate = Tracker.RowsPerSecond is > 0
                ? $"≈ {Tracker.RowsPerSecond:N0} filas/s"
                : "midiendo velocidad…";
            return $"{rate} · {ElapsedText} transcurrido";
        }
    }

    private string ElapsedText
    {
        get
        {
            var elapsed = Tracker.Elapsed;
            if (elapsed < TimeSpan.FromMinutes(1))
            {
                return $"{elapsed.TotalSeconds:0.#} s";
            }
            return $"{(int)elapsed.TotalMinutes} m {elapsed.Seconds} s";
        }
    }

    private string FinishedText => Tracker.Status switch
    {
        "completed" => $"Importación completada: {Tracker.Processed:N0} filas añadidas a tu historial.",
        _ => $"Importación completada: {Tracker.Processed:N0} filas añadidas, {Tracker.ErrorCount:N0} filas omitidas."
    };

    public void Dispose() => Tracker.Changed -= HandleTrackerChanged;
}
