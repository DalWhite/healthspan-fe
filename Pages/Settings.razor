@page "/settings"
@using Healthspan.Authentication
@using System.Net.Http.Headers
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountManagement Acct
@inject Blazored.LocalStorage.ISyncLocalStorageService LocalStorage
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="hs-page-shell">
    <PageHeader Title="Settings" />

    <!-- Account Section -->
    <MudCard Class="mb-4 hs-surface">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Account</MudText>
            <MudButton OnClick="Logout" Color="MudBlazor.Color.Error" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Logout">
                Logout
            </MudButton>
        </MudCardContent>
    </MudCard>

    <!-- Theme Section -->
    <MudCard Class="mb-4 hs-surface">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Appearance</MudText>
            <MudSwitch Value="_isDarkMode" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary"
                       Label="Dark Theme" ValueChanged="HandleDarkModeChanged" T="bool" />
        </MudCardContent>
    </MudCard>

    <!-- Data Section -->
    <MudCard Class="mb-4 hs-surface">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Data Import / Export</MudText>

            <div class="d-flex flex-wrap gap-3 align-center">
                <MudButton OnClick="DownloadTemplate" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Download">
                    Download Template
                </MudButton>

                <MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="OnFileSelected" MaximumFileCount="1">
                    <ButtonTemplate>
                        <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   for="@context.Id">
                            Select CSV
                        </MudButton>
                    </ButtonTemplate>
                </MudFileUpload>

                @if (_selectedFile != null)
                {
                    <MudButton OnClick="ImportFile" Color="MudBlazor.Color.Success" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Upload">
                        Import "@_selectedFile.Name"
                    </MudButton>
                }
            </div>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Dark" Style="opacity: 0.4;">v0.0.1</MudText>
</MudContainer>

@code {
    private bool _isDarkMode;
    private IBrowserFile? _selectedFile;

    protected override void OnInitialized()
    {
        if (LocalStorage.ContainKey("_isDarkMode"))
            _isDarkMode = LocalStorage.GetItem<bool>("_isDarkMode");
    }

    private async Task Logout()
    {
        if (await Acct.CheckAuthenticatedAsync())
            await Acct.LogoutAsync();
        NavigationManager.NavigateTo("/login", true);
    }

    private void HandleDarkModeChanged(bool value)
    {
        _isDarkMode = value;
        LocalStorage.SetItem("_isDarkMode", value);
    }

    private async Task DownloadTemplate()
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync("/data/import/template");
            using var stream = new DotNetStreamReference(new MemoryStream(bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", "exercises-template.csv", stream);
        }
        catch
        {
            Snackbar.Add("Failed to download template.", Severity.Error);
        }
    }

    private void OnFileSelected(IBrowserFile file)
        => _selectedFile = file;

    private async Task ImportFile()
    {
        if (_selectedFile == null)
        {
            Snackbar.Add("Please select a file first.", Severity.Warning);
            return;
        }

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(_selectedFile.OpenReadStream());
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(_selectedFile.ContentType);
            content.Add(fileContent, "\"files\"", "exercises.csv");

            var response = await Http.PostAsync("/data/import", content);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Import completed successfully!", Severity.Success);
                _selectedFile = null;
            }
            else
            {
                Snackbar.Add("Import failed. Please check your file and try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import error: {ex.Message}", Severity.Error);
        }
    }
}
